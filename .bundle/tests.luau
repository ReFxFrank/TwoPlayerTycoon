MODULE_DEFS["ReplicatedStorage/Modules/StateSchema"] = function(script, require, ...)
--#region src/shared/StateSchema.luau
--!strict
--[[
    StateSchema
    The authoritative shape of everything saved, merged or replicated: PlotState, Prestige, Settings,
    Stats and the Profile wrapping them. It builds fresh state, repairs arbitrary input into a legal
    Profile, version-migrates old saves, max-merges two Sanctum states when a partner links in (§1.5)
    and renders the StateSync snapshot (§7). PURE -- no services, no Instances -- so ProfileService,
    PlotService, StateReplicator and the headless tests all share one definition.
    Owner: shared  |  Consumers: ProfileService, PlotService, StateReplicator, Snapshot, tests
]]
--[[ THREAT MODEL. Input to sanitizeProfile is whatever a DataStore returned: nil, a string, an
     array, a cyclic table, NaN/inf/negative numbers, or a profile forged on an older build. It must
     ALWAYS return a legal Profile and NEVER error -- an error here is a failed load, and a failed
     load ends as a kicked player or, far worse, a blank profile overwriting a real save. Every read
     is depth-bounded (no recursive walk) so a cyclic table cannot spin, and every value is clamped
     or dropped, never merely coerced. ]]

local Validate = require(script.Parent.Validate)
local Economy = require(script.Parent.Economy)
local GameConfig = require(script.Parent.GameConfig)
local DropperData = require(script.Parent.DropperData)
local UpgradeData = require(script.Parent.UpgradeData)
local SectionData = require(script.Parent.SectionData)
local EvolutionData = require(script.Parent.EvolutionData)
local AffinityData = require(script.Parent.AffinityData)
local RebirthData = require(script.Parent.RebirthData)

type PlotState = {
	Essence: number, Stage: number, Affinity: string?,
	Droppers: { [string]: number }, Upgrades: { [string]: number }, Sections: { [string]: boolean },
	LifetimeEssence: number,
}
type Prestige = { Rebirths: number, Multiplier: number, Badges: { [string]: boolean }, TotalTranscended: number }
type Settings = { Music: boolean, Sfx: boolean }
type Stats = { TotalEssenceEarned: number, Playtime: number, JoinCount: number, FirstJoin: number, LastSave: number }
type Profile = { SchemaVersion: number, Plot: PlotState, Prestige: Prestige, Settings: Settings, Stats: Stats }

local StateSchema = {}
StateSchema.VERSION = 1
-- Currency ceilings sit below 2^53 so every stored balance stays an exact integer; past that,
-- addition rounds and a shared wallet silently drifts. MAX_TIME is seconds since the epoch.
local MAX_CURRENCY, MAX_TIME = 1e15, 1e11
local EMPTY: { [string]: any } = {}
local clamp = Validate.clampNumber -- (v, min, max, default); total, NaN/inf safe
local function tbl(v: any): { [string]: any }
	return if type(v) == "table" then v :: { [string]: any } else EMPTY
end
local function int(v: any, min: number, max: number, default: number): number
	return math.floor(clamp(v, min, max, default))
end
-- Only catalogue ids survive, each count clamped to that def's own ceiling: the single barrier
-- between a hand-edited save ({ god_mode = 1e300 }) and the income loop. Zeroes are dropped so the
-- table stays small and `next(Droppers) == nil` means "owns nothing".
local function sanitizeCounts(raw: any, get: (string) -> any, ceilingField: string): { [string]: number }
	local out: { [string]: number } = {}
	if type(raw) ~= "table" then return out end
	for id, value in pairs(raw :: { [any]: any }) do
		local def = if type(id) == "string" then get(id) else nil
		if def ~= nil then
			local n = int(value, 0, clamp(tbl(def)[ceilingField], 0, 1e6, 0), 0)
			if n > 0 then out[id] = n end
		end
	end
	return out
end
local function sanitizePlotState(raw: any): PlotState
	local src = tbl(raw)
	-- the base wing is force-unlocked: a save that lost it would have no pads and no way back
	local sections: { [string]: boolean } = { [SectionData.Base] = true }
	if type(src.Sections) == "table" then
		for id, value in pairs(src.Sections :: { [any]: any }) do
			if value and type(id) == "string" and SectionData.get(id) ~= nil then sections[id] = true end
		end
	end
	return {
		Essence = clamp(src.Essence, 0, MAX_CURRENCY, 0),
		Stage = int(src.Stage, 1, EvolutionData.MaxStage, 1),
		-- an unknown affinity id becomes nil (unchosen), not a failed lookup on every income tick
		Affinity = if AffinityData.isValid(src.Affinity) then src.Affinity :: string else nil,
		Droppers = sanitizeCounts(src.Droppers, DropperData.get, "MaxOwned"),
		Upgrades = sanitizeCounts(src.Upgrades, UpgradeData.get, "MaxLevel"),
		Sections = sections, LifetimeEssence = clamp(src.LifetimeEssence, 0, MAX_CURRENCY, 0),
	}
end
-- Badges are rebuilt from the rebirth count, then unioned with any stored badge still in the
-- catalogue: rebuilding self-heals an award lost to a failed save, the union keeps a hand-granted
-- one, unknown ids are dropped.
local function sanitizePrestige(raw: any): Prestige
	local src = tbl(raw)
	local rebirths = int(src.Rebirths, 0, RebirthData.MaxTrackedRebirths, 0)
	local badges = RebirthData.badgesFor(rebirths)
	if type(src.Badges) == "table" then
		for id, value in pairs(src.Badges :: { [any]: any }) do
			if value and type(id) == "string" and RebirthData.ById[id] ~= nil then badges[id] = true end
		end
	end
	-- Multiplier is always recomputed: the stored field is a cache, and trusting it would turn one
	-- bad write into a permanent income multiplier.
	return {
		Rebirths = rebirths, Multiplier = Economy.getPrestigeMultiplier(rebirths),
		Badges = badges, TotalTranscended = clamp(src.TotalTranscended, 0, MAX_CURRENCY, 0),
	}
end
-- Both default ON: a missing setting must not silently mute a player who never opened the menu.
local function sanitizeSettings(raw: any): Settings
	local src = tbl(raw)
	return {
		Music = if type(src.Music) == "boolean" then src.Music :: boolean else true,
		Sfx = if type(src.Sfx) == "boolean" then src.Sfx :: boolean else true,
	}
end
local function sanitizeStats(raw: any): Stats
	local src, now = tbl(raw), os.time()
	return {
		TotalEssenceEarned = clamp(src.TotalEssenceEarned, 0, MAX_CURRENCY, 0),
		Playtime = clamp(src.Playtime, 0, MAX_TIME, 0),
		JoinCount = int(src.JoinCount, 0, 1e7, 0),
		FirstJoin = int(src.FirstJoin, 0, MAX_TIME, now), -- absent becomes now, never 1970
		LastSave = int(src.LastSave, 0, MAX_TIME, 0),
	}
end
function StateSchema.newPlotState(): PlotState
	return {
		Essence = clamp(GameConfig.Currency.StartingAmount, 0, MAX_CURRENCY, 0),
		Stage = 1, Affinity = nil, Droppers = {}, Upgrades = {},
		Sections = { [SectionData.Base] = true }, LifetimeEssence = 0,
	}
end
function StateSchema.newProfile(): Profile
	local now = os.time()
	return {
		SchemaVersion = StateSchema.VERSION,
		Plot = StateSchema.newPlotState(),
		Prestige = { Rebirths = 0, Multiplier = Economy.getPrestigeMultiplier(0), Badges = {}, TotalTranscended = 0 },
		Settings = { Music = true, Sfx = true },
		Stats = { TotalEssenceEarned = 0, Playtime = 0, JoinCount = 0, FirstJoin = now, LastSave = 0 },
	}
end
-- Cloning IS repairing: a copy that preserved corruption would spread it to the next save, so the
-- deep copy and the sanitiser are deliberately one operation.
function StateSchema.clonePlotState(state: PlotState): PlotState
	return sanitizePlotState(state)
end
function StateSchema.sanitizeProfile(raw: any): Profile
	local ok, profile = pcall(function(): Profile
		local src = tbl(raw)
		return {
			SchemaVersion = StateSchema.VERSION,
			Plot = sanitizePlotState(src.Plot), Prestige = sanitizePrestige(src.Prestige),
			Settings = sanitizeSettings(src.Settings), Stats = sanitizeStats(src.Stats),
		}
	end)
	-- last resort: a pathological input (protected metatable, __index that throws) still yields a
	-- playable profile instead of an error escaping into the load path
	return if ok then profile else StateSchema.newProfile()
end
-- from-version -> transform. Empty at VERSION 1; each future entry converts one step forward and
-- may assume nothing about its input beyond "it is whatever was stored".
local MIGRATIONS: { [number]: (any) -> any } = {}
function StateSchema.migrate(raw: any): Profile
	local working: any = raw
	local version = int(tbl(raw).SchemaVersion, 0, 1e6, 0)
	local steps = 0 -- bounds the loop even if a future step rewrites SchemaVersion backwards
	while version < StateSchema.VERSION and steps < 64 do
		local step = MIGRATIONS[version]
		if step ~= nil then
			-- a step that throws is skipped, not fatal: sanitizeProfile still salvages the fields it
			-- understands, which beats resetting a veteran's account to zero
			local ok, result = pcall(step, working)
			if ok then working = result end
		end
		version += 1
		steps += 1
	end
	-- A profile stamped NEWER than this server (a rollback) is sanitised down, not refused: unknown
	-- fields are lost, but the player is never locked out of their account.
	return StateSchema.sanitizeProfile(working)
end
--[[ Max-merge (§1.5): joining an occupied Sanctum must never cost the joiner something they owned,
     so every scalar takes the max and every set takes the union. Essence is MAXed, not summed --
     summing would let a pair relink over and over to duplicate their wallet. ]]
function StateSchema.mergePlotStates(a: PlotState, b: PlotState): PlotState
	local left, right = sanitizePlotState(a), sanitizePlotState(b)
	local out = StateSchema.newPlotState()
	out.Essence = math.max(left.Essence, right.Essence)
	out.Stage = math.max(left.Stage, right.Stage)
	out.LifetimeEssence = math.max(left.LifetimeEssence, right.LifetimeEssence)
	-- `a` wins the affinity: it is the LIVE sanctum, whose conflux visuals and multipliers are
	-- already running. A joiner never rewrites the element the pair has been playing.
	out.Affinity = left.Affinity or right.Affinity
	for _, field in ipairs({ "Droppers", "Upgrades" }) do
		local target = (out :: any)[field] :: { [string]: number }
		for id, count in pairs((left :: any)[field] :: { [string]: number }) do target[id] = count end
		for id, count in pairs((right :: any)[field] :: { [string]: number }) do
			target[id] = math.max(target[id] or 0, count)
		end
	end
	for id in pairs(left.Sections) do out.Sections[id] = true end
	for id in pairs(right.Sections) do out.Sections[id] = true end
	-- re-clamped: a union can exceed a def's MaxOwned if the catalogue shrank between the two saves
	return sanitizePlotState(out)
end
-- NOTE: rendering the StateSync payload lives in Snapshot.luau, NOT here. It was split out to
-- keep both files inside the project's 300-line budget, and because replication is a different
-- concern from persistence. Do not re-add snapshotForClient to this module.
-- Exposed so PlotService and the specs can repair a FRAGMENT of state without loading a whole
-- Profile; they are the very functions the sanitiser uses, so "legal" has one definition.
StateSchema.sanitizePlotState = sanitizePlotState
StateSchema.sanitizePrestige = sanitizePrestige
StateSchema.sanitizeSettings = sanitizeSettings
StateSchema.MAX_CURRENCY, StateSchema.MAX_TIME = MAX_CURRENCY, MAX_TIME

return StateSchema

--#endregion
end
MODULE_ORDER[#MODULE_ORDER + 1] = { Path = "ReplicatedStorage/Modules/TableUtil", Class = "ModuleScript", File = "src/shared/TableUtil.luau" }
MODULE_DEFS["ReplicatedStorage/Modules/TableUtil"] = function(script, require, ...)
--#region src/shared/TableUtil.luau
--!strict
--[[
    TableUtil
    Pure table helpers used across every layer: copying (cycle-safe), merging, key/value extraction,
    list transforms and deep comparison. No services, no Instances -- safe on client, server and in
    the headless test harness.
    Owner: shared  |  Consumers: StateSchema, ClientStore, ProfileService, PlotService, UiBuilder
]]

local TableUtil = {}

type AnyTable = { [any]: any }

-- WHY the identity map: PlotState snapshots and runtime tables can contain shared sub-tables (and,
-- during development, accidental cycles). Copying with a `seen` map preserves the original object
-- graph exactly and makes a cyclic input terminate instead of overflowing the stack.
local function copyValue(value: any, seen: AnyTable): any
	if type(value) ~= "table" then
		-- Numbers/strings/booleans are immutable; userdata (Color3, Vector3, CFrame, Enum items) is
		-- immutable in Roblox too, so both are copied BY REFERENCE. Never touch their metatables.
		return value
	end

	local existing = seen[value]
	if existing ~= nil then
		return existing
	end

	local copy: AnyTable = {}
	seen[value] = copy
	for key, item in pairs(value) do
		-- Keys are NOT deep-copied: a copied table-key would be unreachable via the original key.
		copy[key] = copyValue(item, seen)
	end

	-- Share the metatable by reference so class-like tables keep their behaviour; deep-copying a
	-- metatable would duplicate methods for no benefit. Guard against __metatable-protected tables,
	-- where getmetatable returns a non-table.
	local meta = getmetatable(value :: any)
	if type(meta) == "table" then
		setmetatable(copy, meta)
	end
	return copy
end

function TableUtil.deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	return copyValue(t, {}) :: any
end

function TableUtil.shallowCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	return (table.clone(t :: any) :: any)
end

-- Returns a NEW table: base with patch applied. Nested plain tables are merged recursively so a
-- patch like { Plot = { Essence = 5 } } does not wipe the rest of Plot; array-like tables and
-- userdata are replaced wholesale (there is no sane element-wise merge for ordered data).
function TableUtil.merge(base: AnyTable?, patch: AnyTable?): AnyTable
	local result: AnyTable = {}
	if type(base) == "table" then
		for key, value in pairs(base :: AnyTable) do
			result[key] = TableUtil.deepCopy(value)
		end
	end
	if type(patch) == "table" then
		for key, value in pairs(patch :: AnyTable) do
			local current = result[key]
			if type(value) == "table" and type(current) == "table" and not TableUtil.isArray(value) then
				result[key] = TableUtil.merge(current :: AnyTable, value :: AnyTable)
			else
				result[key] = TableUtil.deepCopy(value)
			end
		end
	end
	return result
end

function TableUtil.count(t: AnyTable?): number
	if type(t) ~= "table" then
		return 0
	end
	local n = 0
	for _ in pairs(t :: AnyTable) do
		n += 1
	end
	return n
end

function TableUtil.keys(t: AnyTable?): { any }
	local out: { any } = {}
	if type(t) ~= "table" then
		return out
	end
	for key in pairs(t :: AnyTable) do
		table.insert(out, key)
	end
	return out
end

function TableUtil.values(t: AnyTable?): { any }
	local out: { any } = {}
	if type(t) ~= "table" then
		return out
	end
	for _, value in pairs(t :: AnyTable) do
		table.insert(out, value)
	end
	return out
end

-- Deterministic key order. WHY a default comparator: table.sort errors on mixed key types, and
-- dictionaries keyed by both strings and numbers do occur (Theme.Stage is numeric, ids are strings).
function TableUtil.sortedKeys(t: AnyTable?, comparator: ((a: any, b: any) -> boolean)?): { any }
	local out = TableUtil.keys(t)
	local compare = comparator
		or function(a: any, b: any): boolean
			local ta, tb = type(a), type(b)
			if ta ~= tb then
				return ta < tb
			end
			if ta == "number" or ta == "string" then
				return (a :: any) < (b :: any)
			end
			return tostring(a) < tostring(b)
		end
	table.sort(out, compare)
	return out
end

function TableUtil.isEmpty(t: AnyTable?): boolean
	if type(t) ~= "table" then
		return true
	end
	return next(t :: AnyTable) == nil
end

-- True for a contiguous 1..n integer-keyed table. An empty table counts as an array, which is what
-- callers merging/serialising state want.
function TableUtil.isArray(t: any): boolean
	if type(t) ~= "table" then
		return false
	end
	local length = #t
	local seen = 0
	for key in pairs(t) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > length then
			return false
		end
		seen += 1
	end
	return seen == length
end

function TableUtil.find<V>(list: { V }?, predicate: (value: V, index: number) -> boolean): (V?, number?)
	if type(list) ~= "table" or type(predicate) ~= "function" then
		return nil, nil
	end
	for index, value in ipairs(list :: { V }) do
		if predicate(value, index) then
			return value, index
		end
	end
	return nil, nil
end

function TableUtil.map<V, R>(list: { V }?, fn: (value: V, index: number) -> R): { R }
	local out: { R } = {}
	if type(list) ~= "table" or type(fn) ~= "function" then
		return out
	end
	for index, value in ipairs(list :: { V }) do
		out[index] = fn(value, index)
	end
	return out
end

function TableUtil.filter<V>(list: { V }?, fn: (value: V, index: number) -> boolean): { V }
	local out: { V } = {}
	if type(list) ~= "table" or type(fn) ~= "function" then
		return out
	end
	for index, value in ipairs(list :: { V }) do
		if fn(value, index) then
			table.insert(out, value)
		end
	end
	return out
end

function TableUtil.reduce<V, A>(list: { V }?, fn: (acc: A, value: V, index: number) -> A, init: A): A
	local acc = init
	if type(list) ~= "table" or type(fn) ~= "function" then
		return acc
	end
	for index, value in ipairs(list :: { V }) do
		acc = fn(acc, value, index)
	end
	return acc
end

-- Structural equality. Userdata (Color3/Vector3) compares with ==, which Roblox defines by value.
-- The `seen` pair-map makes cyclic inputs terminate: a pair already being compared is assumed equal
-- (standard co-inductive equality) rather than recursing forever.
local function deepEquals(a: any, b: any, seen: AnyTable): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end

	local pairsForA = seen[a]
	if pairsForA ~= nil and pairsForA[b] then
		return true
	end
	if pairsForA == nil then
		pairsForA = {}
		seen[a] = pairsForA
	end
	pairsForA[b] = true

	for key, value in pairs(a) do
		if not deepEquals(value, (b :: AnyTable)[key], seen) then
			return false
		end
	end
	for key in pairs(b) do
		if (a :: AnyTable)[key] == nil then
			return false
		end
	end
	return true
end

function TableUtil.deepEquals(a: any, b: any): boolean
	return deepEquals(a, b, {})
end

return TableUtil

--#endregion
end
MODULE_ORDER[#MODULE_ORDER + 1] = { Path = "ReplicatedStorage/Modules/Theme", Class = "ModuleScript", File = "src/shared/Theme.luau" }
MODULE_DEFS["ReplicatedStorage/Modules/Theme"] = function(script, require, ...)
--#region src/shared/Theme.luau
--!strict
--[[
    Theme
    The visual identity of Sanctum of Embers in one place: the dark-slate + warm-ember UI palette,
    a colour/material set per Affinity, a colour/size/material set per Attunement Stage, and the
    blend rule that decides what the Conflux actually looks like right now.
    Pure data + one pure function: only Color3/Enum constructors, no services, no Instances.
    Owner: shared  |  Consumers: UiBuilder, HudController, PromptController, EvolutionFxController,
                                 PlotBuilder, EvolutionService
]]

type AffinityTheme = {
	Primary: Color3,
	Secondary: Color3,
	Material: Enum.Material,
}

type StageTheme = {
	Color: Color3,
	Size: number,
	Material: Enum.Material,
}

type ConfluxAppearance = {
	Color: Color3,
	Size: number,
	Material: Enum.Material,
}

type Rgb = { number }

-- WHY raw RGB triples are kept alongside the Color3 values: getConfluxAppearance blends a stage
-- colour with an affinity colour, and doing that on plain numbers avoids reading Color3 components
-- (keeping this module to constructors only, exactly as the purity rule requires).
local STAGE_DEFS: { { Rgb: Rgb, Size: number, Material: Enum.Material } } = {
	-- 1 Mote: a timid spark. Small, pale, warm.
	{ Rgb = { 255, 196, 120 }, Size = 6.0, Material = Enum.Material.Neon },
	-- 2 Wisp: brighter and hungrier.
	{ Rgb = { 255, 158, 84 }, Size = 7.5, Material = Enum.Material.Neon },
	-- 3 Sprite: the stage where an Affinity is chosen, so the base colour is a strong ember.
	{ Rgb = { 255, 122, 58 }, Size = 9.0, Material = Enum.Material.Glass },
	-- 4 Elemental: the ember starts burning through into raw energy.
	{ Rgb = { 255, 92, 96 }, Size = 11.0, Material = Enum.Material.Neon },
	-- 5 Warden: arcane violet, visibly "not fire any more".
	{ Rgb = { 206, 120, 255 }, Size = 13.0, Material = Enum.Material.ForceField },
	-- 6 Primordial: near-white starlight; the transcendence-ready look.
	{ Rgb = { 255, 244, 222 }, Size = 16.0, Material = Enum.Material.Neon },
}

local AFFINITY_DEFS: { [string]: { Primary: Rgb, Secondary: Rgb, Material: Enum.Material } } = {
	-- Ember: aggressive orange, the "default" flavour of the sanctum.
	ember = { Primary = { 255, 112, 40 }, Secondary = { 122, 30, 12 }, Material = Enum.Material.Neon },
	-- Tide: deep water blue, glassy so it reads as liquid rather than flame.
	tide = { Primary = { 58, 168, 255 }, Secondary = { 14, 58, 122 }, Material = Enum.Material.Glass },
	-- Terra: mossy green over stone; the dense, heavy affinity.
	terra = { Primary = { 128, 198, 90 }, Secondary = { 58, 92, 44 }, Material = Enum.Material.Slate },
	-- Zephyr: pale cyan mist, ForceField so it looks barely-there and fast.
	zephyr = { Primary = { 168, 240, 236 }, Secondary = { 60, 120, 132 }, Material = Enum.Material.ForceField },
}

-- How strongly the chosen Affinity tints the Conflux. Below 0.5 on purpose: the stage progression
-- must still read at a glance, the affinity is a flavour on top of it.
local AFFINITY_TINT = 0.45

local function lerpChannel(a: number, b: number, alpha: number): number
	local blended = a + (b - a) * alpha
	return math.clamp(math.floor(blended + 0.5), 0, 255)
end

local Theme = {}

--[[ UI palette: dark slate panels so the glowing sanctum stays the brightest thing on screen, with
     a single warm ember accent used for anything actionable. ]]
Theme.Ui = {
	Background = Color3.fromRGB(12, 14, 20), -- behind everything / modal scrim base
	Panel = Color3.fromRGB(24, 28, 38), -- HUD + modal panel fill
	Accent = Color3.fromRGB(255, 138, 61), -- ember accent: buttons, progress fill, highlights
	Text = Color3.fromRGB(236, 240, 248), -- primary label colour
	Muted = Color3.fromRGB(138, 148, 168), -- secondary/disabled label colour
	Positive = Color3.fromRGB(92, 214, 137), -- success toasts, affordable prompts
	Negative = Color3.fromRGB(232, 86, 86), -- errors, unaffordable prompts
	Warning = Color3.fromRGB(245, 196, 84), -- vote timers, "are you sure" states
	Stroke = Color3.fromRGB(52, 60, 78), -- UIStroke colour for panels (extra, non-spec)
	Overlay = Color3.fromRGB(6, 7, 11), -- full-screen modal dim (extra, non-spec)
}

Theme.Affinity = {} :: { [string]: AffinityTheme }
for id, def in pairs(AFFINITY_DEFS) do
	Theme.Affinity[id] = {
		Primary = Color3.fromRGB(def.Primary[1], def.Primary[2], def.Primary[3]),
		Secondary = Color3.fromRGB(def.Secondary[1], def.Secondary[2], def.Secondary[3]),
		Material = def.Material,
	}
end

Theme.Stage = {} :: { StageTheme }
for index, def in ipairs(STAGE_DEFS) do
	Theme.Stage[index] = {
		Color = Color3.fromRGB(def.Rgb[1], def.Rgb[2], def.Rgb[3]),
		Size = def.Size,
		Material = def.Material,
	}
end

--[[ The one place that decides how the Conflux looks. Returns a FRESH table each call so callers
     (PlotBuilder / EvolutionService) can hand it around without risk of mutating the palette.
     Out-of-range or nan stages clamp to a valid stage; an unknown affinity id is treated as "none"
     rather than erroring, because it can arrive from an old save. ]]
function Theme.getConfluxAppearance(stage: number, affinity: string?): ConfluxAppearance
	local index = 1
	if type(stage) == "number" and stage == stage then
		index = math.clamp(math.floor(stage), 1, #STAGE_DEFS)
	end

	local stageDef = STAGE_DEFS[index]
	local stageTheme = Theme.Stage[index]

	local affinityDef = if type(affinity) == "string" then AFFINITY_DEFS[affinity] else nil
	if affinityDef == nil then
		return {
			Color = stageTheme.Color,
			Size = stageTheme.Size,
			Material = stageTheme.Material,
		}
	end

	local base, tint = stageDef.Rgb, affinityDef.Primary
	return {
		Color = Color3.fromRGB(
			lerpChannel(base[1], tint[1], AFFINITY_TINT),
			lerpChannel(base[2], tint[2], AFFINITY_TINT),
			lerpChannel(base[3], tint[3], AFFINITY_TINT)
		),
		Size = stageTheme.Size,
		-- The affinity owns the material once chosen: it is the clearest non-colour signal of which
		-- element a sanctum committed to.
		Material = affinityDef.Material,
	}
end

-- Freeze the palette tables (see GameConfig for the same reasoning): a stray write here would
-- desync every UI element built after it.
-- table.freeze ERRORS on an already-frozen table, and shared sub-tables (or a cycle) would hit the
-- same table twice, so isfrozen doubles as the visited-set here.
local function deepFreeze(t: { [any]: any }): { [any]: any }
	if table.isfrozen(t) then
		return t
	end
	table.freeze(t)
	for _, value in pairs(t) do
		if type(value) == "table" then
			deepFreeze(value :: { [any]: any })
		end
	end
	return t
end

deepFreeze(Theme.Ui)
deepFreeze(Theme.Affinity :: any)
deepFreeze(Theme.Stage :: any)
table.freeze(Theme)

return Theme

--#endregion
end
