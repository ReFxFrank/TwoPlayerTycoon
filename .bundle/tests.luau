local ENV = getfenv(1)

ENV.Vector2 = { new = newVector2, zero = newVector2(0, 0), one = newVector2(1, 1) }
ENV.Vector3 = {
    new = newVector3, zero = newVector3(0, 0, 0), one = newVector3(1, 1, 1),
    xAxis = newVector3(1, 0, 0), yAxis = newVector3(0, 1, 0), zAxis = newVector3(0, 0, 1),
