        <Properties>
          <string name="Name">AffinityData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    AffinityData
    The four elemental Affinities a Sanctum's Conflux can bind to at EvolutionData.AffinityUnlockStage.
    The choice is permanent for the run (it is cleared only by Transcendence) so each entry is a
    genuine trade-off rather than a strict upgrade. PURE data -- Color3 only, no services.
    Owner: shared  |  Consumers: Economy, EvolutionService, Theme, AffinityController, HudController
]]

--[[ BALANCE MODEL

    Three of the five fields feed income multiplicatively through Economy:
        effective income ~ IncomeMultiplier * SpawnRateMultiplier * MoteValueMultiplier
    The other two are texture: RailSpeedMultiplier changes how long a Mote spends in transit (it
    smooths income and keeps the live-Mote cap from clipping during a Stage spike) and WalkSpeedBonus
    is pure comfort for a 200x200 stud Sanctum.

    Income products, kept inside a 1% band so no pick is objectively correct:
        ember   1.22 * 1.00 * 1.00 = 1.2200
        tide    1.00 * 1.28 * 0.95 = 1.2160
        terra   1.00 * 0.88 * 1.38 = 1.2144
        zephyr  1.06 * 1.12 * 1.02 = 1.2109

    The tie is broken by feel, not by numbers:
      ember  - flat and boring on purpose; the safe pick and the one that scales best with prestige.
      tide   - many small Motes: lively rails, but it hits the Mote cap first, so it wants mote_lattice.
      terra  - few enormous Motes: slow, chunky, forgiving of a low cap, punished by a slow rail.
      zephyr - the mobility pick; the weakest raw income is repaid by the fastest rails (least income
               in flight at any moment) and by far the best traversal speed for a two-player Sanctum.
]]

export type Affinity = {
	Id: string,
	Name: string,
	Description: string,
	IncomeMultiplier: number,
	SpawnRateMultiplier: number, -- >1 shortens the Wellspring interval
	MoteValueMultiplier: number,
	RailSpeedMultiplier: number, -- >1 shortens Ley Rail travel time
	WalkSpeedBonus: number, -- added studs/s on top of the Stage WalkSpeed
	Color: Color3,
	Order: number,
}

local AffinityData = {}

AffinityData.List = {
	{
		Id = "ember", Name = "Ember",
		Description = "Steady heat. A flat lift to every Essence the Sanctum earns, at the cost of slightly sluggish rails.",
		IncomeMultiplier = 1.22, SpawnRateMultiplier = 1.00, MoteValueMultiplier = 1.00,
		RailSpeedMultiplier = 0.95, WalkSpeedBonus = 0,
		Color = Color3.fromRGB(255, 118, 46), Order = 1,
	},
	{
		Id = "tide", Name = "Tide",
		Description = "Relentless rhythm. Wellsprings condense far more often, though each Mote carries a little less.",
		IncomeMultiplier = 1.00, SpawnRateMultiplier = 1.28, MoteValueMultiplier = 0.95,
		RailSpeedMultiplier = 1.00, WalkSpeedBonus = 1,
		Color = Color3.fromRGB(58, 158, 255), Order = 2,
	},
	{
		Id = "terra", Name = "Terra",
		Description = "Patient weight. Rare, enormous Motes that shrug off a crowded rail -- but the Sanctum breathes slowly.",
		IncomeMultiplier = 1.00, SpawnRateMultiplier = 0.88, MoteValueMultiplier = 1.38,
		RailSpeedMultiplier = 0.92, WalkSpeedBonus = 2,
		Color = Color3.fromRGB(140, 205, 92), Order = 3,
	},
	{
		Id = "zephyr", Name = "Zephyr",
		Description = "Nothing stands still. The quickest rails and the quickest feet, with only a modest edge on raw yield.",
		IncomeMultiplier = 1.06, SpawnRateMultiplier = 1.12, MoteValueMultiplier = 1.02,
		RailSpeedMultiplier = 1.35, WalkSpeedBonus = 6,
		Color = Color3.fromRGB(196, 236, 255), Order = 4,
	},
} :: { Affinity }

table.sort(AffinityData.List, function(a: Affinity, b: Affinity): boolean
	return a.Order < b.Order
end)

AffinityData.ById = {} :: { [string]: Affinity }
for _, def in ipairs(AffinityData.List) do
	AffinityData.ById[def.Id] = def
end

function AffinityData.get(id: string): Affinity?
	return AffinityData.ById[id]
end

-- Guard for the ChooseAffinity remote: the client sends a raw string, so the type check lives here
-- rather than in the caller. Anything that is not one of the four literal ids is rejected.
function AffinityData.isValid(id: any): boolean
	return type(id) == "string" and AffinityData.ById[id] ~= nil
end

return AffinityData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ClientStore</string>
          <string name="Source"><![CDATA[--!strict
--[[
    ClientStore
    The client's single copy of the server's StateSync snapshot (spec section 7), wrapped in an
    observable. Controllers never read a remote directly: they Observe("Plot.Stage") and get called
    once with the current value and again only when that value genuinely changes, which keeps the
    UI from rebuilding itself twice a second on essence-only ticks.
    Owner: shared (client-consumed)  |  Consumers: ClientBootstrap and every client Controller
]]

local Signal = require(script.Parent.Signal)
local TableUtil = require(script.Parent.TableUtil)

export type Snapshot = { [string]: any }

local ClientStore = {}
ClientStore.__index = ClientStore

export type Store = typeof(setmetatable(
	{} :: {
		Changed: Signal.Signal, -- (newSnapshot, oldSnapshot)
		_state: Snapshot,
	},
	ClientStore
))

-- WHY a hand-built default instead of `{}`: every controller runs its first layout pass BEFORE the
-- first StateSync arrives. Handing them a snapshot of the correct SHAPE (section 7, with Full=false
-- and Essence=0) means no controller needs a nil check, and the HUD renders a clean zeroed state
-- instead of flickering placeholder text. Nothing here is a claim about the real save -- it is
-- deliberately the emptiest legal snapshot.
local function defaultSnapshot(): Snapshot
	return {
		Full = false, -- nothing authoritative has arrived yet
		Tick = 0,
		Essence = 0,
		Plot = {
			Id = 0,
			Stage = 1,
			Affinity = nil,
			-- Empty, NOT pre-seeded with the base Wing: before the first snapshot the client knows
			-- nothing, and pretending a Wing is unlocked would light up pads the server may reject.
			Droppers = {},
			Upgrades = {},
			Sections = {},
			LifetimeEssence = 0,
			IncomePerSecond = 0,
			Multiplier = 1,
			MoteCount = 0,
			MoteCapacity = 0,
		},
		Occupants = {},
		You = {
			Rebirths = 0,
			Multiplier = 1,
			Badges = {},
			Settings = { Music = true, Sfx = true },
			TotalEssenceEarned = 0,
			Slot = 0,
		},
		Gates = {
			-- Reason codes are the closed set Economy returns. "need_essence"/"need_stage" are the
			-- honest pre-connection answer: we have no essence and no stage yet.
			Attune = { Ok = false, Reason = "need_essence", Cost = 0, NextStage = nil },
			Transcend = { Ok = false, Reason = "need_stage" },
			Affinity = { Available = false, Chosen = nil },
		},
	}
end

function ClientStore.new(): Store
	return setmetatable({
		Changed = Signal.new(),
		_state = defaultSnapshot(),
	}, ClientStore)
end

-- Split "Plot.Stage" into { "Plot", "Stage" }. An empty path means "the whole snapshot"; a
-- non-string path yields no segments rather than erroring, so GetPath stays total.
local function splitPath(path: any): { string }
	local parts: { string } = {}
	if type(path) ~= "string" then
		return parts
	end
	for segment in string.gmatch(path, "[^%.]+") do
		table.insert(parts, segment)
	end
	return parts
end

local function resolve(root: any, parts: { string }): any
	local node: any = root
	for _, segment in ipairs(parts) do
		if type(node) ~= "table" then
			-- A missing branch is normal (Gates only exists on Full snapshots), never an error.
			return nil
		end
		local child = node[segment]
		if child == nil then
			-- Occupants is an array, so "Occupants.1.Name" arrives with a string "1". Fall back to
			-- the numeric key so array paths are observable like any other.
			local index = tonumber(segment)
			child = if index ~= nil then node[index] else nil
		end
		node = child
	end
	return node
end

-- Scalars compare with ==; tables need a structural compare because the server rebuilds the
-- Droppers/Upgrades/Sections tables on every Full snapshot, so identity always differs.
local function sameValue(a: any, b: any): boolean
	if type(a) == "table" and type(b) == "table" then
		return TableUtil.deepEquals(a, b)
	end
	return a == b
end

-- Cached observer values must be immune to later mutation of the snapshot they came from, so table
-- values are stored as a deep copy. Scalars are already immutable and copy for free.
local function cacheValue(value: any): any
	if type(value) == "table" then
		return TableUtil.deepCopy(value)
	end
	return value
end

--[[
    Replace the current snapshot and notify observers.

    SPEC NOTE: section 7 splits StateSync into a Full snapshot and an essence-only fast tick
    (Full=false). Literally replacing the state with a fast tick would wipe Plot/Occupants/Gates
    twice a second and thrash every observer, so: a Full payload REPLACES the snapshot (the server
    is the sole authority on what exists), while a delta is layered over the retained snapshot by
    top-level key. Either way the old table is never mutated, so `oldSnapshot` stays valid for
    Changed listeners and for cached observer values.
]]
function ClientStore.Set(self: Store, snapshot: Snapshot): ()
	if type(snapshot) ~= "table" then
		-- Loud but not fatal. This only happens if the server sends a malformed StateSync, and a
		-- frozen HUD would be a worse outcome than a stale one plus a log line.
		warn("[ClientStore] ignoring a non-table snapshot of type " .. typeof(snapshot))
		return
	end

	local old = self._state
	local new: Snapshot
	if snapshot.Full == true then
		-- Copy so a caller that recycles its payload table cannot mutate our state behind our back.
		new = TableUtil.deepCopy(snapshot)
	else
		new = TableUtil.shallowCopy(old)
		for key, value in pairs(snapshot) do
			new[key] = value
		end
		new.Full = false
	end

	self._state = new
	self.Changed:Fire(new, old)
end

-- Never nil. Callers must treat the result as read-only: it is the live table, not a copy, because
-- copying it on every HUD frame would be pure garbage churn.
function ClientStore.Get(self: Store): Snapshot
	return self._state
end

function ClientStore.GetPath(self: Store, path: string): any
	return resolve(self._state, splitPath(path))
end

--[[
    Observe one dotted path. `fn` is called immediately with the current value, then again only when
    the value at that path actually changes.

    The immediate call is SYNCHRONOUS on purpose: a controller must be able to build its widgets
    from the current value before Observe returns. Subsequent calls ride Signal:Fire, which
    task.spawns each handler, so a slow or erroring observer cannot stall replication.
]]
function ClientStore.Observe(self: Store, path: string, fn: (value: any) -> ()): Signal.Connection
	assert(type(fn) == "function", "ClientStore:Observe expects a function")

	local parts = splitPath(path)
	local last = resolve(self._state, parts)
	local cached = cacheValue(last)

	local connection = self.Changed:Connect(function(newSnapshot: Snapshot)
		local value = resolve(newSnapshot, parts)
		if sameValue(value, cached) then
			return
		end
		cached = cacheValue(value)
		fn(value)
	end)

	-- Mirror Signal's error isolation for the immediate call: one bad controller must not prevent
	-- the rest of the UI from being wired up.
	local ok, err = pcall(fn, last)
	if not ok then
		warn("[ClientStore] observer for '" .. path .. "' errored on its first call: " .. tostring(err))
	end

	return connection
end

function ClientStore.Destroy(self: Store): ()
	self.Changed:Destroy()
end

return ClientStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">DropperData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    DropperData
    Static catalogue of every Wellspring (dropper) in Sanctum of Embers. Each entry describes its
    geometric cost curve, the Essence value of a single Mote, the emit interval, and the Stage/Wing
    gates that decide when a Sanctum may buy it. The module is PURE data -- it never calls
    game:GetService and never touches an Instance -- so the server (PurchaseService, DropperSystem)
    and the client (pads, HUD) can require the exact same numbers and never disagree.
    Owner: shared  |  Consumers: Economy, PurchaseService, DropperSystem, PlotBuilder, HudController
]]

--[[ BALANCE MODEL -- all figures verified with a greedy purchase simulation.

    ASSUMPTION (contract with PlotService): a freshly created Sanctum is granted ONE free
    `ember_vent`. StateSchema.newPlotState() returns Droppers = {} , so PlotService is the component
    that seeds `Droppers.ember_vent = 1` when it builds a brand new (non-loaded) Sanctum. Without
    that seed a cold start has zero income and the first purchase would never be affordable.

    Cold start arithmetic:
      1 free ember_vent -> 1 Essence / 2.0s = 0.50 Essence/s.
      Second ember_vent costs floor(15 * 1.18^1) = 17.  17 / 0.50 = 34 s.
      -> first *purchased* Wellspring lands at ~34 s, inside the 25-40 s target window.

    Per-second yield (BaseValue / Interval) of the BEST Wellspring of each Stage. The brief asks for
    a 6-10x jump per Stage so every Attunement feels like a real power spike:
      S1 dew_font      4 / 2.2 =     1.82/s
      S2 gale_flue    26 / 2.0 =    13.0 /s   (x7.2)
      S3 tidal_weir  190 / 2.0 =    95.0 /s   (x7.3)
      S4 storm_coil 1400 / 2.0 =   700.0 /s   (x7.4)
      S5 magma_heart      12000 / 2.4 =  5000/s   (x7.1)
      S6 aether_spire     90000 / 2.5 = 36000/s   (x7.2)

    BaseCost is set so a first copy pays for itself in ~30 s (S1) rising to ~220 s (S6); the longer
    late-game payback is what stops the curve from running away once Stage multipliers stack.
    CostGrowth shrinks from 1.18 to 1.12 with tier because absolute prices are already enormous --
    all values sit inside the mandated 1.12..1.35 band.

    Simulated first run (prestige x1, no Affinity): Stage 2 @ 4.3 min, Stage 3 @ 18.2 min,
    Stage 4 @ 26.4 min, Stage 5 @ 34.3 min, Stage 6 @ 51.9 min, Transcend-ready @ 54.7 min.
    Same run at 4 rebirths solo: 22.8 min. Two occupants at 4 rebirths each (sanctum multiplier
    1 + 0.25*4 + 0.25*4 = 3.0): 15.1 min, i.e. ~28% of a first run -- the "about a third" target.
]]

export type Dropper = {
	Id: string,
	Name: string,
	Description: string,
	BaseCost: number,
	CostGrowth: number, -- cost = floor(BaseCost * CostGrowth ^ owned)
	BaseValue: number, -- Essence per Mote before multipliers
	Interval: number, -- seconds between Motes before multipliers
	MaxOwned: number,
	RequiredStage: number,
	RequiredSection: string, -- Wing id whose pad hosts this Wellspring
	Order: number,
	Color: Color3,
	Material: Enum.Material,
}

local DropperData = {}

-- Written in ascending Order; `List` is re-sorted below so a future edit cannot silently break the
-- pad layout (PlotLayout.padCFrame keys off Order).
DropperData.List = {
	{
		Id = "ember_vent", Name = "Ember Vent",
		Description = "A hairline fissure in the sanctum floor. It breathes warm sparks -- barely Essence, but it is a beginning.",
		BaseCost = 15, CostGrowth = 1.18, BaseValue = 1, Interval = 2.0, MaxOwned = 25,
		RequiredStage = 1, RequiredSection = "wing_core", Order = 1,
		Color = Color3.fromRGB(255, 120, 48), Material = Enum.Material.Neon,
	},
	{
		Id = "dew_font", Name = "Dew Font",
		Description = "Condenses ambient damp into heavy droplets of raw Essence. Slower than the Vent, four times richer.",
		BaseCost = 150, CostGrowth = 1.17, BaseValue = 4, Interval = 2.2, MaxOwned = 20,
		RequiredStage = 1, RequiredSection = "wing_core", Order = 2,
		Color = Color3.fromRGB(96, 200, 255), Material = Enum.Material.Neon,
	},
	{
		Id = "loam_seep", Name = "Loam Seep",
		Description = "Living soil pressed against the Core, weeping mineral Essence. Cheap enough to stack early in Stage 2.",
		BaseCost = 350, CostGrowth = 1.17, BaseValue = 9, Interval = 2.4, MaxOwned = 20,
		RequiredStage = 2, RequiredSection = "wing_core", Order = 3,
		Color = Color3.fromRGB(150, 200, 96), Material = Enum.Material.Neon,
	},
	{
		Id = "gale_flue", Name = "Gale Flue",
		Description = "A pressure chimney in the Ember Forge that spits Essence on every updraft. The first real power spike.",
		BaseCost = 1300, CostGrowth = 1.16, BaseValue = 26, Interval = 2.0, MaxOwned = 16,
		RequiredStage = 2, RequiredSection = "wing_ember_forge", Order = 4,
		Color = Color3.fromRGB(190, 235, 255), Material = Enum.Material.ForceField,
	},
	{
		Id = "cinder_forge", Name = "Cinder Forge",
		Description = "Hammers spent cinders back into dense Motes. Loud, hot, and the backbone of a Stage 3 sanctum.",
		BaseCost = 3800, CostGrowth = 1.16, BaseValue = 60, Interval = 2.2, MaxOwned = 16,
		RequiredStage = 3, RequiredSection = "wing_ember_forge", Order = 5,
		Color = Color3.fromRGB(255, 86, 40), Material = Enum.Material.Neon,
	},
	{
		Id = "tidal_weir", Name = "Tidal Weir",
		Description = "Dams the Basin's standing wave and taps the pressure differential. Stage 3's headline Wellspring.",
		BaseCost = 14000, CostGrowth = 1.15, BaseValue = 190, Interval = 2.0, MaxOwned = 14,
		RequiredStage = 3, RequiredSection = "wing_tide_basin", Order = 6,
		Color = Color3.fromRGB(40, 150, 255), Material = Enum.Material.Neon,
	},
	{
		Id = "quartz_bloom", Name = "Quartz Bloom",
		Description = "A crystal lattice that flowers, sheds an Essence-dense petal, and regrows. Slow bloom, huge petal.",
		BaseCost = 32000, CostGrowth = 1.15, BaseValue = 420, Interval = 2.2, MaxOwned = 12,
		RequiredStage = 4, RequiredSection = "wing_tide_basin", Order = 7,
		Color = Color3.fromRGB(210, 170, 255), Material = Enum.Material.Glass,
	},
	{
		Id = "storm_coil", Name = "Storm Coil",
		Description = "Bleeds a captive thunderhead one arc at a time. Expensive, but it carries the whole Terra Vault.",
		BaseCost = 120000, CostGrowth = 1.14, BaseValue = 1400, Interval = 2.0, MaxOwned = 12,
		RequiredStage = 4, RequiredSection = "wing_terra_vault", Order = 8,
		Color = Color3.fromRGB(150, 190, 255), Material = Enum.Material.ForceField,
	},
	{
		Id = "magma_heart", Name = "Magma Heart",
		Description = "A caged fragment of the world's core. Every slow pulse is worth more than an entire Stage 3 wing.",
		BaseCost = 1000000, CostGrowth = 1.13, BaseValue = 12000, Interval = 2.4, MaxOwned = 10,
		RequiredStage = 5, RequiredSection = "wing_terra_vault", Order = 9,
		Color = Color3.fromRGB(255, 60, 20), Material = Enum.Material.Neon,
	},
	{
		Id = "aether_spire", Name = "Aether Spire",
		Description = "Pierces the veil above the Zephyr Spire and draws Essence straight from the Primordial. The endgame.",
		BaseCost = 8000000, CostGrowth = 1.12, BaseValue = 90000, Interval = 2.5, MaxOwned = 8,
		RequiredStage = 6, RequiredSection = "wing_zephyr_spire", Order = 10,
		Color = Color3.fromRGB(255, 240, 180), Material = Enum.Material.Neon,
	},
} :: { Dropper }

table.sort(DropperData.List, function(a: Dropper, b: Dropper): boolean
	return a.Order < b.Order
end)

DropperData.ById = {} :: { [string]: Dropper }
for _, def in ipairs(DropperData.List) do
	DropperData.ById[def.Id] = def
end

function DropperData.get(id: string): Dropper?
	return DropperData.ById[id]
end

-- Everything a Sanctum at `stage` is allowed to see. Section ownership is a SEPARATE gate checked by
-- Economy.dropperStatus, because a Wing can be unlocked long after its Stage requirement is met.
function DropperData.forStage(stage: number): { Dropper }
	local out: { Dropper } = {}
	for _, def in ipairs(DropperData.List) do
		if def.RequiredStage <= stage then
			table.insert(out, def)
		end
	end
	return out
end

return DropperData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Economy
    Every number the game charges, pays out or gates on, in one pure module: it reads the static
    catalogues (Dropper/Upgrade/Section/Evolution/Affinity/Rebirth) plus a PlotState and returns costs,
    multipliers, income rates and closed-set gate reasons. It holds no state, mutates nothing, touches
    no Instance and calls no service, so server truth, client prediction and the test harness all
    compute byte-identical numbers.
    Owner: shared  |  Consumers: EconomyService, PurchaseService, EvolutionService, RebirthService,
                                 StateSchema, DropperSystem, MoteSystem, HudController, PromptController
]]
--[[ DEFENSIVE DOCTRINE -- why the reads below look paranoid. Every argument is untrusted (corrupt
     DataStore, def renamed by a live patch, Multipliers from an older version), so every read goes
     through num()/map(), collapsing nil/NaN/inf/string/userdata to a safe default (NaN is the killer:
     `NaN >= x` is false, so unguarded clamps silently fail); every divisor is clamped off zero, since
     an inf/NaN income is written straight back to the save and destroys it permanently; a corrupt def
     is made UNAFFORDABLE, never free; and only catalogue ids are iterated, so an injected save key
     ("i_win" = 1e300) contributes nothing to income, cost or owned counts. ]]

local GameConfig = require(script.Parent.GameConfig)
local DropperData = require(script.Parent.DropperData)
local UpgradeData = require(script.Parent.UpgradeData)
local SectionData = require(script.Parent.SectionData)
local EvolutionData = require(script.Parent.EvolutionData)
local AffinityData = require(script.Parent.AffinityData)
local RebirthData = require(script.Parent.RebirthData)

-- Structurally identical to StateSchema.PlotState, duplicated rather than required because
-- StateSchema requires Economy (for the cached prestige multiplier) and a cycle would break both.
export type PlotState = {
	Essence: number, Stage: number, Affinity: string?,
	Droppers: { [string]: number }, Upgrades: { [string]: number }, Sections: { [string]: boolean },
	LifetimeEssence: number,
}
export type Multipliers = { Prestige: number, Stage: number, Affinity: number, Upgrades: number, Debug: number }

local Economy = {}
-- CLOSED SET of gate reasons. The client maps these codes to human text, so a reason is a protocol
-- value and must never carry free-form detail. locked_* are permanent, need_* are progress gates.
local Reason = {
	Ok = "ok",
	LockedStage = "locked_stage", LockedSection = "locked_section", -- stage gate / wing gate
	MaxOwned = "max_owned", MaxLevel = "max_level", AlreadyOwned = "already_owned",
	Insufficient = "insufficient", -- cannot afford
	MaxStage = "max_stage", -- already Primordial, nothing left to attune into
	NeedEssence = "need_essence", NeedLifetime = "need_lifetime", NeedDroppers = "need_droppers",
	NeedStage = "need_stage", UnknownId = "unknown_id", -- transcend gate / def nil or corrupt
}
Economy.Reason = Reason
-- 2^53 is the last exactly-representable integer double: staying under it keeps essence arithmetic
-- exact and stops a runaway multiplier serialising as inf.
local MAX_MULTIPLIER, MAX_VALUE = 1e12, 1e15
-- Above MAX_VALUE and above any balance StateSchema will store, so `canAfford` is always
-- false against it, while staying finite and printable.
local UNAFFORDABLE = 1e18
local MIN_INTERVAL = 0.15 -- spec floor; below this the mote pipeline just thrashes
local EMPTY: { [string]: any } = {}
local function isFinite(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end
local function num(v: any, default: number): number
	return if isFinite(v) then v :: number else default
end
-- Never nil, so callers index unconditionally. EMPTY is shared and never written to.
local function map(v: any): { [string]: any }
	return if type(v) == "table" then v :: { [string]: any } else EMPTY
end
-- Finite, never negative (a negative multiplier turns income into a debit), never big enough that
-- five multiplied together overflow.
local function mul(v: any): number
	return math.clamp(num(v, 1), 0, MAX_MULTIPLIER)
end
local function stageIndexOf(plot: any): number
	return math.clamp(math.floor(num(map(plot).Stage, 1)), 1, EvolutionData.MaxStage)
end
local function affinityOf(plot: any): AffinityData.Affinity?
	local id = map(plot).Affinity
	return if type(id) == "string" then AffinityData.get(id) else nil
end
local function ownedOf(plot: any, id: any): number
	return math.max(0, math.floor(num(map(map(plot).Droppers)[id], 0)))
end
local function sectionUnlocked(plot: any, id: any): boolean
	if type(id) ~= "string" then return false end -- corrupt RequiredSection stays LOCKED
	if id == SectionData.Base then return true end -- core wing is unlocked by definition
	return map(map(plot).Sections)[id] and true or false
end
-- The one choke point every cost passes through: FastMode (dev switch) divides costs so a tester can
-- walk the whole curve in minutes.
local function finalCost(cost: number): number
	local value = cost
	if GameConfig.Debug.FastMode then
		value /= math.max(1, num(GameConfig.Debug.FastCostDivisor, 1))
	end
	-- An overflowing curve (a corrupt save claiming 1e300 owned) collapses to a FINITE ceiling above
	-- any reachable balance, not math.huge: inf survives into the snapshot and used to render as
	-- "0", labelling an impossible cost as free on the pad.
	return if isFinite(value) then math.max(0, math.floor(value)) else UNAFFORDABLE
end
-- cost = floor(BaseCost * CostGrowth^n). Growth clamps to >= 1: below 1 each copy is cheaper than
-- the last, an infinite-money curve.
local function curveCost(d: { [string]: any }, n: number): number
	local growth = math.clamp(num(d.CostGrowth, 1), 1, 10)
	local steps = math.clamp(math.floor(num(n, 0)), 0, 10000)
	return finalCost(math.max(0, num(d.BaseCost, math.huge)) * growth ^ steps)
end
function Economy.getPrestigeMultiplier(rebirths: number): number
	-- clamped to MaxTrackedRebirths so a tampered profile claiming 1e300 rebirths gets the cap
	return 1 + RebirthData.MultiplierPerRebirth
		* math.clamp(math.floor(num(rebirths, 0)), 0, RebirthData.MaxTrackedRebirths)
end
-- SUM, not product (§1.5): 1 + 0.25*Ra + 0.25*Rb lifts a partner's sanctum without squaring it.
function Economy.getSanctumPrestigeMultiplier(rebirthsList: { number }): number
	local total = 1
	if type(rebirthsList) == "table" then
		for _, r in ipairs(rebirthsList) do
			total += Economy.getPrestigeMultiplier(r) - 1
		end
	end
	return math.clamp(num(total, 1), 1, MAX_MULTIPLIER)
end
function Economy.upgradeLevel(plot: PlotState, upgradeId: string): number
	local def = if type(upgradeId) == "string" then UpgradeData.get(upgradeId) else nil
	if def == nil then return 0 end -- a tampered save cannot invent an upgrade to farm effects from
	return math.clamp(math.floor(num(map(map(plot).Upgrades)[upgradeId], 0)), 0,
		math.max(0, math.floor(num(def.MaxLevel, 0))))
end
-- Summed PerLevel * level per `kind`; iterating the CATALOGUE (never the save) makes injected ids inert.
function Economy.upgradeEffect(plot: PlotState, kind: string): number
	local total = 0
	for _, def in ipairs(UpgradeData.List) do
		if def.Kind == kind then
			total += num(def.PerLevel, 0) * Economy.upgradeLevel(plot, def.Id)
		end
	end
	return math.clamp(num(total, 0), 0, MAX_MULTIPLIER)
end
function Economy.getMultipliers(plot: PlotState, rebirthsList: { number }): Multipliers
	local stage, affinity = EvolutionData.get(stageIndexOf(plot)), affinityOf(plot)
	return {
		Prestige = mul(Economy.getSanctumPrestigeMultiplier(rebirthsList)),
		Stage = mul(if stage then stage.IncomeMultiplier else 1),
		Affinity = mul(if affinity then affinity.IncomeMultiplier else 1),
		Upgrades = mul(1 + Economy.upgradeEffect(plot, "GlobalIncome")),
		-- FastMode's income half; its cost half lives in finalCost
		Debug = mul(if GameConfig.Debug.FastMode then math.max(1, num(GameConfig.Debug.FastIncomeMultiplier, 1)) else 1),
	}
end

-- Missing fields read as 1 (neutral): a partial Multipliers table must degrade, not zero all income.
function Economy.totalMultiplier(m: Multipliers): number
	local t = map(m)
	local product = mul(t.Prestige) * mul(t.Stage) * mul(t.Affinity) * mul(t.Upgrades) * mul(t.Debug)
	return math.clamp(num(product, 1), 0, MAX_MULTIPLIER)
end
function Economy.getDropperCost(def: DropperData.Dropper, owned: number): number
	return curveCost(map(def), owned)
end
-- UpgradeData.levelCost re-derived, so nil defs and FastMode are handled in one place; the maxed
-- level returns math.huge, which canAfford rejects, so no caller needs a special case.
function Economy.getUpgradeCost(def: UpgradeData.Upgrade, level: number): number
	local d = map(def)
	local maxLevel = math.max(0, math.floor(num(d.MaxLevel, 0)))
	local current = math.clamp(math.floor(num(level, 0)), 0, maxLevel)
	return if current >= maxLevel then math.huge else curveCost(d, current)
end
function Economy.getSectionCost(def: SectionData.Section): number
	return finalCost(math.max(0, num(map(def).Cost, math.huge)))
end
-- Essence per collected Mote. FontYield applies here, not in the global stack: it is a property of
-- the Font swallowing a mote, and an overflow credit must match a rail credit exactly.
function Economy.getMoteValue(def: DropperData.Dropper, plot: PlotState, m: Multipliers): number
	local affinity = affinityOf(plot)
	local value = math.max(0, num(map(def).BaseValue, 0)) * Economy.totalMultiplier(m)
		* (if affinity then mul(affinity.MoteValueMultiplier) else 1)
		* math.max(0, 1 + Economy.upgradeEffect(plot, "FontYield"))
	return math.clamp(num(value, 0), 0, MAX_VALUE)
end
-- `m` is taken for signature stability but unused: prestige/stage/FastMode already scale mote VALUE,
-- and scaling the interval too would compound the same bonus twice.
function Economy.getDropperInterval(def: DropperData.Dropper, plot: PlotState, m: Multipliers): number
	local base = math.clamp(num(map(def).Interval, 1), MIN_INTERVAL, 3600)
	local affinity = affinityOf(plot)
	-- clamped off zero: rate is a divisor, and 0/NaN here would spawn infinite motes in one frame
	local rate = math.clamp(num((1 + Economy.upgradeEffect(plot, "SpawnRate"))
		* (if affinity then mul(affinity.SpawnRateMultiplier) else 1), 1), 0.01, 100)
	return math.max(MIN_INTERVAL, base / rate)
end
function Economy.getRailTravelTime(plot: PlotState, m: Multipliers): number
	local base = math.max(0.05, num(GameConfig.Mote.BaseTravelSeconds, 6))
	local floor = math.clamp(num(GameConfig.Mote.MinTravelSeconds, 1.25), 0.05, base)
	local affinity = affinityOf(plot)
	local speed = math.clamp(num((1 + Economy.upgradeEffect(plot, "RailSpeed"))
		* (if affinity then mul(affinity.RailSpeedMultiplier) else 1), 1), 0.01, 100) -- divisor guard
	-- also clamped <= base: rails only get FASTER, so corruption cannot park motes in flight forever
	return math.clamp(base / speed, floor, base)
end
function Economy.getMoteCapacity(plot: PlotState): number
	-- ceiling of 1000 parts per sanctum: the cap is a render/memory budget as well as a game rule
	return math.clamp(math.floor(num(GameConfig.Mote.MaxLivePerSanctum, 60)
		+ Economy.upgradeEffect(plot, "MoteCapacity")), 1, 1000)
end
function Economy.getWalkSpeed(plot: PlotState): number
	local stage, affinity = EvolutionData.get(stageIndexOf(plot)), affinityOf(plot)
	-- clamped so a corrupt stage table can neither freeze (0) nor fling (1e9) a character
	return math.clamp((if stage then num(stage.WalkSpeed, 16) else 16)
		+ (if affinity then num(affinity.WalkSpeedBonus, 0) else 0), 8, 100)
end
function Economy.estimateIncomePerSecond(plot: PlotState, m: Multipliers): number
	local total = 0
	for _, def in ipairs(DropperData.List) do
		local count = ownedOf(plot, def.Id)
		if count > 0 then
			total += count * Economy.getMoteValue(def, plot, m) / Economy.getDropperInterval(def, plot, m)
		end
	end
	return math.clamp(num(total, 0), 0, MAX_VALUE)
end
function Economy.canAfford(plot: PlotState, cost: number): boolean
	-- math.huge (max level / corrupt def) and NaN must never read as affordable
	if not isFinite(cost) then return false end
	return math.max(0, num(map(plot).Essence, 0)) >= math.max(0, cost)
end
function Economy.totalDroppersOwned(plot: PlotState): number
	local total = 0
	for _, def in ipairs(DropperData.List) do
		total += ownedOf(plot, def.Id)
	end
	return total
end

-- Gate checks return (ok, reasonCode), most-permanent-first so the UI says "locked" not "can't
-- afford" for something unbuyable. Shared prelude: identity, stage gate, wing gate -- a def missing
-- from its catalogue is unknown_id, so a forged pad id can never reach a debit.
local function lockReason(plot: PlotState, d: { [string]: any }, known: boolean): string?
	if type(d.Id) ~= "string" or not known then return Reason.UnknownId end
	if stageIndexOf(plot) < num(d.RequiredStage, math.huge) then return Reason.LockedStage end
	if not sectionUnlocked(plot, d.RequiredSection) then return Reason.LockedSection end
	return nil
end

function Economy.dropperStatus(plot: PlotState, def: DropperData.Dropper): (boolean, string)
	local d = map(def)
	local locked = lockReason(plot, d, type(d.Id) == "string" and DropperData.get(d.Id) ~= nil)
	if locked then return false, locked end
	local owned = ownedOf(plot, d.Id)
	if owned >= math.max(0, math.floor(num(d.MaxOwned, 0))) then return false, Reason.MaxOwned end
	if not Economy.canAfford(plot, Economy.getDropperCost(def, owned)) then return false, Reason.Insufficient end
	return true, Reason.Ok
end
function Economy.upgradeStatus(plot: PlotState, def: UpgradeData.Upgrade): (boolean, string)
	local d = map(def)
	local locked = lockReason(plot, d, type(d.Id) == "string" and UpgradeData.get(d.Id) ~= nil)
	if locked then return false, locked end
	local level = Economy.upgradeLevel(plot, d.Id :: string)
	if level >= math.max(0, math.floor(num(d.MaxLevel, 0))) then return false, Reason.MaxLevel end
	if not Economy.canAfford(plot, Economy.getUpgradeCost(def, level)) then return false, Reason.Insufficient end
	return true, Reason.Ok
end
function Economy.sectionStatus(plot: PlotState, def: SectionData.Section): (boolean, string)
	local d = map(def)
	if type(d.Id) ~= "string" or SectionData.get(d.Id) == nil then return false, Reason.UnknownId end
	-- ownership first: two players triggering one pad on a frame get already_owned, not a double buy
	if sectionUnlocked(plot, d.Id) then return false, Reason.AlreadyOwned end
	if stageIndexOf(plot) < num(d.RequiredStage, math.huge) then return false, Reason.LockedStage end
	if d.RequiredSection ~= nil and not sectionUnlocked(plot, d.RequiredSection) then
		return false, Reason.LockedSection
	end
	if not Economy.canAfford(plot, Economy.getSectionCost(def)) then return false, Reason.Insufficient end
	return true, Reason.Ok
end
-- Attunement gate. FastMode does NOT discount RequiredEssence: EvolutionService debits it straight
-- from the catalogue, so a discount would open the gate on essence the debit then fails to take.
-- Requirements default to huge on a corrupt stage table, so the gate shuts rather than falls open.
function Economy.attuneStatus(plot: PlotState): (boolean, string)
	local nextStage = EvolutionData.next(stageIndexOf(plot))
	if nextStage == nil then return false, Reason.MaxStage end
	local p = map(plot)
	if math.max(0, num(p.Essence, 0)) < num(nextStage.RequiredEssence, math.huge) then
		return false, Reason.NeedEssence
	end
	if math.max(0, num(p.LifetimeEssence, 0)) < num(nextStage.RequiredLifetimeEssence, math.huge) then
		return false, Reason.NeedLifetime
	end
	if Economy.totalDroppersOwned(plot) < num(nextStage.RequiredDroppers, math.huge) then
		return false, Reason.NeedDroppers
	end
	return true, Reason.Ok
end
-- Against LifetimeEssence (earned since the last Transcendence), never the wallet, so the pair is
-- not locked out for having spent it on the sanctum that earned it.
function Economy.transcendStatus(plot: PlotState): (boolean, string)
	if stageIndexOf(plot) < num(RebirthData.RequiredStage, math.huge) then return false, Reason.NeedStage end
	if math.max(0, num(map(plot).LifetimeEssence, 0)) < num(RebirthData.RequiredLifetimeEssence, math.huge) then
		return false, Reason.NeedLifetime
	end
	return true, Reason.Ok
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">EvolutionData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    EvolutionData
    The six Attunement Stages the shared Conflux grows through: their entry price, their gameplay
    gates, the income multiplier they confer, the appearance they give the Conflux, and the exact
    Wellsprings / Upgrades / Wings each Stage unlocks. PURE data (Color3 and Enum constructors only)
    so EvolutionService, Economy and the client HUD all read identical requirements.
    Owner: shared  |  Consumers: Economy, EvolutionService, StateSchema, Theme, HudController
]]

--[[ BALANCE MODEL -- how RequiredEssence was derived, and why it is reachable.

    Income is roughly `sum(count * BaseValue / Interval) * StageMultiplier * upgrades * prestige`.
    Wellspring tiers step ~7x per Stage (see DropperData) and the Stage multiplier adds ~1.4x on top,
    so raw income multiplies by roughly 10x per Stage. RequiredEssence therefore has to grow FASTER
    than 10x per Stage or every Attunement after the third would be instant. It grows 48x, 75x, 29x,
    23x across Stages 2->6, which lengthens the late game back out to a satisfying climb.

    Implied income curve at the moment each Stage is entered (greedy-purchase simulation, one player,
    prestige x1, no Affinity chosen):

        Stage 2   t =  4.3 min    ~7 Essence/s      RequiredEssence            250
        Stage 3   t = 18.2 min  ~617 Essence/s      RequiredEssence         12,000
        Stage 4   t = 26.4 min  ~14.7 K/s           RequiredEssence        900,000
        Stage 5   t = 34.3 min   ~136 K/s           RequiredEssence     26,000,000
        Stage 6   t = 51.9 min   ~1.28 M/s          RequiredEssence    600,000,000
        Transcend t = 54.7 min  ~12.5 M/s           RebirthData.RequiredLifetimeEssence

    Targets hit: Stage 2 in 3-5 min, Stage 6 in 45-75 min. At 4 rebirths the same run takes 22.8 min
    solo and 15.1 min for two 4-rebirth occupants (sanctum multiplier 3.0) -- about a third, as asked.

    RequiredLifetimeEssence is set to ~2.3x RequiredEssence at every Stage. It is deliberately a
    SOFT gate: it is satisfied naturally on the way to affording the Attunement, and only bites if a
    player tries to skip a tier by hoarding a windfall. RequiredDroppers does the same job in the
    other direction -- it forces the Sanctum to actually be built out, not just rich.
]]

export type Stage = {
	Index: number,
	Name: string,
	Title: string,
	Description: string,
	RequiredEssence: number, -- spent (debited) to attune INTO this Stage
	RequiredLifetimeEssence: number,
	RequiredDroppers: number, -- minimum total Wellsprings owned
	IncomeMultiplier: number,
	WalkSpeed: number,
	ConfluxSize: number,
	Color: Color3,
	Material: Enum.Material,
	UnlockedDroppers: { string },
	UnlockedUpgrades: { string },
	UnlockedSections: { string },
}

local EvolutionData = {}

-- Every id below is cross-checked against DropperData / UpgradeData / SectionData; the four modules
-- are authored together and must stay in lockstep.
EvolutionData.Stages = {
	{
		Index = 1, Name = "Mote", Title = "The First Spark",
		Description = "A single ember hangs in the empty Sanctum. It is barely aware, and it is entirely yours.",
		RequiredEssence = 0, RequiredLifetimeEssence = 0, RequiredDroppers = 0,
		IncomeMultiplier = 1.0, WalkSpeed = 16, ConfluxSize = 3,
		Color = Color3.fromRGB(255, 176, 96), Material = Enum.Material.Neon,
		UnlockedDroppers = { "ember_vent", "dew_font" },
		UnlockedUpgrades = { "ley_flow" },
		UnlockedSections = { "wing_core" },
	},
	{
		Index = 2, Name = "Wisp", Title = "Kindled Wisp",
		Description = "The spark has learned to drift. It follows whoever fed it last, and it wants the Forge lit.",
		RequiredEssence = 250, RequiredLifetimeEssence = 600, RequiredDroppers = 4,
		IncomeMultiplier = 1.4, WalkSpeed = 17, ConfluxSize = 5,
		Color = Color3.fromRGB(160, 220, 255), Material = Enum.Material.Neon,
		UnlockedDroppers = { "loam_seep", "gale_flue" },
		UnlockedUpgrades = { "font_resonance", "wellspring_cadence" },
		UnlockedSections = { "wing_ember_forge" },
	},
	{
		Index = 3, Name = "Sprite", Title = "Awakened Sprite",
		Description = "Aware enough to choose. At this Stage the Conflux accepts an Affinity and takes on its element for good.",
		RequiredEssence = 12000, RequiredLifetimeEssence = 28000, RequiredDroppers = 10,
		IncomeMultiplier = 2.0, WalkSpeed = 18, ConfluxSize = 7,
		Color = Color3.fromRGB(150, 255, 190), Material = Enum.Material.Neon,
		UnlockedDroppers = { "cinder_forge", "tidal_weir" },
		UnlockedUpgrades = { "mote_lattice", "conflux_attunement" },
		UnlockedSections = { "wing_tide_basin" },
	},
	{
		Index = 4, Name = "Elemental", Title = "Bound Elemental",
		Description = "The Conflux now holds a shape of its own and bends the Sanctum's rails to serve it.",
		RequiredEssence = 900000, RequiredLifetimeEssence = 2000000, RequiredDroppers = 18,
		IncomeMultiplier = 2.8, WalkSpeed = 20, ConfluxSize = 9.5,
		Color = Color3.fromRGB(200, 150, 255), Material = Enum.Material.Neon,
		UnlockedDroppers = { "quartz_bloom", "storm_coil" },
		UnlockedUpgrades = {},
		UnlockedSections = { "wing_terra_vault" },
	},
	{
		Index = 5, Name = "Warden", Title = "Sanctum Warden",
		Description = "It guards the pair who raised it. The Vault can hold a caged core now, and the Spire can be raised.",
		RequiredEssence = 26000000, RequiredLifetimeEssence = 60000000, RequiredDroppers = 26,
		IncomeMultiplier = 3.9, WalkSpeed = 22, ConfluxSize = 12,
		Color = Color3.fromRGB(255, 210, 110), Material = Enum.Material.Neon,
		UnlockedDroppers = { "magma_heart" },
		UnlockedUpgrades = { "primordial_echo" },
		UnlockedSections = { "wing_zephyr_spire" },
	},
	{
		Index = 6, Name = "Primordial", Title = "Primordial Ascendant",
		Description = "The final Stage. Bank enough Essence here and the pair may Transcend together, keeping the power and losing the Sanctum.",
		RequiredEssence = 600000000, RequiredLifetimeEssence = 1400000000, RequiredDroppers = 34,
		IncomeMultiplier = 5.5, WalkSpeed = 24, ConfluxSize = 15,
		Color = Color3.fromRGB(255, 255, 235), Material = Enum.Material.Neon,
		UnlockedDroppers = { "aether_spire" },
		UnlockedUpgrades = {},
		UnlockedSections = {},
	},
} :: { Stage }

EvolutionData.MaxStage = #EvolutionData.Stages

-- The Stage at which the Affinity modal opens. Placed at 3 (mid-run) so the choice is made with
-- enough information to feel considered, but early enough that its multipliers still matter.
EvolutionData.AffinityUnlockStage = 3

function EvolutionData.get(index: number): Stage?
	return EvolutionData.Stages[index]
end

function EvolutionData.next(index: number): Stage?
	return EvolutionData.Stages[index + 1]
end

return EvolutionData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Format
    Number/time presentation helpers shared by the HUD, prompts, toasts and server log lines so a
    value never renders two different ways in two places. Pure: no services, no Instances.
    Owner: shared  |  Consumers: HudController, PromptController, UiBuilder, NotifyController
]]

local GameConfig = require(script.Parent.GameConfig)

local Format = {}

-- Short-scale suffixes. Index i covers 1000^i, so Dc (decillion) covers [1e33, 1e36).
-- Anything past the table falls back to scientific notation rather than printing garbage.
local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- WHY: a NaN or inf reaching a TextLabel shows "nan"/"inf" to players and can poison later maths.
-- Every public function funnels through this and degrades to a safe zero instead.
-- Rendered instead of "0" when a number really is infinite; see Format.abbreviate.
local INFINITY = "\u{221E}"

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Drops the trailing ".00"/".50" zeros the spec asks for, but only when a decimal point exists
-- (naively stripping zeros would turn "1000" into "1").
local function trimZeros(s: string): string
	if string.find(s, "%.", 1) == nil then
		return s
	end
	s = (string.gsub(s, "0+$", ""))
	s = (string.gsub(s, "%.$", ""))
	return s
end

-- Compact scientific form ("1e36", "2.5e40"). Callers already filtered nan/inf, so %e is safe.
local function scientific(n: number): string
	local formatted = string.format("%.2e", n)
	local mantissa, exponent = string.match(formatted, "^(-?%d+%.?%d*)e([+-]%d+)$")
	if mantissa ~= nil and exponent ~= nil then
		-- Drop the exponent's "+" and leading zeros ("e+36" -> "e36") for a tidier label.
		return trimZeros(mantissa) .. "e" .. tostring(tonumber(exponent) or 0)
	end
	return formatted
end

--[[ 0..999 print exactly; above that use two decimals with the suffix table. ]]
function Format.abbreviate(n: number): string
	if not isFinite(n) then
		-- NaN and non-numbers read as 0, but an infinity must NOT: a cost label showing "0" for an
		-- unreachable price would read as free. Economy avoids producing infinities at all; this is
		-- the second line of defence.
		if n == math.huge then
			return INFINITY
		elseif n == -math.huge then
			return "-" .. INFINITY
		end
		return "0"
	end

	local sign = if n < 0 then "-" else ""
	local value = math.abs(n)

	if value < 1000 then
		if value % 1 == 0 then
			-- string.format avoids tostring()'s scientific notation and any float dust.
			return sign .. string.format("%.0f", value)
		end
		return sign .. trimZeros(string.format("%.2f", value))
	end

	-- Repeated division instead of math.log(value, 1000): logs are off by an ulp at exact powers
	-- (log(1e9, 1000) == 2.9999...), which would render 1e9 as "999.99M".
	local index = 0
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end

	-- Rounding to 2dp can push 999.999 up to "1000.00"; promote to the next suffix instead.
	if value >= 999.995 and index < #SUFFIXES then
		value /= 1000
		index += 1
	end

	if value >= 1000 then
		-- Past Dc: no suffix left, so fall back to scientific notation.
		return sign .. scientific(math.abs(n))
	end

	return sign .. trimZeros(string.format("%.2f", value)) .. SUFFIXES[index]
end

--[[ Thousands separators on the whole part, e.g. 1234567 -> "1,234,567". Fractions are truncated:
     comma() is for exact counts (contributions, leaderstats), abbreviate() is for big numbers. ]]
function Format.comma(n: number): string
	if not isFinite(n) then
		if n == math.huge then
			return INFINITY
		elseif n == -math.huge then
			return "-" .. INFINITY
		end
		return "0"
	end

	local sign = if n < 0 then "-" else ""
	local whole = math.floor(math.abs(n))
	local digits = string.format("%.0f", whole)

	while true do
		local replaced: number
		digits, replaced = string.gsub(digits, "^(%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return sign .. digits
end

--[[ "1h 04m" / "3m 20s" / "12s"; the second unit is zero padded so the label never jitters. ]]
function Format.time(seconds: number): string
	if not isFinite(seconds) or seconds < 0 then
		return "0s"
	end

	local total = math.floor(seconds)
	local days = math.floor(total / 86400)
	local hours = math.floor(total / 3600) % 24
	local minutes = math.floor(total / 60) % 60
	local secs = total % 60

	if days > 0 then
		return string.format("%dd %02dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %02ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

--[[ "x2.35"; trailing zeros are dropped so a clean x2 does not read as "x2.00". ]]
function Format.multiplier(x: number): string
	if not isFinite(x) then
		return "x1"
	end
	if math.abs(x) >= 1000 then
		-- Deep prestige runs can push multipliers into the thousands; reuse the suffix table there.
		return "x" .. Format.abbreviate(x)
	end
	return "x" .. trimZeros(string.format("%.2f", x))
end

function Format.essence(n: number): string
	return GameConfig.Currency.Symbol .. Format.abbreviate(n)
end

--[[ 0.25 -> "25%". Rounded to a whole percent, except tiny non-zero values which would otherwise
     collapse to a misleading "0%". ]]
function Format.percent(x: number): string
	if not isFinite(x) then
		return "0%"
	end
	local scaled = x * 100
	if scaled ~= 0 and math.abs(scaled) < 1 then
		return trimZeros(string.format("%.2f", scaled)) .. "%"
	end
	return string.format("%d%%", math.floor(scaled + 0.5))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
    GameConfig
    The single table of tunables for Sanctum of Embers: currency identity, sanctum/plot geometry,
    mote flight, income cadence, persistence, session locking, rebirth voting, networking and dev
    switches. Pure data -- it touches no services and no Instances, so client, server and the
    headless test harness can all require it safely.
    Owner: shared  |  Consumers: Economy, PlotLayout, every server service, every client controller
]]

-- WHY a single flat config: balance passes and live tuning should never require hunting through a
-- dozen modules. Anything a designer might want to change at 2am lives here with a comment.

local GameConfig = {
	Currency = {
		Name = "Essence", -- display name of the shared wallet
		Symbol = "\u{2726}", -- four-pointed star, prefixed to every essence readout
		StartingAmount = 0, -- essence granted to a brand new profile
	},

	Plot = {
		SlotsPerSanctum = 2, -- co-op pair; slot 1 is the claimer, slot 2 stays open to a late joiner
		SanctumCount = 6, -- how many sanctums the server builds (12 players max at 2 slots each)
		ReleaseGraceSeconds = 45, -- keep a vacated sanctum reserved this long before recycling it
		LinkConfirmSeconds = 30, -- how long a LinkOffer stays valid before it auto-declines
		Origin = Vector3.new(0, 0, 0), -- world position of sanctum #1
		Spacing = 240, -- studs between sanctum origins (must exceed SanctumSize on both axes)
		PerRow = 3, -- sanctums per grid row; keeps the map squarish instead of one long strip
	},

	Mote = {
		MaxLivePerSanctum = 60, -- hard cap on rendered motes; overflow is credited instantly instead
		LifetimeSeconds = 30, -- Debris backstop so a leaked mote part can never linger forever
		BaseTravelSeconds = 6, -- rail flight time before RailSpeed upgrades / affinity bonuses
		MinTravelSeconds = 1.25, -- floor, so motes stay visible and the collector cannot be spammed
		Size = Vector3.new(1.4, 1.4, 1.4), -- mote part size
		SpawnHeight = 3, -- studs above the wellspring pad where a mote appears
	},

	Income = {
		TickRate = 10, -- MoteSystem/DropperSystem steps per second (Heartbeat is decimated to this)
		MinCredit = 0.0001, -- ignore absurdly small credits; guards against float dust loops
	},

	Save = {
		AutosaveSeconds = 120, -- base autosave period per profile
		AutosaveJitter = 20, -- +/- seconds of jitter so 12 players never save on the same frame
		ShutdownBudgetSeconds = 25, -- BindToClose budget; Roblox hard-kills the server at ~30s
		DataStoreName = "SanctumOfEmbers_Profiles_v1", -- bump the suffix to wipe live data
		KeyPrefix = "player_", -- final key is KeyPrefix .. UserId
		RetryBackoff = { 1, 2, 4, 8, 16 }, -- exponential backoff schedule for DataStoreWrapper
		RetryJitter = 0.2, -- +/-20% jitter applied to each backoff step
	},

	Session = {
		LockStaleSeconds = 900, -- a session lock older than this is assumed dead and is stolen
		LockRetries = 5, -- attempts to acquire a live lock before kicking the player
		LockRetryDelay = 6, -- seconds between lock acquisition attempts
	},

	Rebirth = {
		VoteWindowSeconds = 30, -- every occupant must vote yes inside this window (spec 1.8)
	},

	Network = {
		SnapshotIntervalSeconds = 0.5, -- max StateSync rate; essence-only ticks ride this cadence
		MaxNotifyPerSecond = 6, -- server-side Notify throttle, protects the client toast stack
	},

	Debug = {
		Enabled = false, -- verbose server logging
		FastMode = false, -- income x FastIncomeMultiplier, costs / FastCostDivisor (Economy honours it)
		-- Two-part gate on the destructive "reset my save" action. AllowDataReset compiles the
		-- feature in at all; DataResetStudioOnly keeps it out of players' reach on a live server
		-- while leaving it available while developing. GameConfig stays pure, so the RunService
		-- check itself lives in ProfileService (authoritative) and SettingsController (hides the
		-- button) rather than here.
		AllowDataReset = true,
		DataResetStudioOnly = true,
		FastIncomeMultiplier = 25, -- magnitude of the FastMode income boost
		FastCostDivisor = 10, -- magnitude of the FastMode cost reduction
	},
}

-- WHY freeze: config is read by ~30 modules; an accidental write anywhere would desync balance
-- between client prediction and server truth. Nested tables are frozen too, since freezing only the
-- top level would still allow `GameConfig.Plot.Spacing = 1`.
-- EXCEPTION: `Debug` stays mutable on purpose -- dev commands and the test harness flip FastMode /
-- AllowDataReset at runtime, and that is the whole point of those flags.
-- table.freeze ERRORS on an already-frozen table, and shared sub-tables (or a cycle) would hit the
-- same table twice, so isfrozen doubles as the visited-set here.
local function deepFreeze(t: { [any]: any }): { [any]: any }
	if table.isfrozen(t) then
		return t
	end
	table.freeze(t)
	for _, value in pairs(t) do
		if type(value) == "table" then
			deepFreeze(value :: { [any]: any })
		end
	end
	return t
end

for key, value in pairs(GameConfig) do
	if key ~= "Debug" and type(value) == "table" then
		deepFreeze(value :: { [any]: any })
	end
end
table.freeze(GameConfig)

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">PlotLayout</string>
          <string name="Source"><![CDATA[--!strict
--[[
    PlotLayout
    Pure geometry for a Sanctum. It answers every "where does this go?" question exactly once: where
    each Sanctum sits in the world, where a Wing's floor slab lands, where purchase pads line up,
    where the Conflux and its Font float, which waypoints a Mote rides from a Wellspring nozzle to
    the Font, and where players spawn / stand to link. No services, no Instances -- every function is
    a pure function of its arguments plus static config, so PlotBuilder, MoteSystem and the headless
    test harness all agree on one map.
    Owner: shared  |  Consumers: PlotBuilder, MoteSystem, PlotService, PurchaseService
]]

--[[ SANCTUM LAYOUT

    WORLD: Sanctums are a single row marching along +X from GameConfig.Plot.Origin, one every
    GameConfig.Plot.Spacing studs. Spacing (240) exceeds SanctumSize.X (200), so neighbouring
    Sanctums never touch and a stray Mote can never visit the wrong plot.

        Origin        +Spacing       +2*Spacing              ->  +X
          #1            #2             #3            #4  ...
        [======]      [======]       [======]      [======]

    LOCAL SPACE of one Sanctum (200 x 200; the origin CFrame sits at the centre of the floor,
    +X right, +Z "south", -Z "north"). Wing slabs come from SectionData.Offset/Size:

                                  -Z   (north)
        +-----------------------------------------------------------+  z = -100
        |             [ wing_ember_forge   80 x 50 ]                 |
        |              o  o  o  o  o  o    pad row 0, z = -51        |
        +-----------------------------------------------------------+  z = -45
        |                                                           |
        | [wing_    ]  o  o  o  o  o  o    core pads, z = -28        |
        | [zephyr_  ]                                    [wing_     ]
   -X   | [spire    ]         ( ( (  C O N F L U X  ) ) )  [tide_   ]  +X
        |  p            \___ y = 20 ___/                   [basin   ]
        |  p                  ( CONFLUX FONT )  (0, 3, 0)      p     |
        |  p                                                   p     |
        |  x = -51                                        x = +51    |
        |                    S1        S2      spawn slots, z = +30  |
        +-----------------------------------------------------------+  z = +45
        |              o  o  o  o  o  o    pad row 0, z = +51        |
        |             [ wing_terra_vault   80 x 50 ]                 |
        +-----------------------------------------------------------+  z = +100
                                  +Z   (south)

    PADS: every Wing gets one pad line inset just behind its edge facing the middle, pads spaced
    PAD_SPACING apart along that edge and wrapping into extra rows that grow AWAY from the middle
    (into the Wing's own floor). The core is the exception -- the Font and the Conflux own its
    centre, so its rows grow inward from the north edge. Because every line sits on a different
    plane (|51| for the four Wings, -28 for the core) pads can never overlap between Wings.

    RAILS: five waypoints -- nozzle -> rail deck -> trunk corner -> font approach -> Font. The pad's
    lateral position, a per-order rail lane height and a per-order fan offset keep two rails from
    ever being the same line, but every path ends on the Font.
]]

local GameConfig = require(script.Parent.GameConfig)
local SectionData = require(script.Parent.SectionData)

type Section = SectionData.Section

local PlotLayout = {}

-- Footprint of one Sanctum. Y is generous head-room for the Conflux, not a solid volume.
PlotLayout.SanctumSize = Vector3.new(200, 60, 200)

-- Vertical stack (studs above the Wing floor slabs, which sit at local Y = 0).
local PAD_HEIGHT = 1.5 -- centre of a purchase pad; the slab top is at 0.5
local NOZZLE_HEIGHT = 7 -- where a Wellspring's nozzle sits above its pad
local MOTE_SPAWN_DROP = 1 -- Motes appear this far UNDER the nozzle, so they read as "condensed"
local RAIL_HEIGHT = 5 -- height of rail lane 0
local FONT_HEIGHT = 3 -- centre of the Conflux Font
local CONFLUX_HEIGHT = 20 -- the Conflux floats here, well clear of players and rails
local SPAWN_HEIGHT = 4 -- character spawn height (half a Humanoid clears the slab)

-- Pad line packing.
local PAD_SPACING = 12 -- studs between pad centres along a line (spec: 12)
local PAD_ROW_SPACING = 12 -- studs between wrapped rows
local PAD_END_MARGIN = 8 -- keep pads this far from the ends of a Wing so they read as "on" it
local WING_PAD_INSET = 6 -- how far behind a Wing's inner edge its pad line sits
local CORE_PAD_INSET = 12 -- how far inside the core's north edge its pad line sits

-- Rail shaping.
local RAIL_LANES = 3 -- number of stacked rail decks; adjacent pads use different lanes
local RAIL_LANE_STEP = 1.1 -- vertical gap between lanes, so parallel rails never z-fight
local FONT_APPROACH = 14 -- radius of the ring where every rail lines up on the Font
local APPROACH_FRACTION = 0.6 -- short rail runs shrink their approach ring instead of overshooting
local RAIL_FAN = 3 -- lateral spread of the approach points, so rails stay distinguishable

-- Player furniture, placed on the open (south) half of the core so pads never collide with it.
local SPAWN_Z = 30
local SPAWN_X = 9 -- half the gap between the two slot spawns
local SPAWN_PAIR_STEP = 6 -- extra spread if SlotsPerSanctum is ever raised above 2
local LINK_PAD_Z = 22 -- link pads sit between the spawns and the Font

-- Identity rotation looks down -Z, so a yaw of atan2(-dx, -dz) aims the CFrame at (dx, dz).
-- WHY orient at all: pads must face the player walking in from the middle, and Mote waypoints must
-- face along travel so MoteSystem can CFrame-lerp without computing its own headings.
local function facing(position: Vector3, target: Vector3): CFrame
	local dx = target.X - position.X
	local dz = target.Z - position.Z
	if dx * dx + dz * dz < 1e-6 then
		return CFrame.new(position)
	end
	return CFrame.new(position) * CFrame.Angles(0, math.atan2(-dx, -dz), 0)
end

-- How many pads fit on one row of a Wing edge of `extent` studs.
local function perRowFor(extent: number): number
	return math.max(1, math.floor((extent - 2 * PAD_END_MARGIN) / PAD_SPACING) + 1)
end

-- A Wing's pad line, expressed in Sanctum-local space.
--   Base   = centre of row 0 (the pad at column index (PerRow-1)/2 sits exactly here)
--   Run    = unit axis pads march along
--   Row    = unit axis wrapped rows grow along
--   Inward = unit axis pointing from the line toward the Sanctum centre (where the Font is)
type PadLine = {
	Base: Vector3,
	Run: Vector3,
	Row: Vector3,
	Inward: Vector3,
	PerRow: number,
}

local function padLine(section: Section): PadLine
	local offset = section.Offset
	local halfX = section.Size.X * 0.5
	local halfZ = section.Size.Z * 0.5

	if section.Id == SectionData.Base then
		-- The core's middle is spoken for (Font + Conflux + spawns), so its pads hug the north edge
		-- and extra rows step INWARD -- there is no outward space to grow into.
		return {
			Base = Vector3.new(offset.X, PAD_HEIGHT, offset.Z - halfZ + CORE_PAD_INSET),
			Run = Vector3.new(1, 0, 0),
			Row = Vector3.new(0, 0, 1),
			Inward = Vector3.new(0, 0, 1),
			PerRow = perRowFor(section.Size.X),
		}
	end

	if math.abs(offset.X) >= math.abs(offset.Z) then
		-- East/west Wing: the edge facing the middle is a plane of constant X, so pads run along Z.
		local sign = if offset.X >= 0 then 1 else -1
		local x = offset.X - sign * halfX + sign * WING_PAD_INSET
		return {
			Base = Vector3.new(x, PAD_HEIGHT, offset.Z),
			Run = Vector3.new(0, 0, 1),
			Row = Vector3.new(sign, 0, 0),
			Inward = Vector3.new(-sign, 0, 0),
			PerRow = perRowFor(section.Size.Z),
		}
	end

	-- North/south Wing: the inner edge is a plane of constant Z, so pads run along X.
	local sign = if offset.Z >= 0 then 1 else -1
	local z = offset.Z - sign * halfZ + sign * WING_PAD_INSET
	return {
		Base = Vector3.new(offset.X, PAD_HEIGHT, z),
		Run = Vector3.new(1, 0, 0),
		Row = Vector3.new(0, 0, sign),
		Inward = Vector3.new(0, 0, -sign),
		PerRow = perRowFor(section.Size.X),
	}
end

-- Local-space centre of the pad at `order` (1-based) on `section`.
-- NOTE: `order` is a PER-WING pad index. Wellsprings, Upgrades and Wing-unlock pads share one Wing,
-- so PurchaseService must hand out one running index per Wing rather than reusing DropperData.Order
-- (whose numbering restarts per catalogue and would stack two pads on the same stud).
local function padPosition(section: Section, order: number): Vector3
	local line = padLine(section)
	local index = math.max(0, math.floor(order) - 1)
	local column = index % line.PerRow
	local row = math.floor(index / line.PerRow)
	local along = column * PAD_SPACING - (line.PerRow - 1) * PAD_SPACING * 0.5
	local depth = row * PAD_ROW_SPACING
	return Vector3.new(
		line.Base.X + line.Run.X * along + line.Row.X * depth,
		line.Base.Y,
		line.Base.Z + line.Run.Z * along + line.Row.Z * depth
	)
end

function PlotLayout.sanctumOrigin(plotIndex: number): CFrame
	-- One row along +X: trivially collision-free, keeps plot N's world position derivable from N
	-- alone, and makes the "which Sanctum is that?" question answerable at a glance in Studio.
	local index = math.max(1, math.floor(plotIndex))
	local base = GameConfig.Plot.Origin
	return CFrame.new(base + Vector3.new((index - 1) * GameConfig.Plot.Spacing, 0, 0))
end

function PlotLayout.sectionCFrame(origin: CFrame, section: Section): CFrame
	-- SectionData.Offset is already Sanctum-local, so the Wing slab is just a local translation.
	return origin * CFrame.new(section.Offset)
end

function PlotLayout.padCFrame(origin: CFrame, section: Section, order: number): CFrame
	local position = padPosition(section, order)
	-- Pads face the middle of the Sanctum, i.e. the player approaching from the Conflux.
	return origin * facing(position, Vector3.new(0, position.Y, 0))
end

function PlotLayout.confluxCFrame(origin: CFrame): CFrame
	return origin * CFrame.new(0, CONFLUX_HEIGHT, 0)
end

function PlotLayout.fontCFrame(origin: CFrame): CFrame
	return origin * CFrame.new(0, FONT_HEIGHT, 0)
end

function PlotLayout.railPath(origin: CFrame, section: Section, order: number): { CFrame }
	local line = padLine(section)
	local pad = padPosition(section, order)
	local index = math.max(0, math.floor(order) - 1)

	-- Per-order lane height and fan offset: two Wellsprings on the same Wing must not share a rail
	-- line (they would z-fight and their Motes would visually collide), but both must still land on
	-- the Font. Lane/fan cycle every RAIL_LANES pads, and the pad's own lateral position separates
	-- the rest, so no two pads on a Wing produce the same path.
	local railY = RAIL_HEIGHT + (index % RAIL_LANES) * RAIL_LANE_STEP
	local fan = ((index % RAIL_LANES) - 1) * RAIL_FAN

	-- Distance from the Sanctum centre out to the pad (and to the rail deck entry just inside it),
	-- measured along the inward axis.
	local outward = -(pad.X * line.Inward.X + pad.Z * line.Inward.Z)
	local entry = math.max(1, outward - WING_PAD_INSET)
	-- WHY derive the ring radii from `entry` instead of using fixed constants: the radius must
	-- decrease monotonically along the path or a Mote would visibly back up. A short run (the core's
	-- inner pad rows, only ~10 studs out) then behaves exactly like a long one from a far Wing.
	local approach = math.min(FONT_APPROACH, entry * APPROACH_FRACTION)
	local trunk = (entry + approach) * 0.5
	local lateral = pad.X * line.Run.X + pad.Z * line.Run.Z

	local function ringPoint(radius: number, side: number, height: number): Vector3
		-- centre + (-Inward) * radius + Run * side
		return Vector3.new(
			-line.Inward.X * radius + line.Run.X * side,
			height,
			-line.Inward.Z * radius + line.Run.Z * side
		)
	end

	local points = {
		Vector3.new(pad.X, NOZZLE_HEIGHT - MOTE_SPAWN_DROP, pad.Z), -- 1: born under the nozzle
		Vector3.new(
			pad.X + line.Inward.X * WING_PAD_INSET,
			railY,
			pad.Z + line.Inward.Z * WING_PAD_INSET
		), -- 2: lands on its rail deck
		ringPoint(trunk, lateral, railY), -- 3: trunk corner, still in the pad's own lane
		ringPoint(approach, fan, railY), -- 4: approach ring, fanned so lanes stay readable
		Vector3.new(0, FONT_HEIGHT, 0), -- 5: swallowed by the Conflux Font
	}

	-- Orient each waypoint along the direction of travel; the last inherits the second-to-last's
	-- heading because there is nothing after it to look at.
	local path: { CFrame } = table.create(#points)
	for i, point in ipairs(points) do
		local target = points[i + 1]
		if target ~= nil then
			path[i] = origin * facing(point, target)
		else
			path[i] = origin * facing(point, point + (point - points[i - 1]))
		end
	end
	return path
end

function PlotLayout.spawnSlotCFrame(origin: CFrame, slot: number): CFrame
	-- Slots alternate left/right of the centre line; pairs beyond the first step further out, so a
	-- future GameConfig.Plot.SlotsPerSanctum > 2 still lands everyone on the core floor.
	local index = math.max(1, math.floor(slot))
	local pair = math.floor((index - 1) / 2)
	local side = if index % 2 == 1 then -1 else 1
	local position = Vector3.new(side * (SPAWN_X + pair * SPAWN_PAIR_STEP), SPAWN_HEIGHT, SPAWN_Z)
	-- Face the Conflux: the first thing a player sees on spawn is the thing they are here to grow.
	return origin * facing(position, Vector3.new(0, SPAWN_HEIGHT, 0))
end

function PlotLayout.linkPadCFrame(origin: CFrame, slot: number): CFrame
	local index = math.max(1, math.floor(slot))
	local pair = math.floor((index - 1) / 2)
	local side = if index % 2 == 1 then -1 else 1
	local position = Vector3.new(side * (SPAWN_X + pair * SPAWN_PAIR_STEP), PAD_HEIGHT, LINK_PAD_Z)
	return origin * facing(position, Vector3.new(0, PAD_HEIGHT, 0))
end

return PlotLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RebirthData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    RebirthData
    Constants and milestone badges for Transcendence. Transcending wipes the shared Sanctum PlotState
    but grants every consenting occupant a permanent, per-player prestige multiplier and any badges
    they have newly earned. PURE data -- no services, no Instances, and deliberately no requires, so
    that a corrupt sibling module can never stop the prestige gate from being evaluated.
    Owner: shared  |  Consumers: Economy, RebirthService, StateSchema, RebirthController, HudController
]]

--[[ BALANCE MODEL

    RequiredStage is 6 == EvolutionData.MaxStage (kept as a literal here purely to avoid a require
    from a data module; EvolutionData is the source of truth for the Stage list itself).

    RequiredLifetimeEssence is 3.5e9. Per the EvolutionData simulation, a first run enters Stage 6 at
    ~51.9 min with ~1.28 M Essence/s and climbs fast; banking the remaining Lifetime Essence takes
    another ~2.8 min, putting the first Transcendence at ~54.7 min -- inside the 45-75 min target.
    Note it is measured against LifetimeEssence (Essence credited SINCE the last Transcendence), not
    the wallet, so a player cannot stall at Stage 6 spending nothing and be locked out.

    MultiplierPerRebirth is 0.25, and Economy.getSanctumPrestigeMultiplier sums the occupants'
    bonuses rather than multiplying them: 1 + 0.25*Ra + 0.25*Rb. Summing is what makes a linked
    Sanctum meaningfully better than two solo ones without letting a single veteran trivialise the
    run for a brand-new partner.

    MaxTrackedRebirths caps the stored counter at 100 (a x26 multiplier). Past that the number stops
    being interesting and starts being a serialisation hazard, so it is clamped by sanitizeProfile.
]]

export type Badge = {
	Id: string,
	Name: string,
	Description: string,
	Rebirths: number, -- rebirth count at which the badge is awarded
	Color: Color3,
}

local RebirthData = {}

RebirthData.RequiredStage = 6 -- == EvolutionData.MaxStage
RebirthData.RequiredLifetimeEssence = 3500000000
RebirthData.MultiplierPerRebirth = 0.25 -- Economy.getPrestigeMultiplier(R) = 1 + 0.25 * R
RebirthData.MaxTrackedRebirths = 100

-- Ordered ascending by Rebirths; highestBadge relies on that ordering.
RebirthData.Badges = {
	{
		Id = "ember_initiate", Name = "Ember Initiate",
		Description = "Let the Conflux go once. The Sanctum remembers the heat it left behind.",
		Rebirths = 1, Color = Color3.fromRGB(255, 138, 64),
	},
	{
		Id = "wisp_walker", Name = "Wisp Walker",
		Description = "Three Transcendences. You know the road from spark to Primordial by heart.",
		Rebirths = 3, Color = Color3.fromRGB(160, 220, 255),
	},
	{
		Id = "sprite_sovereign", Name = "Sprite Sovereign",
		Description = "Five Sanctums raised and released. Affinities bend to you now.",
		Rebirths = 5, Color = Color3.fromRGB(150, 255, 190),
	},
	{
		Id = "elemental_adept", Name = "Elemental Adept",
		Description = "Ten cycles. Any partner who links with you inherits a frightening head start.",
		Rebirths = 10, Color = Color3.fromRGB(200, 150, 255),
	},
	{
		Id = "warden_eternal", Name = "Warden Eternal",
		Description = "Twenty-five. The Conflux answers before you finish asking.",
		Rebirths = 25, Color = Color3.fromRGB(255, 210, 110),
	},
	{
		Id = "primordial_ascendant", Name = "Primordial Ascendant",
		Description = "Fifty Transcendences. There is nothing left in the Sanctum that you have not already been.",
		Rebirths = 50, Color = Color3.fromRGB(255, 255, 235),
	},
} :: { Badge }

table.sort(RebirthData.Badges, function(a: Badge, b: Badge): boolean
	return a.Rebirths < b.Rebirths
end)

RebirthData.ById = {} :: { [string]: Badge }
for _, badge in ipairs(RebirthData.Badges) do
	RebirthData.ById[badge.Id] = badge
end

-- Returns the FULL earned set rather than only the newest badge, so RebirthService can simply
-- overwrite Prestige.Badges and self-heal a profile that missed an award through a failed save.
function RebirthData.badgesFor(rebirths: number): { [string]: boolean }
	local out: { [string]: boolean } = {}
	local count = if type(rebirths) == "number" and rebirths == rebirths then rebirths else 0
	for _, badge in ipairs(RebirthData.Badges) do
		if count >= badge.Rebirths then
			out[badge.Id] = true
		end
	end
	return out
end

function RebirthData.highestBadge(rebirths: number): Badge?
	local best: Badge? = nil
	for _, badge in ipairs(RebirthData.Badges) do
		if rebirths >= badge.Rebirths then
			best = badge
		end
	end
	return best
end

-- Human text for the Transcend button tooltip. Built locally (no Format require) to keep this module
-- dependency-free; the abbreviation only ever has to handle this one constant.
function RebirthData.requirementText(): string
	local amount = RebirthData.RequiredLifetimeEssence
	local short: string
	if amount >= 1e9 then
		short = string.format("%.1fB", amount / 1e9)
	elseif amount >= 1e6 then
		short = string.format("%.1fM", amount / 1e6)
	else
		short = tostring(amount)
	end
	return string.format(
		"Reach Stage %d and bank %s Essence since your last Transcendence.",
		RebirthData.RequiredStage,
		short
	)
end

return RebirthData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">RemoteSchema</string>
          <string name="Source"><![CDATA[--!strict
--[[
    RemoteSchema
    The wire contract: every RemoteEvent the game owns, declared exactly once so RemoteService (which
    creates them) and ClientBootstrap (which looks them up) can never disagree about a name, a
    direction, a rate limit or a payload shape. Client -> server entries carry a token-bucket budget
    and a total validator; server -> client entries carry neither, because the server is trusted.
    Owner: shared  |  Consumers: RemoteService, RateLimiter, ClientBootstrap, every controller, tests
]]
--[[ WHY THE SURFACE IS THIS SMALL (§1.7). Purchases run through server-listened ProximityPrompts,
     so there is no client -> server message that names an amount, a price or a plot to charge. What
     is left is intent only: a vote, a choice between four literal ids, two booleans and a refresh.
     Every validator below is TOTAL -- it returns false instead of erroring on any input, including
     userdata and tables with hostile metatables -- because an error thrown inside a remote handler
     is a free denial of service. Every validator also REJECTS EXTRA KEYS: a payload padded with
     junk is an attempt to smuggle a field past a future handler that reads it. ]]

local Validate = require(script.Parent.Validate)
local GameConfig = require(script.Parent.GameConfig)
local AffinityData = require(script.Parent.AffinityData)

export type RemoteDef = {
	Name: string,
	Direction: "ServerToClient" | "ClientToServer",
	RateLimit: { Tokens: number, Interval: number }?, -- ClientToServer only
	Validate: ((payload: any) -> (boolean, string?))?, -- ClientToServer only
}

local RemoteSchema = {}
RemoteSchema.FolderName = "SanctumRemotes"

local S2C: "ServerToClient" = "ServerToClient"
local C2S: "ClientToServer" = "ClientToServer"

-- Wraps a checker so it can never throw: a metatable whose __index errors, a userdata payload or a
-- deeply nested table all collapse to a clean rejection instead of unwinding the handler.
local function total(check: (payload: any) -> (boolean, string?)): (payload: any) -> (boolean, string?)
	return function(payload: any): (boolean, string?)
		local ok, accepted, reason = pcall(check, payload)
		if not ok then
			return false, "validator error"
		end
		if accepted == true then
			return true, nil
		end
		return false, if type(reason) == "string" then reason else "rejected"
	end
end

-- Shape first (exact fields, exact kinds, no extras), then any value-level rule.
local function shaped(shape: { [string]: string }, extra: ((payload: any) -> (boolean, string?))?)
	return total(function(payload: any): (boolean, string?)
		local ok, reason = Validate.payload(payload, shape)
		if not ok then
			return false, reason
		end
		if extra ~= nil then
			return extra(payload)
		end
		return true, nil
	end)
end

-- Plot ids are indices into the server's sanctum array. Bounding them here means a forged id can
-- never reach a table lookup, and a float ("PlotId = 1.5") can never alias slot 1.
local function isPlotId(value: any): boolean
	return type(value) == "number"
		and value == value
		and value % 1 == 0
		and value >= 1
		and value <= GameConfig.Plot.SanctumCount
end

RemoteSchema.Remotes = {
	--[[ Server -> client. No RateLimit and no Validate: these are produced by trusted code, and a
	     validator on this side would only cost CPU on the hot replication path. ]]
	StateSync = { Name = "StateSync", Direction = S2C }, -- §7 snapshot; the highest-frequency remote
	Notify = { Name = "Notify", Direction = S2C }, -- { Kind = "info"|"success"|"warn"|"error", Text }
	Fx = { Name = "Fx", Direction = S2C }, -- { Kind = "attune"|"transcend"|"purchase"|"link", PlotId, Data? }
	LinkOffer = { Name = "LinkOffer", Direction = S2C }, -- { PlotId, FromUserId, FromName, ExpiresAt }
	RebirthVoteState = { Name = "RebirthVoteState", Direction = S2C }, -- { PlotId, Votes, ExpiresAt, Names }

	--[[ Client -> server. Budgets are sized at "a human mashing the button", not "a script": each
	     one is a few times the fastest honest rate, so a real player never notices and a spammer is
	     throttled before the handler runs. ]]

	-- A resync button and the reconnect path both fire this; 4 per 5s absorbs an impatient
	-- double-tap while capping the cost of forcing a full snapshot rebuild.
	RequestSnapshot = {
		Name = "RequestSnapshot",
		Direction = C2S,
		RateLimit = { Tokens = 4, Interval = 5 },
		-- an empty shape accepts only nil or {}; anything carried here is an attempt to smuggle
		-- arguments into a handler that takes none
		Validate = shaped({}),
	},

	-- The consensus vote (§1.8). Accept is the WHOLE payload: the sanctum is derived from the
	-- player's occupancy server-side, so nobody can vote in someone else's transcendence.
	RebirthVote = {
		Name = "RebirthVote",
		Direction = C2S,
		RateLimit = { Tokens = 5, Interval = 10 },
		Validate = shaped({ Accept = "boolean" }),
	},

	-- Permanent for the run, so it is checked against the catalogue rather than a pattern: only the
	-- four literal ids are accepted, and "id" already bounds length and character set.
	ChooseAffinity = {
		Name = "ChooseAffinity",
		Direction = C2S,
		RateLimit = { Tokens = 4, Interval = 10 },
		Validate = shaped({ Affinity = "id" }, function(payload: any): (boolean, string?)
			if not AffinityData.isValid((payload :: any).Affinity) then
				return false, "unknown affinity"
			end
			return true, nil
		end),
	},

	-- Cosmetic, but still validated: Key is a closed set because it is used to index the saved
	-- Settings table, and an arbitrary string there would write a field the sanitiser then drops.
	SetSetting = {
		Name = "SetSetting",
		Direction = C2S,
		RateLimit = { Tokens = 10, Interval = 10 },
		Validate = shaped({ Key = "string", Value = "boolean" }, function(payload: any): (boolean, string?)
			local key = (payload :: any).Key
			if key ~= "Music" and key ~= "Sfx" then
				return false, "unknown setting"
			end
			return true, nil
		end),
	},

	-- Answer to a LinkOffer. PlotId is bounded so a decline for a sanctum the player was never
	-- offered cannot index past the array; the server still re-checks that an offer is pending.
	LinkResponse = {
		Name = "LinkResponse",
		Direction = C2S,
		RateLimit = { Tokens = 5, Interval = 10 },
		Validate = shaped({ PlotId = "number", Accept = "boolean" }, function(payload: any): (boolean, string?)
			if not isPlotId((payload :: any).PlotId) then
				return false, "plot id out of range"
			end
			return true, nil
		end),
	},

	-- Destructive and irreversible, so it is the tightest budget in the game and is refused outright
	-- unless the build opted in. Confirm must be literally true: a truthy 1 or "yes" is rejected, so
	-- a mistyped client cannot wipe a profile.
	ResetData = {
		Name = "ResetData",
		Direction = C2S,
		RateLimit = { Tokens = 1, Interval = 30 },
		Validate = shaped({ Confirm = "boolean" }, function(payload: any): (boolean, string?)
			if GameConfig.Debug.AllowDataReset ~= true then
				return false, "data reset disabled"
			end
			if (payload :: any).Confirm ~= true then
				return false, "confirmation required"
			end
			return true, nil
		end),
	},
} :: { [string]: RemoteDef }

-- Deterministic creation order for RemoteService: `pairs` order is unspecified in Luau, so without
-- this sort the folder would be built differently on every boot. Server -> client remotes are
-- created FIRST, so a client that is already listening cannot miss an early push while the inbound
-- events are still being made; alphabetical inside each direction keeps it diffable.
RemoteSchema.List = {} :: { RemoteDef }
for _, def in pairs(RemoteSchema.Remotes) do
	table.insert(RemoteSchema.List, def)
end
table.sort(RemoteSchema.List, function(a: RemoteDef, b: RemoteDef): boolean
	if a.Direction ~= b.Direction then
		return a.Direction == S2C
	end
	return a.Name < b.Name
end)

function RemoteSchema.get(name: string): RemoteDef?
	-- typed guard: `Remotes[name]` with a non-string would be a silent nil, and callers use the nil
	-- as "this remote does not exist" -- which is exactly what an unknown name should look like
	if type(name) ~= "string" then
		return nil
	end
	return RemoteSchema.Remotes[name]
end

return RemoteSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">SectionData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    SectionData
    Static catalogue of the Sanctum's Wings. A Wing is both an economic gate (it hosts the pads for a
    tier of Wellsprings and Upgrades) and a piece of geometry (PlotBuilder parents its floor at
    Offset and sizes it to Size, relative to the Sanctum origin). PURE data: Vector3 constructors
    only, no services and no Instances.
    Owner: shared  |  Consumers: PlotLayout, PlotBuilder, Economy, PurchaseService, EvolutionService
]]

--[[ GEOMETRY

    The Sanctum footprint is 200 x 200 studs, i.e. local X and Z both span -100..100. wing_core sits
    dead centre at (0, 0, 0) and the four purchasable Wings fan out on the cardinals, leaving a 5
    stud gap between every pair of slabs so PlotBuilder can drop a visible bridge/threshold in the
    seam and so no two floor parts ever z-fight.

        Wing               centre      half-extents     occupies X          occupies Z
        wing_core          (  0, 0)    40 x 40          -40 .. 40           -40 .. 40
        wing_ember_forge   (  0,-70)   40 x 25          -40 .. 40           -95 .. -45
        wing_tide_basin    ( 70, 0)    25 x 40           45 .. 95           -40 .. 40
        wing_terra_vault   (  0, 70)   40 x 25          -40 .. 40            45 .. 95
        wing_zephyr_spire  (-70, 0)    25 x 40          -95 .. -45          -40 .. 40

    No two ranges intersect in both axes, so there is no overlap; every slab stays inside +/-100.
    Y is always 0 -- Wings are floors, PlotLayout lifts pads and rails above them.

    COST: each Wing is priced just under the Attunement that unlocks the NEXT Stage, so the natural
    play pattern is "attune -> buy the new Wing -> fill it with Wellsprings -> attune again".
]]

export type Section = {
	Id: string,
	Name: string,
	Description: string,
	Cost: number,
	RequiredStage: number,
	RequiredSection: string?, -- prerequisite Wing; nil only for the base Wing
	Order: number,
	Offset: Vector3, -- centre of the floor slab, relative to the Sanctum origin
	Size: Vector3, -- full extents of the floor slab (Y is slab thickness)
}

local SectionData = {}

-- The Wing every Sanctum owns from the moment it is claimed. Never purchasable, never lockable.
SectionData.Base = "wing_core"

SectionData.List = {
	{
		Id = "wing_core", Name = "Conflux Core",
		Description = "The heart of the Sanctum. The Conflux floats here above the Font, and the first Wellsprings ring it.",
		Cost = 0, RequiredStage = 1, RequiredSection = nil, Order = 1,
		Offset = Vector3.new(0, 0, 0), Size = Vector3.new(80, 1, 80),
	},
	{
		Id = "wing_ember_forge", Name = "Ember Forge",
		Description = "A vaulted furnace hall to the north. Heat-hungry Wellsprings only work once the Forge is lit.",
		Cost = 2500, RequiredStage = 2, RequiredSection = "wing_core", Order = 2,
		Offset = Vector3.new(0, 0, -70), Size = Vector3.new(80, 1, 50),
	},
	{
		Id = "wing_tide_basin", Name = "Tide Basin",
		Description = "A sunken eastern reservoir. Its standing wave never settles, and the Weir taps that restlessness.",
		Cost = 45000, RequiredStage = 3, RequiredSection = "wing_ember_forge", Order = 3,
		Offset = Vector3.new(70, 0, 0), Size = Vector3.new(50, 1, 80),
	},
	{
		Id = "wing_terra_vault", Name = "Terra Vault",
		Description = "A southern strongroom cut into bedrock. Heavy enough to cage a storm, or a piece of the world's core.",
		Cost = 700000, RequiredStage = 4, RequiredSection = "wing_tide_basin", Order = 4,
		Offset = Vector3.new(0, 0, 70), Size = Vector3.new(80, 1, 50),
	},
	{
		Id = "wing_zephyr_spire", Name = "Zephyr Spire",
		Description = "A western needle that pierces the veil. The last Wing, and the only place the Aether can be reached.",
		Cost = 15000000, RequiredStage = 5, RequiredSection = "wing_terra_vault", Order = 5,
		Offset = Vector3.new(-70, 0, 0), Size = Vector3.new(50, 1, 80),
	},
} :: { Section }

table.sort(SectionData.List, function(a: Section, b: Section): boolean
	return a.Order < b.Order
end)

SectionData.ById = {} :: { [string]: Section }
for _, def in ipairs(SectionData.List) do
	SectionData.ById[def.Id] = def
end

function SectionData.get(id: string): Section?
	return SectionData.ById[id]
end

return SectionData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Signal
    A tiny dependency-free event object (Connect / Once / Fire / Wait / DisconnectAll / Destroy).
    Handlers are dispatched through task.spawn so a single erroring listener can never abort the
    dispatch loop or the code that fired the signal, and Fire iterates a snapshot so listeners may
    disconnect (or connect) themselves from inside a handler.
    Owner: shared  |  Consumers: ClientStore, ProfileService, PlotService, DropperSystem, MoteSystem
]]

type Handler = (...any) -> ()

local Connection = {}
Connection.__index = Connection

export type Connection = typeof(setmetatable(
	{} :: {
		Connected: boolean,
		_signal: any, -- back-reference to the owning Signal (any, to avoid a recursive type)
		_fn: Handler,
	},
	Connection
))

-- Disconnecting is idempotent: services tear down in arbitrary order and double-disconnects are
-- normal, so this must never error.
function Connection.Disconnect(self: Connection): ()
	if not self.Connected then
		return
	end
	self.Connected = false
	local signal = self._signal
	if signal ~= nil then
		local handlers = signal._handlers
		local index = table.find(handlers, self)
		if index ~= nil then
			table.remove(handlers, index)
		end
		self._signal = nil
	end
end

local Signal = {}
Signal.__index = Signal

export type Signal = typeof(setmetatable(
	{} :: {
		_handlers: { Connection },
		_destroyed: boolean,
	},
	Signal
))

function Signal.new(): Signal
	return setmetatable({
		_handlers = {},
		_destroyed = false,
	}, Signal)
end

function Signal.Connect(self: Signal, fn: Handler): Connection
	assert(type(fn) == "function", "Signal:Connect expects a function")
	local connection: Connection = setmetatable({
		Connected = true,
		_signal = self,
		_fn = fn,
	}, Connection)
	-- A destroyed signal hands back an already-dead connection instead of erroring: callers racing
	-- against shutdown should degrade quietly.
	if self._destroyed then
		connection.Connected = false
		connection._signal = nil
		return connection
	end
	table.insert(self._handlers, connection)
	return connection
end

function Signal.Once(self: Signal, fn: Handler): Connection
	assert(type(fn) == "function", "Signal:Once expects a function")
	local connection: Connection
	connection = self:Connect(function(...)
		-- Disconnect BEFORE invoking so a re-entrant Fire from inside fn cannot run it twice.
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal.Fire(self: Signal, ...: any): ()
	-- Snapshot: handlers may Disconnect (or Connect) during dispatch, which mutates _handlers.
	local snapshot = table.clone(self._handlers)
	for _, connection in ipairs(snapshot) do
		-- Re-check Connected: an earlier handler in this same dispatch may have killed this one,
		-- and a disconnected listener must not observe the event.
		if connection.Connected then
			-- task.spawn isolates errors AND matches Roblox event semantics (handlers may yield
			-- without stalling the firer).
			task.spawn(connection._fn, ...)
		end
	end
end

-- Yields the calling thread until the next Fire and returns its arguments.
function Signal.Wait(self: Signal): ...any
	local thread = coroutine.running()
	local resumed = false
	self:Once(function(...)
		if resumed then
			return
		end
		resumed = true
		-- We are already inside a task.spawn'd thread here, so resuming the waiter directly is safe
		-- and avoids a polling loop (which would add a frame of latency to every Wait).
		local ok, err = coroutine.resume(thread, ...)
		if not ok then
			warn("[Signal] error after Wait resumed: " .. tostring(err))
		end
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: Signal): ()
	local snapshot = table.clone(self._handlers)
	table.clear(self._handlers)
	for _, connection in ipairs(snapshot) do
		connection.Connected = false
		connection._signal = nil
	end
end

function Signal.Destroy(self: Signal): ()
	self._destroyed = true
	self:DisconnectAll()
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Snapshot</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Snapshot
    Renders the StateSync payload (spec section 7) that the server pushes to clients. Split out of
    StateSchema so each file stays inside the 300-line budget, and because this is the only piece of
    shared state handling that is about REPLICATION rather than PERSISTENCE.

    PURE: it takes a Sanctum-shaped table plus the per-player Profiles the caller looked up, so it
    can be unit tested with plain tables and never touches a service.
    Owner: shared  |  Consumers: StateReplicator (server), tests
]]

local Validate = require(script.Parent.Validate)
local Economy = require(script.Parent.Economy)
local GameConfig = require(script.Parent.GameConfig)
local EvolutionData = require(script.Parent.EvolutionData)
local StateSchema = require(script.Parent.StateSchema)

type Prestige = StateSchema.Prestige

-- Options for snapshotForClient. Prestige/Settings/Stats live in per-player Profiles, which a pure
-- module cannot fetch, so the caller passes them in keyed by UserId.
export type SnapshotOpts = {
	Full: boolean?, -- false = essence-only fast tick; anything else = full snapshot
	Tick: number?, MoteCount: number?,
	Profiles: { [number]: any }?, -- UserId -> Profile
	Names: { [number]: string }?, -- UserId -> display name
	Multipliers: any?, -- EconomyService's cached Multipliers; recomputed when absent
}

local Snapshot = {}

local EMPTY: { [string]: any } = {}
local MAX_CURRENCY, MAX_TIME = StateSchema.MAX_CURRENCY, StateSchema.MAX_TIME
local clamp = Validate.clampNumber

local function tbl(v: any): { [string]: any }
	return if type(v) == "table" then v :: { [string]: any } else EMPTY
end
local function int(v: any, min: number, max: number, default: number): number
	return math.floor(clamp(v, min, max, default))
end
local sanitizePlotState = StateSchema.sanitizePlotState
local sanitizePrestige = StateSchema.sanitizePrestige
local sanitizeSettings = StateSchema.sanitizeSettings

-- UserId from a number, a plain table (tests) or a Player-like object. pcall'd because the value can
-- be userdata with a protective metatable; a failed read simply means "not you".
local function userIdOf(v: any): number
	if type(v) == "number" then return int(v, 0, 1e18, 0) end
	local ok, id = pcall(function(): any return (v :: any).UserId end)
	return if ok and type(id) == "number" then int(id, 0, 1e18, 0) else 0
end
local function nameOf(opts: { [string]: any }, uid: number, occupant: { [string]: any }): string
	local given = tbl(opts.Names)[uid :: any]
	if type(given) == "string" and #given > 0 then return given end
	if type(occupant.Name) == "string" then return occupant.Name :: string end
	-- read-only fallback off a Player-like field; the pcall keeps this total for plain-table tests
	local ok, name = pcall(function(): any return (occupant.Player :: any).Name end)
	return if ok and type(name) == "string" then name else "Occupant " .. tostring(uid)
end
local function prestigeOf(opts: { [string]: any }, uid: number): Prestige
	return sanitizePrestige(tbl(tbl(opts.Profiles)[uid :: any]).Prestige)
end
local function buildSnapshot(sanctum: any, forPlayer: any, opts: any): { [string]: any }
	local o, root = tbl(opts), tbl(sanctum)
	-- accepts a Sanctum or a bare PlotState, so unit tests can drive it with a plain table
	local plot = sanitizePlotState(if type(root.State) == "table" then root.State else root)
	-- Essence rides every tick, everything else only when Full: §7's bandwidth split
	local snapshotTick = clamp(o.Tick, 0, MAX_TIME, 0)
	if o.Full == false then return { Full = false, Tick = snapshotTick, Essence = plot.Essence } end

	local youId = userIdOf(forPlayer)
	local occupants: { any }, rebirthsList: { number }, yourSlot = {}, {}, 0
	for _, entry in pairs(tbl(root.Occupants)) do
		local occ = tbl(entry)
		local uid = userIdOf(if occ.UserId ~= nil then occ.UserId else occ.Player)
		local prestige = prestigeOf(o, uid)
		local isYou = uid ~= 0 and uid == youId
		local slot = int(occ.Slot, 0, GameConfig.Plot.SlotsPerSanctum, 0)
		if isYou then yourSlot = slot end
		table.insert(rebirthsList, prestige.Rebirths)
		table.insert(occupants, {
			UserId = uid, Name = nameOf(o, uid, occ), Slot = slot,
			Contribution = clamp(occ.Contribution, 0, MAX_CURRENCY, 0),
			Rebirths = prestige.Rebirths, Multiplier = prestige.Multiplier, IsYou = isYou,
		})
	end
	-- sorted by slot: `pairs` order is unspecified, and an unstable partner panel would flicker
	table.sort(occupants, function(x, y): boolean
		return if x.Slot == y.Slot then x.UserId < y.UserId else x.Slot < y.Slot
	end)

	local m = if type(o.Multipliers) == "table" then o.Multipliers else Economy.getMultipliers(plot, rebirthsList)
	local you, yourProfile = prestigeOf(o, youId), tbl(tbl(o.Profiles)[youId :: any])
	local attuneOk, attuneReason = Economy.attuneStatus(plot)
	local transcendOk, transcendReason = Economy.transcendStatus(plot)
	local nextStage = EvolutionData.next(plot.Stage)
	return {
		Full = true, Tick = snapshotTick, Essence = plot.Essence,
		Plot = {
			Id = int(root.Id, 0, 1e6, 0), Stage = plot.Stage, Affinity = plot.Affinity,
			-- fresh tables straight from sanitizePlotState, so a queued payload can never be mutated
			-- out from under the client by the next server tick
			Droppers = plot.Droppers, Upgrades = plot.Upgrades, Sections = plot.Sections,
			LifetimeEssence = plot.LifetimeEssence,
			IncomePerSecond = Economy.estimateIncomePerSecond(plot, m),
			Multiplier = Economy.totalMultiplier(m),
			MoteCount = int(o.MoteCount, 0, 1e6, 0), MoteCapacity = Economy.getMoteCapacity(plot),
		},
		Occupants = occupants,
		You = {
			Rebirths = you.Rebirths, Multiplier = you.Multiplier, Badges = you.Badges,
			Settings = sanitizeSettings(yourProfile.Settings), Slot = yourSlot,
			TotalEssenceEarned = clamp(tbl(yourProfile.Stats).TotalEssenceEarned, 0, MAX_CURRENCY, 0),
		},
		Gates = {
			Attune = { Ok = attuneOk, Reason = attuneReason, -- Cost is 0 at max stage, never nil
				Cost = if nextStage then clamp(nextStage.RequiredEssence, 0, MAX_CURRENCY, 0) else 0,
				NextStage = if nextStage then nextStage.Index else nil },
			Transcend = { Ok = transcendOk, Reason = transcendReason },
			-- Available means "the modal may open" (stage gate only); Chosen stays nil until the
			-- pair picks, and the client uses the pair to choose prompt vs. read-only chip.
			Affinity = { Available = plot.Stage >= EvolutionData.AffinityUnlockStage, Chosen = plot.Affinity },
		},
	}
end
-- Degrades to a harmless fast tick rather than throwing: it runs inside the replication loop, whose
-- single Heartbeat connection drives every sanctum.
function Snapshot.forClient(sanctum: any, forPlayer: any, opts: any): { [string]: any }
	local ok, snapshot = pcall(buildSnapshot, sanctum, forPlayer, opts)
	return if ok then snapshot else { Full = false, Tick = 0, Essence = 0 }
end

return Snapshot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">StateSchema</string>
          <string name="Source"><![CDATA[--!strict
--[[
    StateSchema
    The authoritative shape of everything saved, merged or replicated: PlotState, Prestige, Settings,
    Stats and the Profile wrapping them. It builds fresh state, repairs arbitrary input into a legal
    Profile, version-migrates old saves, max-merges two Sanctum states when a partner links in (§1.5)
    and renders the StateSync snapshot (§7). PURE -- no services, no Instances -- so ProfileService,
    PlotService, StateReplicator and the headless tests all share one definition.
    Owner: shared  |  Consumers: ProfileService, PlotService, StateReplicator, Snapshot, tests
]]
--[[ THREAT MODEL. Input to sanitizeProfile is whatever a DataStore returned: nil, a string, an
     array, a cyclic table, NaN/inf/negative numbers, or a profile forged on an older build. It must
     ALWAYS return a legal Profile and NEVER error -- an error here is a failed load, and a failed
     load ends as a kicked player or, far worse, a blank profile overwriting a real save. Every read
     is depth-bounded (no recursive walk) so a cyclic table cannot spin, and every value is clamped
     or dropped, never merely coerced. ]]

local Validate = require(script.Parent.Validate)
local Economy = require(script.Parent.Economy)
local GameConfig = require(script.Parent.GameConfig)
local DropperData = require(script.Parent.DropperData)
local UpgradeData = require(script.Parent.UpgradeData)
local SectionData = require(script.Parent.SectionData)
local EvolutionData = require(script.Parent.EvolutionData)
local AffinityData = require(script.Parent.AffinityData)
local RebirthData = require(script.Parent.RebirthData)

export type PlotState = {
	Essence: number, Stage: number, Affinity: string?,
	Droppers: { [string]: number }, Upgrades: { [string]: number }, Sections: { [string]: boolean },
	LifetimeEssence: number,
}
export type Prestige = { Rebirths: number, Multiplier: number, Badges: { [string]: boolean }, TotalTranscended: number }
export type Settings = { Music: boolean, Sfx: boolean }
export type Stats = { TotalEssenceEarned: number, Playtime: number, JoinCount: number, FirstJoin: number, LastSave: number }
export type Profile = { SchemaVersion: number, Plot: PlotState, Prestige: Prestige, Settings: Settings, Stats: Stats }

local StateSchema = {}
StateSchema.VERSION = 1
-- Currency ceilings sit below 2^53 so every stored balance stays an exact integer; past that,
-- addition rounds and a shared wallet silently drifts. MAX_TIME is seconds since the epoch.
local MAX_CURRENCY, MAX_TIME = 1e15, 1e11
local EMPTY: { [string]: any } = {}
local clamp = Validate.clampNumber -- (v, min, max, default); total, NaN/inf safe
local function tbl(v: any): { [string]: any }
	return if type(v) == "table" then v :: { [string]: any } else EMPTY
end
local function int(v: any, min: number, max: number, default: number): number
	return math.floor(clamp(v, min, max, default))
end
-- Only catalogue ids survive, each count clamped to that def's own ceiling: the single barrier
-- between a hand-edited save ({ god_mode = 1e300 }) and the income loop. Zeroes are dropped so the
-- table stays small and `next(Droppers) == nil` means "owns nothing".
local function sanitizeCounts(raw: any, get: (string) -> any, ceilingField: string): { [string]: number }
	local out: { [string]: number } = {}
	if type(raw) ~= "table" then return out end
	for id, value in pairs(raw :: { [any]: any }) do
		local def = if type(id) == "string" then get(id) else nil
		if def ~= nil then
			local n = int(value, 0, clamp(tbl(def)[ceilingField], 0, 1e6, 0), 0)
			if n > 0 then out[id] = n end
		end
	end
	return out
end
local function sanitizePlotState(raw: any): PlotState
	local src = tbl(raw)
	-- the base wing is force-unlocked: a save that lost it would have no pads and no way back
	local sections: { [string]: boolean } = { [SectionData.Base] = true }
	if type(src.Sections) == "table" then
		for id, value in pairs(src.Sections :: { [any]: any }) do
			if value and type(id) == "string" and SectionData.get(id) ~= nil then sections[id] = true end
		end
	end
	return {
		Essence = clamp(src.Essence, 0, MAX_CURRENCY, 0),
		Stage = int(src.Stage, 1, EvolutionData.MaxStage, 1),
		-- an unknown affinity id becomes nil (unchosen), not a failed lookup on every income tick
		Affinity = if AffinityData.isValid(src.Affinity) then src.Affinity :: string else nil,
		Droppers = sanitizeCounts(src.Droppers, DropperData.get, "MaxOwned"),
		Upgrades = sanitizeCounts(src.Upgrades, UpgradeData.get, "MaxLevel"),
		Sections = sections, LifetimeEssence = clamp(src.LifetimeEssence, 0, MAX_CURRENCY, 0),
	}
end
-- Badges are rebuilt from the rebirth count, then unioned with any stored badge still in the
-- catalogue: rebuilding self-heals an award lost to a failed save, the union keeps a hand-granted
-- one, unknown ids are dropped.
local function sanitizePrestige(raw: any): Prestige
	local src = tbl(raw)
	local rebirths = int(src.Rebirths, 0, RebirthData.MaxTrackedRebirths, 0)
	local badges = RebirthData.badgesFor(rebirths)
	if type(src.Badges) == "table" then
		for id, value in pairs(src.Badges :: { [any]: any }) do
			if value and type(id) == "string" and RebirthData.ById[id] ~= nil then badges[id] = true end
		end
	end
	-- Multiplier is always recomputed: the stored field is a cache, and trusting it would turn one
	-- bad write into a permanent income multiplier.
	return {
		Rebirths = rebirths, Multiplier = Economy.getPrestigeMultiplier(rebirths),
		Badges = badges, TotalTranscended = clamp(src.TotalTranscended, 0, MAX_CURRENCY, 0),
	}
end
-- Both default ON: a missing setting must not silently mute a player who never opened the menu.
local function sanitizeSettings(raw: any): Settings
	local src = tbl(raw)
	return {
		Music = if type(src.Music) == "boolean" then src.Music :: boolean else true,
		Sfx = if type(src.Sfx) == "boolean" then src.Sfx :: boolean else true,
	}
end
local function sanitizeStats(raw: any): Stats
	local src, now = tbl(raw), os.time()
	return {
		TotalEssenceEarned = clamp(src.TotalEssenceEarned, 0, MAX_CURRENCY, 0),
		Playtime = clamp(src.Playtime, 0, MAX_TIME, 0),
		JoinCount = int(src.JoinCount, 0, 1e7, 0),
		FirstJoin = int(src.FirstJoin, 0, MAX_TIME, now), -- absent becomes now, never 1970
		LastSave = int(src.LastSave, 0, MAX_TIME, 0),
	}
end
function StateSchema.newPlotState(): PlotState
	return {
		Essence = clamp(GameConfig.Currency.StartingAmount, 0, MAX_CURRENCY, 0),
		Stage = 1, Affinity = nil, Droppers = {}, Upgrades = {},
		Sections = { [SectionData.Base] = true }, LifetimeEssence = 0,
	}
end
function StateSchema.newProfile(): Profile
	local now = os.time()
	return {
		SchemaVersion = StateSchema.VERSION,
		Plot = StateSchema.newPlotState(),
		Prestige = { Rebirths = 0, Multiplier = Economy.getPrestigeMultiplier(0), Badges = {}, TotalTranscended = 0 },
		Settings = { Music = true, Sfx = true },
		Stats = { TotalEssenceEarned = 0, Playtime = 0, JoinCount = 0, FirstJoin = now, LastSave = 0 },
	}
end
-- Cloning IS repairing: a copy that preserved corruption would spread it to the next save, so the
-- deep copy and the sanitiser are deliberately one operation.
function StateSchema.clonePlotState(state: PlotState): PlotState
	return sanitizePlotState(state)
end
function StateSchema.sanitizeProfile(raw: any): Profile
	local ok, profile = pcall(function(): Profile
		local src = tbl(raw)
		return {
			SchemaVersion = StateSchema.VERSION,
			Plot = sanitizePlotState(src.Plot), Prestige = sanitizePrestige(src.Prestige),
			Settings = sanitizeSettings(src.Settings), Stats = sanitizeStats(src.Stats),
		}
	end)
	-- last resort: a pathological input (protected metatable, __index that throws) still yields a
	-- playable profile instead of an error escaping into the load path
	return if ok then profile else StateSchema.newProfile()
end
-- from-version -> transform. Empty at VERSION 1; each future entry converts one step forward and
-- may assume nothing about its input beyond "it is whatever was stored".
local MIGRATIONS: { [number]: (any) -> any } = {}
function StateSchema.migrate(raw: any): Profile
	local working: any = raw
	local version = int(tbl(raw).SchemaVersion, 0, 1e6, 0)
	local steps = 0 -- bounds the loop even if a future step rewrites SchemaVersion backwards
	while version < StateSchema.VERSION and steps < 64 do
		local step = MIGRATIONS[version]
		if step ~= nil then
			-- a step that throws is skipped, not fatal: sanitizeProfile still salvages the fields it
			-- understands, which beats resetting a veteran's account to zero
			local ok, result = pcall(step, working)
			if ok then working = result end
		end
		version += 1
		steps += 1
	end
	-- A profile stamped NEWER than this server (a rollback) is sanitised down, not refused: unknown
	-- fields are lost, but the player is never locked out of their account.
	return StateSchema.sanitizeProfile(working)
end
--[[ Max-merge (§1.5): joining an occupied Sanctum must never cost the joiner something they owned,
     so every scalar takes the max and every set takes the union. Essence is MAXed, not summed --
     summing would let a pair relink over and over to duplicate their wallet. ]]
function StateSchema.mergePlotStates(a: PlotState, b: PlotState): PlotState
	local left, right = sanitizePlotState(a), sanitizePlotState(b)
	local out = StateSchema.newPlotState()
	out.Essence = math.max(left.Essence, right.Essence)
	out.Stage = math.max(left.Stage, right.Stage)
	out.LifetimeEssence = math.max(left.LifetimeEssence, right.LifetimeEssence)
	-- `a` wins the affinity: it is the LIVE sanctum, whose conflux visuals and multipliers are
	-- already running. A joiner never rewrites the element the pair has been playing.
	out.Affinity = left.Affinity or right.Affinity
	for _, field in ipairs({ "Droppers", "Upgrades" }) do
		local target = (out :: any)[field] :: { [string]: number }
		for id, count in pairs((left :: any)[field] :: { [string]: number }) do target[id] = count end
		for id, count in pairs((right :: any)[field] :: { [string]: number }) do
			target[id] = math.max(target[id] or 0, count)
		end
	end
	for id in pairs(left.Sections) do out.Sections[id] = true end
	for id in pairs(right.Sections) do out.Sections[id] = true end
	-- re-clamped: a union can exceed a def's MaxOwned if the catalogue shrank between the two saves
	return sanitizePlotState(out)
end
-- NOTE: rendering the StateSync payload lives in Snapshot.luau, NOT here. It was split out to
-- keep both files inside the project's 300-line budget, and because replication is a different
-- concern from persistence. Do not re-add snapshotForClient to this module.
-- Exposed so PlotService and the specs can repair a FRAGMENT of state without loading a whole
-- Profile; they are the very functions the sanitiser uses, so "legal" has one definition.
StateSchema.sanitizePlotState = sanitizePlotState
StateSchema.sanitizePrestige = sanitizePrestige
StateSchema.sanitizeSettings = sanitizeSettings
StateSchema.MAX_CURRENCY, StateSchema.MAX_TIME = MAX_CURRENCY, MAX_TIME

return StateSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">TableUtil</string>
          <string name="Source"><![CDATA[--!strict
--[[
    TableUtil
    Pure table helpers used across every layer: copying (cycle-safe), merging, key/value extraction,
    list transforms and deep comparison. No services, no Instances -- safe on client, server and in
    the headless test harness.
    Owner: shared  |  Consumers: StateSchema, ClientStore, ProfileService, PlotService, UiBuilder
]]

local TableUtil = {}

type AnyTable = { [any]: any }

-- WHY the identity map: PlotState snapshots and runtime tables can contain shared sub-tables (and,
-- during development, accidental cycles). Copying with a `seen` map preserves the original object
-- graph exactly and makes a cyclic input terminate instead of overflowing the stack.
local function copyValue(value: any, seen: AnyTable): any
	if type(value) ~= "table" then
		-- Numbers/strings/booleans are immutable; userdata (Color3, Vector3, CFrame, Enum items) is
		-- immutable in Roblox too, so both are copied BY REFERENCE. Never touch their metatables.
		return value
	end

	local existing = seen[value]
	if existing ~= nil then
		return existing
	end

	local copy: AnyTable = {}
	seen[value] = copy
	for key, item in pairs(value) do
		-- Keys are NOT deep-copied: a copied table-key would be unreachable via the original key.
		copy[key] = copyValue(item, seen)
	end

	-- Share the metatable by reference so class-like tables keep their behaviour; deep-copying a
	-- metatable would duplicate methods for no benefit. Guard against __metatable-protected tables,
	-- where getmetatable returns a non-table.
	local meta = getmetatable(value :: any)
	if type(meta) == "table" then
		setmetatable(copy, meta)
	end
	return copy
end

function TableUtil.deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	return copyValue(t, {}) :: any
end

function TableUtil.shallowCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	return (table.clone(t :: any) :: any)
end

-- Returns a NEW table: base with patch applied. Nested plain tables are merged recursively so a
-- patch like { Plot = { Essence = 5 } } does not wipe the rest of Plot; array-like tables and
-- userdata are replaced wholesale (there is no sane element-wise merge for ordered data).
function TableUtil.merge(base: AnyTable?, patch: AnyTable?): AnyTable
	local result: AnyTable = {}
	if type(base) == "table" then
		for key, value in pairs(base :: AnyTable) do
			result[key] = TableUtil.deepCopy(value)
		end
	end
	if type(patch) == "table" then
		for key, value in pairs(patch :: AnyTable) do
			local current = result[key]
			if type(value) == "table" and type(current) == "table" and not TableUtil.isArray(value) then
				result[key] = TableUtil.merge(current :: AnyTable, value :: AnyTable)
			else
				result[key] = TableUtil.deepCopy(value)
			end
		end
	end
	return result
end

function TableUtil.count(t: AnyTable?): number
	if type(t) ~= "table" then
		return 0
	end
	local n = 0
	for _ in pairs(t :: AnyTable) do
		n += 1
	end
	return n
end

function TableUtil.keys(t: AnyTable?): { any }
	local out: { any } = {}
	if type(t) ~= "table" then
		return out
	end
	for key in pairs(t :: AnyTable) do
		table.insert(out, key)
	end
	return out
end

function TableUtil.values(t: AnyTable?): { any }
	local out: { any } = {}
	if type(t) ~= "table" then
		return out
	end
	for _, value in pairs(t :: AnyTable) do
		table.insert(out, value)
	end
	return out
end

-- Deterministic key order. WHY a default comparator: table.sort errors on mixed key types, and
-- dictionaries keyed by both strings and numbers do occur (Theme.Stage is numeric, ids are strings).
function TableUtil.sortedKeys(t: AnyTable?, comparator: ((a: any, b: any) -> boolean)?): { any }
	local out = TableUtil.keys(t)
	local compare = comparator
		or function(a: any, b: any): boolean
			local ta, tb = type(a), type(b)
			if ta ~= tb then
				return ta < tb
			end
			if ta == "number" or ta == "string" then
				return (a :: any) < (b :: any)
			end
			return tostring(a) < tostring(b)
		end
	table.sort(out, compare)
	return out
end

function TableUtil.isEmpty(t: AnyTable?): boolean
	if type(t) ~= "table" then
		return true
	end
	return next(t :: AnyTable) == nil
end

-- True for a contiguous 1..n integer-keyed table. An empty table counts as an array, which is what
-- callers merging/serialising state want.
function TableUtil.isArray(t: any): boolean
	if type(t) ~= "table" then
		return false
	end
	local length = #t
	local seen = 0
	for key in pairs(t) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > length then
			return false
		end
		seen += 1
	end
	return seen == length
end

function TableUtil.find<V>(list: { V }?, predicate: (value: V, index: number) -> boolean): (V?, number?)
	if type(list) ~= "table" or type(predicate) ~= "function" then
		return nil, nil
	end
	for index, value in ipairs(list :: { V }) do
		if predicate(value, index) then
			return value, index
		end
	end
	return nil, nil
end

function TableUtil.map<V, R>(list: { V }?, fn: (value: V, index: number) -> R): { R }
	local out: { R } = {}
	if type(list) ~= "table" or type(fn) ~= "function" then
		return out
	end
	for index, value in ipairs(list :: { V }) do
		out[index] = fn(value, index)
	end
	return out
end

function TableUtil.filter<V>(list: { V }?, fn: (value: V, index: number) -> boolean): { V }
	local out: { V } = {}
	if type(list) ~= "table" or type(fn) ~= "function" then
		return out
	end
	for index, value in ipairs(list :: { V }) do
		if fn(value, index) then
			table.insert(out, value)
		end
	end
	return out
end

function TableUtil.reduce<V, A>(list: { V }?, fn: (acc: A, value: V, index: number) -> A, init: A): A
	local acc = init
	if type(list) ~= "table" or type(fn) ~= "function" then
		return acc
	end
	for index, value in ipairs(list :: { V }) do
		acc = fn(acc, value, index)
	end
	return acc
end

-- Structural equality. Userdata (Color3/Vector3) compares with ==, which Roblox defines by value.
-- The `seen` pair-map makes cyclic inputs terminate: a pair already being compared is assumed equal
-- (standard co-inductive equality) rather than recursing forever.
local function deepEquals(a: any, b: any, seen: AnyTable): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end

	local pairsForA = seen[a]
	if pairsForA ~= nil and pairsForA[b] then
		return true
	end
	if pairsForA == nil then
		pairsForA = {}
		seen[a] = pairsForA
	end
	pairsForA[b] = true

	for key, value in pairs(a) do
		if not deepEquals(value, (b :: AnyTable)[key], seen) then
			return false
		end
	end
	for key in pairs(b) do
		if (a :: AnyTable)[key] == nil then
			return false
		end
	end
	return true
end

function TableUtil.deepEquals(a: any, b: any): boolean
	return deepEquals(a, b, {})
end

return TableUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Theme
    The visual identity of Sanctum of Embers in one place: the dark-slate + warm-ember UI palette,
    a colour/material set per Affinity, a colour/size/material set per Attunement Stage, and the
    blend rule that decides what the Conflux actually looks like right now.
    Pure data + one pure function: only Color3/Enum constructors, no services, no Instances.
    Owner: shared  |  Consumers: UiBuilder, HudController, PromptController, EvolutionFxController,
                                 PlotBuilder, EvolutionService
]]

export type AffinityTheme = {
	Primary: Color3,
	Secondary: Color3,
	Material: Enum.Material,
}

export type StageTheme = {
	Color: Color3,
	Size: number,
	Material: Enum.Material,
}

export type ConfluxAppearance = {
	Color: Color3,
	Size: number,
	Material: Enum.Material,
}

type Rgb = { number }

-- WHY raw RGB triples are kept alongside the Color3 values: getConfluxAppearance blends a stage
-- colour with an affinity colour, and doing that on plain numbers avoids reading Color3 components
-- (keeping this module to constructors only, exactly as the purity rule requires).
local STAGE_DEFS: { { Rgb: Rgb, Size: number, Material: Enum.Material } } = {
	-- 1 Mote: a timid spark. Small, pale, warm.
	{ Rgb = { 255, 196, 120 }, Size = 6.0, Material = Enum.Material.Neon },
	-- 2 Wisp: brighter and hungrier.
	{ Rgb = { 255, 158, 84 }, Size = 7.5, Material = Enum.Material.Neon },
	-- 3 Sprite: the stage where an Affinity is chosen, so the base colour is a strong ember.
	{ Rgb = { 255, 122, 58 }, Size = 9.0, Material = Enum.Material.Glass },
	-- 4 Elemental: the ember starts burning through into raw energy.
	{ Rgb = { 255, 92, 96 }, Size = 11.0, Material = Enum.Material.Neon },
	-- 5 Warden: arcane violet, visibly "not fire any more".
	{ Rgb = { 206, 120, 255 }, Size = 13.0, Material = Enum.Material.ForceField },
	-- 6 Primordial: near-white starlight; the transcendence-ready look.
	{ Rgb = { 255, 244, 222 }, Size = 16.0, Material = Enum.Material.Neon },
}

local AFFINITY_DEFS: { [string]: { Primary: Rgb, Secondary: Rgb, Material: Enum.Material } } = {
	-- Ember: aggressive orange, the "default" flavour of the sanctum.
	ember = { Primary = { 255, 112, 40 }, Secondary = { 122, 30, 12 }, Material = Enum.Material.Neon },
	-- Tide: deep water blue, glassy so it reads as liquid rather than flame.
	tide = { Primary = { 58, 168, 255 }, Secondary = { 14, 58, 122 }, Material = Enum.Material.Glass },
	-- Terra: mossy green over stone; the dense, heavy affinity.
	terra = { Primary = { 128, 198, 90 }, Secondary = { 58, 92, 44 }, Material = Enum.Material.Slate },
	-- Zephyr: pale cyan mist, ForceField so it looks barely-there and fast.
	zephyr = { Primary = { 168, 240, 236 }, Secondary = { 60, 120, 132 }, Material = Enum.Material.ForceField },
}

-- How strongly the chosen Affinity tints the Conflux. Below 0.5 on purpose: the stage progression
-- must still read at a glance, the affinity is a flavour on top of it.
local AFFINITY_TINT = 0.45

local function lerpChannel(a: number, b: number, alpha: number): number
	local blended = a + (b - a) * alpha
	return math.clamp(math.floor(blended + 0.5), 0, 255)
end

local Theme = {}

--[[ UI palette: dark slate panels so the glowing sanctum stays the brightest thing on screen, with
     a single warm ember accent used for anything actionable. ]]
Theme.Ui = {
	Background = Color3.fromRGB(12, 14, 20), -- behind everything / modal scrim base
	Panel = Color3.fromRGB(24, 28, 38), -- HUD + modal panel fill
	Accent = Color3.fromRGB(255, 138, 61), -- ember accent: buttons, progress fill, highlights
	Text = Color3.fromRGB(236, 240, 248), -- primary label colour
	Muted = Color3.fromRGB(138, 148, 168), -- secondary/disabled label colour
	Positive = Color3.fromRGB(92, 214, 137), -- success toasts, affordable prompts
	Negative = Color3.fromRGB(232, 86, 86), -- errors, unaffordable prompts
	Warning = Color3.fromRGB(245, 196, 84), -- vote timers, "are you sure" states
	Stroke = Color3.fromRGB(52, 60, 78), -- UIStroke colour for panels (extra, non-spec)
	Overlay = Color3.fromRGB(6, 7, 11), -- full-screen modal dim (extra, non-spec)
}

Theme.Affinity = {} :: { [string]: AffinityTheme }
for id, def in pairs(AFFINITY_DEFS) do
	Theme.Affinity[id] = {
		Primary = Color3.fromRGB(def.Primary[1], def.Primary[2], def.Primary[3]),
		Secondary = Color3.fromRGB(def.Secondary[1], def.Secondary[2], def.Secondary[3]),
		Material = def.Material,
	}
end

Theme.Stage = {} :: { StageTheme }
for index, def in ipairs(STAGE_DEFS) do
	Theme.Stage[index] = {
		Color = Color3.fromRGB(def.Rgb[1], def.Rgb[2], def.Rgb[3]),
		Size = def.Size,
		Material = def.Material,
	}
end

--[[ The one place that decides how the Conflux looks. Returns a FRESH table each call so callers
     (PlotBuilder / EvolutionService) can hand it around without risk of mutating the palette.
     Out-of-range or nan stages clamp to a valid stage; an unknown affinity id is treated as "none"
     rather than erroring, because it can arrive from an old save. ]]
function Theme.getConfluxAppearance(stage: number, affinity: string?): ConfluxAppearance
	local index = 1
	if type(stage) == "number" and stage == stage then
		index = math.clamp(math.floor(stage), 1, #STAGE_DEFS)
	end

	local stageDef = STAGE_DEFS[index]
	local stageTheme = Theme.Stage[index]

	local affinityDef = if type(affinity) == "string" then AFFINITY_DEFS[affinity] else nil
	if affinityDef == nil then
		return {
			Color = stageTheme.Color,
			Size = stageTheme.Size,
			Material = stageTheme.Material,
		}
	end

	local base, tint = stageDef.Rgb, affinityDef.Primary
	return {
		Color = Color3.fromRGB(
			lerpChannel(base[1], tint[1], AFFINITY_TINT),
			lerpChannel(base[2], tint[2], AFFINITY_TINT),
			lerpChannel(base[3], tint[3], AFFINITY_TINT)
		),
		Size = stageTheme.Size,
		-- The affinity owns the material once chosen: it is the clearest non-colour signal of which
		-- element a sanctum committed to.
		Material = affinityDef.Material,
	}
end

-- Freeze the palette tables (see GameConfig for the same reasoning): a stray write here would
-- desync every UI element built after it.
-- table.freeze ERRORS on an already-frozen table, and shared sub-tables (or a cycle) would hit the
-- same table twice, so isfrozen doubles as the visited-set here.
local function deepFreeze(t: { [any]: any }): { [any]: any }
	if table.isfrozen(t) then
		return t
	end
	table.freeze(t)
	for _, value in pairs(t) do
		if type(value) == "table" then
			deepFreeze(value :: { [any]: any })
		end
	end
	return t
end

deepFreeze(Theme.Ui)
deepFreeze(Theme.Affinity :: any)
deepFreeze(Theme.Stage :: any)
table.freeze(Theme)

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">UpgradeData</string>
          <string name="Source"><![CDATA[--!strict
--[[
    UpgradeData
    Static catalogue of the six Sanctum Upgrades. Each Upgrade is a levelled purchase whose `Kind`
    tells Economy which part of the pipeline it bends: Ley Rail travel time, Conflux Font yield,
    Wellspring spawn rate, live Mote capacity, or a flat global income multiplier. PURE data -- no
    services, no Instances -- so the pad text on the client and the debit on the server are computed
    from one identical table.
    Owner: shared  |  Consumers: Economy, PurchaseService, MoteSystem, DropperSystem, HudController
]]

--[[ BALANCE MODEL

    Economy treats PerLevel as a FRACTION for the four multiplicative Kinds (0.06 = +6% per level)
    and as a FLAT COUNT for MoteCapacity (10 = +10 live Motes per level). Fully levelled, the
    multiplicative stack is deliberately capped at roughly:
        GlobalIncome  1 + (15 * 0.04) + (20 * 0.06) = x2.80
        FontYield     1 + (12 * 0.05)               = x1.60
        SpawnRate     1 + (12 * 0.04)               = x1.48
        -> combined income ceiling ~x6.6
    That ceiling matters: Wellspring tiers already grow ~7x per Stage, so an uncapped upgrade stack
    would compress Stages 4-6 into a couple of minutes. x6.6 across a whole run is roughly "one free
    extra Stage", which is a satisfying reward without collapsing the curve.

    CostGrowth is HIGHER than the Wellspring curves (1.24..1.35 vs 1.12..1.18) on purpose: an Upgrade
    level is strictly better than an extra Wellspring at equal price because it scales the entire
    Sanctum, so it has to price itself out faster or nothing else would ever be bought.

    RailSpeed and MoteCapacity are quality-of-life rather than raw income -- they stop Motes queueing
    up at the cap during a Stage spike, which is where income is silently lost. They are cheap early
    for exactly that reason.
]]

export type UpgradeKind = "RailSpeed" | "FontYield" | "SpawnRate" | "MoteCapacity" | "GlobalIncome"

export type Upgrade = {
	Id: string,
	Name: string,
	Description: string,
	Kind: UpgradeKind,
	MaxLevel: number,
	BaseCost: number,
	CostGrowth: number, -- cost of the NEXT level = floor(BaseCost * CostGrowth ^ currentLevel)
	PerLevel: number, -- fraction for multiplicative Kinds, flat count for MoteCapacity
	RequiredStage: number,
	RequiredSection: string, -- Wing id whose pad hosts this Upgrade
	Order: number,
}

local UpgradeData = {}

UpgradeData.List = {
	{
		Id = "ley_flow", Name = "Ley Flow",
		Description = "Polishes the Ley Rails so Motes slide to the Font faster. Less time in transit, less income sitting still.",
		Kind = "RailSpeed", MaxLevel = 10, BaseCost = 500, CostGrowth = 1.30, PerLevel = 0.06,
		RequiredStage = 1, RequiredSection = "wing_core", Order = 1,
	},
	{
		Id = "font_resonance", Name = "Font Resonance",
		Description = "Tunes the Conflux Font to the Sanctum's key, so every Mote it swallows yields more Essence.",
		Kind = "FontYield", MaxLevel = 12, BaseCost = 900, CostGrowth = 1.28, PerLevel = 0.05,
		RequiredStage = 2, RequiredSection = "wing_core", Order = 2,
	},
	{
		Id = "wellspring_cadence", Name = "Wellspring Cadence",
		Description = "Shortens the pause between condensations. Every Wellspring in the Sanctum emits more often.",
		Kind = "SpawnRate", MaxLevel = 12, BaseCost = 2500, CostGrowth = 1.32, PerLevel = 0.04,
		RequiredStage = 2, RequiredSection = "wing_ember_forge", Order = 3,
	},
	{
		Id = "mote_lattice", Name = "Mote Lattice",
		Description = "Widens the rails so more Motes can ride at once. Raises the live cap by ten per level.",
		Kind = "MoteCapacity", MaxLevel = 8, BaseCost = 6000, CostGrowth = 1.35, PerLevel = 10,
		RequiredStage = 3, RequiredSection = "wing_ember_forge", Order = 4,
	},
	{
		Id = "conflux_attunement", Name = "Conflux Attunement",
		Description = "Teaches the Conflux to draw on the whole Sanctum at once. A flat boost to all Essence earned.",
		Kind = "GlobalIncome", MaxLevel = 15, BaseCost = 15000, CostGrowth = 1.26, PerLevel = 0.04,
		RequiredStage = 3, RequiredSection = "wing_tide_basin", Order = 5,
	},
	{
		Id = "primordial_echo", Name = "Primordial Echo",
		Description = "Late-run capstone: the Conflux remembers every Stage it has worn and echoes them all at once.",
		Kind = "GlobalIncome", MaxLevel = 20, BaseCost = 2500000, CostGrowth = 1.24, PerLevel = 0.06,
		RequiredStage = 5, RequiredSection = "wing_terra_vault", Order = 6,
	},
} :: { Upgrade }

table.sort(UpgradeData.List, function(a: Upgrade, b: Upgrade): boolean
	return a.Order < b.Order
end)

UpgradeData.ById = {} :: { [string]: Upgrade }
for _, def in ipairs(UpgradeData.List) do
	UpgradeData.ById[def.Id] = def
end

function UpgradeData.get(id: string): Upgrade?
	return UpgradeData.ById[id]
end

function UpgradeData.forStage(stage: number): { Upgrade }
	local out: { Upgrade } = {}
	for _, def in ipairs(UpgradeData.List) do
		if def.RequiredStage <= stage then
			table.insert(out, def)
		end
	end
	return out
end

-- Cost of buying level `currentLevel + 1`. Floored so the UI, the pad text and the debit can never
-- disagree by a fraction of an Essence. Returns math.huge at max level so `canAfford` is always
-- false there and no caller needs a special case.
function UpgradeData.levelCost(def: Upgrade, currentLevel: number): number
	if currentLevel >= def.MaxLevel then
		return math.huge
	end
	local level = math.max(0, math.floor(currentLevel))
	return math.floor(def.BaseCost * def.CostGrowth ^ level)
end

return UpgradeData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Validate</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Validate
    Defensive type/shape predicates. Everything crossing a trust boundary -- client remote payloads
    and DataStore reads -- passes through here first. Every function is total: it accepts ANY input
    (nil, userdata, functions, cyclic tables) and returns a value instead of erroring, because a
    thrown error inside a remote handler is itself a denial-of-service vector.
    Owner: shared  |  Consumers: RemoteSchema, RemoteService, StateSchema, ProfileService
]]

local Validate = {}

-- Accepted field kinds for Validate.payload shapes. A trailing "?" marks the field optional.
local KIND_CHECKS: { [string]: (value: any) -> boolean } = {}

function Validate.isNumber(v: any): boolean
	return type(v) == "number"
end

-- Rejects nan and +/-inf as well as non-numbers. Anything that reaches arithmetic on state must be
-- finite: nan poisons every comparison it touches (nan >= 0 is false, so clamps silently fail).
function Validate.isFiniteNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function Validate.isString(v: any): boolean
	return type(v) == "string"
end

function Validate.isBoolean(v: any): boolean
	return type(v) == "boolean"
end

function Validate.isTable(v: any): boolean
	return type(v) == "table"
end

-- Contiguous 1..n integer keys (an empty table qualifies).
function Validate.isArray(v: any): boolean
	if type(v) ~= "table" then
		return false
	end
	local length = #v
	local seen = 0
	for key in pairs(v) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > length then
			return false
		end
		seen += 1
	end
	return seen == length
end

-- Ids (dropper/upgrade/section/affinity) are word characters only: they end up in attribute names,
-- Instance names and DataStore payloads, so punctuation and spaces are rejected outright.
function Validate.isId(v: any): boolean
	if type(v) ~= "string" then
		return false
	end
	local length = #v
	if length < 1 or length > 64 then
		return false
	end
	return string.match(v, "^[%w_]+$") ~= nil
end

--[[ Returns a guaranteed-finite number inside [min, max]. Non-numbers, nan and inf collapse to
     `default` (itself clamped), so callers can use the result without a second check. ]]
function Validate.clampNumber(v: any, min: number, max: number, default: number): number
	local low = if Validate.isFiniteNumber(min) then min else -math.huge
	local high = if Validate.isFiniteNumber(max) then max else math.huge
	if low > high then
		low, high = high, low -- tolerate swapped bounds instead of erroring inside math.clamp
	end

	local fallback = if Validate.isFiniteNumber(default) then default else 0
	fallback = math.max(low, math.min(high, fallback))

	if not Validate.isFiniteNumber(v) then
		return fallback
	end
	return math.max(low, math.min(high, v :: number))
end

-- `set` is used as a lookup table (e.g. AffinityData.ById), so membership is `set[v] ~= nil`.
function Validate.stringOneOf(v: any, set: { [string]: any }): boolean
	if type(v) ~= "string" or type(set) ~= "table" then
		return false
	end
	return (set :: { [string]: any })[v] ~= nil
end

KIND_CHECKS["number"] = Validate.isFiniteNumber
KIND_CHECKS["string"] = Validate.isString
KIND_CHECKS["boolean"] = Validate.isBoolean
KIND_CHECKS["id"] = Validate.isId
KIND_CHECKS["table"] = Validate.isTable

--[[ Exact shape check for remote payloads.
     shape = { Accept = "boolean", Affinity = "id", Data = "table?" }
     Rules: every required field present and of the right kind, and NO unexpected extra keys -- an
     attacker padding a payload with junk must be rejected, not silently trimmed. An empty shape
     means "no payload": nil or an empty table. ]]
local function checkPayload(value: any, shape: any): (boolean, string?)
	if type(shape) ~= "table" then
		return false, "invalid shape"
	end

	local expected = 0
	for _ in pairs(shape) do
		expected += 1
	end

	if expected == 0 then
		if value == nil then
			return true, nil
		end
		if type(value) ~= "table" or next(value) ~= nil then
			return false, "expected no payload"
		end
		return true, nil
	end

	if type(value) ~= "table" then
		return false, "expected a table payload"
	end

	for field, kind in pairs(shape) do
		if type(field) ~= "string" then
			return false, "invalid shape key"
		end
		if type(kind) ~= "string" then
			return false, "invalid shape kind for " .. field
		end

		local optional = string.sub(kind, -1) == "?"
		local baseKind = if optional then string.sub(kind, 1, -2) else kind
		local check = KIND_CHECKS[baseKind]
		if check == nil then
			return false, "unknown shape kind '" .. baseKind .. "'"
		end

		local given = (value :: { [string]: any })[field]
		if given == nil then
			if not optional then
				return false, "missing field '" .. field .. "'"
			end
		elseif not check(given) then
			return false, "field '" .. field .. "' expected " .. baseKind
		end
	end

	-- Reject extras. Iterating only the top level keeps this O(fields) and cycle-proof.
	for field in pairs(value :: { [any]: any }) do
		if type(field) ~= "string" or (shape :: { [string]: any })[field] == nil then
			return false, "unexpected field '" .. tostring(field) .. "'"
		end
	end

	return true, nil
end

function Validate.payload(value: any, shape: any): (boolean, string?)
	-- pcall is the belt to checkPayload's braces: even a pathological input (protected metatable,
	-- __index that errors) can only ever produce `false` here, never an error out of a remote.
	local ok, result, reason = pcall(checkPayload, value, shape)
	if not ok then
		return false, "payload rejected"
	end
	return result == true, reason
end

return Validate
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="21">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">Core</string>
      </Properties>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Bootstrap
	The server's entry point and its ONLY wiring: it requires every service module, registers each
	with a ServiceRegistry in dependency order, runs the two boot phases (Init, then Start) and binds
	shutdown to StopAll. It contains no gameplay logic at all -- everything a service needs it gets
	from the registry, so this file stays the one place the boot order is written down.

	The whole boot runs inside a pcall and a failure is refused rather than absorbed: a server that
	came up with, say, PlotService live and EconomyService missing would take real players' sessions
	and mirror broken state into their saves. A server that refuses to start loses one session; a
	server that boots half a game loses accounts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local Core = script.Parent
local ServiceRegistry = require(Core:WaitForChild("ServiceRegistry"))
local Services = Core:WaitForChild("Services")

--[[ REGISTRATION ORDER IS DEPENDENCY ORDER (spec section 6). Registry:InitAll and :StartAll walk
     this list forwards and :StopAll walks it backwards, so every service is constructed after the
     peers it resolves and torn down before them.

       RateLimiter        nothing
       RemoteService      RateLimiter
       DataStoreWrapper   nothing
       ProfileService     DataStoreWrapper
       EconomyService     ProfileService
       PlotService        ProfileService, EconomyService, RemoteService  (+ PurchaseService, lazily)
       PurchaseService    EconomyService, PlotService, RemoteService
       EvolutionService   PlotService, EconomyService, RemoteService
       RebirthService     PlotService, EconomyService, ProfileService, RemoteService
       LeaderboardService PlotService, ProfileService
       StateReplicator    PlotService, ProfileService, RemoteService, EconomyService

     PlotService is the one forward reference: it needs PurchaseService to build pads, which needs
     PlotService's Sanctums to build them on. That cycle is broken with registry:TryGet inside
     PlotService rather than by reordering, because the pads cannot exist before the plots do. ]]
local ORDER = {
	"RateLimiter",
	"RemoteService",
	"DataStoreWrapper",
	"ProfileService",
	"EconomyService",
	"PlotService",
	"PurchaseService",
	"EvolutionService",
	"RebirthService",
	"LeaderboardService",
	"StateReplicator",
}

local registry = ServiceRegistry.new()

--[[ Names the step that was in flight when something threw. ServiceRegistry's own error already
     lists which service failed Init or Start, but a module that errors at REQUIRE time (a bad
     upvalue, a missing sibling) never reaches the registry at all -- and without this the log would
     show only a stack inside that module with nothing to say which service it belonged to. ]]
local stage = "startup"

local function boot(): ()
	for _, name in ipairs(ORDER) do
		stage = ("require %s"):format(name)
		-- WaitForChild, not FindFirstChild: under Rojo the Services folder streams in as its own
		-- instances, and a nil here would read as "this service does not exist" rather than
		-- "it has not replicated yet".
		local service = require(Services:WaitForChild(name)) :: any
		stage = ("register %s"):format(name)
		registry:Register(name, service)
	end
	--[[ Two phases, never one. Init resolves peers and allocates state, Start connects events and
	     opens loops, so by the time any Start runs EVERY service exists and is initialised -- which
	     is what removes the circular-require problem without a dependency-injection framework. ]]
	stage = "InitAll"
	registry:InitAll()
	stage = "StartAll"
	registry:StartAll()
	stage = "running"
end

local startedAt = os.clock()
local ok, err = pcall(boot)

--[[ Bound AFTER the boot attempt, so ProfileService's own BindToClose (registered during its Start)
     is registered first and its shutdown SaveAll runs before StopAll tears its peers down. Bound
     even on failure: whatever did start still deserves an orderly teardown, and StopAll pcalls every
     Stop, so a service that never finished Init cannot throw out of the shutdown path. ]]
game:BindToClose(function()
	registry:StopAll()
end)

if ok then
	-- One line, and it is the line a live-server operator reads first: what came up, how long it
	-- took, how big the world is, and whether the build is in a debug mode that changes balance.
	print(
		("[Bootstrap] Sanctum of Embers online -- %d services in %.0fms | %d sanctums x %d slots | FastMode=%s Debug=%s | %s"):format(
			#ORDER,
			(os.clock() - startedAt) * 1000,
			GameConfig.Plot.SanctumCount,
			GameConfig.Plot.SlotsPerSanctum,
			tostring(GameConfig.Debug.FastMode),
			tostring(GameConfig.Debug.Enabled),
			table.concat(ORDER, " -> ")
		)
	)
else
	-- Loud and unmissable. The banner exists because this line lands in a log full of ordinary
	-- warnings, and "which service" is the only question worth answering at 3am.
	warn("==================================================================")
	warn(("[Bootstrap] BOOT FAILED during: %s"):format(stage))
	warn(("[Bootstrap] %s"):format(tostring(err)))
	warn("[Bootstrap] The server is NOT running the game. No sanctum will be claimed and no")
	warn("[Bootstrap] profile will be written -- which is deliberate: a half-booted server would")
	warn("[Bootstrap] mirror broken state into real players' saves.")
	warn("==================================================================")
	--[[ Re-raised last, once the warnings are out and BindToClose is bound. Roblox's error telemetry
	     reports errors, not warnings, so without this a broken deploy is invisible on the dashboard;
	     and raising from the entry point is the closest thing available to refusing to start. ]]
	error(("Bootstrap failed during %s: %s"):format(stage, tostring(err)), 0)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ServiceRegistry</string>
          <string name="Source"><![CDATA[--!strict
--[[
    ServiceRegistry
    The server's dependency container and boot orchestrator. Services register themselves by name in
    Bootstrap and are then driven through three ordered phases: Init (resolve peers, build state),
    Start (connect events, start loops) and Stop (tear down, in reverse). Splitting Init from Start
    is what lets two services depend on each other without a circular require -- Init may only store
    references, so by the time any Start runs every peer already exists and is initialised.
    Owner: server  |  Consumers: Bootstrap.server.luau and every module under src/server/Services
]]

-- A service is a plain table (spec section 6) and the registry deliberately knows nothing about what
-- is inside one, so every lifecycle method is optional and resolved dynamically at call time.
type Service = { [string]: any }

local Registry = {}
Registry.__index = Registry

type Registry = typeof(setmetatable(
	{} :: {
		_services: { [string]: Service },
		_order: { string }, -- registration order IS boot order; StopAll walks it backwards
		_initialised: boolean,
		_started: boolean,
		_stopped: boolean,
	},
	Registry
))

-- Rendered into every "missing service" error, so the fix is visible without opening Bootstrap.
local function describe(self: Registry): string
	if #self._order == 0 then
		return "<nothing registered>"
	end
	return table.concat(self._order, ", ")
end

--[[ Runs one lifecycle method across `names`, in the order given, and returns the failures.
     Every call is pcall'd because the alternative -- letting the first broken service throw --
     hides every later failure behind it, turning a boot into a whack-a-mole restart loop. One run
     should report everything that is wrong. ]]
local function runPhase(self: Registry, methodName: string, names: { string }, argument: any): { string }
	local failures: { string } = {}

	for _, name in ipairs(names) do
		local service = self._services[name]
		local method = service[methodName]

		if type(method) == "function" then
			local ok, err = pcall(method, service, argument)
			if not ok then
				local detail = string.format("%s:%s() -> %s", name, methodName, tostring(err))
				warn("[ServiceRegistry] " .. detail)
				table.insert(failures, detail)
			end
		elseif method ~= nil then
			-- A non-function Init/Start is always a typo (`Service.Start = true`), never intent.
			-- Silently skipping it would leave the service permanently unstarted.
			local detail = string.format("%s.%s is a %s, not a function", name, methodName, typeof(method))
			warn("[ServiceRegistry] " .. detail)
			table.insert(failures, detail)
		end
	end

	return failures
end

local function raiseIfFailed(phase: string, failures: { string }): ()
	if #failures == 0 then
		return
	end
	-- Re-raised AFTER every service has been given its chance: a half-booted server (a live
	-- PlotService with no EconomyService behind it) corrupts saves, which is strictly worse than a
	-- server that refuses to start. Level 0 because the useful position is in the list, not here.
	local list = table.concat(failures, "\n  ")
	error(string.format("ServiceRegistry:%s failed for %d service(s):\n  %s", phase, #failures, list), 0)
end

function Registry.new(): Registry
	return setmetatable({
		_services = {},
		_order = {},
		_initialised = false,
		_started = false,
		_stopped = false,
	}, Registry)
end

--[[ Registration order is the boot order, so this call site is also where a service declares its
     position in the dependency chain. ]]
function Registry.Register(self: Registry, name: string, service: any): ()
	if type(name) ~= "string" or name == "" then
		-- An empty or non-string name registers a service that nothing can ever Get back.
		error("ServiceRegistry:Register expects a non-empty string name, got " .. typeof(name), 2)
	end
	if type(service) ~= "table" then
		error(string.format("ServiceRegistry:Register('%s') expects a table, got %s", name, typeof(service)), 2)
	end
	if self._services[name] ~= nil then
		-- Overwriting would leave the first copy in _order and already wired into whichever peers
		-- resolved it, so two live instances of one service would run side by side forever.
		error(string.format("ServiceRegistry: '%s' is already registered", name), 2)
	end
	if self._initialised then
		-- A late registration never receives Init or Start, so its state stays nil and the mistake
		-- surfaces much later as an unrelated nil index in gameplay code. Fail at the cause.
		error(string.format("ServiceRegistry: cannot register '%s' after InitAll", name), 2)
	end

	-- Service.Name is cosmetic (it only appears in logs), so a mismatch warns rather than stops --
	-- but it almost always means a service module was copy-pasted and its Name left behind.
	local declared = (service :: Service).Name
	if type(declared) == "string" and declared ~= name then
		warn(string.format("[ServiceRegistry] registered '%s' but it declares Name = '%s'", name, declared))
	end

	self._services[name] = service
	table.insert(self._order, name)
end

--[[ Errors instead of returning nil: a mistyped dependency name would otherwise surface as a nil
     index deep inside gameplay code, minutes after boot and nowhere near the typo. ]]
function Registry.Get(self: Registry, name: string): any
	local service = if type(name) == "string" then self._services[name] else nil
	if service == nil then
		error(
			string.format(
				"ServiceRegistry: no service named '%s'. Registered (in boot order): %s",
				tostring(name),
				describe(self)
			),
			2
		)
	end
	return service
end

--[[ The nil-tolerant twin, for genuinely optional peers (a service that enhances another when it is
     present). Never use it to paper over a missing required dependency -- that is what Get is for,
     and swallowing that mistake is exactly what Get's error message exists to prevent. ]]
function Registry.TryGet(self: Registry, name: string): any?
	if type(name) ~= "string" then
		return nil
	end
	return self._services[name]
end

--[[ A second InitAll is refused, not absorbed. Init allocates state and resolves peers, so it is
     not idempotent for most services -- a silent no-op would hide a genuine Bootstrap bug, and
     re-running would hand every service a second copy of its own state. Nothing is re-run either
     way; the error is what makes the mistake visible. ]]
function Registry.InitAll(self: Registry): ()
	if self._initialised then
		error("ServiceRegistry:InitAll called twice -- Init is not idempotent for most services", 2)
	end
	-- Flagged BEFORE the phase runs: if a service throws, a retry would re-Init everything that
	-- already succeeded, which is the double-Init this flag exists to prevent.
	self._initialised = true

	raiseIfFailed("InitAll", runPhase(self, "Init", self._order, self))
end

function Registry.StartAll(self: Registry): ()
	if not self._initialised then
		-- Not the same case as a double call: Start may talk to peers, and a peer that never ran
		-- Init has nil state. A phase ordering mistake in Bootstrap must be loud.
		error("ServiceRegistry:StartAll called before InitAll", 2)
	end
	if self._started then
		-- Start connects events and opens loops; a replay would double-wire every one of them.
		error("ServiceRegistry:StartAll called twice -- Start connects events and would double-wire", 2)
	end
	self._started = true

	raiseIfFailed("StartAll", runPhase(self, "Start", self._order, nil))
end

--[[ Reverse order, so a service is stopped before anything it depends on: the last-registered (most
     dependent) service gets its chance to flush while its peers are still alive.
     Unlike Init/Start this never re-raises. StopAll runs from BindToClose, where throwing would
     abort whatever the caller still has to do -- ProfileService's final SaveAll runs from the same
     shutdown path, and losing player data to a tidy error report is a bad trade. ]]
function Registry.StopAll(self: Registry): ()
	if self._stopped then
		-- Shutdown is racy: BindToClose and an explicit teardown can both reach here. A second call
		-- is a no-op rather than an error, because erroring during shutdown helps nobody.
		return
	end
	self._stopped = true

	local reversed: { string } = {}
	for index = #self._order, 1, -1 do
		table.insert(reversed, self._order[index])
	end

	runPhase(self, "Stop", reversed, nil)
end

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">DataStoreWrapper</string>
            <string name="Source"><![CDATA[--!strict
--[[
    DataStoreWrapper
    The single choke point for every DataStore call the server makes. It memoises store handles,
    waits for request budget, retries transient failures on a jittered exponential backoff and
    classifies everything else as fatal -- and it NEVER throws: each entry point answers
    (ok, valueOrError) so a DataStore outage cannot escape into a PlayerRemoving handler or a
    BindToClose save and take the rest of the shutdown down with it.
    Owner: server/Services  |  Consumers: ProfileService (and any future service that persists data)
]]

local DataStoreService = game:GetService("DataStoreService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

-- A GlobalDataStore handle. Kept opaque: the harness supplies a stand-in with the same four
-- methods, and pinning a Roblox-only type here would make this module unloadable headlessly.
type Store = any

type Counters = {
	Attempts: number, -- individual DataStore calls issued
	FailedAttempts: number, -- calls that threw, transient or fatal
	Failures: number, -- OPERATIONS that ran out of retries and returned false
	Retries: number, -- backoff sleeps taken, i.e. attempts beyond the first
	BudgetWaits: number, -- polls spent waiting for request budget to refill
}

local BACKOFF: { number } = GameConfig.Save.RetryBackoff -- { 1, 2, 4, 8, 16 }
local JITTER: number = GameConfig.Save.RetryJitter -- +/-20%
local DEFAULT_MAX_ATTEMPTS = 5

-- Poll rather than sleep the whole budget: Roblox refills continuously. The CAP is the important
-- half -- a permanently starved budget must not park a shutdown save forever, so past it the
-- attempt is spent anyway and the call fails honestly, still inside BindToClose's 30s kill.
local BUDGET_POLL_SECONDS = 0.5
local MAX_BUDGET_WAIT_SECONDS = 4

-- Roblox rejects keys over 50 UTF-8 bytes with a fatal error; catching it here costs no request.
local MAX_KEY_LENGTH = 50

-- Substrings (case-insensitive, plain -- not Lua patterns) marking a failure worth retrying.
-- Everything else -- an unserialisable value, a size limit, a bug in a caller's transform -- is
-- deterministic: five attempts fail five times and burn budget the OTHER players' saves need.
local TRANSIENT_PATTERNS = {
	"throttl", -- "Number of requests exceeded limit" family
	"timeout",
	"request was queued", -- Roblox's own "please retry" wording
	"internal", -- "InternalError" / "internal server error"
	"502",
	"503",
	"temporarily",
	-- A bare "request failed" with no further detail is the generic transport-level error Roblox
	-- reports for a dropped HTTP call to the DataStore backend; that is transient by definition.
	"request failed",
}

local REQUEST_GET = Enum.DataStoreRequestType.GetAsync
-- SetAsync, IncrementAsync and RemoveAsync all draw from the same SetIncrementAsync pool.
local REQUEST_SET = Enum.DataStoreRequestType.SetIncrementAsync
local REQUEST_UPDATE = Enum.DataStoreRequestType.UpdateAsync

local Service = {}
Service.Name = "DataStoreWrapper"

-- Attempts and FailedAttempts count individual round trips; Failures counts OPERATIONS that ran
-- out of retries and returned false. Failures is the number worth alerting on -- a server that
-- retried 400 times and never lost a save is healthy, one with a single Failure is not.
Service.Stats = {
	Attempts = 0,
	FailedAttempts = 0,
	Failures = 0,
	Retries = 0,
	BudgetWaits = 0,
} :: Counters

Service.MaxAttempts = DEFAULT_MAX_ATTEMPTS

local stores: { [string]: Store } = {}
-- Own RNG so jitter never perturbs the global math.random sequence other systems (mote paths,
-- autosave jitter) draw from, which would make their tests non-reproducible.
local rng = Random.new(os.time())
local warnedStoreFailure = false

local function isTransient(err: any): boolean
	if type(err) ~= "string" then
		-- A thrown table (only reachable through a caller's UpdateAsync transform) carries no
		-- message to classify. Retrying a deterministic bug 5x helps nobody, so: fatal.
		return false
	end
	local lowered = string.lower(err)
	for _, needle in ipairs(TRANSIENT_PATTERNS) do
		if string.find(lowered, needle, 1, true) ~= nil then
			return true
		end
	end
	return false
end

-- Delay AFTER attempt `attempt`, jittered so a server full of players whose saves failed on the
-- same outage does not stampede the backend in lockstep on every retry.
local function backoffFor(attempt: number): number
	local base = BACKOFF[math.min(attempt, #BACKOFF)] or 1
	local spread = base * JITTER
	return math.max(base + rng:NextNumber(-spread, spread), 0)
end

-- Returns the total seconds spent waiting so far, so the cap applies to the whole operation
-- rather than resetting on every attempt.
local function awaitBudget(requestType: any, alreadySpent: number): number
	local spent = alreadySpent
	while spent < MAX_BUDGET_WAIT_SECONDS do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(requestType)
		end)
		-- If the budget API itself is unavailable we proceed blind: a missing forecast is not a
		-- reason to refuse to save, and the call below will report the real error if there is one.
		if not ok or type(budget) ~= "number" or budget > 0 then
			return spent
		end
		Service.Stats.BudgetWaits += 1
		task.wait(BUDGET_POLL_SECONDS)
		spent += BUDGET_POLL_SECONDS
	end
	return spent
end

local function perform(requestType: any, call: () -> any): (boolean, any)
	local stats = Service.Stats
	local maxAttempts = math.max(Service.MaxAttempts, 1)
	local budgetSpent = 0
	local lastError: any = "DataStoreWrapper: no attempt was made"

	for attempt = 1, maxAttempts do
		budgetSpent = awaitBudget(requestType, budgetSpent)
		stats.Attempts += 1
		local ok, result = pcall(call)
		if ok then
			return true, result
		end
		stats.FailedAttempts += 1
		lastError = result
		if not isTransient(result) then
			stats.Failures += 1
			return false, result
		end
		-- No sleep after the final attempt: the caller is already out of retries and, on a
		-- shutdown path, every second of it is stolen from the next player's save.
		if attempt < maxAttempts then
			stats.Retries += 1
			task.wait(backoffFor(attempt))
		end
	end

	stats.Failures += 1
	return false, lastError
end

-- One guard for all four entry points: resolve the handle (a store NAME is accepted too, so a
-- caller holding only the configured name need not memoise it itself) and reject a key Roblox
-- would fatally refuse -- catching that here costs no request budget.
local function prepare(store: Store, key: any): (Store, string?)
	local ds = if type(store) == "string" then Service:GetStore(store) else store
	if ds == nil then
		return nil, "DataStoreWrapper: no datastore handle"
	end
	if type(key) ~= "string" or #key == 0 then
		return nil, "DataStoreWrapper: key must be a non-empty string"
	end
	if #key > MAX_KEY_LENGTH then
		return nil, ("DataStoreWrapper: key exceeds %d characters"):format(MAX_KEY_LENGTH)
	end
	return ds
end

--[[ Public API ]]

-- Memoised: DataStoreService:GetDataStore allocates a fresh handle per call, and ProfileService
-- asks for the same store on every join, save and release.
function Service:GetStore(name: string?): Store
	local storeName = if type(name) == "string" and #name > 0 then name else GameConfig.Save.DataStoreName
	local cached = stores[storeName]
	if cached ~= nil then
		return cached
	end
	-- GetDataStore throws in Studio without API access, and in a place where DataStores are
	-- disabled. Returning nil (instead of propagating) keeps that failure inside the (ok, err)
	-- contract below, where ProfileService already knows how to fall back to a no-save profile.
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(storeName)
	end)
	if not ok or store == nil then
		if not warnedStoreFailure then
			warnedStoreFailure = true -- once per server: this fails identically on every call
			warn(("[DataStoreWrapper] GetDataStore(%q) failed: %s"):format(storeName, tostring(store)))
		end
		return nil
	end
	stores[storeName] = store
	return store
end

function Service:Get(store: Store, key: string): (boolean, any)
	local ds, err = prepare(store, key)
	if ds == nil then
		return false, err
	end
	return perform(REQUEST_GET, function()
		return ds:GetAsync(key)
	end)
end

function Service:Set(store: Store, key: string, value: any): (boolean, any)
	local ds, err = prepare(store, key)
	if ds == nil then
		return false, err
	end
	if value == nil then
		-- SetAsync(nil) is a fatal error in Roblox; callers that mean "delete" want :Remove.
		return false, "DataStoreWrapper: value must not be nil (use :Remove)"
	end
	return perform(REQUEST_SET, function()
		return ds:SetAsync(key, value)
	end)
end

-- The transform runs once per ATTEMPT, so callers must keep it idempotent and free of side
-- effects outside the value it returns.
function Service:Update(store: Store, key: string, transform: (any) -> any): (boolean, any)
	local ds, err = prepare(store, key)
	if ds == nil then
		return false, err
	end
	if type(transform) ~= "function" then
		return false, "DataStoreWrapper: transform must be a function"
	end
	return perform(REQUEST_UPDATE, function()
		return ds:UpdateAsync(key, transform)
	end)
end

function Service:Remove(store: Store, key: string): (boolean, any)
	local ds, err = prepare(store, key)
	if ds == nil then
		return false, err
	end
	return perform(REQUEST_SET, function()
		return ds:RemoveAsync(key)
	end)
end

-- Lower this on the shutdown path. BindToClose has a HARD 30s budget (the server is killed
-- regardless of what the handler is doing) and the full 5-attempt schedule sleeps 15s for ONE key,
-- so a server full of failing saves needs a shorter schedule, not a longer wait.
function Service:SetMaxAttempts(n: number): ()
	if type(n) ~= "number" or n ~= n then -- n ~= n catches NaN, which would make math.clamp lie
		return
	end
	Service.MaxAttempts = math.clamp(math.floor(n), 1, #BACKOFF + 1)
end

-- A copy: callers (tests, telemetry) must not be able to reset the live counters by writing to
-- the table they were handed.
function Service:GetStats(): Counters
	local stats = Service.Stats
	return {
		Attempts = stats.Attempts,
		FailedAttempts = stats.FailedAttempts,
		Failures = stats.Failures,
		Retries = stats.Retries,
		BudgetWaits = stats.BudgetWaits,
	}
end

-- Dev/test affordance: zero the counters between cases without replacing the table itself, since
-- `perform` closes over Service.Stats.
function Service:ResetStats(): ()
	local stats = Service.Stats
	stats.Attempts = 0
	stats.FailedAttempts = 0
	stats.Failures = 0
	stats.Retries = 0
	stats.BudgetWaits = 0
end

-- ServiceRegistry contract. This service owns no events and no loops: it is a pure helper with a
-- cache, so there is nothing to wire up or tear down.
function Service:Init(_registry: any): ()
	Service.MaxAttempts = DEFAULT_MAX_ATTEMPTS
end

function Service:Start(): () end

function Service:Stop(): ()
	-- Drop handles so a rebuilt registry (the harness restarts the server between specs) does not
	-- hand out stores captured from a torn-down DataStoreService.
	stores = {}
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyService
	The ONLY writer of PlotState.Essence in the whole game. Every other service asks it: motes credit
	through Credit, pads and attunements spend through TryDebit, and nothing else is allowed to touch
	the shared wallet. It also owns the per-Sanctum Multipliers CACHE -- Economy.getMultipliers walks
	every upgrade in the catalogue and this runs inside the one income Heartbeat, so the result is
	computed on change (RefreshMultipliers) rather than on read. Every method is total: it runs in
	that shared loop, where one error would stop income for every Sanctum on the server.
	Owner: server/Services  |  Consumers: PlotService, PurchaseService, EvolutionService,
	                                      RebirthService, StateReplicator, LeaderboardService
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Economy = require(Modules:WaitForChild("Economy"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

type Multipliers = Economy.Multipliers
--[[ Every public method takes the Sanctum as `any` rather than a named type. Two reasons: PlotService
     owns the real Sanctum type and resolves THIS service through the registry, so naming it here
     would be a require cycle; and the argument is untrusted anyway -- it is validated at runtime by
     stateOf, which is what lets the harness drive these methods with a plain table. Only State,
     Occupants and Dirty are ever touched. ]]
type Occupant = { [string]: any }

local function isFinite(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local MAX_CURRENCY = StateSchema.MAX_CURRENCY
--[[ Dust floor. A credit smaller than this is arithmetic noise -- a rounding remainder, or a corrupt
     def yielding 1e-300 -- and adding it to a wallet held as a double changes nothing while still
     costing a dirty flag and a replication tick every frame. GameConfig owns the number; the guard
     is here because a hand-edited config must never turn the floor into NaN (which rejects every
     credit) or into a large number (which would silently swallow real income). ]]
local CONFIGURED_FLOOR = GameConfig.Income.MinCredit
local MIN_CREDIT = math.clamp(if isFinite(CONFIGURED_FLOOR) then CONFIGURED_FLOOR else 0.0001, 0, 1)
local EMPTY: { [string]: any } = {}
-- No occupants resolved => no prestige bonus. Shared and never written to.
local NO_REBIRTHS: { number } = {}

local Service = {}
Service.Name = "EconomyService"

local profiles: any = nil -- ProfileService, resolved in Init (registered before this service)
local plots: any = nil -- PlotService, resolved LAZILY: it is registered AFTER this service
local registryRef: any = nil
-- Fires at most once per boot: the clamp below can only engage on a balance bug, and a warning per
-- mote would bury the one line that matters under thousands of copies.
local clampWarned = false

-- Every currency read passes through here: NaN/inf/nil/string all collapse to 0, and a stored value
-- above the ceiling (a corrupt save) is repaired on the spot rather than propagated into a write.
local function currency(v: any): number
	return if isFinite(v) then math.clamp(v :: number, 0, MAX_CURRENCY) else 0
end

--[[ The one gate every public method opens with. A nil, non-table or State-less Sanctum returns nil
     and the caller no-ops: PlotService drives all six Sanctums from ONE Heartbeat, so erroring on a
     half-released plot would take income down for every player on the server, not just that one. ]]
local function stateOf(sanctum: any): { [string]: any }?
	if type(sanctum) ~= "table" then return nil end
	local state = (sanctum :: { [string]: any }).State
	return if type(state) == "table" then state :: { [string]: any } else nil
end

--[[ Occupants is keyed by UserId in PlotService, but this walks it with `pairs` and reads each entry
     structurally, so a differently-keyed table (or one holding a nil-ed slot mid-release) iterates
     correctly instead of erroring. ]]
local function eachOccupant(sanctum: any, fn: (Occupant) -> ()): ()
	local list = (sanctum :: { [string]: any }).Occupants
	if type(list) ~= "table" then return end
	for _, entry in pairs(list :: { [any]: any }) do
		if type(entry) == "table" then fn(entry :: Occupant) end
	end
end

-- pcall'd: a Player is userdata, and reading a field off one that has already left can throw. A
-- failed read simply means "cannot identify this player", never a crash inside the income loop.
local function userIdOf(player: any): number?
	if player == nil then return nil end
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and isFinite(id) then id :: number else nil
end

-- Identity by object first, UserId second: the object compare is what matches under Roblox, the
-- UserId compare is what matches a rejoined Player instance or a harness table.
local function isSource(occupant: Occupant, player: any, userId: number?): boolean
	if player == nil then return false end
	if occupant.Player == player then return true end
	return userId ~= nil and occupant.UserId == userId
end

--[[ Dirty is set on the Sanctum FIRST, so the flag survives even when PlotService is not resolvable
     yet (boot order) -- StateReplicator reads the field, not the call. The peer call is what fires
     SanctumChanged for anyone listening. ]]
local function markDirty(sanctum: any): ()
	(sanctum :: { [string]: any }).Dirty = true
	-- TryGet, never Get: PlotService is legitimately absent during Init and in unit tests, where Get
	-- would ERROR by design. The type check covers a stub registry (the harness passes a table with
	-- only Get) -- calling a nil TryGet would throw from inside the income loop.
	if plots == nil and type(registryRef) == "table" and type(registryRef.TryGet) == "function" then
		plots = registryRef:TryGet("PlotService")
	end
	if plots ~= nil and type(plots.MarkDirty) == "function" then
		plots:MarkDirty(sanctum)
	end
end

-- Weak KEYS so a Sanctum that PlotService has released is not pinned alive by its cached
-- multipliers; the entry disappears with the plot instead of leaking for the life of the server.
local function newCache(): { [any]: Multipliers }
	return (setmetatable({}, { __mode = "k" }) :: any) :: { [any]: Multipliers }
end
local cache: { [any]: Multipliers } = newCache()

--[[ The prestige half of the multiplier stack lives in per-player Profiles, not in PlotState, so it
     is gathered here per refresh. A missing profile contributes nothing rather than defaulting to
     something: a player whose profile failed to load must not silently earn a stranger's bonus. ]]
local function rebirthsOf(sanctum: any): { number }
	if profiles == nil then return NO_REBIRTHS end
	local list: { number } = {}
	eachOccupant(sanctum, function(occupant: Occupant)
		local player = occupant.Player
		if player == nil then return end
		local profile = profiles:Get(player)
		local prestige = if type(profile) == "table" then (profile :: any).Prestige else nil
		if type(prestige) == "table" then
			-- Raw: Economy.getPrestigeMultiplier clamps to RebirthData.MaxTrackedRebirths itself, so
			-- a tampered count is capped in exactly one place.
			table.insert(list, if isFinite(prestige.Rebirths) then prestige.Rebirths else 0)
		end
	end)
	return list
end

--[[ Public API ]]

--[[ Recompute and cache. MUST be called after any stage, affinity, upgrade or occupancy change --
     those are the four inputs to Economy.getMultipliers, and a stale cache would pay the old rate
     until something else happened to invalidate it. ]]
function Service:RefreshMultipliers(sanctum: any): Multipliers
	local state = stateOf(sanctum)
	if state == nil then
		-- A corrupt Sanctum still gets legal, neutral multipliers (Economy defaults every field) so
		-- the caller can multiply by them; nothing is cached against a key we could not validate.
		return Economy.getMultipliers(EMPTY :: any, NO_REBIRTHS)
	end
	local multipliers = Economy.getMultipliers(state :: any, rebirthsOf(sanctum))
	-- Frozen because the table is SHARED with every reader until the next refresh: a consumer
	-- adjusting one field in place would silently retune income for the whole Sanctum.
	cache[sanctum] = table.freeze(multipliers)
	return multipliers
end

-- Lazy read. The cache miss path is the same recompute, so a caller never has to know whether
-- anything has refreshed this Sanctum yet.
function Service:GetMultipliers(sanctum: any): Multipliers
	if type(sanctum) == "table" then
		local cached = cache[sanctum]
		if cached ~= nil then return cached end
	end
	return Service:RefreshMultipliers(sanctum)
end

--[[ The only way Essence enters the world. Returns the amount actually credited, which is 0 for
     every rejected call, so a caller can log or account for the difference.
     `amount` is already fully multiplied by the caller (MoteSystem values a mote through
     Economy.getMoteValue) -- this function applies no multipliers of its own. ]]
function Service:Credit(sanctum: any, amount: number, sourcePlayer: Player?): number
	local state = stateOf(sanctum)
	if state == nil then return 0 end
	-- `not isFinite` first: every comparison against NaN is false, so an unguarded `amount <= 0`
	-- would pass NaN straight through and poison the wallet permanently.
	if not isFinite(amount) or amount < MIN_CREDIT then return 0 end

	local wallet = currency(state.Essence)
	--[[ Ceiling clamp. MAX_CURRENCY (1e15) sits below 2^53, the last exactly-representable integer:
	     past it a shared wallet stops being exact and additions silently round away. Reaching it in
	     play is impossible, so the clamp engaging means a runaway multiplier -- worth exactly one
	     loud line, and worth surviving rather than storing an inf that would destroy the save. ]]
	local credited = math.min(amount, MAX_CURRENCY - wallet)
	if credited < amount and not clampWarned then
		clampWarned = true
		warn(("[EconomyService] essence clamped at %g -- a multiplier has run away"):format(MAX_CURRENCY))
	end
	if credited <= 0 then return 0 end

	state.Essence = wallet + credited
	-- LifetimeEssence is the transcendence gate and resets with the Sanctum, so it tracks what was
	-- actually banked, not what was offered: the clamped figure keeps the two in step.
	state.LifetimeEssence = math.min(currency(state.LifetimeEssence) + credited, MAX_CURRENCY)

	local sourceId = userIdOf(sourcePlayer)
	eachOccupant(sanctum, function(occupant: Occupant)
		-- Lifetime stat, per player, never reset: BOTH occupants earn from a shared wallet, so both
		-- profiles are credited in full rather than splitting one payout between them.
		local player = occupant.Player
		local profile = if player ~= nil and profiles ~= nil then profiles:Get(player) else nil
		local stats = if type(profile) == "table" then (profile :: any).Stats else nil
		if type(stats) == "table" then
			stats.TotalEssenceEarned = math.min(currency(stats.TotalEssenceEarned) + credited, MAX_CURRENCY)
		end
		if isSource(occupant, sourcePlayer, sourceId) then
			occupant.Contribution = math.min(currency(occupant.Contribution) + credited, MAX_CURRENCY)
		end
	end)

	markDirty(sanctum)
	return credited
end

--[[ The only way Essence leaves the world. Atomic in the sense that matters here: the balance is
     re-read from live state and tested INSIDE this call, so a price checked by PurchaseService a
     moment ago cannot be spent twice by two pads triggered on the same frame. Nothing is mutated on
     a failed debit, and Essence can never go negative. ]]
function Service:TryDebit(sanctum: any, amount: number): boolean
	local state = stateOf(sanctum)
	if state == nil then return false end
	-- NaN, inf (a maxed upgrade's cost) and negative "refunds" are all rejected here
	if not isFinite(amount) or amount < 0 then return false end
	-- Economy.canAfford, not a local comparison: the pad's affordability check and this debit must
	-- agree exactly, or a purchase can pass the gate and then fail to pay for itself.
	if not Economy.canAfford(state :: any, amount) then return false end
	if amount <= 0 then
		return true -- a free item (a FastMode-discounted cost that floored to 0): nothing to move
	end
	-- currency() re-clamps as it reads, so a corrupt balance ABOVE the ceiling is repaired by the
	-- same statement that spends from it rather than being carried forward into the next save.
	state.Essence = math.max(0, currency(state.Essence) - amount)
	markDirty(sanctum)
	return true
end

--[[ Session-only leaderboard flavour (spec 1.2): it records who carried, and touches NO wallet.
     Contribution lives on the Occupant, not in PlotState, so it is never saved and never merged. ]]
function Service:AddContribution(sanctum: any, player: any, amount: number): ()
	if stateOf(sanctum) == nil or not isFinite(amount) or amount <= 0 then return end
	local userId = userIdOf(player)
	eachOccupant(sanctum, function(occupant: Occupant)
		if isSource(occupant, player, userId) then
			occupant.Contribution = math.min(currency(occupant.Contribution) + amount, MAX_CURRENCY)
			markDirty(sanctum) -- Contribution rides the full snapshot; the partner panel reads it
		end
	end)
end

--[[ ServiceRegistry contract ]]

function Service:Init(registry: any): ()
	registryRef = registry
	profiles = registry:Get("ProfileService") -- resolved only: section 6 forbids calls during Init
	--[[ PlotService is registered AFTER this service, so it does not exist yet. It is resolved
	     lazily in markDirty instead -- Get here would error and abort the whole boot. ]]
	plots = nil
	-- Rebuilt so a re-Init never serves multipliers cached against a previous boot's Sanctums.
	cache = newCache()
	clampWarned = false
end

function Service:Start(): ()
	-- Nothing to connect: this service is entirely driven by its callers. The cache is invalidated
	-- by whoever changes an input (PlotService on occupancy, EvolutionService on stage/affinity,
	-- PurchaseService on an upgrade, RebirthService on prestige), which is the only correct moment.
end

function Service:Stop(): ()
	cache = newCache()
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">EvolutionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EvolutionService
	The Attunement authority. It decides whether a Sanctum may take its next Stage, spends the Essence
	for it, advances the Stage by exactly one step, repaints the Conflux, re-applies both occupants'
	walk speed, and owns the permanent Stage 3 Affinity choice. It is the ONLY writer of
	PlotState.Stage and PlotState.Affinity, and every gate it opens is re-read from the LIVE state at
	the moment of the change: a client's copy, a pad's wording and a check made one frame ago are all
	hints, never permission.
	Owner: server/Services  |  Consumers: PurchaseService (the attunement pad), RebirthService (which
	                                      re-applies Stage 1 visuals after a reset), tests
]]
--[[ WHAT "unlock the Stage's UnlockedSections" MEANS, and why nothing priced is granted here. The
     manifest is the same kind as UnlockedDroppers/UnlockedUpgrades: it names what the Stage makes
     REACHABLE, not what it hands over -- a new tier of Wellsprings is bought, and so is a Wing.
     SectionData prices all four (2.5K -> 15M) around the loop "attune -> buy the Wing -> fill it ->
     attune again" and each Wing's RequiredStage IS the Stage listing it, so granting one here would
     make PurchaseService:PurchaseSection answer `already_owned` forever (four pads nobody could ever
     use) and delete ~15.7M Essence from a curve the owner confirmed final (spec 9.5 item 3). A Stage
     therefore OPENS its sections (Economy.sectionStatus does that from RequiredStage) and only a
     free one is granted outright; Wing visibility is then re-asserted from ownership. ]]

local Players = game:GetService("Players")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local AffinityData = require(Modules:WaitForChild("AffinityData"))
local Economy = require(Modules:WaitForChild("Economy"))
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local SectionData = require(Modules:WaitForChild("SectionData"))
local Theme = require(Modules:WaitForChild("Theme"))

local PlotBuilder = require(script.Parent.Parent:WaitForChild("Systems"):WaitForChild("PlotBuilder"))

-- Sanctum is `any` throughout: PlotService owns the real type and resolves THIS service through the
-- registry, so naming it would be a require cycle -- and the argument is untrusted anyway, which is
-- what lets the headless harness drive these methods with a plain table.
type Connection = { Disconnect: (self: any) -> () }

local Service = {}
Service.Name = "EvolutionService"

-- Closed set (DECISIONS #11): the client maps a code to wording, and a gate never returns prose.
-- Economy owns most of these; the two added here are about WHO is asking.
local Reason = {
	UnknownSanctum = "unknown_sanctum", -- not a table, or carrying no PlotState
	NoPlayer = "no_player", -- not an occupant, so not entitled to spend this Sanctum's wallet
	Ok = Economy.Reason.Ok, Insufficient = Economy.Reason.Insufficient,
	MaxStage = Economy.Reason.MaxStage, NeedStage = Economy.Reason.NeedStage,
	UnknownId = Economy.Reason.UnknownId, AlreadyOwned = Economy.Reason.AlreadyOwned,
}
Service.Reason = Reason

local plots: any, economy: any, remotes: any, registryRef: any = nil, nil, nil, nil
local purchases: any = nil -- registered AFTER this service; resolved lazily in refreshPads
local connections: { Connection } = {}
-- userId -> respawn watch, keyed by id so a rejoin replaces its own entry instead of leaking one.
local watched: { [number]: Connection } = {}

local function stateOf(sanctum: any): { [string]: any }?
	local state = if type(sanctum) == "table" then (sanctum :: { [string]: any }).State else nil
	return if type(state) == "table" then state :: { [string]: any } else nil
end

-- Clamped exactly as Economy clamps it, so "never skip a Stage, never pass MaxStage" holds even for
-- a stored Stage of 0, 9e99 or NaN.
local function stageOf(state: { [string]: any }): number
	local raw = state.Stage
	return math.clamp(math.floor(if type(raw) == "number" and raw == raw then raw else 1), 1, EvolutionData.MaxStage)
end

-- pcall'd: a Player is userdata and reading a field off one who has already left can throw.
local function userIdOf(player: any): number?
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and type(id) == "number" and id == id then id else nil
end

-- THE authorisation check for every mutation below. Occupants is keyed by UserId in PlotService,
-- but a direct hit is not assumed: a fixture (or a table caught mid-release) may be keyed otherwise,
-- so a structural sweep matches it rather than erroring inside a remote handler.
local function occupantOf(sanctum: any, player: any): boolean
	local userId, list = userIdOf(player), (sanctum :: { [string]: any }).Occupants
	if userId == nil or type(list) ~= "table" then return false end
	if type((list :: { [any]: any })[userId]) == "table" then return true end
	for _, entry in pairs(list :: { [any]: any }) do
		if type(entry) == "table" and (entry.Player == player or entry.UserId == userId) then return true end
	end
	return false
end

local function occupantsOf(sanctum: any): { Player }
	return if plots ~= nil then plots:GetOccupants(sanctum) else {}
end

-- PlotService's accessor first: it proves the Sanctum is one of ours before handing over its
-- Instance tree. A fixture is not, so the field is the fallback; every PlotBuilder entry point used
-- below is total against a malformed runtime.
local function runtimeOf(sanctum: any): any
	local runtime = if plots ~= nil then plots:GetSanctumRuntime(sanctum) else nil
	return if runtime ~= nil then runtime else (sanctum :: { [string]: any }).Runtime
end

-- A Stage change re-prices and re-opens pads, so signs must be redrawn. TryGet, never Get:
-- PurchaseService is registered AFTER this service and Get errors by design.
local function refreshPads(sanctum: any): ()
	if purchases == nil and registryRef ~= nil then purchases = registryRef:TryGet("PurchaseService") end
	if purchases ~= nil and type(purchases.RefreshPads) == "function" then purchases:RefreshPads(sanctum) end
end

-- MOCK-EXTRA: Humanoid.WalkSpeed assignment -- 3.1 lists Humanoid as read-only, and this is the one
-- write the Stage curve needs. Wrapped whole: a character mid-respawn is a Model whose Humanoid has
-- not been parented yet, which is normal and not worth an error inside the signal a death fires.
local function applySpeed(player: any, speed: number): ()
	pcall(function()
		local character = (player :: any).Character
		local humanoid = if character ~= nil then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid ~= nil then humanoid.WalkSpeed = speed end
	end)
end

local function unwatch(userId: number?): ()
	local existing = if userId ~= nil then watched[userId] else nil
	if existing ~= nil then existing:Disconnect() end
	if userId ~= nil then watched[userId] = nil end
end
local function disconnectAll(): ()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	for userId in pairs(watched) do unwatch(userId) end
end

function Service:CanAttune(sanctum: any): (boolean, string)
	local state = stateOf(sanctum)
	if state == nil then return false, Reason.UnknownSanctum end
	return Economy.attuneStatus(state :: any)
end

-- The Conflux's look follows (Stage, Affinity); every Wing's presence follows ownership. Both are
-- re-asserted rather than diffed -- a handful of writes on a rare event, and re-asserting REPAIRS a
-- Sanctum whose visuals drifted (a link merge that added a Wing, a reset that took four away).
function Service:ApplyStageVisuals(sanctum: any): ()
	local state = stateOf(sanctum)
	local runtime = if state ~= nil then runtimeOf(sanctum) else nil
	if state == nil or runtime == nil then return end

	local affinity = if type(state.Affinity) == "string" then state.Affinity :: string else nil
	PlotBuilder.setConfluxAppearance(runtime, Theme.getConfluxAppearance(stageOf(state), affinity))
	local owned = if type(state.Sections) == "table" then state.Sections :: { [string]: any } else nil
	for _, section in ipairs(SectionData.List) do
		local visible = section.Id == SectionData.Base or (owned ~= nil and owned[section.Id] == true)
		PlotBuilder.setSectionVisible(runtime, section.Id, visible)
	end
end

-- Walk speed is a Stage + Affinity property of the SANCTUM, applied to whoever stands in it now --
-- including a partner who linked in at Stage 6 and has never attuned anything themselves.
function Service:ApplyStageStats(sanctum: any): ()
	local state = stateOf(sanctum)
	if state == nil then return end
	local speed = Economy.getWalkSpeed(state :: any)
	for _, player in ipairs(occupantsOf(sanctum)) do applySpeed(player, speed) end
end

-- Spend the next Stage's RequiredEssence and take exactly one step up. Debit BEFORE mutating:
-- TryDebit re-reads the wallet and is atomic against a second pad triggered on the same frame, so
-- two occupants hammering the attunement pad together cannot buy one Stage twice or skip one.
function Service:Attune(player: any, sanctum: any): (boolean, string)
	local state = stateOf(sanctum)
	if state == nil then return false, Reason.UnknownSanctum end
	-- Re-checked from live occupancy even though the pad stands inside the Sanctum: a prompt can be
	-- triggered by anyone who can reach it, and reaching it is not the same as owning the wallet.
	if not occupantOf(sanctum, player) then return false, Reason.NoPlayer end
	local allowed, reason = Economy.attuneStatus(state :: any)
	if not allowed then return false, reason end

	-- attuneStatus already refuses the top Stage; nextStage is re-derived because the debit below
	-- reads RequiredEssence off that very table.
	local nextStage = EvolutionData.next(stageOf(state))
	if nextStage == nil then return false, Reason.MaxStage end
	-- A failed debit is only reachable when another spend landed between the gate and here. The
	-- Stage is NOT advanced: a free Attunement is far worse than a wasted prompt.
	if economy == nil or not economy:TryDebit(sanctum, nextStage.RequiredEssence) then
		return false, Reason.Insufficient
	end
	state.Stage = nextStage.Index
	if type(state.Sections) ~= "table" then state.Sections = {} end
	local sections = state.Sections :: { [string]: any }
	for _, id in ipairs(nextStage.UnlockedSections) do
		local def = SectionData.get(id) -- free sections only; see the note at the top of this file
		if def ~= nil and def.Cost <= 0 then sections[id] = true end
	end
	-- The Stage multiplier feeds every Mote's value, so the cache is rebuilt before the next tick.
	if economy ~= nil then economy:RefreshMultipliers(sanctum) end
	Service:ApplyStageVisuals(sanctum)
	Service:ApplyStageStats(sanctum)
	if plots ~= nil then plots:MarkDirty(sanctum) end
	refreshPads(sanctum)

	if remotes ~= nil then
		local to, id = occupantsOf(sanctum), (sanctum :: { [string]: any }).Id
		remotes:FireClients(to, "Fx", { Kind = "attune", Data = { Stage = nextStage.Index },
			PlotId = if type(id) == "number" then id else 0 })
		remotes:FireClients(to, "Notify", { Kind = "success",
			Text = string.format("Attuned to Stage %d -- %s.", nextStage.Index, nextStage.Title) })
	end
	return true, Reason.Ok
end

-- The Stage 3 elemental choice (spec 9.5 item 4). ONE Affinity per Sanctum, not one each: either
-- occupant may make it and it binds both until the next Transcendence. Refusals are ordered
-- most-permanent-first, so the client says "already chosen" rather than "wrong stage".
function Service:ChooseAffinity(player: any, sanctum: any, affinityId: any): (boolean, string)
	local state = stateOf(sanctum)
	if state == nil then return false, Reason.UnknownSanctum end
	if not occupantOf(sanctum, player) then return false, Reason.NoPlayer end
	-- RemoteSchema already rejects anything outside the catalogue at the wire; checked again because
	-- a pad path and a spec both reach this function without passing through that validator.
	if not AffinityData.isValid(affinityId) then return false, Reason.UnknownId end
	if AffinityData.isValid(state.Affinity) then return false, Reason.AlreadyOwned end
	if stageOf(state) < EvolutionData.AffinityUnlockStage then return false, Reason.NeedStage end

	state.Affinity = affinityId :: string
	-- One choice moves IncomeMultiplier, SpawnRate, MoteValue, RailSpeed and WalkSpeed at once, so
	-- the cache, the Conflux material and both characters all follow it in the same breath.
	if economy ~= nil then economy:RefreshMultipliers(sanctum) end
	Service:ApplyStageVisuals(sanctum)
	Service:ApplyStageStats(sanctum)
	if plots ~= nil then plots:MarkDirty(sanctum) end
	local def = AffinityData.get(affinityId :: string)
	if remotes ~= nil then
		remotes:FireClients(occupantsOf(sanctum), "Notify", { Kind = "success", Text = string.format(
			"The Conflux binds to %s. This lasts until you Transcend.", (def :: any).Name) })
	end
	return true, Reason.Ok
end

-- Respawn handling. Without it a death resets a Stage 6 player to 16 studs/s on a 200x200 stud
-- Sanctum, permanently, because nothing else ever re-writes WalkSpeed.
-- MOCK-EXTRA: Player.CharacterAdded.
local function watch(player: any): ()
	local userId = userIdOf(player)
	if userId == nil or watched[userId] ~= nil then return end
	local ok, connection = pcall(function(): any
		return (player :: any).CharacterAdded:Connect(function()
			-- Re-read the Sanctum instead of capturing it: by the time a respawn lands, this player
			-- may have left the plot or linked into another one at a different Stage.
			local sanctum = if plots ~= nil then plots:GetSanctumForPlayer(player) else nil
			if sanctum ~= nil then Service:ApplyStageStats(sanctum) end
		end)
	end)
	if ok and connection ~= nil then watched[userId] = connection end
end

function Service:Init(registry: any): () -- ServiceRegistry contract; resolve peers only
	registryRef = registry
	-- Resolved only: section 6 forbids cross-service calls during Init.
	plots = registry:Get("PlotService")
	economy = registry:Get("EconomyService")
	remotes = registry:Get("RemoteService")
	purchases = nil -- registered after this service; resolved lazily in refreshPads
	-- A re-Init must not inherit the previous boot's connections: they would keep writing WalkSpeed
	-- from a discarded registry's view of the world.
	disconnectAll()
end

function Service:Start(): ()
	if remotes ~= nil then
		-- The payload names an element and nothing else: the Sanctum comes from the sender's live
		-- occupancy, so nobody can bind an element in a plot they are not standing in.
		remotes:On("ChooseAffinity", function(player: Player, payload: any)
			local sanctum = if plots ~= nil then plots:GetSanctumForPlayer(player) else nil
			if sanctum == nil then return end
			local id = if type(payload) == "table" then (payload :: any).Affinity else nil
			-- One line and no code on refusal: a refused choice is either a stale modal or a probe,
			-- and naming the gate that closed only helps the second.
			if not Service:ChooseAffinity(player, sanctum, id) then
				remotes:FireClient(player, "Notify", { Kind = "warn",
					Text = "The Conflux will not bind to that right now." })
			end
		end)
	end
	-- A partner linking into a Stage 6 Sanctum inherits its speed at once; a fresh claimer is put
	-- back to 16 rather than keeping the speed of the plot they left.
	if plots ~= nil then
		table.insert(connections, plots.OccupantAdded:Connect(function(sanctum: any)
			Service:ApplyStageStats(sanctum)
		end))
	end
	table.insert(connections, Players.PlayerAdded:Connect(watch))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		unwatch(userIdOf(player))
	end))
	for _, player in ipairs(Players:GetPlayers()) do watch(player) end -- joined before Start
end

function Service:Stop(): ()
	disconnectAll()
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardService
	Owns the `leaderstats` folder Roblox reads to draw the in-game player list: Essence (the floor of
	the Sanctum's SHARED wallet, so both occupants show the same figure), Rebirths (per player, from
	their Profile's Prestige) and Contributed (that occupant's session share of what the pair earned).
	It only ever READS -- no gate, no purchase and no save depends on anything here, so a stale or
	missing leaderstat is a cosmetic bug and never a gameplay one.
	Kept in sync from PlotService's signals (throttled: SanctumChanged fires on every income tick) and
	a slow sweep that catches anything no signal announced.
	Owner: server/Services  |  Consumers: Bootstrap (registration), the Roblox player list
]]

local Players = game:GetService("Players")

-- Spec section 3.1: a connection is anything with :Disconnect(). Structural, so this behaves the
-- same under Roblox's RBXScriptConnection and under the headless mock.
type Connection = { Disconnect: (self: any) -> () }
type Entry = { Folder: any, Essence: any, Rebirths: any, Contributed: any }

local FOLDER_NAME = "leaderstats" -- the exact name Roblox looks for; anything else shows nothing
local STAT_NAMES = { "Essence", "Rebirths", "Contributed" } -- display order in the player list

--[[ THE CLAMP THAT MUST NOT BE REMOVED. An IntValue is a SIGNED 32-BIT integer: assigning
     2147483648 does not error and does not saturate -- it WRAPS, and the player list shows a large
     NEGATIVE balance. This is not a theoretical edge. StateSchema caps a wallet at MAX_CURRENCY =
     1e15, six orders of magnitude past 2^31-1, and the late-game income curve reaches nine figures
     long before Stage 6, so a real session WILL cross it. Clamping shows a pinned 2,147,483,647
     instead: wrong, but monotonically wrong in the direction a player expects, and the HUD (which
     reads the snapshot, not this) still shows the true figure.
     A NumberValue would hold the real number, but Roblox renders leaderstats through the IntValue
     path players recognise, and spec section 6 names IntValue. ]]
local INT32_MAX = 2147483647
local INT32_MIN = -2147483648

--[[ Cadences. SIGNAL_INTERVAL throttles the signal-driven refresh because PlotService coalesces
     SanctumChanged to once per INCOME tick -- ten times a second per Sanctum -- and an IntValue
     write replicates to every client in the server. SWEEP_SECONDS is the backstop for the values no
     signal covers (a rebirth granted while the plot sat still, a contribution that moved without a
     state change), so the board can be at most this stale, never permanently wrong. ]]
local SIGNAL_INTERVAL = 0.5
local SWEEP_SECONDS = 5

local Service = {}
Service.Name = "LeaderboardService"

local plots: any, profiles: any = nil, nil
local connections: { Connection } = {}
local entries: { [any]: Entry } = {}
local running, generation = false, 0

--[[ Sanctum -> os.clock() of its last signal-driven refresh. WEAK KEYS: PlotService rebuilds its
     Sanctums on a re-Init, and a strong key would pin every discarded one alive for the life of the
     server. ]]
local function newThrottle(): { [any]: number }
	return (setmetatable({}, { __mode = "k" }) :: any) :: { [any]: number }
end
local lastRefresh: { [any]: number } = newThrottle()

-- `Parent ~= Players` is the O(1) "still in the server" test (engine and mock both unparent on
-- PlayerRemoving). The typeof/IsA pair in front makes it total, since a signal can hand this a
-- plain table from the harness or a nil from a half-released Sanctum.
local function isLivePlayer(player: any): boolean
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

-- pcall'd: a Player is userdata, and reading a field off one who has already left can throw.
local function userIdOf(player: any): number?
	if player == nil then return nil end
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and type(id) == "number" and id == id then id else nil
end

-- Every value written to an IntValue passes through here. NaN is tested FIRST: every comparison
-- against it is false, so math.clamp would pass it straight through to the wrapping assignment.
local function toInt32(value: any): number
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	-- math.floor(inf) is still inf, which clamp then pins to the ceiling -- deliberate, and the
	-- reason the floor happens before the clamp rather than after.
	return math.clamp(math.floor(value), INT32_MIN, INT32_MAX)
end

-- Written only when it actually changes: an IntValue assignment replicates to every client in the
-- server, and the sweep alone would otherwise send three unchanged numbers per player per cycle.
local function assign(target: any, value: any): ()
	local clamped = toInt32(value)
	if target ~= nil and target.Value ~= clamped then
		target.Value = clamped
	end
end

--[[ `parent`'s IntValue of this name, created only if absent. A wrong-class squatter is destroyed:
     leaving, say, a StringValue named "Essence" in place would make that column render as text and
     every later assign would throw. ]]
local function ensureValue(parent: any, name: string): any
	local existing = parent:FindFirstChild(name)
	if existing ~= nil then
		if existing:IsA("IntValue") then
			return existing
		end
		existing:Destroy()
	end
	local created = Instance.new("IntValue")
	created.Name = name
	created.Value = 0
	created.Parent = parent
	return created
end

--[[ The player's leaderstats, built on first use. Idempotent by design -- it is called from four
     signals and the sweep, and any of them can be the first to reach a given player. ]]
local function ensureStats(player: any): Entry?
	if not isLivePlayer(player) then
		-- A folder parented to a departed Player is never seen by anyone and would keep the Player
		-- (and its character) referenced by our entry table.
		return nil
	end
	local cached = entries[player]
	if cached ~= nil and cached.Folder.Parent == player then
		return cached
	end
	local folder = player:FindFirstChild(FOLDER_NAME)
	if folder ~= nil and not folder:IsA("Folder") then
		folder:Destroy() -- Roblox reads only a Folder here; anything else silently shows no stats
		folder = nil
	end
	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
	end
	local entry: Entry = {
		Folder = folder,
		Essence = ensureValue(folder, STAT_NAMES[1]),
		Rebirths = ensureValue(folder, STAT_NAMES[2]),
		Contributed = ensureValue(folder, STAT_NAMES[3]),
	}
	-- Parented LAST, so the player list can only ever see a folder that already has all three
	-- columns in it rather than popping them in one at a time.
	folder.Parent = player
	entries[player] = entry
	return entry
end

--[[ Public API ]]

--[[ Re-reads one player's three numbers from live state. Total: a player with no Sanctum shows
     zeroes rather than the last plot they were in, which is the honest reading while they are
     between plots (their real progress is in their Profile, not on the board). ]]
function Service:Refresh(player: any): ()
	local entry = ensureStats(player)
	if entry == nil then
		return
	end
	local essence, contributed = 0, 0
	local sanctum = if plots ~= nil then plots:GetSanctumForPlayer(player) else nil
	if type(sanctum) == "table" then
		local state = (sanctum :: { [string]: any }).State
		if type(state) == "table" then
			essence = (state :: { [string]: any }).Essence
		end
		-- Occupants is keyed by UserId; read structurally so a half-released Sanctum (an entry
		-- nil-ed mid-removal) is simply "no contribution" instead of an error.
		local occupants = (sanctum :: { [string]: any }).Occupants
		local userId = userIdOf(player)
		local occupant = if type(occupants) == "table" and userId ~= nil then occupants[userId] else nil
		if type(occupant) == "table" then
			contributed = (occupant :: { [string]: any }).Contribution
		end
	end
	-- Prestige is per player and NEVER merged (§1.5), so it comes from the Profile, not the Sanctum.
	local profile = if profiles ~= nil then profiles:Get(player) else nil
	local prestige = if type(profile) == "table" then (profile :: { [string]: any }).Prestige else nil
	local rebirths = if type(prestige) == "table" then (prestige :: { [string]: any }).Rebirths else 0

	assign(entry.Essence, essence)
	assign(entry.Rebirths, rebirths)
	assign(entry.Contributed, contributed)
end

-- Every occupant of one Sanctum. `force` skips the throttle, for the structural signals (someone
-- joined or left) where a half-second-late board would be visibly wrong.
function Service:RefreshSanctum(sanctum: any, force: boolean?): ()
	if plots == nil or type(sanctum) ~= "table" then
		return
	end
	if force ~= true then
		local last = lastRefresh[sanctum]
		-- os.clock is monotonic: a wall-clock correction cannot stall this throttle or open it early.
		if last ~= nil and os.clock() - last < SIGNAL_INTERVAL then
			return
		end
	end
	lastRefresh[sanctum] = os.clock()
	for _, player in ipairs(plots:GetOccupants(sanctum)) do
		Service:Refresh(player)
	end
end

function Service:RefreshAll(): ()
	for _, player in ipairs(Players:GetPlayers()) do
		--[[ pcall'd per player: this runs on a timer nothing supervises, so one player in a strange
		     state (mid-release, character gone) must not stop the others being updated -- and an
		     error escaping here would kill the sweep thread for the rest of the server's life. ]]
		local ok, err = pcall(Service.Refresh, Service, player)
		if not ok then
			warn(("[LeaderboardService] refresh failed: %s"):format(tostring(err)))
		end
	end
end

--[[ ServiceRegistry contract ]]

function Service:Init(registry: any): ()
	-- Resolved only: section 6 forbids cross-service calls during Init. Both are registered before
	-- this service, so a missing one is a Bootstrap bug worth erroring on.
	plots = registry:Get("PlotService")
	profiles = registry:Get("ProfileService")
	-- A re-Init must not inherit the previous boot's connections or entries: the connections would
	-- keep firing into a discarded table, and the entries would point at Players from a dead run.
	Service:Stop()
	entries = {}
	lastRefresh = newThrottle()
end

function Service:Start(): ()
	running = true
	--[[ The board exists from the moment the player joins, before their Profile has loaded: an empty
	     row reads as "loading", whereas no row at all reads as a broken game. ]]
	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		ensureStats(player)
	end))
	--[[ Without this, `entries` keeps one Entry per departed player forever -- and because a Player
	     instance is a strong key, each leaked entry also pins that Player and its character. The
	     folder itself needs no cleanup: it is a child of the Player and leaves with them. ]]
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		entries[player] = nil
	end))
	-- Rebirths is only knowable once the Profile is in memory.
	table.insert(connections, profiles.ProfileLoaded:Connect(function(player: Player)
		Service:Refresh(player)
	end))
	--[[ Occupancy changed, so BOTH occupants' rows are wrong at once: the newcomer's Essence column
	     has to switch to the shared wallet, and the partner's contribution share changes with them.
	     Forced past the throttle -- this is the one moment a stale board is obvious. ]]
	table.insert(connections, plots.OccupantAdded:Connect(function(sanctum: any, player: Player)
		Service:Refresh(player)
		Service:RefreshSanctum(sanctum, true)
	end))
	table.insert(connections, plots.OccupantRemoved:Connect(function(sanctum: any, player: Player)
		Service:Refresh(player) -- they have no Sanctum now, so their row zeroes out
		Service:RefreshSanctum(sanctum, true)
	end))
	-- The income signal. Throttled: PlotService coalesces it to once per income tick, which is ten
	-- times a second per Sanctum.
	table.insert(connections, plots.SanctumChanged:Connect(function(sanctum: any)
		Service:RefreshSanctum(sanctum, false)
	end))

	--[[ The slow sweep. A generation token, not just `running`, is what stops a Stop/Start cycle (or
	     a re-Init in the harness) leaving two loops writing to the same IntValues at twice the rate:
	     the older thread finds a changed generation at its next wake and exits. ]]
	generation += 1
	local mine = generation
	task.spawn(function()
		while running and generation == mine do
			task.wait(SWEEP_SECONDS)
			-- Re-checked after the park: the service may have stopped while this thread slept.
			if not running or generation ~= mine then
				break
			end
			Service:RefreshAll()
		end
	end)
end

function Service:Stop(): ()
	running = false -- the sweep thread exits at its next wake
	generation += 1
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	-- The leaderstats folders are deliberately LEFT STANDING: they belong to the Players, and
	-- destroying them on a soft restart would blank every player's row for no reason.
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PlotLinkController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlotLinkController
	The offer book behind PlotService:RequestLink / :ResolveLink. It holds at most one outstanding
	LinkOffer per Sanctum, pushes it to the occupants whose consent is required, expires it after
	GameConfig.Plot.LinkConfirmSeconds, and hands an accepted offer back to its owner so the
	max-merge can happen there. It owns no occupancy and no PlotState: every gate that depends on who
	is actually in a Sanctum is PlotService's, checked once before the offer goes out and again when
	it lands, because up to thirty seconds of world can happen in between.
	Owner: server/Services  |  Consumers: PlotService (which owns exactly one of these)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

type Offer = { PlotId: number, Joiner: any, JoinerId: number, ExpiresAt: number, Token: number }
-- Remotes is RemoteService and OnAccepted is PlotService's merge step. Both are optional so a spec
-- can drive the offer book with plain tables and no server standing behind it.
type Deps = { Remotes: any?, OnAccepted: ((sanctum: any, joiner: any) -> ())? }

local PlotLinkController = {}

--[[ CLOSED SET, exactly like Economy's gate reasons (DECISIONS #11): the client owns the wording,
     and a free-text reason handed back through the link pad is free reconnaissance for whoever is
     probing it. ]]
local Reason = {
	Ok = "ok",
	OfferPending = "offer_pending", -- someone else is already asking to join that Sanctum
	NoRecipient = "no_recipient", -- nobody is there to consent
	NoOffer = "no_offer", -- an answer with nothing behind it: stale, or forged
	SelfOffer = "self_offer", -- the joiner tried to approve their own request
	Declined = "declined",
}
PlotLinkController.Reason = Reason

local Controller = {}
Controller.__index = Controller

type ControllerSelf = {
	_offers: { [number]: Offer }, -- keyed by PlotId: one open offer per Sanctum, never more
	_remotes: any,
	_onAccepted: (sanctum: any, joiner: any) -> (),
	_token: number, -- monotonic; identifies WHICH offer an expiry closure belongs to
}
type Controller = typeof(setmetatable({} :: ControllerSelf, Controller))

-- pcall'd because a Player is userdata and reading a field off one who has already disconnected can
-- throw. This runs on the path a remote reaches, where an escaping error is a free denial of service.
local function userIdOf(player: any): number
	local ok, id = pcall(function(): any
		return (player :: any).UserId
	end)
	return if ok and type(id) == "number" and id == id then id else 0
end

local function nameOf(player: any): string
	local ok, name = pcall(function(): any
		return (player :: any).Name
	end)
	return if ok and type(name) == "string" and #name > 0 then name else "A wanderer"
end

function PlotLinkController.new(deps: Deps): Controller
	local given: Deps = if type(deps) == "table" then deps else {}
	return setmetatable({
		_offers = {},
		_remotes = given.Remotes,
		-- A no-op default keeps every call site total: a controller built without an owner still
		-- expires and declines correctly, it simply has nowhere to hand an acceptance.
		_onAccepted = given.OnAccepted or function() end,
		_token = 0,
	}, Controller)
end

function Controller._notify(self: Controller, player: any, kind: string, text: string): ()
	if self._remotes == nil then
		return
	end
	self._remotes:FireClient(player, "Notify", { Kind = kind, Text = text })
end

--[[ Opens an offer and pushes it to `recipients`. PlotService has already established that the
     joiner is unattached, that the Sanctum has a free slot and that the joiner's Profile is loaded;
     everything left is bookkeeping. ]]
function Controller.Open(self: Controller, joiner: any, sanctum: any, recipients: { any }): (boolean, string)
	local plotId = (sanctum :: any).Id
	if type(plotId) ~= "number" then
		return false, Reason.NoRecipient
	end
	--[[ One offer per Sanctum. Two in flight would race for a single slot, and the loser would be
	     merged into a plot that had no room left by the time their acceptance arrived. ]]
	if self._offers[plotId] ~= nil then
		return false, Reason.OfferPending
	end
	if type(recipients) ~= "table" or #recipients == 0 then
		return false, Reason.NoRecipient
	end

	self._token += 1
	local token = self._token
	-- Floored at one second: a hand-edited config of 0 would expire the offer before the client
	-- could render the modal, making the link pad silently unusable.
	local window = math.max(1, GameConfig.Plot.LinkConfirmSeconds)
	local offer: Offer = {
		PlotId = plotId,
		Joiner = joiner,
		JoinerId = userIdOf(joiner),
		-- os.time, not tick: the client compares it against its own os.time to draw the countdown.
		ExpiresAt = os.time() + window,
		Token = token,
	}
	self._offers[plotId] = offer
	if self._remotes ~= nil then
		self._remotes:FireClients(recipients, "LinkOffer", {
			PlotId = plotId,
			FromUserId = offer.JoinerId,
			FromName = nameOf(joiner),
			ExpiresAt = offer.ExpiresAt,
		})
	end
	--[[ The TOKEN is the cancellation, not the thread: an offer that is answered or replaced is
	     removed from the book, so this closure finds a mismatch and does nothing. Nothing in it
	     yields, so a wedged client can never hold a Sanctum's second slot open past its window. ]]
	task.delay(window, function()
		local current = self._offers[plotId]
		if current == nil or current.Token ~= token then
			return
		end
		self._offers[plotId] = nil
		self:_notify(current.Joiner, "warn", "Nobody answered your link request.")
	end)
	self:_notify(joiner, "info", "Link requested. Waiting for the sanctum to answer.")
	return true, Reason.Ok
end

--[[ Answers the open offer for `sanctum`. PlotService has already established that `responder` is a
     current occupant of it -- the offer was addressed to them and to nobody else. ]]
function Controller.Resolve(self: Controller, responder: any, sanctum: any, accept: boolean): (boolean, string)
	local plotId = (sanctum :: any).Id
	local offer = if type(plotId) == "number" then self._offers[plotId] else nil
	if offer == nil then
		return false, Reason.NoOffer
	end
	-- The joiner cannot wave their own request through: the occupant's consent IS the opt-in (§1.5),
	-- and without this check a stranger could join any plot by answering for themselves.
	if userIdOf(responder) == offer.JoinerId then
		return false, Reason.SelfOffer
	end
	-- Consumed either way, BEFORE the callback: the merge inside OnAccepted must not be able to see
	-- a still-open offer and act on it a second time.
	self._offers[plotId :: number] = nil
	if accept ~= true then
		self:_notify(offer.Joiner, "warn", "Your link request was declined.")
		return true, Reason.Declined
	end
	self._onAccepted(sanctum, offer.Joiner)
	return true, Reason.Ok
end

function Controller.Pending(self: Controller, plotId: any): Offer?
	return if type(plotId) == "number" then self._offers[plotId] else nil
end

-- Called when a Sanctum empties: there is nobody left who could consent, so the offer dies with it.
function Controller.Cancel(self: Controller, plotId: any): ()
	local offer = self:Pending(plotId)
	if offer == nil then
		return
	end
	self._offers[plotId :: number] = nil
	self:_notify(offer.Joiner, "warn", "That sanctum is no longer available.")
end

-- The joiner left before anyone answered. Dropped silently -- there is nobody to tell.
function Controller.CancelForPlayer(self: Controller, player: any): ()
	local userId = userIdOf(player)
	-- 0 is the "could not read a UserId" sentinel, and matching on it would cancel every offer whose
	-- joiner was equally unreadable rather than the one that belongs to this player.
	if userId == 0 then
		return
	end
	for plotId, offer in pairs(self._offers) do
		if offer.JoinerId == userId then
			self._offers[plotId] = nil
		end
	end
end

--[[ Builds the in-world way to ASK. The link pads belong here rather than to PurchaseService:
     standing on one buys nothing, it opens the offer above, and PurchaseService's contract is
     purchases. Listened to on the SERVER, so there is no inbound message to forge (§1.7) -- the
     player and the pad both arrive from the engine. Returns its connections for the owner to hold. ]]
function Controller.AttachPads(self: Controller, sanctum: any, onRequest: (player: any) -> ()): { any }
	local made: { any } = {}
	local runtime = (sanctum :: any).Runtime
	local pads = if type(runtime) == "table" then (runtime :: any).Pads else nil
	if type(pads) ~= "table" then
		return made
	end
	for slot = 1, GameConfig.Plot.SlotsPerSanctum do
		local pad = pads["link:" .. tostring(slot)]
		-- Re-entrancy guard: a second Start must not stack two prompts on one pad, which would open
		-- (and immediately refuse) two offers for a single hold.
		if pad ~= nil and pad:FindFirstChildOfClass("ProximityPrompt") == nil then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Link"
			prompt.ObjectText = "Sanctum " .. tostring((sanctum :: any).Id)
			prompt.RequiresLineOfSight = false
			prompt.MaxActivationDistance = 10
			prompt.HoldDuration = 0
			prompt.Parent = pad
			table.insert(made, prompt.Triggered:Connect(onRequest))
		end
	end
	return made
end

-- Teardown. Outstanding expiry threads survive, but every one of them now finds an empty book.
function Controller.Clear(self: Controller): ()
	table.clear(self._offers)
end

return PlotLinkController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">PlotMirror</string>
            <string name="Source"><![CDATA[--!strict
--[[
    PlotMirror
    The bridge between a Sanctum's live PlotState and the per-player Profiles that persist it:
    mirroring the shared state out to every occupant, reading a player's saved state back, and
    adopting it when they claim a plot.

    Split out of PlotSession to keep that file inside the 300-line budget. It is the only place that
    decides which direction state flows between a Sanctum and a Profile, which is worth having in
    one file regardless.
    Owner: server  |  Consumers: PlotSession
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local StateSchema = require(Modules:WaitForChild("StateSchema"))

type PlotState = StateSchema.PlotState

local PlotMirror = {}
local profiles: any = nil

function PlotMirror.bind(profileService: any): ()
	profiles = profileService
end

--[[ Writes the live shared PlotState into EVERY occupant's Profile (§1.5). Co-op means both players
     carry the same result home, so there is no host copy and no guest copy. CLONED, not aliased: a
     leaver's Profile must stop tracking a Sanctum they are no longer in. ]]
function PlotMirror.mirror(plot: any): ()
	if profiles == nil then return end
	for _, occupant in pairs(plot.Sanctum.Occupants) do
		local profile = profiles:Get(occupant.Player)
		if type(profile) == "table" then
			(profile :: any).Plot = StateSchema.clonePlotState(plot.Sanctum.State)
		end
	end
end

function PlotMirror.savedPlotOf(player: any): PlotState?
	local profile = if profiles ~= nil then profiles:Get(player) else nil
	local saved = if type(profile) == "table" then (profile :: any).Plot else nil
	return if type(saved) == "table" then saved :: PlotState else nil
end

--[[ Brings the claimer's saved PlotState in. A RECLAIM inside the grace window max-merges rather
     than replacing: the two should already match (release saves), so merging means a save that
     silently failed cannot cost the pair their progress. ]]
function PlotMirror.adopt(plot: any, player: any, reclaiming: boolean): ()
	local saved = PlotMirror.savedPlotOf(player)
	if saved ~= nil then
		plot.Sanctum.State = if reclaiming then StateSchema.mergePlotStates(plot.Sanctum.State, saved)
			else StateSchema.clonePlotState(saved)
	end
end

return PlotMirror
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PlotRuntime</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlotRuntime
	One Sanctum's live machinery: the Instance tree PlotBuilder made, the DropperSystem emit clock,
	the MoteSystem flight pool, the rail geometry each Wellspring's Motes ride, and the Wing
	visibility that follows PlotState. It turns an emit into a Mote and a landed Mote into a credit,
	and exposes exactly one non-yielding Step for PlotService's shared Heartbeat to call. It knows
	nothing about claims, links, Profiles or the release grace: those are policy, and policy lives in
	the service. Split out of PlotService only to keep both files inside the 300-line budget.
	Owner: server/Services  |  Consumers: PlotService (which owns one per Sanctum)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Economy = require(Modules:WaitForChild("Economy"))
local PlotLayout = require(Modules:WaitForChild("PlotLayout"))
local SectionData = require(Modules:WaitForChild("SectionData"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

local Systems = script.Parent.Parent:WaitForChild("Systems")
local DropperSystem = require(Systems:WaitForChild("DropperSystem"))
local MoteSystem = require(Systems:WaitForChild("MoteSystem"))
local PlotBuilder = require(Systems:WaitForChild("PlotBuilder"))

type PlotState = StateSchema.PlotState
-- Player is `any` here rather than Player: the harness drives a Sanctum with plain tables, and this
-- module only ever passes an occupant's Player straight back to EconomyService.
type Occupant = { UserId: number, Player: any, Slot: number, JoinedAt: number, Contribution: number, Vote: boolean? }
type Sanctum = { Id: number, Model: Instance, State: PlotState, Occupants: { [number]: Occupant },
	AnchorUserId: number?, Runtime: any, Dirty: boolean }
type Connection = { Disconnect: (self: any) -> () }

local PlotRuntime = {}

local Plot = {}
Plot.__index = Plot

type PlotSelf = {
	Sanctum: Sanctum,
	--[[ Release-grace and replication bookkeeping. Written ONLY by PlotService -- they live on this
	     record rather than in a parallel table so a plot is one object, but they are its policy, not
	     this module's: Reserved is who may reclaim the plot, GraceToken lets a claim cancel an armed
	     timer without hunting for its thread, and Announced coalesces SanctumChanged. ]]
	Reserved: { [number]: boolean }, GraceToken: number, Announced: boolean, LastWarn: number,
	_droppers: any, _motes: any, _economy: any,
	_paths: { [string]: { CFrame } },
	_characters: { [number]: Connection }, -- one respawn watch per occupant, dropped when they leave
}
type Plot = typeof(setmetatable({} :: PlotSelf, Plot))

--[[ Cached for the life of the plot: rail geometry is fixed once PlotBuilder has run, and MoteSystem
     borrows the path by reference and never mutates it, so one table serves every Mote a Wellspring
     ever emits. The pad publishes its own (section, order), so this can never drift from the pad
     numbering PlotBuilder invented. ]]
local function railPathFor(self: Plot, def: any): { CFrame }?
	local cached = self._paths[def.Id]
	if cached ~= nil then return cached end
	local runtime = self.Sanctum.Runtime
	local pads = if type(runtime) == "table" then (runtime :: any).Pads else nil
	local pad = if type(pads) == "table" then pads["dropper:" .. tostring(def.Id)] else nil
	if pad == nil then return nil end
	local section = SectionData.get(pad:GetAttribute("PadSection") :: any)
	local order = pad:GetAttribute("PadOrder")
	-- A pad with no usable (section, order) would send PlotLayout arithmetic on nil, inside the
	-- income loop that drives every Sanctum on the server.
	if section == nil or type(order) ~= "number" then return nil end
	local path = PlotLayout.railPath((runtime :: any).Origin, section, order)
	self._paths[def.Id] = path
	return path
end

--[[ Passive income has no single author, so each occupant is credited the share earned WHILE THEY
     WERE PRESENT: a partner who joins for the last five minutes shows a small contribution and the
     player who carried the hour shows a large one, which is the whole point of tracking it next to a
     wallet that is shared (§1.2). It moves no Essence -- AddContribution is leaderboard flavour. ]]
local function shareContribution(self: Plot, credited: any): ()
	if type(credited) ~= "number" or credited <= 0 then return end
	local occupants, count = self.Sanctum.Occupants, 0
	for _ in pairs(occupants) do count += 1 end
	if count == 0 then return end -- a Mote landing on the frame the last occupant left
	local share = credited / count
	for _, occupant in pairs(occupants) do
		self._economy:AddContribution(self.Sanctum, occupant.Player, share)
	end
end

local function emit(self: Plot, def: any): ()
	local path = railPathFor(self, def)
	--[[ No rail means PlotBuilder never gave this Wellspring a pad -- a build bug, not a game state.
	     Following MoteSystem's rule for a malformed path, it is NOT credited: paying for it would
	     hide the bug behind income that still looks correct. ]]
	if path == nil then return end
	local sanctum = self.Sanctum
	local multipliers = self._economy:GetMultipliers(sanctum)
	self._motes:Spawn(def, Economy.getMoteValue(def, sanctum.State, multipliers), path,
		Economy.getRailTravelTime(sanctum.State, multipliers))
end

function PlotRuntime.new(id: number, parent: Instance, economy: any): Plot
	local model, runtime = PlotBuilder.build(id, parent)
	local sanctum: Sanctum = { Id = id, Model = model, State = StateSchema.newPlotState(),
		Occupants = {}, AnchorUserId = nil, Runtime = runtime, Dirty = false }
	local self: Plot = setmetatable({
		Sanctum = sanctum, Reserved = {}, GraceToken = 0, Announced = false, LastWarn = 0,
		_droppers = DropperSystem.new(sanctum), _motes = MoteSystem.new(sanctum),
		_economy = economy, _paths = {}, _characters = {},
	}, Plot)
	self._droppers.OnSpawn:Connect(function(def: any)
		emit(self, def)
	end)
	-- The one place a Mote's value becomes Essence, and it only ASKS: EconomyService owns the wallet.
	self._motes.OnCollected:Connect(function(value: number)
		shareContribution(self, self._economy:Credit(sanctum, value))
	end)
	-- Every Wing but the core starts locked, so the fresh plot must not ship with all five standing.
	self:ApplySections()
	return self
end

--[[ Locked Wings are REPARENTED out of the world by PlotBuilder, which is what makes their pads
     unreachable rather than merely invisible -- PurchaseService then never has to re-check the Wing
     lock on a trigger, because the prompt cannot be reached at all. ]]
function Plot.ApplySections(self: Plot): ()
	local unlocked = self.Sanctum.State.Sections
	for _, section in ipairs(SectionData.List) do
		local visible = section.Id == SectionData.Base or unlocked[section.Id] == true
		PlotBuilder.setSectionVisible(self.Sanctum.Runtime, section.Id, visible)
	end
end

-- NOTHING on this path may yield: it runs inside the one Heartbeat that drives every Sanctum, and a
-- yield there would stall income for the whole server behind one plot's slow call.
function Plot.Step(self: Plot, dt: number): ()
	self._droppers:Step(dt, self._economy:GetMultipliers(self.Sanctum))
	self._motes:Step(dt)
end

-- Re-derives everything downstream of PlotState. Called after a load, a link merge, a purchase, an
-- attunement and a reset -- anything that can change what the Sanctum owns.
function Plot.Rebuild(self: Plot): ()
	self._droppers:Rebuild()
	self:ApplySections()
	self._economy:RefreshMultipliers(self.Sanctum)
end

--[[ Back to a blank Sanctum: the grace window expired, or a claimer took a plot that was counting
     down for somebody else. Motes in flight are DISCARDED rather than credited -- there is no longer
     a wallet that earned them, and the previous pair's progress is already in their Profiles. ]]
function Plot.Reset(self: Plot): ()
	self.Sanctum.State = StateSchema.newPlotState()
	self.Sanctum.AnchorUserId = nil
	self.Reserved = {}
	self._motes:Clear()
	self:Rebuild()
end

--[[ Puts a character on its slot's spawn. Only a BasePart carries a CFrame, and a character mid
     respawn is a Model whose root has not arrived yet -- both are normal, so a missing root simply
     leaves the player where they are rather than erroring inside a join. ]]
function Plot.Seat(self: Plot, player: any, slot: number): ()
	local character = (player :: any).Character
	if character == nil then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root ~= nil and root:IsA("Part") then
		root.CFrame = PlotLayout.spawnSlotCFrame((self.Sanctum.Runtime :: any).Origin, slot)
	end
end

--[[ MOCK-EXTRA: Player.CharacterAdded. Without this watch a death respawns the player at the world
     origin, which is Sanctum 1's floor -- i.e. inside a stranger's plot, every time anybody dies. ]]
function Plot.Watch(self: Plot, player: any, userId: number): ()
	self:Unwatch(userId) -- a rejoin must not stack a second watch on the same player
	self._characters[userId] = (player :: any).CharacterAdded:Connect(function()
		-- Re-read rather than capture: by the time a respawn lands, this player may have been
		-- released from the plot entirely, and seating them here would drag them back.
		local occupant = self.Sanctum.Occupants[userId]
		if occupant ~= nil then self:Seat(player, occupant.Slot) end
	end)
end

function Plot.Unwatch(self: Plot, userId: number): ()
	local existing = self._characters[userId]
	if existing ~= nil then
		existing:Disconnect()
		self._characters[userId] = nil
	end
end

function Plot.ClearMotes(self: Plot): ()
	self._motes:Clear()
end

function Plot.MoteCount(self: Plot): number
	return self._motes:Count()
end

function Plot.Destroy(self: Plot): ()
	-- Respawn watches hold a reference to this plot; left connected they would keep seating players
	-- on a Sanctum that no longer exists.
	for userId in pairs(self._characters) do self:Unwatch(userId) end
	self._droppers:Destroy()
	self._motes:Destroy()
	-- PlotBuilder.destroy, not Model:Destroy: locked Wings live OUTSIDE the model and would leak.
	PlotBuilder.destroy(self.Sanctum.Model)
end

return PlotRuntime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlotService
	Owns every Sanctum on the server: it builds the six plots at boot, hands one to each arriving
	player, links a consenting second occupant in, holds a vacated plot through its grace window, and
	drives ALL of them from a SINGLE Heartbeat connection. It is the one authority on occupancy and
	the one place a live PlotState is mirrored back into a Profile.
	Three plain modules do the work under it, split out only to keep every file inside the 300-line
	budget: PlotRuntime is one Sanctum's machinery, PlotSession is a player's relationship to a plot
	(claim, link, release, grace), and PlotLinkController is the link offer book.
	Owner: server/Services  |  Consumers: EconomyService, PurchaseService, EvolutionService,
	                                      RebirthService, StateReplicator, LeaderboardService
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Signal = require(Modules:WaitForChild("Signal"))

local Peers = script.Parent
local PlotLinkController = require(Peers:WaitForChild("PlotLinkController"))
local PlotRuntime = require(Peers:WaitForChild("PlotRuntime"))
local PlotSession = require(Peers:WaitForChild("PlotSession"))

type Occupant = { UserId: number, Player: any, Slot: number, JoinedAt: number, Contribution: number, Vote: boolean? }
type Sanctum = { Id: number, Model: Instance, State: any, Occupants: { [number]: Occupant },
	AnchorUserId: number?, Runtime: any, Dirty: boolean }
type Plot = any -- PlotRuntime's object; typed there, and naming it here would be a require cycle
type Connection = { Disconnect: (self: any) -> () }

-- Heartbeat is DECIMATED to GameConfig.Income.TickRate: DropperSystem's catch-up bound is sized off
-- a 0.1s step, and stepping six Sanctums at render rate buys nothing a Mote's flight can show.
local STEP_INTERVAL = 1 / math.max(1, GameConfig.Income.TickRate)
local MAX_STEP = 0.5 -- after a hitch the banked dt would teleport every Mote to the Font in one frame
local MIRROR_SECONDS = 1 -- how often a dirty Sanctum is copied into its occupants' Profiles
local WARN_SECONDS = 10 -- throttle on the per-Sanctum step-failure warning
local FOLDER_NAME = "Sanctums"

local Service = {}
Service.Name = "PlotService"
-- Built at module scope, never in Init: rebuilding them would silently drop every connection a peer
-- made at boot, and those peers are already running by the time a re-Init could happen.
Service.SanctumChanged = Signal.new()
Service.OccupantAdded = Signal.new()
Service.OccupantRemoved = Signal.new()
Service.Reason = PlotSession.Reason -- the closed set of link/claim gate codes (DECISIONS #11)

local plots: { Plot } = {}
local byId: { [number]: Plot } = {}
local connections: { Connection } = {}
local heartbeat: Connection? = nil
local links: any, profiles: any, economy: any, remotes: any = nil, nil, nil, nil
local purchases: any, registryRef: any = nil, nil
local accumulator, mirrorClock = 0, 0

--[[ Resolves a caller's Sanctum back to the plot that owns it. The IDENTITY check matters: a spec
     fixture (or a stale reference to a rebuilt plot) can share an Id with a live Sanctum, and
     driving the real one from it would move a live player's occupancy. ]]
local function plotOf(sanctum: any): Plot?
	if type(sanctum) ~= "table" then return nil end
	local id = (sanctum :: any).Id
	local plot = if type(id) == "number" then byId[id] else nil
	return if plot ~= nil and plot.Sanctum == sanctum then plot else nil
end

function Service:GetSanctum(id: any): Sanctum?
	local plot = if type(id) == "number" then byId[id] else nil
	return if plot ~= nil then plot.Sanctum else nil
end

function Service:GetSanctumForPlayer(player: any): Sanctum?
	local plot = PlotSession.plotFor(player)
	return if plot ~= nil then plot.Sanctum else nil
end

-- Read structurally rather than through plotOf, so a spec fixture's Sanctum works here too.
function Service:GetOccupants(sanctum: any): { Player }
	local list: { Player } = {}
	local occupants = if type(sanctum) == "table" then (sanctum :: any).Occupants else nil
	if type(occupants) ~= "table" then return list end
	local ordered: { Occupant } = {}
	for _, occupant in pairs(occupants :: { [any]: Occupant }) do table.insert(ordered, occupant) end
	-- Sorted by slot: `pairs` order is unspecified, and an unstable partner panel would flicker.
	table.sort(ordered, function(a: Occupant, b: Occupant): boolean return a.Slot < b.Slot end)
	for _, occupant in ipairs(ordered) do table.insert(list, occupant.Player) end
	return list
end

function Service:ForEachSanctum(fn: (Sanctum) -> ()): ()
	if type(fn) ~= "function" then return end
	for _, plot in ipairs(plots) do fn(plot.Sanctum) end
end

function Service:MarkDirty(sanctum: any): ()
	if type(sanctum) ~= "table" then return end
	local target = sanctum :: any
	target.Dirty = true
	local plot = plotOf(sanctum)
	if plot == nil then
		Service.SanctumChanged:Fire(sanctum) -- not one of ours; there is nothing to coalesce against
		return
	end
	--[[ COALESCED to one announcement per income tick. EconomyService calls this on EVERY credit --
	     dozens a second per Sanctum -- and Signal.Fire spawns a thread per handler, so an
	     uncoalesced version would spend more time waking listeners than earning. The flag is
	     re-armed at the top of each tick, so no change ever waits longer than one tick to be seen. ]]
	if plot.Announced then return end
	plot.Announced = true
	Service.SanctumChanged:Fire(plot.Sanctum)
end

--[[ Re-derives everything downstream of PlotState -- emit streams, Wing visibility, the multiplier
     cache and the pads' wording. Call it after a load, a link merge, a purchase, an attunement or a
     reset: anything that changes what the Sanctum owns. ]]
function Service:RebuildSanctum(sanctum: any): ()
	local plot = plotOf(sanctum)
	if plot == nil then return end
	PlotSession.ensureSeed(plot) -- the cold-start invariant, restored before anything reads the state
	plot:Rebuild()
	-- PurchaseService is registered AFTER this service, so it is resolved lazily; TryGet, never Get,
	-- because Get errors by design and this runs on paths that must not throw.
	if purchases == nil and registryRef ~= nil then purchases = registryRef:TryGet("PurchaseService") end
	if purchases ~= nil and type(purchases.RefreshPads) == "function" then
		purchases:RefreshPads(plot.Sanctum)
	end
	Service:MarkDirty(plot.Sanctum)
end

function Service:ClaimEmpty(player: any): Sanctum?
	local plot = PlotSession.claim(player)
	return if plot ~= nil then plot.Sanctum else nil
end

function Service:RequestLink(player: any, sanctum: any): (boolean, string)
	local plot = plotOf(sanctum)
	if plot == nil then return false, Service.Reason.UnknownSanctum end
	return PlotSession.requestLink(player, plot)
end

function Service:ResolveLink(player: any, sanctum: any, accept: boolean): (boolean, string)
	local plot = plotOf(sanctum)
	if plot == nil then return false, Service.Reason.UnknownSanctum end
	return PlotSession.resolveLink(player, plot, accept)
end

function Service:ReleaseOccupant(player: any): ()
	PlotSession.release(player)
end

--[[ Mirrors first, then hands every write to ProfileService: the shutdown budget and the session
     locking live there, and a second save loop here would double every player's write rate. ]]
function Service:SaveAll(release: boolean?): ()
	PlotSession.mirrorAll()
	if profiles ~= nil then profiles:SaveAll(release) end
end

-- PurchaseService needs the pads and signs, EvolutionService the Conflux. nil for a foreign Sanctum.
function Service:GetSanctumRuntime(sanctum: any): any
	local plot = plotOf(sanctum)
	return if plot ~= nil then plot.Sanctum.Runtime else nil
end

-- StateReplicator publishes MoteCount in the §7 snapshot; RebirthService clears the flight pool on a
-- reset, where crediting Motes still in the air would pay the pair for pressing the button.
function Service:GetMoteCount(sanctum: any): number
	local plot = plotOf(sanctum)
	return if plot ~= nil then plot:MoteCount() else 0
end

function Service:ClearMotes(sanctum: any): ()
	local plot = plotOf(sanctum)
	if plot ~= nil then plot:ClearMotes() end
end

--[[ The one loop -- one connection for the WHOLE service, never one per Sanctum. ]]

local function stepPlot(plot: Plot, dt: number, mirroring: boolean): ()
	plot:Step(dt)
	-- Cheap and non-yielding, so it rides the income tick: any save (autosave, release, shutdown)
	-- then finds a Profile at most MIRROR_SECONDS behind the live Sanctum, whoever triggered it.
	if mirroring and plot.Sanctum.Dirty then PlotSession.mirrorOne(plot) end
end

local function tick(dt: any): ()
	accumulator += if type(dt) == "number" and dt == dt then dt else 0
	if accumulator < STEP_INTERVAL then return end
	local step = math.min(accumulator, MAX_STEP)
	accumulator = 0
	mirrorClock += step
	local mirroring = mirrorClock >= MIRROR_SECONDS
	if mirroring then mirrorClock = 0 end
	for _, plot in ipairs(plots) do
		plot.Announced = false -- re-arm the coalesced SanctumChanged for this tick
		if next(plot.Sanctum.Occupants) ~= nil then
			--[[ Per-Sanctum pcall, not one around the whole loop: an error in plot 3 must not stop
			     plots 4-6 earning, and an unguarded error would kill this connection for every
			     player on the server for the rest of its life. ]]
			local ok, err = pcall(stepPlot, plot, step, mirroring)
			if not ok and os.clock() - plot.LastWarn >= WARN_SECONDS then
				plot.LastWarn = os.clock()
				warn(("[PlotService] sanctum %d step failed: %s"):format(plot.Sanctum.Id, tostring(err)))
			end
		end
	end
end

local function teardown(): ()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	if heartbeat ~= nil then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	PlotSession.reset()
	for _, plot in ipairs(plots) do plot:Destroy() end
	table.clear(plots)
	table.clear(byId)
end

--[[ ServiceRegistry contract ]]

function Service:Init(registry: any): ()
	registryRef = registry
	-- Resolved only: section 6 forbids cross-service calls during Init.
	profiles = registry:Get("ProfileService")
	economy = registry:Get("EconomyService")
	remotes = registry:Get("RemoteService")
	purchases = nil -- registered AFTER this service; resolved lazily in RebuildSanctum
	links = PlotLinkController.new({
		Remotes = remotes,
		OnAccepted = function(sanctum: any, joiner: any)
			local plot = plotOf(sanctum)
			if plot ~= nil then PlotSession.linkAccepted(plot, joiner) end
		end,
	})
	teardown() -- a re-Init must not leave the previous boot's models, runtimes or connections behind
	PlotSession.bind(Service, plots, profiles, links)
	accumulator, mirrorClock = 0, 0
	-- Rebuilt from scratch: a leftover folder would leave six abandoned Sanctums in the world, and
	-- their pads would still answer a ProximityPrompt.
	local previous = workspace:FindFirstChild(FOLDER_NAME)
	if previous ~= nil then previous:Destroy() end
	local created = Instance.new("Folder")
	created.Name = FOLDER_NAME
	created.Parent = workspace
	for id = 1, GameConfig.Plot.SanctumCount do
		local plot = PlotRuntime.new(id, created, economy)
		table.insert(plots, plot)
		byId[id] = plot
	end
end

function Service:Start(): ()
	purchases = if registryRef ~= nil then registryRef:TryGet("PurchaseService") else nil
	for _, plot in ipairs(plots) do
		if purchases ~= nil and type(purchases.BuildPads) == "function" then
			purchases:BuildPads(plot.Sanctum)
		end
		for _, connection in ipairs(links:AttachPads(plot.Sanctum, function(player: Player)
			Service:RequestLink(player, plot.Sanctum)
		end)) do
			table.insert(connections, connection)
		end
	end
	--[[ Claiming hangs off ProfileLoaded, not PlayerAdded: the claim reads the saved PlotState, and
	     claiming before it arrived would seed a blank Sanctum and merge the real save over it. ]]
	table.insert(connections, profiles.ProfileLoaded:Connect(function(player: Player)
		if Service:ClaimEmpty(player) == nil and remotes ~= nil then
			remotes:FireClient(player, "Notify", { Kind = "error", Text = "Every sanctum is occupied right now." })
		end
	end))
	table.insert(connections, profiles.ProfileReleasing:Connect(PlotSession.flush))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		Service:ReleaseOccupant(player)
	end))
	if remotes ~= nil then
		remotes:On("LinkResponse", function(player: Player, payload: any)
			-- Never trust the client: the payload names a plot, never an outcome. Occupancy and the
			-- pending offer are both re-checked from live state inside ResolveLink.
			local id = if type(payload) == "table" then (payload :: any).PlotId else nil
			local plot = if type(id) == "number" then byId[id] else nil
			if plot ~= nil then Service:ResolveLink(player, plot.Sanctum, (payload :: any).Accept == true) end
		end)
	end
	heartbeat = RunService.Heartbeat:Connect(tick)
	-- A Profile that loaded before Start (a boot-order edge, or a spec) still needs its Sanctum.
	for _, player in ipairs(Players:GetPlayers()) do
		if profiles:IsLoaded(player) then Service:ClaimEmpty(player) end
	end
end

function Service:Stop(): ()
	teardown()
	if links ~= nil then links:Clear() end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PlotSession</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlotSession
	Everything about a PLAYER's relationship to a Sanctum, kept apart from the machinery that makes a
	Sanctum run: which plot a claim lands on, the slot and spawn they get, the max-merge that admits
	a linked partner, the mirror of the live state into every occupant's Profile, and the grace
	window that lets a disconnect-and-rejoin keep the plot. PlotService owns it, drives it and
	publishes its results; it was split out only to keep every file inside the 300-line budget.
	Owner: server/Services  |  Consumers: PlotService (which binds exactly one)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local DropperData = require(Modules:WaitForChild("DropperData"))
local Economy = require(Modules:WaitForChild("Economy"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

local PlotMirror = require(script.Parent.PlotMirror)

type PlotState = StateSchema.PlotState
type Occupant = { UserId: number, Player: any, Slot: number, JoinedAt: number, Contribution: number, Vote: boolean? }
type Plot = any -- PlotRuntime's object; typed there, and naming it here would be a require cycle

local SLOTS = GameConfig.Plot.SlotsPerSanctum
local STARTER_DROPPER = "ember_vent" -- DropperData's balance model names this as the cold-start seed

local PlotSession = {}

-- Closed set (DECISIONS #11): the client maps a code to wording, and the server never sends prose.
local Reason = {
	Ok = "ok", UnknownSanctum = "unknown_sanctum",
	NoPlayer = "no_player", -- not a live player, or not an occupant entitled to answer
	AlreadyHere = "already_here", AlreadyLinked = "already_linked", -- §1.5: one Sanctum at a time
	SanctumEmpty = "sanctum_empty", -- claim it outright; there is nobody there to ask
	SanctumFull = "sanctum_full",
	NotLoaded = "not_loaded", -- no saved PlotState to merge, so no offer is made
}
PlotSession.Reason = Reason

local owner: any, plots: { Plot }, profiles: any, links: any = nil, {}, nil, nil
local byUserId: { [number]: Plot } = {}

-- pcall'd: a Player is userdata, and reading a field off one who has already left can throw.
local function userIdOf(player: any): number?
	if player == nil then return nil end
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and type(id) == "number" and id == id then id else nil
end

local function occupantCount(plot: Plot): number
	local total = 0
	for _ in pairs(plot.Sanctum.Occupants) do total += 1 end
	return total
end

local function freeSlot(plot: Plot): number?
	local taken: { [number]: boolean } = {}
	for _, occupant in pairs(plot.Sanctum.Occupants) do taken[occupant.Slot] = true end
	for slot = 1, SLOTS do
		if not taken[slot] then return slot end
	end
	return nil
end

local function addOccupant(plot: Plot, player: any, userId: number): Occupant?
	local slot = freeSlot(plot)
	if slot == nil then return nil end
	local occupant: Occupant = { UserId = userId, Player = player, Slot = slot,
		JoinedAt = os.time(), Contribution = 0, Vote = nil }
	plot.Sanctum.Occupants[userId] = occupant
	byUserId[userId] = plot
	-- Bumping the token cancels any armed release timer: a live occupant must never have their
	-- Sanctum blanked by a countdown that started before they arrived.
	plot.GraceToken += 1
	plot.Reserved = {}
	if plot.Sanctum.AnchorUserId == nil then plot.Sanctum.AnchorUserId = userId end
	plot:Watch(player, userId)
	plot:Seat(player, slot)
	owner.OccupantAdded:Fire(plot.Sanctum, player)
	return occupant
end

local function removeOccupant(plot: Plot, occupant: Occupant): ()
	local sanctum = plot.Sanctum
	sanctum.Occupants[occupant.UserId] = nil
	if byUserId[occupant.UserId] == plot then byUserId[occupant.UserId] = nil end
	--[[ Reserved for the grace window: a disconnect-and-rejoin must land back on this plot with its
	     progress intact, because losing a Sanctum to a dropped connection would be the single most
	     frustrating thing in the game (DECISIONS #6). ]]
	plot.Reserved[occupant.UserId] = true
	plot:Unwatch(occupant.UserId) -- their respawns are no longer this Sanctum's business
	if sanctum.AnchorUserId == occupant.UserId then
		-- Promote whoever is left, so the plot always has a nameable owner; nil when nobody is.
		sanctum.AnchorUserId = nil
		for id in pairs(sanctum.Occupants) do
			sanctum.AnchorUserId = id
			break
		end
	end
end

-- The Profile <-> PlotState bridge lives in PlotMirror; aliased so call sites read unchanged.
local mirror, savedPlotOf, adopt = PlotMirror.mirror, PlotMirror.savedPlotOf, PlotMirror.adopt
local function beginGrace(plot: Plot): ()
	plot.GraceToken += 1
	local token = plot.GraceToken
	task.delay(math.max(0, GameConfig.Plot.ReleaseGraceSeconds), function()
		-- The TOKEN, not the thread, is the cancellation: any claim bumps it, so a plot that was
		-- reclaimed or taken by someone else simply finds a mismatch here and is left alone.
		if plot.GraceToken ~= token or next(plot.Sanctum.Occupants) ~= nil then return end
		plot:Reset()
		owner:MarkDirty(plot.Sanctum)
	end)
end

--[[ Public surface -- every entry point PlotService forwards to. ]]

function PlotSession.bind(service: any, list: { Plot }, profileService: any, linkController: any): ()
	owner, plots, profiles, links = service, list, profileService, linkController
	PlotMirror.bind(profileService)
end

-- Teardown for Stop / re-Init. The respawn watches belong to each plot and die with it in Destroy.
function PlotSession.reset(): ()
	table.clear(byUserId)
end

--[[ THE COLD-START INVARIANT: an OCCUPIED Sanctum always owns at least one Wellspring. Without it
     income is exactly zero, and with zero income no purchase ever becomes affordable -- the pair are
     stuck forever. DropperData's balance model states the assumption explicitly (one free ember_vent,
     first purchase at ~34s) and names PlotService as the component that seeds it.
     It is restored HERE, at the single choke point every state change passes through, rather than at
     the four call sites that can empty a Sanctum: a fresh claim, a link merge, an Attunement and a
     Transcendence reset. Granted only when the pair owns NOTHING at all, so it can never top up a
     real save, and never for an empty plot, which must stay blank until somebody claims it. ]]
function PlotSession.ensureSeed(plot: Plot): ()
	local state: PlotState = plot.Sanctum.State
	if next(plot.Sanctum.Occupants) == nil or Economy.totalDroppersOwned(state) > 0 then return end
	local starter = DropperData.get(STARTER_DROPPER) or DropperData.List[1]
	if starter ~= nil then state.Droppers[starter.Id] = 1 end
end

function PlotSession.plotFor(player: any): Plot?
	local userId = userIdOf(player)
	return if userId ~= nil then byUserId[userId] else nil
end

--[[ Picks a plot in a deliberate order: the one this player just left (still inside its grace
     window) first, then a genuinely idle one, and only then one that is counting down for somebody
     else. Stealing a graced plot is safe -- its state was mirrored into every occupant's Profile
     before that timer started -- and it is what stops a busy server turning a player away. ]]
function PlotSession.claim(player: any): Plot?
	local userId = userIdOf(player)
	if userId == nil then return nil end
	local existing = byUserId[userId]
	if existing ~= nil then return existing end -- idempotent: never move a settled player

	local reserved: Plot?, idle: Plot?, graced: Plot? = nil, nil, nil
	for _, plot in ipairs(plots) do
		if next(plot.Sanctum.Occupants) == nil then
			if plot.Reserved[userId] then
				reserved = plot
				break
			elseif next(plot.Reserved) == nil then
				idle = idle or plot
			else
				graced = graced or plot
			end
		end
	end
	local plot = reserved or idle or graced
	if plot == nil then return nil end

	local reclaiming = plot == reserved
	-- A stolen graced plot still holds the previous pair's progress; blank it first so the claimer
	-- never sees, or earns from, a stranger's Wellsprings.
	if not reclaiming then plot:Reset() end
	plot.Reserved = {}
	if addOccupant(plot, player, userId) == nil then return nil end
	adopt(plot, player, reclaiming)
	owner:RebuildSanctum(plot.Sanctum)
	return plot
end

function PlotSession.release(player: any): ()
	local userId = userIdOf(player)
	if userId == nil then return end
	if links ~= nil then links:CancelForPlayer(player) end
	local plot = byUserId[userId]
	if plot == nil then return end
	local occupant = plot.Sanctum.Occupants[userId]
	if occupant == nil then
		byUserId[userId] = nil -- a stale index entry; there is nothing else to unwind
		return
	end
	-- Mirrored BEFORE the occupant is dropped, so the leaver's own Profile carries the shared result
	-- home (§1.5) rather than the state they arrived with.
	mirror(plot)
	removeOccupant(plot, occupant)
	owner.OccupantRemoved:Fire(plot.Sanctum, player)
	-- Income is NOT paused for whoever is left (DECISIONS #6): nothing here touches the runtime.
	if profiles ~= nil then
		for _, other in ipairs(owner:GetOccupants(plot.Sanctum)) do profiles:Save(other) end
	end
	if next(plot.Sanctum.Occupants) == nil then
		if links ~= nil then links:Cancel(plot.Sanctum.Id) end
		beginGrace(plot)
	end
	owner:MarkDirty(plot.Sanctum)
end

--[[ ProfileService saves AND releases on PlayerRemoving, and its own handler is connected first
     (registration order), so ProfileReleasing is the last window in which the leaver's Profile can
     still be given the shared result. Nothing here yields, so it lands before that write. ]]
function PlotSession.flush(player: any, profile: any): ()
	local userId = userIdOf(player)
	local plot = if userId ~= nil then byUserId[userId] else nil
	if plot ~= nil and type(profile) == "table" then
		profile.Plot = StateSchema.clonePlotState(plot.Sanctum.State)
	end
end

function PlotSession.mirrorAll(): ()
	for _, plot in ipairs(plots) do mirror(plot) end
end

function PlotSession.mirrorOne(plot: Plot): ()
	mirror(plot)
end

function PlotSession.requestLink(player: any, plot: Plot): (boolean, string)
	local userId = userIdOf(player)
	if userId == nil then return false, Reason.NoPlayer end
	local current = byUserId[userId]
	if current == plot then return false, Reason.AlreadyHere end
	--[[ §1.5 is "one Sanctum at a time", NOT "never linked". Every player auto-claims a plot when
	     their Profile loads, so refusing anyone who has one would make linking -- the entire
	     two-player hook -- unreachable. A SOLO player may link out and their progress travels with
	     them through the merge; what is refused is stranding a PARTNER behind. ]]
	if current ~= nil and occupantCount(current) > 1 then return false, Reason.AlreadyLinked end
	local recipients = owner:GetOccupants(plot.Sanctum)
	if #recipients == 0 then return false, Reason.SanctumEmpty end
	if #recipients >= SLOTS then return false, Reason.SanctumFull end
	-- The merge reads the joiner's SAVED PlotState, so an unloaded Profile must not be offered:
	-- accepting one would link them in with nothing of their own and read as data loss.
	if savedPlotOf(player) == nil then return false, Reason.NotLoaded end
	return links:Open(player, plot.Sanctum, recipients)
end

function PlotSession.resolveLink(player: any, plot: Plot, accept: boolean): (boolean, string)
	local userId = userIdOf(player)
	-- Only a CURRENT occupant may answer. The offer was addressed to them, and the opt-in exists
	-- precisely to stop anyone else waving a stranger into their plot.
	if userId == nil or plot.Sanctum.Occupants[userId] == nil then return false, Reason.NoPlayer end
	return links:Resolve(player, plot.Sanctum, accept == true)
end

--[[ Runs up to LinkConfirmSeconds after the request, so EVERY gate is re-checked against live state:
     the joiner may have claimed a plot of their own in the meantime, and the second slot may have
     been taken by an offer that was accepted first. ]]
function PlotSession.linkAccepted(plot: Plot, joiner: any): ()
	local userId = userIdOf(joiner)
	if userId == nil or occupantCount(plot) >= SLOTS then return end
	local current = byUserId[userId]
	if current == plot then return end
	if current ~= nil then
		-- Re-checked at ACCEPT time: a partner may have linked into the joiner's own Sanctum during
		-- the confirmation window, and leaving now would strand them.
		if occupantCount(current) > 1 then return end
		-- release() mirrors the live state into their Profile first, so the merge below picks up
		-- what they earned while the offer was pending. Reserved is cleared because a deliberate
		-- move is not a disconnect: their old plot is genuinely free.
		PlotSession.release(joiner)
		current.Reserved = {}
	end
	local saved = savedPlotOf(joiner)
	if saved ~= nil then
		--[[ MAX-MERGE (§1.5): per-field max, union of sets, so nobody can lose anything they owned
		     by being sociable. The LIVE state is the left argument, which is what keeps the Affinity
		     the pair has already been playing rather than the joiner's. ]]
		plot.Sanctum.State = StateSchema.mergePlotStates(plot.Sanctum.State, saved)
	end
	if addOccupant(plot, joiner, userId) == nil then return end
	owner:RebuildSanctum(plot.Sanctum)
	mirror(plot) -- the merged state belongs to BOTH of them from this moment on
end

return PlotSession
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ProfileLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
    ProfileLock
    The session-lock protocol: how a stored record encodes ownership of a player's save, and when a
    lock may be taken. Split out of ProfileService to keep that file inside the 300-line budget, and
    because this is the part whose reasoning most needs to sit in one place -- get it wrong in one
    direction and a crashed server locks a player out of their own account forever; get it wrong in
    the other and two servers write one profile.
    Owner: server  |  Consumers: ProfileService
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

local SAVE, SESSION = GameConfig.Save, GameConfig.Session

export type Lock = { JobId: string, Stamp: number }

local ProfileLock = {}
-- The identity this server claims locks under. game.JobId is empty in Studio, so a stable
-- fallback keeps a Studio session from colliding with a real one.
ProfileLock.JobId = if game.JobId ~= nil and #game.JobId > 0 then game.JobId else "studio-local"

function ProfileLock.keyFor(player: Player): string return SAVE.KeyPrefix .. tostring(player.UserId) end

--[[ The stored value is { Lock = {JobId, Stamp}, Data = Profile }. A raw legacy Profile (written by
     a build predating the lock) has no Data field and is read as unlocked data, so an old save is
     adopted rather than mistaken for garbage and overwritten. ]]
function ProfileLock.unwrap(raw: any): (Lock?, any)
	if type(raw) ~= "table" then return nil, nil end
	local stored = raw :: { [string]: any }
	if type(stored.Data) ~= "table" then return nil, raw end
	local lock = stored.Lock
	if type(lock) ~= "table" or type(lock.JobId) ~= "string" or type(lock.Stamp) ~= "number" then
		-- A malformed or absent lock is no lock. Refusing to load over a half-written lock record
		-- would strand the player for LockStaleSeconds over a value we can simply replace.
		return nil, stored.Data
	end
	return { JobId = lock.JobId, Stamp = lock.Stamp }, stored.Data
end

--[[ A lock blocks a load only while it is live AND belongs to someone else.
     WHY a stale lock MUST be stealable: a server that crashes never runs its release-save, so its
     lock is left behind forever. Without the steal, one crash locks that player out of their own
     save permanently -- the account becomes unloadable. The steal is the repair for a dead server.
     WHY the window must sit well above the autosave interval: every save refreshes the stamp, so a
     live session's lock is never older than one autosave period (120s +/-20s). LockStaleSeconds is
     900 -- seven autosaves of slack -- so a laggy but living server is never mistaken for a dead
     one. A window near or below the autosave period would steal locks from LIVE sessions and let
     two servers write one profile: exactly the corruption the lock exists to prevent. ]]
function ProfileLock.blocks(lock: Lock?, now: number): boolean
	if lock == nil or lock.JobId == ProfileLock.JobId then return false end -- unlocked, or ours (a rejoin here)
	return (now - lock.Stamp) <= SESSION.LockStaleSeconds
end

return ProfileLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProfileService
	The only path between a Player and their saved Profile. Every load takes a JobId-stamped session
	lock through DataStoreWrapper:Update, every save refreshes it (or clears it on release), and
	everything read back goes through StateSchema.migrate, so a corrupt or forged record is repaired
	rather than fatal. A player whose lock is held by another LIVE server is refused (nil) so the
	caller can kick them honestly; a player the DataStore cannot serve at all still gets a playable
	session on a profile flagged __NoSave that is never written back.
	Owner: server/Services  |  Consumers: PlotService, EconomyService, RebirthService, LeaderboardService
]]

local Players = game:GetService("Players")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Signal = require(Modules:WaitForChild("Signal"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

local ProfileLock = require(script.Parent.ProfileLock)

type Profile = StateSchema.Profile
type Lock = { JobId: string, Stamp: number }
-- Spec section 3.1: a connection is anything with :Disconnect(). Structural, so this module behaves
-- identically under Roblox's RBXScriptConnection and under the headless mock.
type Connection = { Disconnect: (self: any) -> () }
type Entry = {
	Player: Player,
	Profile: Profile,
	Saving: boolean, -- a write is in flight; a second Save must not interleave with it
	LastSaveOk: boolean, -- result of the last write, handed back to coalesced callers
	Released: boolean, -- a release-write already cleared the lock; do not write again
	PlaytimeStamp: number, -- os.time() up to which Stats.Playtime has been accounted for
	Autosave: boolean, -- false tells the parked autosave thread to exit at its next wake
}

local SAVE = GameConfig.Save
local SESSION = GameConfig.Session

-- Studio reports an empty JobId. A constant stand-in is right there: Studio runs one server at a
-- time, so a restarted play-test reclaims its own lock immediately instead of waiting out
-- LockStaleSeconds. Live, JobId is unique per server, which is the entire mechanism.
-- ONE definition, shared with ProfileLock. Two fallbacks would differ in Studio (where JobId is
-- empty), and a server that writes one id while blocks() compares another would refuse to
-- recognise its own lock.
local JOB_ID: string = ProfileLock.JobId
-- Poll cadence and ceiling for a caller waiting on an in-flight save. The ceiling clears
-- DataStoreWrapper's full 1+2+4+8s backoff, so a slow-but-healthy save is waited out while one
-- wedged behind an outage cannot park a PlayerRemoving or a shutdown forever.
local SAVE_POLL_SECONDS, SAVE_WAIT_TIMEOUT = 0.1, 20
-- Floor on the autosave period: a hand-edited config (Jitter >= AutosaveSeconds) must not be able to
-- turn the loop into a DataStore flood.
local MIN_AUTOSAVE_SECONDS = 5

local Service = {}
Service.Name = "ProfileService"
-- Built at module scope, not in Init: recreating them would silently drop every connection a peer
-- has made. The harness re-requires modules per test, so they are fresh each run anyway.
Service.ProfileLoaded = Signal.new()
Service.ProfileReleasing = Signal.new()

local entries: { [Player]: Entry } = {}
local connections: { Connection } = {}
local wrapper: any = nil -- DataStoreWrapper, resolved in Init
local running = false
-- Own RNG so autosave jitter never perturbs the global math.random sequence mote paths and other
-- systems draw from, which would make their tests non-reproducible.
local rng = Random.new(os.time())

-- The lock protocol lives in ProfileLock; aliased so call sites below read unchanged.
local keyFor, unwrap, blocks = ProfileLock.keyFor, ProfileLock.unwrap, ProfileLock.blocks
local function startAutosave(entry: Entry): ()
	if entry.Autosave then return end -- a second thread would double this player's write rate
	entry.Autosave = true
	task.spawn(function()
		while entry.Autosave and running do
			-- The +/- jitter IS the stagger: players who joined on the same frame land up to 2 x
			-- AutosaveJitter (40s) apart, and re-rolling each cycle stops them re-converging. A
			-- fixed period would have all twelve occupants of a full server writing on one frame.
			local jitter = rng:NextNumber(-SAVE.AutosaveJitter, SAVE.AutosaveJitter)
			task.wait(math.max(SAVE.AutosaveSeconds + jitter, MIN_AUTOSAVE_SECONDS))
			-- Re-checked after the park: the player may have left (or the server stopped) while this
			-- thread slept, and saving a released profile would retake a lock nobody holds.
			if not entry.Autosave or not running or entries[entry.Player] ~= entry then break end
			Service:Save(entry.Player)
		end
		entry.Autosave = false
	end)
end

local function register(player: Player, profile: Profile): Profile
	local entry: Entry = { Player = player, Profile = profile, Saving = false, LastSaveOk = false,
		Released = false, PlaytimeStamp = os.time(), Autosave = false }
	entries[player] = entry
	if running then startAutosave(entry) end
	Service.ProfileLoaded:Fire(player, profile)
	return profile
end

--[[ WHY this profile is never written back: the DataStore being unreachable says nothing about what
     is stored in it, so persisting this one would replace a veteran's real save with zeroes on the
     strength of a transient outage. That is far worse than losing one session, so Save skips it. ]]
local function unsavable(player: Player): Profile
	local profile: any = StateSchema.newProfile()
	profile.__NoSave = true
	warn(("[ProfileService] %s is on an unsaved profile: the DataStore is unreachable"):format(player.Name))
	return register(player, profile :: Profile)
end

local function writeProfile(entry: Entry, release: boolean): boolean
	local profile, now = entry.Profile, os.time()
	-- Playtime accrues here rather than on a timer, and the stamp advances only once the seconds it
	-- covers are in the payload: a failed write leaves them in memory for the next save instead of
	-- double-counting or dropping them.
	profile.Stats.Playtime += math.max(now - entry.PlaytimeStamp, 0)
	entry.PlaytimeStamp = now
	profile.Stats.LastSave = now
	local stolen = false
	local ok = wrapper:Update(SAVE.DataStoreName, keyFor(entry.Player), function(current: any): any
		-- Runs once per DataStoreWrapper attempt and recomputes from `current` alone; `stolen` is a
		-- last-write-wins status flag, never an accumulator.
		local lock = unwrap(current)
		if lock ~= nil and lock.JobId ~= JOB_ID then
			-- Another server holds this player's lock, so it has already LOADED their profile: ours
			-- is a stale fork now, and writing it would erase their live session.
			stolen = true
			return nil -- abort the write
		end
		stolen = false
		return { Lock = if release then nil else { JobId = JOB_ID, Stamp = os.time() }, Data = profile }
	end)
	if stolen then
		warn(("[ProfileService] abandoned save for %s: another server owns the session lock"):format(entry.Player.Name))
		return false
	end
	if not ok then warn(("[ProfileService] save failed for %s after all retries"):format(entry.Player.Name)) end
	return ok
end

function Service:LoadAsync(player: Player): Profile?
	local existing = entries[player]
	if existing ~= nil then return existing.Profile end -- a second load would take a second lock
	local key, attempts = keyFor(player), math.max(SESSION.LockRetries, 1)
	local loaded: Profile? = nil
	for attempt = 1, attempts do
		local claimed = false
		local ok = wrapper:Update(SAVE.DataStoreName, key, function(current: any): any
			claimed = false -- recomputed per attempt; the wrapper may run this more than once
			local now = os.time()
			local lock, data = unwrap(current)
			if blocks(lock, now) then return nil end -- a live server owns it: nothing is written
			-- migrate sanitises, so `data` may be nil, a string or a tampered table and what comes
			-- back is still a legal Profile. A corrupt save is therefore a non-event.
			local profile = StateSchema.migrate(data)
			profile.Stats.JoinCount += 1
			claimed, loaded = true, profile
			return { Lock = { JobId = JOB_ID, Stamp = now }, Data = profile }
		end)
		if not ok then
			-- The wrapper already exhausted its own retry schedule, so this is not contention: the
			-- DataStore is unreachable. Five more lock attempts would only delay the join.
			return unsavable(player)
		end
		local profile = loaded
		if claimed and profile ~= nil then return register(player, profile) end
		if attempt < attempts then task.wait(SESSION.LockRetryDelay) end
	end
	--[[ Give up with nil, NOT a blank profile. The caller kicks the player with a clear message and
	     they rejoin in seconds; handing back an empty profile would let the next save overwrite a
	     real one, which is unrecoverable. A lost session beats a lost account. ]]
	warn(("[ProfileService] no session lock for %s after %d attempts"):format(player.Name, attempts))
	return nil
end

function Service:Get(player: Player): Profile?
	local entry = entries[player]
	return if entry ~= nil then entry.Profile else nil
end

function Service:IsLoaded(player: Player): boolean
	return entries[player] ~= nil
end

function Service:Save(player: Player, opts: { Release: boolean? }?): boolean
	local entry = entries[player]
	if entry == nil then return false end -- nothing loaded: no state to write, no lock to refresh
	local release = if opts ~= nil then opts.Release == true else false
	if (entry.Profile :: any).__NoSave == true then return false end -- see `unsavable`
	if entry.Saving then
		local waited = 0
		while entry.Saving and waited < SAVE_WAIT_TIMEOUT do
			task.wait(SAVE_POLL_SECONDS)
			waited += SAVE_POLL_SECONDS
		end
		-- Coalesce: the in-flight write publishes the same live table this call would send, so a
		-- second round trip buys nothing. A Release must clear the lock, so it instead falls through
		-- and writes after the first call -- unless that one is still stuck, when racing it is worse.
		if not release or entry.Saving then return entry.LastSaveOk end
	end
	entry.Saving = true
	local ok = writeProfile(entry, release)
	entry.Saving = false
	entry.LastSaveOk = ok
	if ok and release then entry.Released = true end
	return ok
end

function Service:SaveAll(release: boolean?): ()
	--[[ Bounded by the shutdown budget: Roblox hard-kills the server ~30s into BindToClose whatever
	     the handler is doing, so a queue of failing saves must be abandoned in time for the players
	     behind it. os.clock is monotonic: a wall clock correction cannot stretch or collapse it. ]]
	local deadline = os.clock() + SAVE.ShutdownBudgetSeconds
	local doRelease = release == true
	for player in pairs(entries) do
		if os.clock() >= deadline then
			warn("[ProfileService] shutdown budget exhausted; the remaining profiles were not saved")
			break
		end
		Service:Save(player, { Release = doRelease })
	end
end

function Service:Release(player: Player): ()
	local entry = entries[player]
	if entry == nil then return end
	-- Fired before the final write so a consumer can flush last-moment state into the profile. A
	-- handler that yields may miss that window, which is why every other service writes through on
	-- mutation instead of hoarding state until release.
	Service.ProfileReleasing:Fire(player, entry.Profile)
	-- The release-write is what clears the session lock; skipping it would strand the player behind
	-- their own lock until it aged out at LockStaleSeconds.
	if not entry.Released then Service:Save(player, { Release = true }) end
	entry.Autosave = false -- the parked autosave thread exits at its next wake
	entries[player] = nil
end

function Service:Init(registry: any): ()
	wrapper = registry:Get("DataStoreWrapper") -- resolved only: section 6 forbids calls during Init
	running = false
	-- Rebuilt: a re-Init inheriting entries would leave two autosave loops writing through one lock.
	entries = {}
end

--[[ The first domino. Every downstream system hangs off ProfileLoaded -- PlotService claims a
     Sanctum on it, LeaderboardService builds leaderstats, StateReplicator starts pushing -- so
     without this connection a joining player loads no profile, claims no plot and stands in an
     empty world with a blank HUD. Nothing else in the game calls LoadAsync. ]]
local function admit(player: Player): ()
	if Service:IsLoaded(player) then return end
	local profile = Service:LoadAsync(player)
	if profile ~= nil then return end
	--[[ nil means the session lock belongs to a live server after every retry. Kicking is the only
	     safe answer: letting them play on a blank profile would end with the next save overwriting
	     a real one. They rejoin in seconds, usually onto the server that holds the lock. ]]
	if player.Parent ~= nil then
		player:Kick("Your sanctum is still saving on another server. Please rejoin in a moment.")
	end
end

function Service:Start(): ()
	running = true
	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(admit, player) -- LoadAsync yields; PlayerAdded must not block on a DataStore
	end))
	-- A player whose join beat this script (a fresh server fills before the first Heartbeat) still
	-- needs admitting, so the connection alone is not enough.
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(admit, player)
	end
	local leaving = Players.PlayerRemoving:Connect(function(player: Player)
		Service:Release(player) -- saves with Release = true, then drops the in-memory profile
	end)
	table.insert(connections, leaving)
	game:BindToClose(function() -- prescribed by spec section 6 for exactly this
		-- Shorter retry schedule FIRST: the wrapper's full backoff sleeps 1+2+4+8 = 15s on a single
		-- failing key, so one unlucky player would eat most of the budget and everyone behind them
		-- would be saved by nothing at all.
		if wrapper ~= nil and type(wrapper.SetMaxAttempts) == "function" then
			wrapper:SetMaxAttempts(2)
		end
		Service:SaveAll(true)
	end)
	-- A profile loaded before Start (a boot-order edge, or a test) still gets its loop.
	for _, entry in pairs(entries) do startAutosave(entry) end
end

function Service:Stop(): ()
	running = false -- every autosave thread exits at its next wake
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	for _, entry in pairs(entries) do entry.Autosave = false end
	-- Deliberately does NOT save: BindToClose owns the shutdown write, and a second pass here would
	-- either double-write every profile or race the first one mid-flight.
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PurchasePads</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchasePads
	The pure half of PurchaseService: what one pad MEANS, and what it SHOWS. Given a PlotState it
	answers, for a pad kind and id, whether the pad can be acted on, the closed-set reason if it
	cannot, what it costs, what it is called and whether the Sanctum can see it yet -- every answer
	is Economy's, run on the same catalogue the client reads. It then writes that verdict onto the
	pad Instance: the four attributes the client reads, the sign wording, whether the prompt is live
	at all, and whether the pad is visible. It knows nothing about occupancy, Essence or Triggered
	signals -- those are decisions, and decisions live in the service.
	Split out of PurchaseService only to keep both files inside the project's 300-line budget.
	Owner: server/Services  |  Consumers: PurchaseService (only)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local DropperData = require(Modules:WaitForChild("DropperData"))
local Economy = require(Modules:WaitForChild("Economy"))
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local Format = require(Modules:WaitForChild("Format"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local SectionData = require(Modules:WaitForChild("SectionData"))
local UpgradeData = require(Modules:WaitForChild("UpgradeData"))

-- Ok/Reason are the purchase gate; the rest is wording. Hidden means "this Sanctum cannot see the
-- content at all yet", which is a stronger statement than locked.
type Verdict = { Ok: boolean, Reason: string, Cost: number, Name: string, Detail: string, Hidden: boolean }

local PurchasePads = {}

local Reason = Economy.Reason
local SLOTS = math.max(1, GameConfig.Plot.SlotsPerSanctum)
-- The reason code the link pad reports when it is not usable. It never reaches a purchase, so it
-- stays local to the pad's presentation rather than joining Economy's closed set.
local LINK_UNAVAILABLE = "unavailable"

-- Every Runtime.Pads key resolves to one of these; anything else is a pad this build has invented
-- and PurchaseService has not been taught to sell.
local KINDS: { [string]: boolean } = { dropper = true, upgrade = true, section = true,
	attune = true, transcend = true, link = true }
PurchasePads.Kinds = KINDS

--[[ The only two refusals that leave a prompt LIVE. Both mean "come back with more Essence", and a
     pad the pair are visibly saving for must stay a target. Every other refusal DISABLES the prompt
     rather than merely relabelling it, so an unbuyable pad cannot even be pressed. ]]
local SOFT: { [string]: boolean } = { [Reason.Insufficient] = true, [Reason.NeedEssence] = true }

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v :: number else default
end

--[[ Runtime.Pads keys are the server's own identity for a pad ("dropper:ember_vent", "attune",
     "link:2"). They are parsed here rather than read back off the pad's attributes, because those
     attributes are what this module PUBLISHES -- deriving behaviour from them would let one bad
     refresh rewrite what a pad sells. The two bare keys carry the kind as their id, matching what
     PlotBuilder already writes for them. ]]
function PurchasePads.split(key: any): (string?, string)
	if type(key) ~= "string" then return nil, "" end
	local colon = string.find(key, ":", 1, true)
	if colon == nil then return (if KINDS[key] then key else nil), key end
	local kind = string.sub(key, 1, colon - 1)
	return (if KINDS[kind] then kind else nil), string.sub(key, colon + 1)
end

-- Economy has no public owned-count reader, and PurchaseService needs the same number to increment.
function PurchasePads.owned(state: any, id: string): number
	local map = if type(state) == "table" then (state :: any).Droppers else nil
	return math.max(0, math.floor(num(if type(map) == "table" then (map :: any)[id] else nil, 0)))
end

local function verdict(ok: boolean, reason: string, cost: number, name: string, detail: string,
	hidden: boolean): Verdict
	return { Ok = ok, Reason = reason, Cost = cost, Name = name, Detail = detail, Hidden = hidden }
end

-- Both stage-gate codes read the same on a pad, and both hide it: a Wing's contents and a Stage's
-- contents are equally "not yet".
local function stageHidden(reason: string): boolean
	return reason == Reason.LockedStage or reason == Reason.LockedSection
end

--[[ What a pad is worth, what it is called and whether the Sanctum can see it yet -- all of it
     Economy's answer, run against the LIVE PlotState the caller passes in. A pad is HIDDEN when the
     Sanctum has not reached the content at all (a Stage gate, a Wing already bought, a Transcendence
     still Stages away): an unreachable pad standing in the room reads as broken, and hiding it turns
     each Attunement into a visible unlock. Everything else stays visible and says why.
     `occupants` is the live headcount, and is only read by the link pad. ]]
function PurchasePads.evaluate(state: any, kind: string, id: string, occupants: number): Verdict
	if kind == "dropper" then
		local def = DropperData.get(id)
		-- An id no catalogue knows is made UNAVAILABLE, never free -- the same doctrine Economy
		-- applies to a corrupt def, for the same reason.
		if def == nil then return verdict(false, Reason.UnknownId, 0, "Wellspring", "", true) end
		local ok, reason = Economy.dropperStatus(state, def)
		local cost = Economy.getDropperCost(def, PurchasePads.owned(state, id))
		local detail = if reason == Reason.MaxOwned then "Maxed" else Format.essence(cost)
		return verdict(ok, reason, cost, def.Name, detail, stageHidden(reason))
	elseif kind == "upgrade" then
		local def = UpgradeData.get(id)
		if def == nil then return verdict(false, Reason.UnknownId, 0, "Upgrade", "", true) end
		local ok, reason = Economy.upgradeStatus(state, def)
		local level = Economy.upgradeLevel(state, id)
		-- getUpgradeCost returns math.huge at max level. Publishing that would put an infinity on a
		-- sign and in the PadCost attribute; a maxed pad has no price, so it quotes none.
		local maxed = reason == Reason.MaxLevel
		local cost = if maxed then 0 else Economy.getUpgradeCost(def, level)
		local detail = if maxed then "Maxed" else string.format("Lv %d  %s", level + 1, Format.essence(cost))
		return verdict(ok, reason, cost, def.Name, detail, stageHidden(reason))
	elseif kind == "section" then
		local def = SectionData.get(id)
		if def == nil then return verdict(false, Reason.UnknownId, 0, "Wing", "", true) end
		local ok, reason = Economy.sectionStatus(state, def)
		local cost = Economy.getSectionCost(def)
		-- A bought Wing's pad has nothing left to sell, and the room it sold is now standing next
		-- to it, so it is hidden rather than left saying "Unlocked" forever.
		local hidden = reason == Reason.AlreadyOwned or stageHidden(reason)
		return verdict(ok, reason, cost, def.Name, Format.essence(cost), hidden)
	elseif kind == "attune" then
		local ok, reason = Economy.attuneStatus(state)
		local nextStage = EvolutionData.next(math.floor(num(if type(state) == "table"
			then (state :: any).Stage else nil, 1)))
		if nextStage == nil then
			-- Primordial: a landmark, not a purchase. Quoting a price here would be a lie, and
			-- hiding the pad would delete the centrepiece of a finished Sanctum.
			return verdict(ok, reason, 0, "The Conflux", "Primordial", false)
		end
		local cost = math.max(0, num(nextStage.RequiredEssence, 0))
		return verdict(ok, reason, cost, "Attune: " .. nextStage.Name, Format.essence(cost), false)
	elseif kind == "transcend" then
		local ok, reason = Economy.transcendStatus(state)
		-- Transcendence spends the RUN, not the wallet, so it has no price. Its pad stays hidden
		-- until the pair are at the Stage that could ever allow it (§8: it appears when eligible).
		return verdict(ok, reason, 0, "Transcendence", (if ok then "Ready" else "Not yet"),
			reason == Reason.NeedStage)
	end
	--[[ link: not a purchase at all, and the only pad a NON-occupant is meant to use. Nobody home
	     means there is nobody to ask, so the pad is hidden; a full Sanctum shows a dead pad instead,
	     because a link pad that vanishes when a partner arrives reads as a bug. ]]
	local count = math.max(0, math.floor(num(occupants, 0)))
	local ok = count > 0 and count < SLOTS
	return verdict(ok, (if ok then Reason.Ok else LINK_UNAVAILABLE), 0, "Sanctum Link",
		string.format("%d/%d", count, SLOTS), count == 0)
end

--[[ Writes one verdict onto one pad. Locked is the union of "cannot see it" and "cannot act on it
     for a reason more Essence will not fix" -- PadLocked is the client's cue to grey the pad out,
     and prompt.Enabled is the server making that refusal real rather than cosmetic. ]]
function PurchasePads.publish(pad: any, label: any, prompt: any, kind: string, id: string, v: Verdict): ()
	local locked = v.Hidden or (not v.Ok and not SOFT[v.Reason])
	pad:SetAttribute("PadKind", kind)
	pad:SetAttribute("PadId", id)
	pad:SetAttribute("PadCost", v.Cost)
	pad:SetAttribute("PadLocked", locked)
	if label ~= nil then
		label.Text = v.Name .. "\n" .. v.Detail
	end
	if prompt ~= nil then
		prompt.Enabled = not locked
		-- PromptController rewrites both of these with its own wording the moment a snapshot lands;
		-- these are what a client that has not yet loaded (or has no controller) reads.
		prompt.ObjectText = v.Name
		prompt.ActionText = v.Detail
	end
	pad.Transparency = if v.Hidden then 1 else 0
	pad.CanCollide = not v.Hidden
	-- The BillboardGui, not its label: disabling the gui stops it rendering at all, where a blanked
	-- label is still a live billboard on every client within 90 studs.
	local sign = if label ~= nil then label.Parent else nil
	if sign ~= nil then
		sign.Enabled = not v.Hidden
	end
end

return PurchasePads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService
	Every purchase in the game happens here and nowhere else. It hangs a ProximityPrompt on each pad
	PlotBuilder laid out and listens to Triggered ON THE SERVER -- there is no client->server purchase
	remote and DECISIONS #7 says there never will be one, because a Triggered event carries a player
	and a prompt the server already trusts and offers nothing to forge. Every trigger is then
	re-derived from live state: the pad still stands in this Sanctum, the sender is a live Player,
	that player occupies THIS Sanctum, the def still exists in its catalogue, Economy still says yes,
	and EconomyService is what actually moves the Essence. What a pad means and says is PurchasePads'
	answer (which is Economy's answer); this file owns the prompts, the gates and the money.
	Owner: server/Services  |  Consumers: PlotService (BuildPads / RefreshPads), and every pad
]]

local Players = game:GetService("Players")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Economy = require(Modules:WaitForChild("Economy"))
local Format = require(Modules:WaitForChild("Format"))

-- The pure half of this service: key parsing, per-kind verdicts and everything a pad displays.
local PurchasePads = require(script.Parent:WaitForChild("PurchasePads"))

type Connection = { Disconnect: (self: any) -> () }
-- Structurally identical to PurchasePads' Verdict, restated because `export type` is reserved for
-- src/shared. Only Ok, Reason, Cost and Name are read on this side.
type Verdict = { Ok: boolean, Reason: string, Cost: number, Name: string, Detail: string, Hidden: boolean }

local Service = {}
Service.Name = "PurchaseService"

local Reason = Economy.Reason
--[[ Economy's closed set covers every refusal it can SEE, but it never sees who pressed a prompt.
     These four are the refusals only this service can make. They are returned to callers and logged;
     none of them is ever written to a pad, so the client's reason table does not need them. ]]
local NO_PLAYER, NOT_OCCUPANT = "no_player", "not_occupant"
local UNKNOWN_SANCTUM, UNAVAILABLE = "unknown_sanctum", "unavailable"
-- Published so a caller (and a spec) compares against a name rather than a string literal.
local PadReason: { [string]: string } = { NoPlayer = NO_PLAYER, NotOccupant = NOT_OCCUPANT,
	UnknownSanctum = UNKNOWN_SANCTUM, Unavailable = UNAVAILABLE }
for key, value in pairs(Reason) do PadReason[key] = value end
Service.Reason = PadReason

local PROMPT_NAME = "PurchasePrompt"
-- Pad -> Pads folder -> Wing model -> Sanctum model is three hops; 8 leaves room for a deeper tree
-- while still terminating, which a `while parent do` walk over a corrupt chain would not.
local MAX_HOPS = 8

local economy: any, plots: any, remotes: any, registryRef: any = nil, nil, nil, nil
local connections: { Connection } = {}

--[[ Total readers. Every argument is untrusted: a Sanctum may be a spec fixture, a half-released
     plot, or a table whose State was replaced under us between two frames. ]]

-- Read structurally rather than through PlotService's accessors, so a fixture Sanctum (which
-- PlotService would disown) still builds and refreshes its pads identically.
local function tableField(sanctum: any, field: string): any?
	if type(sanctum) ~= "table" then return nil end
	local value = (sanctum :: any)[field]
	return if type(value) == "table" then value else nil
end

-- The same test RemoteService uses. Unparented from Players is how both the engine and the mock mark
-- a player gone, and a prompt press queued before a disconnect still lands after it.
local function isLivePlayer(player: any): boolean
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

--[[ One walk over Occupants, answering both questions this service ever asks of it: who to send Fx
     and Notify to, and whether `player` is one of them -- THE gate that stops a hostile trigger, and
     the reason a player who walked over from another Sanctum cannot buy on this one's pads.
     Identity by object first (what matches under Roblox) and by UserId second (what matches a
     rejoined Player instance, or a harness table). The UserId read is pcall'd because a Player is
     userdata and reading a field off one who has already left can throw. ]]
local function survey(sanctum: any, player: any?): ({ any }, boolean)
	local list: { any }, found = {}, false
	local occupants = tableField(sanctum, "Occupants")
	if occupants == nil then return list, false end
	local ok, raw = pcall(function(): any return (player :: any).UserId end)
	local userId: number? = if ok and type(raw) == "number" and raw == raw then raw :: number else nil
	for _, occupant in pairs(occupants :: { [any]: any }) do
		if type(occupant) == "table" then
			if occupant.Player ~= nil then table.insert(list, occupant.Player) end
			-- `player ~= nil` guards the nil == nil case: an absent player must never match an
			-- occupant record whose Player field has already been cleared.
			if player ~= nil and (occupant.Player == player
				or (userId ~= nil and occupant.UserId == userId)) then found = true end
		end
	end
	return list, found
end

--[[ Walks up rather than calling IsDescendantOf, which is outside the allowed API surface. This is
     what keeps a LOCKED Wing's contents unbuyable: PlotBuilder reparents an unowned Wing into
     ServerStorage without destroying it, so its prompts are still connected and can still be fired
     by anything holding a reference to one. Under the live Sanctum model, or it is not a pad. ]]
local function isUnder(node: any, ancestor: any): boolean
	if typeof(node) ~= "Instance" or typeof(ancestor) ~= "Instance" then return false end
	local current: any = node
	for _ = 1, MAX_HOPS do
		if current == nil then return false end
		if current == ancestor then return true end
		current = current.Parent
	end
	return false
end

function Service:RefreshPads(sanctum: any): ()
	local state, runtime = tableField(sanctum, "State"), tableField(sanctum, "Runtime")
	if state == nil or runtime == nil or type(runtime.Pads) ~= "table" then return end
	local signs = if type(runtime.Signs) == "table" then runtime.Signs else nil
	local occupants = #(survey(sanctum))
	for key, pad in pairs(runtime.Pads :: { [any]: any }) do
		local kind, id = PurchasePads.split(key)
		if kind ~= nil and typeof(pad) == "Instance" then
			local label = if signs ~= nil then signs[key] else nil
			PurchasePads.publish(pad, label, pad:FindFirstChild(PROMPT_NAME), kind, id,
				PurchasePads.evaluate(state, kind, id, occupants))
		end
	end
end

function Service:BuildPads(sanctum: any): ()
	local runtime = tableField(sanctum, "Runtime")
	if runtime == nil or type(runtime.Pads) ~= "table" then return end
	for key, pad in pairs(runtime.Pads :: { [any]: any }) do
		local kind, id = PurchasePads.split(key)
		--[[ An unrecognised key is a pad this service has not been taught to sell; it is left inert
		     rather than given a prompt whose handler would have nothing to do. The FindFirstChild is
		     what makes BuildPads idempotent -- PlotService may rebuild a Sanctum, and a second prompt
		     on one pad would charge the pair twice for one keypress. ]]
		if kind ~= nil and typeof(pad) == "Instance" and pad:FindFirstChild(PROMPT_NAME) == nil then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = PROMPT_NAME
			prompt.RequiresLineOfSight = false -- pads stand in the open; a stray part must not blind one
			prompt.MaxActivationDistance = 10
			prompt.HoldDuration = 0
			prompt.ActionText = ""
			prompt.ObjectText = ""
			prompt.Parent = pad
			-- Connected on the SERVER (DECISIONS #7). `pad`, `kind` and `id` are captured from the
			-- Runtime table here and never read back off the prompt, so nothing a later attribute
			-- write could corrupt decides what this prompt buys.
			table.insert(connections, prompt.Triggered:Connect(function(player: any)
				-- pcall'd: an error would unwind the engine's prompt thread and, worse, leave the
				-- pair unsure whether they were charged. A failure is a refusal, and it is logged.
				local ok, err = pcall(Service._Trigger, Service, sanctum, pad, prompt, kind :: string, id, player)
				if not ok then warn(("[PurchaseService] %s pad failed: %s"):format(tostring(key), tostring(err))) end
			end))
		end
	end
	Service:RefreshPads(sanctum)
end

--[[ Re-derives everything downstream of PlotState and republishes the pads. RebuildSanctum no-ops
     for a Sanctum PlotService does not own (a spec fixture), so the two steps this purchase genuinely
     owes -- the dirty flag and the pad refresh -- are made unconditionally rather than left to it. ]]
local function commit(sanctum: any): ()
	if plots ~= nil then
		if type(plots.RebuildSanctum) == "function" then plots:RebuildSanctum(sanctum) end
		if type(plots.MarkDirty) == "function" then plots:MarkDirty(sanctum) end
	end
	Service:RefreshPads(sanctum)
end

local function announce(sanctum: any, player: any, v: Verdict): ()
	if remotes == nil then return end
	local recipients = survey(sanctum)
	if #recipients == 0 then return end
	local id = (sanctum :: any).Id
	remotes:FireClients(recipients, "Fx", { Kind = "purchase", Data = { Name = v.Name, Cost = v.Cost },
		PlotId = if type(id) == "number" and id == id then math.floor(id) else 0 })
	-- Sent to BOTH occupants: the wallet is shared (§1.2), so a partner spending from it is news.
	remotes:FireClients(recipients, "Notify", { Kind = "success",
		Text = string.format("%s bought %s for %s", tostring(player), v.Name, Format.essence(v.Cost)) })
end

--[[ Writes the goods. A missing bucket is REPAIRED rather than refused, because this runs after the
     debit: a PlotState with no Droppers map is a corrupt fixture, and charging the pair for a write
     that then landed on the floor is the one outcome worse than a repaired table. ]]
local BUCKET: { [string]: string } = { dropper = "Droppers", upgrade = "Upgrades", section = "Sections" }
local function apply(state: any, kind: string, id: string): ()
	local field = BUCKET[kind]
	if field == nil then return end
	if type(state[field]) ~= "table" then state[field] = {} end
	-- Counts are re-derived from live state rather than incremented from the label the pad showed.
	state[field][id] = if kind == "dropper" then PurchasePads.owned(state, id) + 1
		elseif kind == "upgrade" then Economy.upgradeLevel(state, id) + 1
		else true
end

--[[ The whole purchase path, in the one order that is safe, with no shortcut for a check the client
     or the prompt has "already done". Nothing before TryDebit mutates anything, so every refusal
     leaves the Sanctum exactly as it was. ]]
local function buy(player: any, sanctum: any, kind: string, id: any): (boolean, string)
	if not isLivePlayer(player) then return false, NO_PLAYER end
	local state = tableField(sanctum, "State")
	if state == nil then return false, UNKNOWN_SANCTUM end
	local occupants, isOccupant = survey(sanctum, player)
	if not isOccupant then return false, NOT_OCCUPANT end
	if type(id) ~= "string" then return false, Reason.UnknownId end
	-- The def is re-read from its catalogue and re-gated against LIVE state inside evaluate: the pad
	-- was labelled at some earlier moment, and the wallet, the Stage and the Wing may all have moved
	-- since -- including by the partner, on this very frame.
	local v = PurchasePads.evaluate(state, kind, id, #occupants)
	if not v.Ok then return false, v.Reason end
	if economy == nil then return false, UNAVAILABLE end
	--[[ EconomyService is the only writer of Essence, and TryDebit re-reads the balance inside
	     itself, which is what stops two pads triggered on the same frame spending it twice. A lost
	     race reads as insufficient, which is exactly what it was by the time the debit ran. ]]
	if not economy:TryDebit(sanctum, v.Cost) then return false, Reason.Insufficient end
	apply(state, kind, id)
	commit(sanctum)
	announce(sanctum, player, v)
	return true, Reason.Ok
end

function Service:PurchaseDropper(player: any, sanctum: any, id: any): (boolean, string)
	return buy(player, sanctum, "dropper", id)
end
function Service:PurchaseUpgrade(player: any, sanctum: any, id: any): (boolean, string)
	return buy(player, sanctum, "upgrade", id)
end
function Service:PurchaseSection(player: any, sanctum: any, id: any): (boolean, string)
	return buy(player, sanctum, "section", id)
end

--[[ One trigger, from a player who should be assumed hostile and standing somewhere they should not
     be. Underscored because it is the prompt's entry point, not part of the spec's API. ]]
function Service:_Trigger(sanctum: any, pad: any, prompt: any, kind: string, id: string,
	player: any): (boolean, string)
	-- 1. The prompt must still BE this pad's prompt, and the pad must still stand in this Sanctum.
	-- A pad on a Wing that has been reparented into ServerStorage fails here, which is what keeps a
	-- locked Wing's contents unbuyable even for something holding a stale prompt reference.
	if prompt.Parent ~= pad or not isUnder(pad, (sanctum :: any).Model) then return false, UNKNOWN_SANCTUM end
	if not isLivePlayer(player) then return false, NO_PLAYER end
	if kind == "link" then
		--[[ The ONE pad no occupancy check may gate: its entire purpose is a player from ANOTHER
		     Sanctum asking to join this one. PlotService:RequestLink re-checks everything that
		     matters -- who they are, whether leaving would strand a partner, whether a slot is free,
		     whether their save has even loaded -- and the occupants still have to consent. ]]
		if plots == nil then return false, UNAVAILABLE end
		return plots:RequestLink(player, sanctum)
	end
	local _, isOccupant = survey(sanctum, player)
	if not isOccupant then return false, NOT_OCCUPANT end
	if kind == "attune" or kind == "transcend" then
		--[[ Resolved LAZILY, never at Init: both services are registered AFTER this one, so a Get in
		     Init would error and abort the whole boot. Absent (a spec that booted neither) refuses
		     the ritual rather than erroring inside a prompt handler. ]]
		local peer = if registryRef ~= nil
			then registryRef:TryGet(if kind == "attune" then "EvolutionService" else "RebirthService")
			else nil
		if peer == nil then return false, UNAVAILABLE end
		-- Both re-validate from live state themselves; the pad is only the doorbell.
		return if kind == "attune" then peer:Attune(player, sanctum) else peer:BeginVote(player, sanctum)
	end
	--[[ Deliberately routed through the public method, which re-runs the live-player and occupancy
	     checks this handler just made. The duplication is the point: the public API is reachable
	     without a prompt, so it can never rely on a caller having gated for it. ]]
	return buy(player, sanctum, kind, id)
end

--[[ ServiceRegistry contract ]]

local function teardown(): ()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
end

function Service:Init(registry: any): ()
	registryRef = registry
	-- Resolved only: section 6 forbids cross-service calls during Init. All three are registered
	-- BEFORE this service, so Get is right here and a missing one is a Bootstrap bug worth erroring on.
	economy = registry:Get("EconomyService")
	plots = registry:Get("PlotService")
	remotes = registry:Get("RemoteService")
	-- A re-Init must not leave the previous boot's Triggered handlers alive: they capture the old
	-- Sanctums and would keep charging players against plots that no longer exist.
	teardown()
end

function Service:Start(): ()
	--[[ PlotService:Start runs first (registration order) and calls BuildPads for every Sanctum, so
	     this sweep normally finds every pad already prompted and only refreshes wording. It exists so
	     the pads are this service's own responsibility rather than a favour from its caller. ]]
	if plots ~= nil and type(plots.ForEachSanctum) == "function" then
		plots:ForEachSanctum(function(sanctum: any) Service:BuildPads(sanctum) end)
	end
end

function Service:Stop(): ()
	-- StopAll runs in reverse registration order, so this disconnects while PlotService's Sanctums
	-- (and their prompts) are still standing; PlotService then destroys the models themselves.
	teardown()
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
    RateLimiter
    Token buckets keyed by (player, key). Every client->server remote spends a token before its
    handler is allowed to run, so a flooding client is throttled at the edge instead of inside
    gameplay code. Buckets refill continuously from elapsed clock time rather than from a timer:
    there is no per-bucket task to schedule, the service costs nothing while idle, and a bucket that
    has been quiet for a minute is simply full again when it is next read.
    Owner: server/Services  |  Consumers: RemoteService (every C2S remote), Bootstrap.server.luau
]]

local Players = game:GetService("Players")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Validate = require(Modules:WaitForChild("Validate"))

-- Spec section 3.1: a connection is anything with :Disconnect(). Typed structurally so the module
-- behaves identically under Roblox's RBXScriptConnection and under the headless test mock.
type Connection = { Disconnect: (self: any) -> () }

type Bucket = {
	Tokens: number, -- fractional: refill is continuous, so partial tokens are normal
	Capacity: number, -- burst size, and the ceiling refill clamps to
	Rate: number, -- tokens restored per second (Capacity / Interval)
	Stamp: number, -- clock reading at the last refill
}

type PlayerBuckets = { [string]: Bucket }

type RateLimiterService = {
	Name: string,
	Clock: () -> number,
	_buckets: { [Player]: PlayerBuckets },
	_connection: Connection?,
	Init: (self: RateLimiterService, registry: any) -> (),
	Start: (self: RateLimiterService) -> (),
	Stop: (self: RateLimiterService) -> (),
	Consume: (
		self: RateLimiterService,
		player: Player,
		key: string,
		tokens: number,
		interval: number
	) -> boolean,
	Reset: (self: RateLimiterService, player: Player) -> (),
	Stats: (self: RateLimiterService, player: Player) -> { [string]: number },
}

local Service = {} :: RateLimiterService
Service.Name = "RateLimiter"

--[[ The one time source for every bucket, read through this field so it can be substituted.

     tick() rather than os.clock(): both are continuous (no scheduled refill task either way), but
     tick() is the clock the headless harness can advance, so the refill curve is testable instead
     of taken on trust. tick()'s known weakness -- it follows the host wall clock and can jump if
     that is corrected -- is fully contained here: `refill` credits nothing for non-positive
     elapsed time (a backwards jump costs a client nothing and re-anchors), and a forward jump is
     clamped by Capacity, so the worst case is one client getting one extra burst. Neither can
     unbound the limiter, which is the only property that matters. ]]
Service.Clock = tick

Service._buckets = {}

--[[ Advance `bucket` to `now`. Refill happens on read rather than on a schedule, which is what keeps
     an idle server free of timers: elapsed time IS the refill. ]]
local function refill(bucket: Bucket, now: number): ()
	local elapsed = now - bucket.Stamp
	if elapsed <= 0 then
		-- Non-positive elapsed means two calls landed in the same clock tick, or the clock moved
		-- backwards. Granting tokens for negative time would be a free refill, and leaving a Stamp
		-- in the future would grant a huge one on the next call, so re-anchor without crediting.
		bucket.Stamp = math.min(bucket.Stamp, now)
		return
	end

	bucket.Stamp = now
	bucket.Tokens = math.min(bucket.Capacity, bucket.Tokens + elapsed * bucket.Rate)
end

function Service:Init(_registry: any): ()
	-- Dropping a live connection without disconnecting it would leave an orphan handler writing
	-- into the discarded bucket table forever, so a re-Init (a soft restart, a test) unwires first.
	if self._connection ~= nil then
		self._connection:Disconnect()
		self._connection = nil
	end
	-- Rebuilt rather than carried over, so a re-Init never inherits buckets belonging to players
	-- from a previous run.
	self._buckets = {}
end

function Service:Start(): ()
	--[[ Without this the bucket table grows by one entry per (player, remote key) for the lifetime
	     of the server. Worse than the table itself: a Player instance is a strong key, so every
	     leaked entry also pins a departed Player -- and whatever it still references -- in memory
	     forever. ]]
	self._connection = Players.PlayerRemoving:Connect(function(player: Player)
		self:Reset(player)
	end)
end

function Service:Stop(): ()
	if self._connection ~= nil then
		self._connection:Disconnect()
		self._connection = nil
	end
	table.clear(self._buckets)
end

--[[ Spend one token from (player, key), refilling from elapsed time first. Returns true when the
     call is allowed.

     `tokens` and `interval` describe the BUDGET, not the amount to spend: they are
     RemoteSchema's `RateLimit = { Tokens = 4, Interval = 5 }` passed straight through, meaning
     "4 calls per 5 seconds, burstable to 4". Each Consume costs exactly one token.

     Every rejection path returns false instead of erroring. This runs on the remote edge, where a
     thrown error is itself the denial of service the limiter exists to prevent. ]]
function Service:Consume(player: Player, key: string, tokens: number, interval: number): boolean
	-- typeof, not a nil check: a non-Instance player is a caller bug (a UserId or a name passed by
	-- mistake), and letting it through would open a bucket table keyed by something that no
	-- PlayerRemoving will ever clean up.
	if typeof(player) ~= "Instance" then
		return false
	end
	-- A non-string key means the caller built it wrong (a nil remote name, an Instance, a number).
	-- Hard deny: coercing to a shared fallback key would let unrelated remotes drain each other's
	-- budget, and the cheapest way to bypass a limiter is to make its key collide.
	if not Validate.isString(key) or key == "" then
		return false
	end
	if not Validate.isFiniteNumber(tokens) or tokens <= 0 then
		return false
	end
	-- interval <= 0 makes the refill rate infinite (or nan), silently disabling the limiter for
	-- this key. Deny instead of trusting arithmetic to fail safe.
	if not Validate.isFiniteNumber(interval) or interval <= 0 then
		return false
	end

	local buckets = self._buckets[player]
	if buckets == nil then
		buckets = {}
		self._buckets[player] = buckets
	end

	local now = Service.Clock()
	local rate = tokens / interval
	local bucket = buckets[key]

	if bucket == nil then
		-- A fresh bucket starts FULL, so a player's first call after joining is never throttled.
		bucket = { Tokens = tokens, Capacity = tokens, Rate = rate, Stamp = now }
		buckets[key] = bucket
	else
		if bucket.Capacity ~= tokens or bucket.Rate ~= rate then
			-- The budget for this key changed (a config reload, or two call sites disagreeing).
			-- Adopt the new one and clamp, rather than honouring a stale rate for the whole
			-- session; clamping stops a shrunk budget from carrying over a bigger old balance.
			bucket.Capacity = tokens
			bucket.Rate = rate
			bucket.Tokens = math.min(bucket.Tokens, tokens)
		end
		refill(bucket, now)
	end

	if bucket.Tokens < 1 then
		return false
	end

	bucket.Tokens -= 1
	return true
end

-- Drops every bucket for `player`. Called on PlayerRemoving, and safe to call for a player who has
-- never consumed anything.
function Service:Reset(player: Player): ()
	if typeof(player) ~= "Instance" then
		return
	end
	self._buckets[player] = nil
end

--[[ key -> tokens remaining, refilled to the current clock reading first so a caller sees the same
     numbers Consume would. Values are fractional by design (continuous refill); tests wanting exact
     figures should substitute Service.Clock. Read-only: it never creates a bucket, so asking about
     a player cannot itself allocate one. ]]
function Service:Stats(player: Player): { [string]: number }
	local stats: { [string]: number } = {}
	if typeof(player) ~= "Instance" then
		return stats
	end

	local buckets = self._buckets[player]
	if buckets == nil then
		return stats
	end

	local now = Service.Clock()
	for key, bucket in pairs(buckets) do
		refill(bucket, now)
		stats[key] = bucket.Tokens
	end
	return stats
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RebirthService
	Transcendence: the consensus vote and the reset behind it. It opens a vote when an occupant asks,
	broadcasts the live ballot, and executes only when EVERY current occupant has voted yes inside
	GameConfig.Rebirth.VoteWindowSeconds (spec 9.5 item 2) -- a single no, a departure, a roster
	change or the window running out all cancel it. Execution grants every occupant their permanent
	prestige, wipes the shared PlotState back to a seeded Stage 1 Sanctum, and saves them at once.
	Owner: server/Services  |  Consumers: PurchaseService (the transcendence pad), tests
]]
--[[ WHY CONSENSUS, AND WHY THE RESET COMES LAST. A shared plot with a unilateral reset button is a
     griefing tool (DECISIONS #9), so the vote is the gate; a solo occupant's single yes IS
     unanimous, so playing alone is never blocked. Execute's ordering is the difference between a
     rebirth and a disaster: Prestige is written FIRST (the only thing a player cannot re-earn), the
     Sanctum is reset second, and each Profile is given the RESET plot before it is saved. Saving
     ahead of that mirror persists "Stage 6 plot + one extra rebirth": a free rebirth every rejoin. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local DropperData = require(Modules:WaitForChild("DropperData"))
local Economy = require(Modules:WaitForChild("Economy"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local RebirthData = require(Modules:WaitForChild("RebirthData"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

type Connection = { Disconnect: (self: any) -> () }
-- One live vote. Sanctum is held by reference so a stale timer can prove which vote it is cancelling.
type Vote = { Sanctum: any, ExpiresAt: number, Ballots: { [number]: boolean } }

local STARTER_DROPPER = "ember_vent" -- DropperData's balance model names this the cold-start seed
local WINDOW = math.max(1, GameConfig.Rebirth.VoteWindowSeconds)
local MAX_CURRENCY = StateSchema.MAX_CURRENCY

local Service = {}
Service.Name = "RebirthService"

-- Closed set (DECISIONS #11): the client maps a code to wording, and a gate never returns prose.
local Reason = {
	UnknownSanctum = "unknown_sanctum", -- not a table, or carrying no PlotState
	NoPlayer = "no_player", -- not an occupant of THIS Sanctum, so not entitled to reset it
	VoteOpen = "vote_open", -- one vote at a time; a second request is a duplicate, not a new one
	Declined = "declined", Expired = "expired", RosterChanged = "roster_changed", Ok = Economy.Reason.Ok,
	NeedStage = Economy.Reason.NeedStage, NeedLifetime = Economy.Reason.NeedLifetime,
}
Service.Reason = Reason

local plots: any, economy: any, profiles: any, remotes: any = nil, nil, nil, nil
local evolution: any = nil -- optional presentation peer; see Init
local connections: { Connection } = {}
-- Weak KEYS so a Sanctum PlotService has released is not pinned alive by an abandoned ballot.
local function newBallotBook(): { [any]: Vote }
	return (setmetatable({}, { __mode = "k" }) :: any) :: { [any]: Vote }
end
local active: { [any]: Vote } = newBallotBook()

local function stateOf(sanctum: any): { [string]: any }?
	local state = if type(sanctum) == "table" then (sanctum :: { [string]: any }).State else nil
	return if type(state) == "table" then state :: { [string]: any } else nil
end
-- pcall'd: a Player is userdata, and reading a field off one who has already left can throw.
local function userIdOf(player: any): number?
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and type(id) == "number" and id == id then id else nil
end
local function nameOf(player: any): string
	local ok, name = pcall(function(): any return (player :: any).Name end)
	return if ok and type(name) == "string" then name else "Occupant"
end
-- NaN/inf/nil all collapse to 0: these figures are written straight back into a save.
local function currency(v: any): number
	local finite = type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
	return if finite then math.clamp(v :: number, 0, MAX_CURRENCY) else 0
end
local function occupantsOf(sanctum: any): { Player }
	return if plots ~= nil then plots:GetOccupants(sanctum) else {}
end
local function plotIdOf(sanctum: any): number
	local id = if type(sanctum) == "table" then (sanctum :: { [string]: any }).Id else nil
	return if type(id) == "number" and id == id then id else 0
end
-- Authorisation: only a live occupant of THIS Sanctum may open or answer its vote.
local function isOccupant(sanctum: any, player: any): boolean
	for _, other in ipairs(occupantsOf(sanctum)) do
		if other == player then return true end
	end
	return false
end
local function notify(sanctum: any, kind: string, text: string): ()
	if remotes == nil then return end
	remotes:FireClients(occupantsOf(sanctum), "Notify", { Kind = kind, Text = text })
end

-- The ballot as the client renders it. Keys are STRINGS (RebirthController indexes Names/Votes by
-- tostring(UserId)), and an ExpiresAt that is not in the future is the terminal push every ending
-- shares -- which is what closes the modal on a cancel, an expiry and a completed vote alike.
local function broadcast(sanctum: any, vote: Vote?): ()
	if remotes == nil then return end
	local names: { [string]: string }, ballots: { [string]: boolean } = {}, {}
	local recipients = occupantsOf(sanctum)
	if vote ~= nil then
		for _, player in ipairs(recipients) do
			local userId = userIdOf(player)
			if userId ~= nil then
				names[tostring(userId)] = nameOf(player)
				local cast = vote.Ballots[userId]
				if cast ~= nil then ballots[tostring(userId)] = cast end
			end
		end
	end
	remotes:FireClients(recipients, "RebirthVoteState", { PlotId = plotIdOf(sanctum),
		Votes = ballots, Names = names, ExpiresAt = if vote ~= nil then vote.ExpiresAt else 0 })
end

function Service:CanTranscend(sanctum: any): (boolean, string)
	local state = stateOf(sanctum)
	if state == nil then return false, Reason.UnknownSanctum end
	return Economy.transcendStatus(state :: any)
end

-- Grants prestige, wipes the Sanctum and re-seeds it. Reached only from a unanimous ballot, so
-- "every occupant" and "everyone who voted yes" (spec 9.5 item 2) are the same set here.
function Service:Execute(sanctum: any): ()
	local state = stateOf(sanctum)
	if state == nil then return end
	active[sanctum] = nil
	local occupants = occupantsOf(sanctum)
	local banked = currency(state.LifetimeEssence) -- read BEFORE the reset zeroes it
	for _, player in ipairs(occupants) do
		local profile = if profiles ~= nil then profiles:Get(player) else nil
		local prestige = if type(profile) == "table" then (profile :: any).Prestige else nil
		if type(prestige) == "table" then
			local rebirths = math.clamp(math.floor(currency(prestige.Rebirths)) + 1, 0, RebirthData.MaxTrackedRebirths)
			prestige.Rebirths = rebirths
			-- Recomputed, never incremented: the stored multiplier is a cache of the count, and one
			-- bad write would otherwise become a permanent income bonus.
			prestige.Multiplier = Economy.getPrestigeMultiplier(rebirths)
			-- badgesFor returns the FULL earned set, so merging it in also self-heals an award lost
			-- to a failed save. Merged into, never replaced: a hand-granted badge survives.
			if type(prestige.Badges) ~= "table" then prestige.Badges = {} end
			for id, earned in pairs(RebirthData.badgesFor(rebirths)) do
				if earned then (prestige.Badges :: { [string]: boolean })[id] = true end
			end
			prestige.TotalTranscended = math.min(currency(prestige.TotalTranscended) + banked, MAX_CURRENCY)
		end
	end

	-- The Sanctum, not the players: Prestige lives in a different table precisely so a bug here
	-- cannot touch the one thing players cannot re-earn.
	local fresh = StateSchema.newPlotState()
	-- THE COLD-START INVARIANT, restored here as well as in PlotSession: a Sanctum with no Wellspring
	-- earns exactly zero, and zero income never affords a first purchase, so the pair would be stuck
	-- forever holding a fresh multiplier they could not use.
	local starter = DropperData.get(STARTER_DROPPER) or DropperData.List[1]
	if starter ~= nil then fresh.Droppers[starter.Id] = 1 end
	;(sanctum :: { [string]: any }).State = fresh

	-- Motes in flight belong to the run that just ended; crediting them would pay the pair for
	-- pressing the button. RebuildSanctum re-derives emit streams, Wings, the cache and pad wording.
	if plots ~= nil then
		plots:ClearMotes(sanctum)
		plots:RebuildSanctum(sanctum)
	end
	-- Explicit as well as via RebuildSanctum: prestige just changed, and RebuildSanctum is a no-op
	-- for a Sanctum this PlotService does not own (a spec fixture), where the cache would stay stale.
	if economy ~= nil then economy:RefreshMultipliers(sanctum) end
	if evolution ~= nil then
		evolution:ApplyStageVisuals(sanctum) -- Conflux back to Stage 1, four Wings back out of the world
		evolution:ApplyStageStats(sanctum) -- and both characters back to 16 studs/s
	end
	if plots ~= nil then plots:MarkDirty(sanctum) end

	if remotes ~= nil then
		remotes:FireClients(occupants, "Fx", { Kind = "transcend", PlotId = plotIdOf(sanctum) })
	end
	notify(sanctum, "success", "The Conflux transcends. The Sanctum is new; the power is yours to keep.")
	-- Mirror the RESET plot, then save immediately rather than at the next autosave: PlotService's
	-- own mirror is up to a second away (see the note at the top), and a rebirth lost to a crash is
	-- unrecoverable because the hour of progress that bought it is already gone from the Sanctum.
	for _, player in ipairs(occupants) do
		local profile = if profiles ~= nil then profiles:Get(player) else nil
		if type(profile) == "table" then (profile :: any).Plot = StateSchema.clonePlotState(fresh) end
		if profiles ~= nil then profiles:Save(player) end
	end
end

-- Cancels the live vote and pushes the terminal state. Total and idempotent: it is reached from a
-- "no", a departure, an expiry and a roster change, and two of those can land on one frame.
function Service:Cancel(sanctum: any, reason: string): ()
	local vote = if type(sanctum) == "table" then active[sanctum] else nil
	if vote == nil then return end
	active[sanctum] = nil
	broadcast(sanctum, nil)
	notify(sanctum, "warn", if reason == Reason.Expired
		then "The Transcendence vote expired. Nothing was reset."
		else "The Transcendence vote was called off. Nothing was reset.")
end

--[[ Unanimity is measured against the LIVE occupant list, not against who was present when the vote
     opened: that is what makes "every occupant must vote yes" true at the moment of the reset rather
     than thirty seconds earlier. Only an occupant can reach here, so it is never vacuously true. ]]
local function tally(sanctum: any, vote: Vote): ()
	for _, other in ipairs(occupantsOf(sanctum)) do
		local id = userIdOf(other)
		if id == nil or vote.Ballots[id] ~= true then
			broadcast(sanctum, vote)
			return
		end
	end
	Service:Execute(sanctum)
end

-- Opens the window. The initiator's own yes is counted immediately (they asked for it), which is
-- also what makes a SOLO occupant's single vote unanimous and executes on the spot.
function Service:BeginVote(player: any, sanctum: any): (boolean, string)
	local state = stateOf(sanctum)
	if state == nil then return false, Reason.UnknownSanctum end
	if not isOccupant(sanctum, player) then return false, Reason.NoPlayer end
	if active[sanctum] ~= nil then return false, Reason.VoteOpen end
	-- Re-checked against LIVE state: the pad's wording, the client's snapshot and any check made
	-- before the walk to the pad are all stale by definition.
	local allowed, reason = Economy.transcendStatus(state :: any)
	if not allowed then return false, reason end
	local userId = userIdOf(player)
	if userId == nil then return false, Reason.NoPlayer end

	local vote: Vote = { Sanctum = sanctum, ExpiresAt = os.time() + WINDOW, Ballots = { [userId] = true } }
	active[sanctum] = vote
	-- Identity, not a token, is the cancellation: a later vote on this Sanctum is a DIFFERENT table,
	-- so a stale timer finds a mismatch and leaves the new vote alone.
	task.delay(WINDOW, function()
		if active[sanctum] == vote then Service:Cancel(sanctum, Reason.Expired) end
	end)
	tally(sanctum, vote) -- broadcasts, or executes outright when the initiator is the only occupant
	return true, Reason.Ok
end

-- The RebirthVote remote lands here. The Sanctum comes from the sender's live occupancy, so nobody
-- can vote in a Transcendence they are not part of, and no payload names a plot.
function Service:CastVote(player: any, accept: boolean): ()
	local sanctum = if plots ~= nil then plots:GetSanctumForPlayer(player) else nil
	if sanctum == nil then return end
	local vote = active[sanctum]
	if vote == nil then
		-- Nothing open: a yes is a request to start one (the client's Confirm button doubles as
		-- both), and a no has nothing to refuse.
		if accept == true then Service:BeginVote(player, sanctum) end
		return
	end
	if not isOccupant(sanctum, player) then return end
	if accept ~= true then
		-- One no ends it at once. Waiting out the window would leave the pair staring at a countdown
		-- whose outcome is already decided.
		Service:Cancel(sanctum, Reason.Declined)
		return
	end
	local userId = userIdOf(player)
	if userId == nil then return end
	vote.Ballots[userId] = true
	tally(sanctum, vote)
end

function Service:Init(registry: any): () -- ServiceRegistry contract; resolve peers only
	-- Resolved only: section 6 forbids cross-service calls during Init.
	plots = registry:Get("PlotService")
	economy = registry:Get("EconomyService")
	profiles = registry:Get("ProfileService")
	remotes = registry:Get("RemoteService")
	-- TryGet, not Get: EvolutionService is registered before this one so it is always there on a real
	-- boot, but its role here is PRESENTATION (repaint the Conflux, re-apply walk speed). A reset is
	-- correct without it, and refusing to boot a server over a cosmetic peer would be worse.
	evolution = registry:TryGet("EvolutionService")
	-- A re-Init must not inherit the previous boot's connections, nor a ballot from a dead world.
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	active = newBallotBook()
end

function Service:Start(): ()
	if remotes ~= nil then
		remotes:On("RebirthVote", function(player: Player, payload: any)
			Service:CastVote(player, type(payload) == "table" and (payload :: any).Accept == true)
		end)
	end
	-- Any change to who is in the Sanctum cancels the vote: a leaver would otherwise have their yes
	-- counted for a reset they are not part of, and a partner linking in mid-vote would be reset by
	-- a decision nobody asked them about.
	if plots ~= nil then
		local function roster(sanctum: any)
			Service:Cancel(sanctum, Reason.RosterChanged)
		end
		table.insert(connections, plots.OccupantRemoved:Connect(roster))
		table.insert(connections, plots.OccupantAdded:Connect(roster))
	end
end

function Service:Stop(): ()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RemoteService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    RemoteService
    The one door a client -> server message walks through: it builds the SanctumRemotes folder and
    every RemoteEvent RemoteSchema declares, then funnels every inbound event into one guarded
    dispatcher -- sender check, rate-limit token, payload validation, handler inside a pcall, so one
    erroring handler cannot take a remote down for everybody. Outbound sends are name- and
    direction-checked against the same schema, so a typo is a boot-time error rather than silence.
    Owner: server/Services  |  Consumers: every service that talks to a client, RateLimiter, tests
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))

-- Spec section 3.1: anything with :Disconnect() is a connection -- structural, so the mock fits too.
type Connection = { Disconnect: (self: any) -> () }
type Handler = (player: Player, payload: any) -> ()

-- A local mirror of RemoteSchema.RemoteDef rather than an import: the test bundler strips `export`
-- from type aliases, so a cross-module type reference would not resolve inside the harness.
type RemoteDef = {
	Name: string, Direction: string, RateLimit: { Tokens: number, Interval: number }?,
	Validate: ((payload: any) -> (boolean, string?))?,
}

local C2S = "ClientToServer"
local S2C = "ServerToClient"

--[[ A rejected call is one an exploiter repeats as fast as the network allows. Counting each is
     cheap; PRINTING each is not -- unthrottled warns turn a spam loop into a log flood, itself a
     denial of service. The counter always increments; only the warn is rationed, per player. ]]
local WARN_INTERVAL = 10

--[[ Rejection bucket for anything that is not a live player: a garbage first argument, or a stale
     Player whose PlayerRemoving has already run. Neither can be cleaned up later, so keying them by
     real UserId would re-create entries nothing removes -- one slow leak per departed player. ]]
local UNKNOWN_SENDER = 0

local Service = {}
Service.Name = "RemoteService"

-- The clock behind the warn throttle, read through this field so tests can substitute it. tick() is
-- the clock the headless harness can advance; its backwards jumps are handled in noteRejection.
Service.Clock = tick

Service._rateLimiter = nil :: any
Service._folder = nil :: any
Service._remotes = {} :: { [string]: any }
Service._handlers = {} :: { [string]: Handler }
Service._connections = {} :: { Connection }
Service._rejections = {} :: { [number]: { [string]: number } }
Service._lastWarn = {} :: { [number]: number }

--[[ True only for a player the server can still reach. `Parent ~= Players` is the O(1) "still in
     Players" test (engine and mock both unparent on PlayerRemoving); the typeof/IsA pair in front
     makes it total, since Mock.fireServer hands this nils and tables that .Parent would throw on. ]]
local function isLivePlayer(player: any): boolean
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

-- Record one rejection and, at most once per player per WARN_INTERVAL, say so. `reason` is for the
-- SERVER log only: telling an exploiter which gate stopped them is free reconnaissance.
local function noteRejection(self: any, userId: number, remoteName: string, reason: string): ()
	local byRemote = self._rejections[userId]
	if byRemote == nil then
		byRemote = {}
		self._rejections[userId] = byRemote
	end
	byRemote[remoteName] = (byRemote[remoteName] or 0) + 1

	local now = Service.Clock()
	local last = self._lastWarn[userId]
	-- `now < last` means the clock jumped backwards (tick() follows the host wall clock); warn and
	-- re-anchor, because a bare `now - last < WARN_INTERVAL` would mute the log for the whole jump.
	if last ~= nil and now >= last and now - last < WARN_INTERVAL then
		return
	end
	self._lastWarn[userId] = now
	warn(string.format("[RemoteService] rejected %s from userId %d: %s", remoteName, userId, reason))
end

-- The guarded path every inbound message takes. It NEVER errors (an error unwinds the shared
-- OnServerEvent thread) and NEVER replies (a reply leaks which gate closed).
local function dispatch(self: any, def: RemoteDef, player: any, payload: any): ()
	-- 1. Sender. The engine supplies this, but a stale reference still arrives -- an event queued
	-- before a disconnect lands after it -- and that Player has no profile, sanctum or character.
	if not isLivePlayer(player) then
		noteRejection(self, UNKNOWN_SENDER, def.Name, "sender is not a live player")
		return
	end
	-- A non-number UserId cannot happen on a real Player, but the rejection table is keyed by it and
	-- `t[nil] = v` throws -- exactly the crash this dispatcher exists to prevent.
	local raw = player.UserId
	local userId: number = if type(raw) == "number" then raw else UNKNOWN_SENDER
	-- An inbound def missing either piece is a RemoteSchema bug. Fail closed rather than skipping
	-- the missing check: a visibly dead feature beats an unthrottled or unvalidated front door.
	local budget, validate = def.RateLimit, def.Validate
	if budget == nil or validate == nil then
		noteRejection(self, userId, def.Name, "schema entry has no rate limit or validator")
		return
	end

	-- 2. Rate limit BEFORE validation: validation is the pricier check, so a flood dies cheaper here.
	if not self._rateLimiter:Consume(player, def.Name, budget.Tokens, budget.Interval) then
		noteRejection(self, userId, def.Name, "rate limited")
		return
	end

	-- 3. Payload. RemoteSchema wraps every validator so it cannot throw; the pcall is here because
	-- this module must not lean on that promise -- an escaping error would skip the accounting.
	local ran, accepted, why = pcall(validate, payload)
	if not ran then
		noteRejection(self, userId, def.Name, "validator errored")
		return
	elseif accepted ~= true then
		noteRejection(self, userId, def.Name, if type(why) == "string" then why else "invalid payload")
		return
	end

	-- 4. Nothing has claimed this remote. Counted, not ignored: normal during boot, dead feature after.
	local handler = self._handlers[def.Name]
	if handler == nil then
		noteRejection(self, userId, def.Name, "no handler registered")
		return
	end

	-- 5. The handler is another service's code reached from the network edge. Isolate it. The warn is
	-- not throttled -- an erroring handler is a server bug worth seeing, and step 2 already caps it.
	local ok, err = pcall(handler, player, payload)
	if not ok then
		warn(string.format("[RemoteService] handler for %s errored: %s", def.Name, tostring(err)))
	end
end

--[[ Resolve an outbound remote, erroring on a name that is unknown or inbound. Outbound names are
     server-authored constants, so a wrong one is a typo; returning nil (ServiceRegistry:Get's
     reasoning) would make it a message that never arrives. Level 3 blames Fire*'s caller. ]]
local function outbound(self: any, name: string, caller: string): any
	local def: RemoteDef? = RemoteSchema.get(name)
	if def == nil or def.Direction ~= S2C then
		local why = if def == nil then "no such remote in RemoteSchema" else "that remote is inbound"
		error(string.format("RemoteService:%s('%s'): %s", caller, tostring(name), why), 3)
	end
	local remote = self._remotes[name]
	if remote == nil then
		error(string.format("RemoteService:%s('%s'): remote missing -- Init has not run", caller, name), 3)
	end
	return remote
end

--[[ `parent`'s child of `className` named `name`, created only if absent. Reuse is the point: after
     a soft restart clients still hold references to these instances, and rebuilding would leave them
     listening to dead ones. A wrong-class squatter is destroyed -- WaitForChild would resolve it. ]]
local function ensureChild(parent: any, className: string, name: string): any
	local existing = parent:FindFirstChild(name)
	if existing ~= nil then
		if existing:IsA(className) then
			return existing
		end
		existing:Destroy()
	end
	local created = Instance.new(className)
	created.Name = name
	-- Parented last, so a client's WaitForChild can only ever resolve a fully built instance.
	created.Parent = parent
	return created
end

function Service:_disconnectAll(): ()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
end

function Service:Init(registry: any): ()
	self._rateLimiter = registry:Get("RateLimiter")
	-- A re-Init must not inherit live connections from the previous run: an orphaned OnServerEvent
	-- handler would keep dispatching into the discarded handler table forever.
	self:_disconnectAll()
	self._handlers = {}
	self._rejections = {}
	self._lastWarn = {}
	self._remotes = {}
	self._folder = ensureChild(ReplicatedStorage, "Folder", RemoteSchema.FolderName)
	-- ipairs over the sorted List, never pairs over .Remotes: `pairs` order is unspecified, and the
	-- List puts every server -> client remote FIRST so a listening client cannot miss an early push.
	for _, def in ipairs(RemoteSchema.List :: { RemoteDef }) do
		self._remotes[def.Name] = ensureChild(self._folder, "RemoteEvent", def.Name)
	end
end

function Service:Start(): ()
	for _, def in ipairs(RemoteSchema.List :: { RemoteDef }) do
		local remote = self._remotes[def.Name]
		if def.Direction ~= C2S or remote == nil then
			continue
		end
		-- Arguments past the first are dropped rather than rejected: the handler signature is fixed
		-- at (player, payload), so a smuggled extra has nowhere to arrive.
		local connection = remote.OnServerEvent:Connect(function(player: any, payload: any)
			dispatch(self, def, player, payload)
		end)
		table.insert(self._connections, connection)
	end
	-- Without this the rejection and warn-throttle tables keep one entry per departed player for the
	-- lifetime of the server.
	local removing = Players.PlayerRemoving:Connect(function(player: Player)
		local userId = player.UserId
		if type(userId) == "number" then
			self._rejections[userId] = nil
			self._lastWarn[userId] = nil
		end
	end)
	table.insert(self._connections, removing)
end

-- Disconnects only. The folder and its remotes deliberately survive, so a Stop/Init cycle does not
-- invalidate the references every connected client is already holding.
function Service:Stop(): ()
	self:_disconnectAll()
end

-- Claim a client -> server remote. Every refusal here is a mistake made at boot by trusted code, so
-- it errors: a silent no-op would leave a feature unreachable with nothing in the log to say why.
function Service:On(name: string, handler: Handler): ()
	local def: RemoteDef? = RemoteSchema.get(name)
	if def == nil or def.Direction ~= C2S then
		local why = if def == nil then "no such remote in RemoteSchema" else "that remote is outbound"
		error(string.format("RemoteService:On('%s'): %s", tostring(name), why), 2)
	end
	if type(handler) ~= "function" then
		error(string.format("RemoteService:On('%s') expects a function, got %s", name, typeof(handler)), 2)
	end
	if self._handlers[name] ~= nil then
		-- Two handlers on one remote has no good reading: either the second replaces the first (a
		-- feature stops working) or both run (every payload processed twice, once per service).
		error(string.format("RemoteService:On('%s'): a handler is already registered", name), 2)
	end
	self._handlers[name] = handler
end

-- A player can leave between the decision to send and the send (a reply to their own remote, a
-- queued notify). That race is unavoidable, so a departed target is skipped; only a bad NAME errors.
function Service:FireClient(player: Player, name: string, payload: any): ()
	local remote = outbound(self, name, "FireClient")
	if not isLivePlayer(player) then
		return
	end
	remote:FireClient(player, payload)
end

function Service:FireClients(players: { Player }, name: string, payload: any): ()
	local remote = outbound(self, name, "FireClients")
	-- A non-table list is a caller reading an empty sanctum; nothing to send is not an error.
	if type(players) ~= "table" then
		return
	end
	for _, player in ipairs(players) do
		if isLivePlayer(player) then
			remote:FireClient(player, payload)
		end
	end
end

function Service:FireAllClients(name: string, payload: any): ()
	outbound(self, name, "FireAllClients"):FireAllClients(payload)
end

-- nil for an unknown name rather than an error: "does this remote exist" is a fair question.
function Service:GetRemote(name: string): RemoteEvent?
	if type(name) ~= "string" then
		return nil
	end
	return self._remotes[name]
end

-- userId -> remote name -> rejection count. Copied, not handed out live: a telemetry reader that
-- mutated the table would corrupt the counters it reads. userId 0 is UNKNOWN_SENDER.
function Service:GetRejectionStats(): { [number]: { [string]: number } }
	local copy: { [number]: { [string]: number } } = {}
	for userId, byRemote in pairs(self._rejections) do
		copy[userId] = table.clone(byRemote)
	end
	return copy
end

-- The warn throttle is cleared alongside the counters: a stale timestamp would otherwise mute the
-- first warning of the next test or telemetry window for up to WARN_INTERVAL seconds.
function Service:ResetRejectionStats(): ()
	table.clear(self._rejections)
	table.clear(self._lastWarn)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">StateReplicator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StateReplicator
	The only sender of StateSync. It runs ONE Heartbeat accumulator for the whole server and, at most
	every GameConfig.Network.SnapshotIntervalSeconds, gives each occupied Sanctum exactly one of two
	pushes: a FULL snapshot (spec section 7) when the Sanctum is marked Dirty, or an essence-only
	fast tick when only the shared wallet moved. Essence is the one field that changes many times a
	second; Stage, Occupants, Gates and the rest change on a purchase or an attunement, so sending
	them at essence cadence would be the same payload twenty times over for nothing.
	Snapshot.forClient is pure and cannot fetch a Profile, so the per-player Prestige/Settings/Stats
	it renders are gathered here from ProfileService and handed in.
	Owner: server/Services  |  Consumers: Bootstrap (registration), every client through StateSync
]]

local RunService = game:GetService("RunService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Snapshot = require(Modules:WaitForChild("Snapshot"))
local StateSchema = require(Modules:WaitForChild("StateSchema"))

-- Spec section 3.1: a connection is anything with :Disconnect(). Structural, so this behaves the
-- same under Roblox's RBXScriptConnection and under the headless mock.
type Connection = { Disconnect: (self: any) -> () }
type ProfileMap = { [number]: any }
type NameMap = { [number]: string }

--[[ Floor on the push period. GameConfig.Debug is deliberately mutable and the rest of the config is
     hand-edited, so a 0 (or a NaN, which loses every comparison) would put a full snapshot per
     player on EVERY frame -- the exact bandwidth blowout this service exists to prevent. ]]
local MIN_INTERVAL = 1 / 30
local CONFIGURED = GameConfig.Network.SnapshotIntervalSeconds
local INTERVAL = if type(CONFIGURED) == "number" and CONFIGURED == CONFIGURED
	then math.max(CONFIGURED, MIN_INTERVAL)
	else 0.5
local WARN_SECONDS = 10 -- throttle on the per-Sanctum push-failure warning

local Service = {}
Service.Name = "StateReplicator"

local plots: any, profiles: any, remotes: any, economy: any = nil, nil, nil, nil
local heartbeat: Connection? = nil
local accumulator, tickCount, lastWarn = 0, 0, 0

--[[ Sanctum -> the Essence value its occupants were last told about. WEAK KEYS: PlotService rebuilds
     its Sanctums on a re-Init, and a strong key here would pin every discarded one (with its model,
     runtime and occupant table) alive for the life of the server. ]]
local function newEssenceCache(): { [any]: number }
	return (setmetatable({}, { __mode = "k" }) :: any) :: { [any]: number }
end
local lastEssence: { [any]: number } = newEssenceCache()

-- pcall'd: a Player is userdata, and reading a field off one who has already left can throw. A
-- failed read means "cannot identify this player", never an error inside the replication loop.
local function userIdOf(player: any): number?
	if player == nil then return nil end
	local ok, id = pcall(function(): any return (player :: any).UserId end)
	return if ok and type(id) == "number" and id == id then id else nil
end

local function nameOf(player: any): string?
	local ok, name = pcall(function(): any return (player :: any).Name end)
	return if ok and type(name) == "string" then name else nil
end

local function essenceOf(sanctum: any): number
	local state = (sanctum :: { [string]: any }).State
	local essence = if type(state) == "table" then (state :: { [string]: any }).Essence else nil
	-- NaN is deliberately NOT normalised away: `NaN ~= NaN` makes the change test fire every tick,
	-- which is the correct behaviour for a wallet that has been corrupted -- the client sees it.
	return if type(essence) == "number" then essence else 0
end

--[[ Prestige, Settings and Stats live in per-player Profiles. Snapshot.forClient is pure and takes
     them as `opts.Profiles` / `opts.Names` keyed by UserId, so they are collected here. A player
     with no loaded profile is simply absent from the map: Snapshot then renders a zeroed You block
     for them rather than borrowing somebody else's prestige. ]]
local function gather(players: { Player }): (ProfileMap, NameMap)
	local profileById: ProfileMap, nameById: NameMap = {}, {}
	for _, player in ipairs(players) do
		local userId = userIdOf(player)
		if userId ~= nil then
			profileById[userId] = if profiles ~= nil then profiles:Get(player) else nil
			local name = nameOf(player)
			if name ~= nil then nameById[userId] = name end
		end
	end
	return profileById, nameById
end

--[[ ONE payload per player, not one per Sanctum: a full snapshot carries `IsYou` on each occupant
     and a private `You` block (that player's badges, settings and lifetime earnings), so two
     occupants of the same Sanctum must never be sent the same table. ]]
local function pushFull(sanctum: any, players: { Player }): ()
	local profileById, nameById = gather(players)
	local opts = {
		Full = true,
		Tick = tickCount,
		MoteCount = plots:GetMoteCount(sanctum),
		Profiles = profileById,
		Names = nameById,
		-- EconomyService's cached (and frozen) Multipliers. Passing them keeps Snapshot from walking
		-- the whole upgrade catalogue once per occupant per push.
		Multipliers = economy:GetMultipliers(sanctum),
	}
	for _, player in ipairs(players) do
		remotes:FireClient(player, "StateSync", Snapshot.forClient(sanctum, player, opts))
	end
end

-- The fast tick is identical for every occupant -- the wallet is shared and the payload carries
-- nothing player-specific -- so it is built once and broadcast.
local function pushFast(sanctum: any, players: { Player }): ()
	local payload = Snapshot.forClient(sanctum, nil, { Full = false, Tick = tickCount })
	remotes:FireClients(players, "StateSync", payload)
end

--[[ Public API ]]

--[[ An immediate FULL snapshot for one player, whatever the accumulator is doing. This answers
     RequestSnapshot, so it must be total: a client that just respawned is exactly the case where
     the server's own state may be unusual. ]]
function Service:PushTo(player: any): ()
	if remotes == nil then return end
	tickCount += 1
	local sanctum = if plots ~= nil then plots:GetSanctumForPlayer(player) else nil
	if sanctum ~= nil then
		pushFull(sanctum, { player :: Player })
		return
	end
	--[[ No Sanctum yet -- the profile is still loading, every plot is full, or their plot's grace
	     window expired. They still get a VALID snapshot rather than nothing: the client's controllers
	     all read the store, and leaving them on ClientStore's zeroed default forever would show a
	     HUD that never acknowledges the player exists. Their own prestige and settings are real; the
	     plot half is an empty Sanctum, which is the honest answer. ]]
	local userId = userIdOf(player)
	local empty = { Id = 0, State = StateSchema.newPlotState(), Occupants = {} }
	local profileById: ProfileMap, nameById: NameMap = {}, {}
	if userId ~= nil then
		profileById[userId] = if profiles ~= nil then profiles:Get(player) else nil
		local name = nameOf(player)
		if name ~= nil then nameById[userId] = name end
	end
	remotes:FireClient(player, "StateSync", Snapshot.forClient(empty, player, {
		Full = true, Tick = tickCount, MoteCount = 0, Profiles = profileById, Names = nameById,
	}))
end

--[[ An immediate FULL snapshot to every occupant of one Sanctum -- for a caller that has just made
     a change too important to wait out the accumulator (an attunement, a transcendence). ]]
function Service:PushSanctum(sanctum: any): ()
	if plots == nil or remotes == nil or type(sanctum) ~= "table" then return end
	local players = plots:GetOccupants(sanctum)
	if #players == 0 then return end
	tickCount += 1
	--[[ The flag is cleared because this push IS the full snapshot the flag asks for; leaving it set
	     would send the identical payload again on the very next accumulator tick. Essence is recorded
	     for the same reason -- a full snapshot already carries it. ]]
	local record = sanctum :: { [string]: any }
	record.Dirty = false
	lastEssence[sanctum] = essenceOf(sanctum)
	pushFull(sanctum, players)
end

--[[ The loop ]]

local function replicate(sanctum: any): ()
	local players = plots:GetOccupants(sanctum)
	--[[ Nobody to tell. The Dirty flag is deliberately LEFT SET: an empty Sanctum can still be
	     mutated (its grace window expires and PlotService resets it), and clearing the flag with no
	     audience would mean the next player to claim this plot never receives that change. ]]
	if #players == 0 then return end

	local record = sanctum :: { [string]: any }
	local essence = essenceOf(sanctum)
	if record.Dirty == true then
		-- Cleared BEFORE the push: pushFull cannot yield, but clearing first means a re-entrant
		-- MarkDirty (a credit landing inside a handler) survives into the next tick instead of
		-- being wiped by this one.
		record.Dirty = false
		lastEssence[sanctum] = essence
		pushFull(sanctum, players)
	elseif lastEssence[sanctum] ~= essence then
		--[[ Only reachable when the wallet moved WITHOUT a dirty flag. Nothing in the shipped server
		     does that (EconomyService marks dirty on every credit and debit), so this branch is the
		     safety net that keeps the HUD's essence counter live if that ever stops being true. ]]
		lastEssence[sanctum] = essence
		pushFast(sanctum, players)
	end
end

local function onHeartbeat(dt: any): ()
	-- A non-number or NaN dt would poison the accumulator permanently: every later comparison
	-- against NaN is false, so the loop would never push again.
	accumulator += if type(dt) == "number" and dt == dt then dt else 0
	if accumulator < INTERVAL then return end
	-- Reset rather than subtract: after a server hitch the banked time would otherwise fire several
	-- pushes back to back, which is the burst the throttle exists to prevent.
	accumulator = 0
	tickCount += 1
	plots:ForEachSanctum(function(sanctum: any)
		--[[ Per-Sanctum pcall, not one around the whole sweep: a failure on plot 3 must not stop
		     plots 4-6 replicating, and an unguarded error would kill this connection -- and with it
		     every client's HUD -- for the rest of the server's life. ]]
		local ok, err = pcall(replicate, sanctum)
		if not ok and os.clock() - lastWarn >= WARN_SECONDS then
			lastWarn = os.clock()
			warn(("[StateReplicator] snapshot push failed: %s"):format(tostring(err)))
		end
	end)
end

--[[ ServiceRegistry contract ]]

function Service:Init(registry: any): ()
	-- Resolved only: section 6 forbids cross-service calls during Init. This service is registered
	-- LAST, so every peer already exists and Get is right -- a missing one is a Bootstrap bug.
	plots = registry:Get("PlotService")
	profiles = registry:Get("ProfileService")
	remotes = registry:Get("RemoteService")
	economy = registry:Get("EconomyService")
	-- A re-Init must not leave the previous boot's Heartbeat running: it would push snapshots built
	-- from Sanctums PlotService has already destroyed.
	if heartbeat ~= nil then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	accumulator, tickCount, lastWarn = 0, 0, 0
	-- Rebuilt so a re-Init never compares a fresh Sanctum's wallet against a previous boot's reading.
	lastEssence = newEssenceCache()
end

function Service:Start(): ()
	-- The client asks for this on join and on every respawn: the HUD survives a respawn, and a quiet
	-- plot may not go dirty again for minutes, so without an on-demand full push a respawned player
	-- could sit on a stale snapshot indefinitely. RemoteService rate-limits it at 4 per 5s.
	remotes:On("RequestSnapshot", function(player: Player)
		Service:PushTo(player)
	end)
	heartbeat = RunService.Heartbeat:Connect(onHeartbeat)
end

function Service:Stop(): ()
	if heartbeat ~= nil then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	lastEssence = newEssenceCache()
end

return Service
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="43">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">BuildKit</string>
            <string name="Source"><![CDATA[--!strict
--[[
    BuildKit
    The construction primitives PlotBuilder assembles a Sanctum from: one Part factory that cannot
    forget to anchor, one billboard-sign factory, one folder helper, and the shared geometry and
    material constants they use.

    Split out of PlotBuilder purely to keep both files inside the project's 300-line budget. It has
    no game knowledge -- nothing here reads a data table or a PlotState.
    Owner: server  |  Consumers: PlotBuilder
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Theme = require(Modules:WaitForChild("Theme"))

local BuildKit = {}

type PartProps = { Name: string, Size: Vector3, CFrame: CFrame, Color: Color3, Parent: Instance,
	Material: Enum.Material, Transparency: number?, CanCollide: boolean? }

-- PlotLayout owns every POSITION; these are the extents that fill the space it reserves. Its pad
-- line spacing is 12 studs so a 6-stud pad leaves a walkway, and a 2-tall pad centred on its
-- PAD_HEIGHT of 1.5 rests on the 0.5 slab top rather than hovering.
local PAD_SIZE = Vector3.new(6, 2, 6)
local FONT_SIZE, MARKER_SIZE = Vector3.new(12, 6, 12), Vector3.new(8, 0.2, 8)
local MARKER_DROP = -3.4 -- spawn CFrames float at head clearance; the decal belongs on the floor
local MAX_CONFLUX_SIZE = 60 -- keeps a corrupt stage entry from producing a Sanctum-filling cube
local MAX_LIGHT_RANGE = 60 -- PointLight.Range is hard-capped at 60 by the engine
local RAIL_WIDTH, RAIL_THICKNESS, MIN_RAIL_LENGTH = 2.2, 0.4, 0.5 -- below MIN a segment is degenerate

-- Theme has materials for the Conflux and the Affinities but none for static architecture, so a
-- Sanctum's structural materials are named once here. NEON covers rails and the Font: both glow, so
-- they read as live ley-work rather than as more masonry.
local FLOOR_MATERIAL, PAD_MATERIAL = Enum.Material.Slate, Enum.Material.Metal
local NEON, MARKER_MATERIAL = Enum.Material.Neon, Enum.Material.ForceField

local function newFolder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function makePart(props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.Name
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color
	part.Material = props.Material
	part.Anchored = true -- correctness, not optimisation: an unanchored slab falls out of the world
	part.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	part.Transparency = props.Transparency or 0
	part.Parent = props.Parent
	return part
end

-- A blank billboard label. PurchaseService writes pad wording; the Font supplies its own up front.
local function makeSign(adornee: Instance, text: string, height: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.new(0, 220, 0, 70)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 90 -- 6 Sanctums x ~25 signs = 150 billboards; cull the already-illegible ones
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Theme.Ui.Text
	label.TextStrokeTransparency = 0.4 -- pads glow; a stroke keeps the text off its own background
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	return label
end

BuildKit.PAD_SIZE = PAD_SIZE
BuildKit.FONT_SIZE = FONT_SIZE
BuildKit.MARKER_SIZE = MARKER_SIZE
BuildKit.MARKER_DROP = MARKER_DROP
BuildKit.MAX_CONFLUX_SIZE = MAX_CONFLUX_SIZE
BuildKit.MAX_LIGHT_RANGE = MAX_LIGHT_RANGE
BuildKit.RAIL_WIDTH = RAIL_WIDTH
BuildKit.RAIL_THICKNESS = RAIL_THICKNESS
BuildKit.MIN_RAIL_LENGTH = MIN_RAIL_LENGTH
BuildKit.newFolder = newFolder
BuildKit.makePart = makePart
BuildKit.makeSign = makeSign

return BuildKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">DropperSystem</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DropperSystem
	The emit clock of one Sanctum. It keeps an independent accumulator per OWNED COPY of a Wellspring
	-- three Ember Vents are three staggered streams, not one stream emitting three Motes at once --
	re-reads each stream's interval from Economy on every Step so an upgrade or Attunement lands on
	the very next frame, and bounds catch-up so a laggy Step cannot avalanche. It builds no Instances
	and knows nothing about Motes: it announces OnSpawn(def, index) and PlotService decides what that
	means.
	Owner: server/Systems  |  Consumers: PlotService (owns one per Sanctum, drives it from the one
	                                     shared Heartbeat loop)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Signal = require(Modules:WaitForChild("Signal"))
local Economy = require(Modules:WaitForChild("Economy"))
local DropperData = require(Modules:WaitForChild("DropperData"))

type Dropper = DropperData.Dropper

-- Structural and deliberately loose. PlotService owns the real Sanctum type and requires THIS
-- module, so naming its type here would be a require cycle; only `State` is ever read, which also
-- lets the headless harness drive a Step with a plain table.
type Sanctum = { State: any }

type Stream = {
	Def: Dropper,
	Index: number, -- 1..owned: WHICH copy of this Wellspring, passed straight to OnSpawn
	Key: string, -- "<id>#<index>": the identity whose accumulator phase Rebuild preserves
	Elapsed: number, -- seconds banked toward the current interval
}

-- CATCH-UP BOUND. A Step arriving with a huge dt (a server hitch, a resumed Studio breakpoint, a
-- test calling Step(60)) must not emit one Mote per elapsed interval: at Economy's 0.15s floor that
-- is 400 spawns for ONE Wellspring inside ONE frame, each allocating a part -- the hitch would
-- become a freeze, which is exactly the failure this bound exists to prevent. Four is sized off the
-- production cadence (GameConfig.Income.TickRate = 10, so dt = 0.1): it absorbs a 0.6s stall at the
-- fastest legal interval and never fires in normal play.
local MAX_CATCHUP_PER_STEP = 4

-- Economy.getDropperInterval ignores its Multipliers argument BY DESIGN (prestige and Stage scale a
-- Mote's value, not the cadence -- scaling both would compound one bonus twice), but the signature
-- demands one. This neutral table keeps the seeding call honest without inventing a bonus.
local NEUTRAL: Economy.Multipliers = { Prestige = 1, Stage = 1, Affinity = 1, Upgrades = 1, Debug = 1 }

-- R2 low-discrepancy constants (1/g and 1/g^2 for the plastic number). Successive ordinals land far
-- apart in [0,1), so a freshly bought third Ember Vent syncs neither with the first two nor with a
-- Dew Font that happens to share its interval. Deterministic -- no Random -- so mote tests reproduce.
local PHASE_PER_DROPPER = 0.7548776662466927
local PHASE_PER_COPY = 0.5698402909980532

-- NaN is the reason this is not a plain `or`: every comparison against NaN is false, so an unguarded
-- clamp silently passes it through and one poisoned accumulator never emits again.
local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local DropperSystem = {}

local DropperRuntime = {}
DropperRuntime.__index = DropperRuntime

type DropperRuntimeSelf = {
	OnSpawn: Signal.Signal, -- (dropperDef: Dropper, index: number)
	_sanctum: Sanctum,
	_streams: { Stream }, -- iteration order for Step
	_byKey: { [string]: Stream }, -- phase-preservation index for Rebuild
	_destroyed: boolean,
}
type DropperRuntime = typeof(setmetatable({} :: DropperRuntimeSelf, DropperRuntime))

-- Owned count for one catalogue entry, hardened against a corrupt save: non-numbers, NaN, negatives
-- and fractions collapse to a whole number, and MaxOwned caps it so `Droppers.ember_vent = 1e9`
-- allocates 25 streams rather than a billion.
local function ownedCount(raw: any, def: Dropper): number
	local max = math.max(0, math.floor(num(def.MaxOwned, 0)))
	return math.clamp(math.floor(num(raw, 0)), 0, max)
end

-- Starting phase for a brand new stream, in seconds. Offsetting by the R2 fraction of the interval
-- is what stops a pair who just bought three Wellsprings from watching all three fire in lockstep
-- forever after.
local function initialElapsed(sanctum: Sanctum, def: Dropper, index: number): number
	local interval = Economy.getDropperInterval(def, sanctum.State, NEUTRAL)
	local order = num(def.Order, 1)
	local fraction = ((order - 1) * PHASE_PER_DROPPER + (index - 1) * PHASE_PER_COPY) % 1
	return interval * fraction
end

function DropperSystem.new(sanctum: Sanctum): DropperRuntime
	local self: DropperRuntime = setmetatable({
		OnSpawn = Signal.new(),
		_sanctum = sanctum,
		_streams = {},
		_byKey = {},
		_destroyed = false,
	}, DropperRuntime)
	-- A Sanctum loaded from a save already owns Wellsprings; without this it would sit silent until
	-- the first purchase happened to call Rebuild.
	self:Rebuild()
	return self
end

-- Re-derives the stream set from PlotState. Called after every purchase, Attunement and Transcendence.
function DropperRuntime.Rebuild(self: DropperRuntime): ()
	-- PlotService can release a Sanctum in the same frame a purchase queued a rebuild.
	if self._destroyed then
		return
	end
	local state = self._sanctum.State
	local owned = if type(state) == "table" then (state :: any).Droppers else nil
	local ownedMap: { [string]: any } = if type(owned) == "table" then owned else {}

	local streams: { Stream } = {}
	local byKey: { [string]: Stream } = {}
	-- Iterate the CATALOGUE, never the save. That is Economy's doctrine applied to the emit clock:
	-- an id injected into a tampered profile ("i_win" = 99) can never create a stream at all.
	for _, def in ipairs(DropperData.List) do
		local count = ownedCount(ownedMap[def.Id], def)
		for index = 1, count do
			local key = def.Id .. "#" .. index
			local stream = self._byKey[key]
			if stream == nil then
				-- Only genuinely NEW copies start fresh.
				stream = {
					Def = def,
					Index = index,
					Key = key,
					Elapsed = initialElapsed(self._sanctum, def, index),
				}
			else
				-- Reusing the table preserves Elapsed. Without that, every purchase would reset the
				-- timer of every Wellspring the pair already owned, so a fast-clicking player could
				-- starve their own income by never letting a stream reach its interval.
				stream.Def = def
			end
			streams[#streams + 1] = stream
			byKey[key] = stream
		end
	end
	self._streams = streams
	-- Streams for copies that are gone (a Transcendence reset) simply fall out of the new index.
	self._byKey = byKey
end

function DropperRuntime.Step(self: DropperRuntime, dt: number, multipliers: Economy.Multipliers): ()
	if self._destroyed then
		return
	end
	local step = num(dt, 0)
	-- A non-positive or non-finite dt (a clock that stepped backwards, a NaN out of a division)
	-- would either do nothing or poison every accumulator permanently. Drop the frame instead.
	if step <= 0 then
		return
	end
	local state = self._sanctum.State
	local m: Economy.Multipliers = if type(multipliers) == "table" then multipliers else NEUTRAL

	for _, stream in ipairs(self._streams) do
		-- Re-read every Step, never cached: a SpawnRate upgrade or an Affinity choice must change
		-- the cadence on the next frame, not at the next Rebuild. Economy floors this at 0.15, so it
		-- is always a safe divisor and a safe modulus below.
		local interval = Economy.getDropperInterval(stream.Def, state, m)
		local elapsed = stream.Elapsed + step
		local emitted = 0
		while elapsed >= interval and emitted < MAX_CATCHUP_PER_STEP do
			elapsed -= interval
			emitted += 1
			self.OnSpawn:Fire(stream.Def, stream.Index)
		end
		-- Backlog past the bound is DISCARDED, not banked. Carrying it would pin every Wellspring at
		-- the catch-up cap for minutes after a single hitch, turning one stutter into a lasting lag
		-- tax; the modulus keeps the sub-interval phase so the stream stays staggered. In the normal
		-- path (elapsed already < interval) this is a no-op.
		stream.Elapsed = elapsed % interval
	end
end

-- Live stream count -- one per owned copy. Exposed for PlotService diagnostics and the timing tests;
-- it is a read-only view, not part of the emit contract.
function DropperRuntime.StreamCount(self: DropperRuntime): number
	return #self._streams
end

function DropperRuntime.Destroy(self: DropperRuntime): ()
	self._destroyed = true
	-- Cleared before the signal dies so a Step already part-way through a release cannot resurrect
	-- work against a Sanctum whose State has been handed back.
	table.clear(self._streams)
	table.clear(self._byKey)
	self.OnSpawn:Destroy()
end

return DropperSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">MoteSystem</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MoteSystem
	The flight pool of one Sanctum. Every Mote is an ANCHORED part walked along a precomputed Ley
	Rail polyline by CFrame -- no physics body, no Touched connection (spec decision 8) -- and is
	collected the moment its ARC-LENGTH progress reaches 1. It owns the live-Mote cap, the Debris
	leak backstop and the orphan sweep. It never touches the wallet: it announces OnCollected(value,
	def) and EconomyService decides what the Essence is worth.
	Owner: server/Systems  |  Consumers: PlotService (owns one per Sanctum, drives it from the one
	                                     shared Heartbeat loop)
]]

local Debris = game:GetService("Debris")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Signal = require(Modules:WaitForChild("Signal"))
local Economy = require(Modules:WaitForChild("Economy"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local DropperData = require(Modules:WaitForChild("DropperData"))

type Dropper = DropperData.Dropper

-- Structural and deliberately loose: PlotService owns the real Sanctum type and requires THIS
-- module, so naming its type here would be a require cycle. Only State (for the cap) and
-- Runtime.MoteFolder (for parenting) are ever read, which also lets the harness drive a plain table.
type Sanctum = { State: any, Runtime: any }

-- The part handle stays `any` so this module loads unchanged under the headless harness, whose
-- Instances are tables rather than userdata.
type MotePart = any

type Mote = {
	Part: MotePart,
	Def: Dropper,
	Value: number, -- Essence this Mote is worth when it lands; already fully multiplied
	Progress: number, -- 0..1 across the WHOLE polyline
	Travel: number, -- seconds for the full flight; the divisor progress advances by
	Path: { CFrame }, -- borrowed by reference and NEVER mutated, so callers may cache one per pad
	Marks: { number }, -- cumulative arc length at each waypoint; Marks[1] = 0
	Length: number, -- Marks[#Marks]
	Cursor: number, -- segment the Mote is currently on; monotonic, so lookup is O(1) amortised
}

local MIN_TRAVEL = 0.05 -- divisor floor: dt / 0 is inf progress, which skips the flight entirely
local MAX_TRAVEL = 3600 -- a Mote that would fly for an hour is a leak, not a Mote

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

-- Cumulative arc length, computed ONCE per Spawn. Interpolating by waypoint INDEX instead would make
-- a 4-stud hop off the nozzle and a 90-stud trunk run take exactly as long as each other, so a Mote
-- would crawl across the short segments and teleport across the long one.
local function measure(path: { CFrame }): ({ number }, number)
	local marks = table.create(#path)
	marks[1] = 0
	local total = 0
	for i = 2, #path do
		local delta = (path[i].Position - path[i - 1].Position).Magnitude
		-- A NaN or inf waypoint would poison every later mark and freeze the Mote on the pad; treat
		-- that segment as a zero-length hop instead so the rest of the rail still measures.
		total += num(delta, 0)
		marks[i] = total
	end
	return marks, total
end

-- World CFrame for the Mote's current progress, interpolated by DISTANCE along the polyline.
local function poseOf(mote: Mote): CFrame
	local path, marks = mote.Path, mote.Marks
	local last = #path
	if mote.Length <= 0 then
		-- Degenerate rail (every waypoint identical, or all lengths rejected above): there is no
		-- distance to divide by, so walk the waypoints uniformly rather than dividing by zero.
		local slot = math.clamp(1 + mote.Progress * (last - 1), 1, last)
		local index = math.min(math.floor(slot), last - 1)
		return path[index]:Lerp(path[index + 1], slot - index)
	end
	local target = mote.Progress * mote.Length
	-- Progress only ever increases, so the cursor only ever moves forward: this scan costs O(1)
	-- amortised over the whole flight instead of an O(waypoints) search on every tick of every Mote.
	local cursor = mote.Cursor
	while cursor < last - 1 and marks[cursor + 1] < target do
		cursor += 1
	end
	mote.Cursor = cursor
	local span = marks[cursor + 1] - marks[cursor]
	local alpha = if span > 0 then (target - marks[cursor]) / span else 0
	return path[cursor]:Lerp(path[cursor + 1], math.clamp(alpha, 0, 1))
end

-- Resolved per Spawn, never cached at construction: PlotService rebuilds the Sanctum model on
-- Transcendence, and a cached folder would parent every later Mote into a destroyed tree where the
-- orphan sweep would silently eat it.
local function moteFolder(sanctum: Sanctum): MotePart?
	local runtime = sanctum.Runtime
	if runtime == nil then
		return nil
	end
	return (runtime :: any).MoteFolder
end

local MoteSystem = {}

local MoteRuntime = {}
MoteRuntime.__index = MoteRuntime

type MoteRuntimeSelf = {
	OnCollected: Signal.Signal, -- (value: number, dropperDef: Dropper)
	_sanctum: Sanctum,
	_motes: { Mote },
	_destroyed: boolean,
}
type MoteRuntime = typeof(setmetatable({} :: MoteRuntimeSelf, MoteRuntime))

function MoteSystem.new(sanctum: Sanctum): MoteRuntime
	return setmetatable({
		OnCollected = Signal.new(),
		_sanctum = sanctum,
		_motes = {},
		_destroyed = false,
	}, MoteRuntime)
end

function MoteRuntime.Count(self: MoteRuntime): number
	return #self._motes
end

-- Builds the visual. Split out only so Spawn stays readable; every property here is set because its
-- default is wrong for a Mote, not for decoration.
local function buildPart(def: Dropper, pose: CFrame, folder: MotePart): MotePart
	local part = Instance.new("Part")
	part.Name = "Mote"
	part.Anchored = true -- decision 8: CFrame-driven, never handed to the physics solver
	part.CanCollide = false -- a Mote must never shove a player off their own rail
	part.CanTouch = false -- there is no Touched listener anywhere; this drops the touch bookkeeping
	part.CanQuery = false -- and keeps 60 parts per Sanctum out of every raycast
	part.CastShadow = false -- 60 shadow casters per Sanctum for a 1.4-stud bauble is pure cost
	part.Size = if typeof(GameConfig.Mote.Size) == "Vector3" then GameConfig.Mote.Size else Vector3.new(1.4, 1.4, 1.4)
	part.Shape = Enum.PartType.Ball
	-- Guarded: a def edited badly in a live patch would otherwise throw INSIDE the spawn loop, and
	-- one bad catalogue entry would stop every Sanctum on the server from earning.
	if typeof(def.Color) == "Color3" then
		part.Color = def.Color
	end
	if typeof(def.Material) == "EnumItem" then
		part.Material = def.Material
	end
	part.CFrame = pose
	part.Parent = folder
	-- Leak backstop. Every path out of Step destroys its own part, so this only ever fires for a Mote
	-- the server somehow stopped stepping -- which is precisely the case that would otherwise leak.
	Debris:AddItem(part, math.max(1, num(GameConfig.Mote.LifetimeSeconds, 30)))
	return part
end

function MoteRuntime.Spawn(
	self: MoteRuntime,
	dropperDef: Dropper,
	value: number,
	path: { CFrame },
	travelTime: number
): boolean
	-- A released Sanctum has no wallet left to credit, so this drops the Mote outright rather than
	-- firing OnCollected at a listener PlotService has already torn down.
	if self._destroyed then
		return false
	end
	local worth = num(value, 0)
	-- Non-finite or non-positive value means a bug upstream (a corrupt def, a NaN multiplier). It is
	-- NOT credited: an inf written into the shared wallet is unrecoverable, and a 0 is just noise.
	if worth <= 0 then
		return false
	end
	-- Malformed rail. Also not credited -- unlike the cap below, this is a PlotLayout/PlotBuilder bug,
	-- and paying for it would hide it behind income that still looks correct.
	if type(path) ~= "table" or #path < 2 then
		return false
	end
	for index = 1, #path do
		if typeof(path[index]) ~= "CFrame" then
			return false
		end
	end

	-- OVERFLOW. Income is NEVER lost to the cap (decision 8): the value is credited immediately and
	-- only the VISUAL is dropped, so a pair who let Motes pile up lose feedback, never Essence. The
	-- false return tells the caller no part exists to track.
	if #self._motes >= Economy.getMoteCapacity(self._sanctum.State) then
		self.OnCollected:Fire(worth, dropperDef)
		return false
	end
	local folder = moteFolder(self._sanctum)
	if folder == nil then
		-- Same rule as the cap: a Sanctum whose Runtime has no MoteFolder (a builder that has not
		-- finished yet) can render nothing, but it must not silently swallow the Essence either.
		self.OnCollected:Fire(worth, dropperDef)
		return false
	end

	local travel = math.clamp(num(travelTime, num(GameConfig.Mote.BaseTravelSeconds, 6)), MIN_TRAVEL, MAX_TRAVEL)
	local marks, length = measure(path)
	local part = buildPart(dropperDef, path[1], folder)
	self._motes[#self._motes + 1] = {
		Part = part,
		Def = dropperDef,
		Value = worth,
		Progress = 0,
		Travel = travel,
		Path = path,
		Marks = marks,
		Length = length,
		Cursor = 1,
	}
	return true
end

function MoteRuntime.Step(self: MoteRuntime, dt: number): ()
	if self._destroyed then
		return
	end
	local step = num(dt, 0)
	-- A non-positive or non-finite dt would either do nothing or set every Progress to NaN, after
	-- which `Progress >= 1` is false forever and no Mote is ever collected again.
	if step <= 0 then
		return
	end
	local motes = self._motes
	-- Backwards, because finished Motes are removed in place and a forward loop would skip whichever
	-- element slid down into the freed slot.
	for index = #motes, 1, -1 do
		local mote = motes[index]
		local part = mote.Part
		if part.Parent == nil then
			-- Destroyed out from under us: the Debris backstop fired, or the whole Sanctum model was
			-- torn down. Dropped WITHOUT crediting -- crediting here is how one Mote gets paid for
			-- twice (once on the sweep, once when it lands) or paid for having never landed at all.
			table.remove(motes, index)
		else
			mote.Progress += step / mote.Travel
			if mote.Progress >= 1 then
				-- Removed BEFORE the signal so a handler reading Count() (or spawning a replacement
				-- Mote from inside OnCollected) already sees the freed capacity slot.
				table.remove(motes, index)
				part:Destroy()
				self.OnCollected:Fire(mote.Value, mote.Def)
			else
				part.CFrame = poseOf(mote)
			end
		end
	end
end

function MoteRuntime.Clear(self: MoteRuntime): ()
	local motes = self._motes
	-- Value in flight is deliberately DISCARDED, not credited. Clear is called on Transcendence,
	-- which is resetting the wallet in the same breath, and on plot release, where there is no wallet
	-- left -- crediting here would hand a pair free Essence for pressing reset.
	for index = #motes, 1, -1 do
		local part = motes[index].Part
		if part ~= nil then
			part:Destroy()
		end
	end
	table.clear(motes)
end

function MoteRuntime.Destroy(self: MoteRuntime): ()
	-- Clear FIRST: sixty anchored parts per Sanctum, six Sanctums, every release -- a skipped cleanup
	-- here is a slow leak that only shows up hours into a live server.
	self:Clear()
	self._destroyed = true
	self.OnCollected:Destroy()
end

return MoteSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PlotBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
    PlotBuilder
    Builds and tears down one Sanctum's Instance tree: a floor slab per Wing, the purchase pads and
    their blank signs, the Ley Rail decks a Wellspring's Motes ride, the floating Conflux and its
    Font, the Motes folder, and the per-slot spawn and link markers. Placement comes from PlotLayout
    and colour/material from Theme -- geometry is all this module owns: no income, no affordability
    checks, no prompts. PurchaseService owns each prompt and all wording; it inherits blank pads.
    Owner: server/Systems  |  Consumers: PlotService, which passes the Runtime to PurchaseService,
                                         DropperSystem, MoteSystem and EvolutionService
]]

local ServerStorage = game:GetService("ServerStorage")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local DropperData = require(Modules:WaitForChild("DropperData"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local PlotLayout = require(Modules:WaitForChild("PlotLayout"))
local SectionData = require(Modules:WaitForChild("SectionData"))
local Theme = require(Modules:WaitForChild("Theme"))
local UpgradeData = require(Modules:WaitForChild("UpgradeData"))

type Section = SectionData.Section
type Appearance = Theme.ConfluxAppearance

-- A purchasable needing a pad + its Runtime.Pads/Signs key. Kind/Id become the pad's attributes.
type PadEntry = { Key: string, Kind: string, Id: string }

type Runtime = {
	Model: Instance, Conflux: Instance, Font: Instance, MoteFolder: Instance, PlotId: number,
	Origin: CFrame, Sections: { [string]: Instance }, Pads: { [string]: Instance },
	RailFolders: { [string]: Instance }, Signs: { [string]: TextLabel } }

-- Construction primitives and shared extents live in BuildKit; aliased locally so every call
-- site below reads the same as before the split.
local BuildKit = require(script.Parent.BuildKit)
local newFolder, makePart, makeSign = BuildKit.newFolder, BuildKit.makePart, BuildKit.makeSign
local PAD_SIZE, FONT_SIZE, MARKER_SIZE = BuildKit.PAD_SIZE, BuildKit.FONT_SIZE, BuildKit.MARKER_SIZE
local MARKER_DROP, MAX_CONFLUX_SIZE = BuildKit.MARKER_DROP, BuildKit.MAX_CONFLUX_SIZE
local MAX_LIGHT_RANGE = BuildKit.MAX_LIGHT_RANGE
local RAIL_WIDTH, RAIL_THICKNESS = BuildKit.RAIL_WIDTH, BuildKit.RAIL_THICKNESS
local MIN_RAIL_LENGTH = BuildKit.MIN_RAIL_LENGTH
local HIDDEN_ROOT_NAME = "SanctumHiddenWings" -- where locked Wings wait; see setSectionVisible

local PlotBuilder = {}

--[[ The per-Wing pad numbering, assigned in exactly one place. PlotLayout.padCFrame and .railPath
     take a PER-WING running index, not a catalogue Order -- DropperData and UpgradeData both number
     from 1, so reusing Order would stack an Upgrade pad on a Wellspring. Wellsprings are numbered
     FIRST so they always occupy 1..N: rails are built for exactly those indices. ]]
local function padPlan(sectionId: string): { PadEntry }
	local plan: { PadEntry } = {}
	local function collect(kind: string, list: { any })
		for _, def in ipairs(list) do
			-- On a Wing, RequiredSection reads as "my prerequisite": its unlock pad must stand on
			-- the Wing you can already reach, never inside the room it sells.
			if def.RequiredSection == sectionId then
				table.insert(plan, { Key = kind .. ":" .. def.Id, Kind = kind, Id = def.Id })
			end
		end
	end
	collect("dropper", DropperData.List)
	collect("upgrade", UpgradeData.List)
	collect("section", SectionData.List)
	if sectionId == SectionData.Base then
		-- Both Sanctum-wide rituals act on the Conflux, so they stand on the Wing that holds it.
		table.insert(plan, { Key = "attune", Kind = "attune", Id = "attune" })
		table.insert(plan, { Key = "transcend", Kind = "transcend", Id = "transcend" })
	end
	return plan
end

local function makePad(parent: Instance, cf: CFrame, entry: PadEntry, sectionId: string, order: number): Part
	local pad = makePart({
		Name = string.format("Pad_%s_%s", entry.Kind, entry.Id), Size = PAD_SIZE, CFrame = cf,
		Color = Theme.Ui.Panel, Material = PAD_MATERIAL, Parent = parent,
	})
	pad:SetAttribute("PadKind", entry.Kind)
	pad:SetAttribute("PadId", entry.Id)
	-- EXTRA: MoteSystem needs (section, order) to recompute a rail path and that order is invented
	-- here, so publish it instead of having every consumer re-derive padPlan and drift out of sync.
	pad:SetAttribute("PadSection", sectionId)
	pad:SetAttribute("PadOrder", order)
	return pad
end

-- One Ley Rail: thin decks joining consecutive PlotLayout.railPath waypoints.
local function buildRail(parent: Instance, origin: CFrame, section: Section, order: number, id: string)
	local def = DropperData.get(id)
	local colour = if def ~= nil then def.Color else Theme.Ui.Accent
	local path = PlotLayout.railPath(origin, section, order)
	local folder = newFolder("Rail_" .. id, parent)
	for i = 1, #path - 1 do
		local a, b = path[i].Position, path[i + 1].Position
		local dx, dz = b.X - a.X, b.Z - a.Z
		-- Length is XZ-only and the deck is left level: waypoint heights change between legs
		-- (nozzle -> deck -> Font) and a stepped rail beats a twisted one. Motes fly the true path.
		local length = math.sqrt(dx * dx + dz * dz)
		if length >= MIN_RAIL_LENGTH then
			makePart({
				Name = string.format("Segment_%d", i), Size = Vector3.new(RAIL_WIDTH, RAIL_THICKNESS, length),
				-- Identity looks down -Z, so yaw = atan2(-dx, -dz) aims the long axis along the leg
				-- -- the same convention PlotLayout uses to orient its own waypoints.
				CFrame = CFrame.new((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5, (a.Z + b.Z) * 0.5)
					* CFrame.Angles(0, math.atan2(-dx, -dz), 0),
				Color = colour, Material = NEON, Parent = folder, Transparency = 0.25,
				CanCollide = false, -- a player must never be able to stand on or snag a rail
			})
		end
	end
end

local function hiddenHolder(model: Instance): Instance
	local root = ServerStorage:FindFirstChild(HIDDEN_ROOT_NAME) or newFolder(HIDDEN_ROOT_NAME, ServerStorage)
	local name = model.Name .. "_Hidden"
	return root:FindFirstChild(name) or newFolder(name, root)
end

function PlotBuilder.buildSection(sanctumModel: Instance, section: Section): Instance
	-- Origin is recovered from the Model: the spec's signature has nowhere to pass it. Defaulting to
	-- plot 1 on a missing/non-numeric attribute avoids an arithmetic-on-nil deep inside PlotLayout.
	local plotId = sanctumModel:GetAttribute("PlotId")
	local origin = PlotLayout.sanctumOrigin(if type(plotId) == "number" then plotId else 1)

	local model = Instance.new("Model")
	model.Name = section.Id
	makePart({
		Name = "Floor", Size = section.Size, CFrame = PlotLayout.sectionCFrame(origin, section),
		-- The base Wing is tinted apart so the Core reads as the heart of the Sanctum.
		Color = if section.Id == SectionData.Base then Theme.Ui.Stroke else Theme.Ui.Panel,
		Material = FLOOR_MATERIAL, Parent = model,
	})
	newFolder("Pads", model) -- both filled by build(); buildSection only guarantees they exist
	newFolder("Rails", model)
	model.Parent = sanctumModel
	return model
end

function PlotBuilder.build(plotId: number, parent: Instance): (Instance, Runtime)
	local origin = PlotLayout.sanctumOrigin(plotId)
	local model = Instance.new("Model")
	model.Name = string.format("Sanctum_%d", plotId)
	model:SetAttribute("PlotId", plotId) -- read back by buildSection, and handy in Studio

	local sections: { [string]: Instance }, railFolders: { [string]: Instance } = {}, {}
	local pads: { [string]: Instance }, signs: { [string]: TextLabel } = {}, {}
	for _, section in ipairs(SectionData.List) do
		local sectionModel = PlotBuilder.buildSection(model, section)
		local padFolder = sectionModel:FindFirstChild("Pads") :: Instance
		local railFolder = sectionModel:FindFirstChild("Rails") :: Instance
		sections[section.Id] = sectionModel
		railFolders[section.Id] = railFolder
		for order, entry in ipairs(padPlan(section.Id)) do
			local pad = makePad(padFolder, PlotLayout.padCFrame(origin, section, order), entry, section.Id, order)
			pads[entry.Key] = pad
			signs[entry.Key] = makeSign(pad, "", 3.5)
			if entry.Kind == "dropper" then
				buildRail(railFolder, origin, section, order, entry.Id)
			end
		end
	end

	-- Stage 1 unattuned is the only look PlotBuilder knows; later ones arrive via setConfluxAppearance.
	local look = Theme.getConfluxAppearance(1, nil)
	local size = math.max(1, look.Size)
	local conflux = makePart({
		Name = "Conflux", Size = Vector3.new(size, size, size), CFrame = PlotLayout.confluxCFrame(origin),
		Color = look.Color, Material = look.Material, Parent = model, Transparency = 0.15,
		CanCollide = false, -- it floats 20 studs up, but a solid Conflux would block arriving Motes
	})
	local light = Instance.new("PointLight")
	light.Color = look.Color
	light.Range = math.min(MAX_LIGHT_RANGE, size * 3)
	light.Brightness = 2.5
	light.Parent = conflux

	local font = makePart({
		Name = "ConfluxFont", Size = FONT_SIZE, CFrame = PlotLayout.fontCFrame(origin),
		Color = Theme.Ui.Accent, Material = NEON, Parent = model,
		CanCollide = false, -- every rail ends inside it; nothing may be deflected on the way in
	})
	makeSign(font, string.format("Sanctum %d", plotId), 6)

	local motes = newFolder("Motes", model)
	local markers = newFolder("Markers", model)
	for slot = 1, GameConfig.Plot.SlotsPerSanctum do
		makePart({
			Name = string.format("SpawnMarker_%d", slot), Size = MARKER_SIZE, Transparency = 0.5,
			CFrame = PlotLayout.spawnSlotCFrame(origin, slot) * CFrame.new(0, MARKER_DROP, 0),
			Color = Theme.Ui.Positive, Material = MARKER_MATERIAL, Parent = markers,
			CanCollide = false, -- a spawning character must not be shoved off its own marker
		})
		-- Link pads are Sanctum furniture, not Wing furniture -- PlotLayout places them separately,
		-- so they carry order 0, a value that never indexes a Wing pad line.
		local key = "link:" .. slot
		local entry: PadEntry = { Key = key, Kind = "link", Id = tostring(slot) }
		pads[key] = makePad(markers, PlotLayout.linkPadCFrame(origin, slot), entry, SectionData.Base, 0)
		signs[key] = makeSign(pads[key], "", 3.5)
	end

	-- Parented LAST: the Sanctum then replicates as one burst rather than as ~200 part additions
	-- streaming to every client while it is still half-assembled.
	model.Parent = parent
	return model, {
		Model = model, Sections = sections, Pads = pads, Conflux = conflux, Font = font,
		MoteFolder = motes, RailFolders = railFolders, Signs = signs, PlotId = plotId, Origin = origin,
	}
end

--[[ Locked Wings are REPARENTED out of the world, not made transparent. A transparent slab is still
     a rendered part with a physics record, still streamed to every client, and its pads would still
     be reachable by a ProximityPrompt -- PurchaseService would have to re-check the lock on every
     trigger. ServerStorage costs the client nothing (it never replicates) and makes an unowned
     Wing's pads unreachable by construction. The trade: destroy() must sweep both places. ]]
function PlotBuilder.setSectionVisible(runtime: Runtime, sectionId: string, visible: boolean)
	if type(runtime) ~= "table" or type(runtime.Sections) ~= "table" then
		return
	end
	local section = runtime.Sections[sectionId]
	if section == nil then
		-- A sanitised save can still name a Wing this build lacks; ignore it rather than kill the
		-- whole rebuild over one stale id.
		return
	end
	section.Parent = if visible then runtime.Model else hiddenHolder(runtime.Model)
end

function PlotBuilder.setConfluxAppearance(runtime: Runtime, appearance: Appearance)
	-- Total on purpose. This is called from the Attunement path, and a malformed appearance table
	-- (a stale Theme entry, a sanitised save naming a stage this build lacks) must leave the
	-- Conflux looking wrong rather than abort the Attunement half-applied.
	if type(runtime) ~= "table" or type(appearance) ~= "table" then
		return
	end
	local conflux = runtime.Conflux :: Part
	if conflux == nil then
		return
	end
	-- Clamped: a zero/negative Size would make the Conflux vanish, reading as a bug not an Attunement.
	local size = if type(appearance.Size) == "number" and appearance.Size == appearance.Size
		then math.max(1, math.min(appearance.Size, MAX_CONFLUX_SIZE))
		else 1
	conflux.Size = Vector3.new(size, size, size)
	if typeof(appearance.Color) == "Color3" then
		conflux.Color = appearance.Color
	end
	if typeof(appearance.Material) == "EnumItem" then
		conflux.Material = appearance.Material
	end
	local light = conflux:FindFirstChildOfClass("PointLight")
	if light ~= nil then
		if typeof(appearance.Color) == "Color3" then
			light.Color = appearance.Color
		end
		light.Range = math.min(MAX_LIGHT_RANGE, size * 3)
	end
end

function PlotBuilder.destroy(model: Instance)
	-- Tolerates nil and a non-Instance: the release path can reach here after a partially built or
	-- already-destroyed Sanctum, and erroring during teardown would strand the rest of the cleanup.
	if typeof(model) ~= "Instance" then
		return
	end
	-- Locked Wings live OUTSIDE this Model, so Model:Destroy() alone would leak every Wing the
	-- Sanctum never unlocked, for the remaining life of the server.
	local root = ServerStorage:FindFirstChild(HIDDEN_ROOT_NAME)
	local holder = if root ~= nil then root:FindFirstChild(model.Name .. "_Hidden") else nil
	if holder ~= nil then
		holder:Destroy()
	end
	model:Destroy()
end

return PlotBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="48">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">11</token>
      <float name="DistanceFactor">3.33</float>
      <float name="DopplerScale">1</float>
      <bool name="RespectFilteringEnabled">true</bool>
      <float name="RolloffScale">1</float>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="49">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="50">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">ClientBootstrap</string>
            <string name="Source"><![CDATA[--!strict
--[[
    ClientBootstrap
    The client's only entry point. It waits for the remote folder, builds the SanctumHud, creates
    the ClientStore, feeds StateSync into it, and then hands every controller the same context and
    starts it. Nothing here decides anything about the game: it is wiring, and its one job is to
    make sure a player always ends up with a HUD bound to the server's snapshot.
]]
--[[ WHY EVERY CONTROLLER IS ISOLATED IN A pcall. These eight controllers are independent surfaces
     -- a toast stack, a sound bank, a settings panel. An error while requiring or initialising any
     one of them must not stop the other seven, because the failure mode of an unguarded loop here
     is a player standing in a fully working Sanctum with no interface at all. A broken controller
     costs its own feature and one warn line, never the HUD.

     WHY StateSync IS READ EXACTLY ONCE, HERE. If controllers connected to it themselves they would
     each hold a private copy of the snapshot, and the copies would diverge the moment one of them
     handled a payload slightly differently. The store is the single reader, and Observe is the only
     way anything downstream learns that a value changed. ]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ClientStore = require(Modules:WaitForChild("ClientStore"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))

local ControllerFolder = script.Parent:WaitForChild("Controllers")
local UiBuilder = require(ControllerFolder:WaitForChild("UiBuilder"))

-- Deterministic order, HUD first: if something later in the list is going to fail, the most
-- important surface in the game is already bound by the time it does.
local CONTROLLER_ORDER = {
	"HudController",
	"NotifyController",
	"PromptController",
	"AffinityController",
	"RebirthController",
	"SettingsController",
	"EvolutionFxController",
	"SoundController",
}

-- Bounded so a missing remote surfaces as a warning instead of a client that hangs forever on a
-- server built from an older RemoteSchema.
local WAIT_SECONDS = 10

local function collectRemotes(folder: Instance): { [string]: any }
	local remotes: { [string]: any } = {}
	for _, def in ipairs(RemoteSchema.List) do
		local remote = folder:WaitForChild(def.Name, WAIT_SECONDS)
		if remote ~= nil and remote:IsA("RemoteEvent") then
			remotes[def.Name] = remote
		else
			-- Not fatal: a controller that needs a missing remote simply does nothing, which is a
			-- far better outcome than refusing to build the rest of the interface.
			warn("[ClientBootstrap] remote '" .. def.Name .. "' is missing from " .. RemoteSchema.FolderName)
		end
	end
	return remotes
end

--[[ Init every controller, then Start every controller that survived Init. Two phases, mirroring
     ServiceRegistry on the server: a controller may look another one up during Start (PromptController
     reads HudController.ReasonText), and that is only safe once all of them have been built. ]]
local function startControllers(context: { [string]: any }): ()
	local started: { any } = {}

	for _, name in ipairs(CONTROLLER_ORDER) do
		local module = ControllerFolder:FindFirstChild(name)
		if module == nil then
			warn("[ClientBootstrap] no controller named '" .. name .. "'")
			continue
		end
		local okRequire, controller = pcall(require, module)
		if not okRequire or type(controller) ~= "table" then
			warn("[ClientBootstrap] failed to require " .. name .. ": " .. tostring(controller))
			continue
		end
		local okInit, initError = pcall(function()
			controller:Init(context)
		end)
		if okInit then
			table.insert(started, controller)
		else
			warn("[ClientBootstrap] " .. name .. ":Init failed: " .. tostring(initError))
		end
	end

	for _, controller in ipairs(started) do
		local okStart, startError = pcall(function()
			controller:Start()
		end)
		if not okStart then
			warn("[ClientBootstrap] " .. tostring(controller.Name) .. ":Start failed: " .. tostring(startError))
		end
	end
end

local player = Players.LocalPlayer
if player == nil then
	-- Only reachable if this script is run outside a client context; bailing beats erroring.
	warn("[ClientBootstrap] no LocalPlayer, so there is nobody to build a HUD for")
	return
end

local playerGui = player:WaitForChild("PlayerGui")
local remoteFolder = ReplicatedStorage:WaitForChild(RemoteSchema.FolderName)
if playerGui == nil or remoteFolder == nil then
	warn("[ClientBootstrap] PlayerGui or " .. RemoteSchema.FolderName .. " never arrived; no HUD")
	return
end

local remotes = collectRemotes(remoteFolder)
local store = ClientStore.new()

-- Parented only once the whole tree exists, so a half-built HUD is never on screen.
local ui = UiBuilder.build()
ui.ScreenGui.Parent = playerGui

--[[ The ONLY StateSync listener in the client. ClientStore itself decides what a Full payload means
     versus an essence-only tick, so this handler stays a single forwarding call -- it runs twice a
     second and has no business doing anything more. ]]
local stateSync = remotes[RemoteSchema.Remotes.StateSync.Name]
if stateSync ~= nil then
	stateSync.OnClientEvent:Connect(function(snapshot: any)
		store:Set(snapshot)
	end)
else
	warn("[ClientBootstrap] StateSync is missing; the HUD will show its zeroed default state")
end

local function requestSnapshot(): ()
	local remote = remotes[RemoteSchema.Remotes.RequestSnapshot.Name]
	if remote == nil then
		return
	end
	-- No payload: the server derives the sanctum from the player's occupancy, so there is nothing
	-- to ask for and nothing to forge.
	remote:FireServer()
end

startControllers({
	Store = store,
	Remotes = remotes,
	Player = player,
	PlayerGui = playerGui,
	Ui = ui,
})

--[[ Ask once now, and again on every respawn. The HUD survives a respawn (ResetOnSpawn = false), so
     without this a player who died mid-attunement would keep reading a snapshot from before it --
     and the throttled replicator only pushes a Full snapshot when the sanctum is dirty, so a stale
     HUD could sit there indefinitely on a quiet plot. ]]
requestSnapshot()
player.CharacterAdded:Connect(requestSnapshot)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="53">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">AffinityController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    AffinityController
    The Stage 3 elemental choice: it opens the Affinity modal when the snapshot says the gate is
    open and nothing has been chosen, renders the four elements straight out of AffinityData, and
    forwards one press as ChooseAffinity { Affinity = id }. It closes only when the store reports a
    Chosen affinity, so the modal never claims a commitment the server has not made.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY EVERY NUMBER ON A BUTTON IS READ FROM AffinityData. The choice is permanent for the run and
     the four options are deliberately within 1% of each other on raw income (see the balance model
     in AffinityData), so the trade-off numbers ARE the decision. Restating them here would let the
     UI drift from the balance table, and a player would be choosing on a lie. Every figure below is
     pulled from the def and formatted; not one is typed out.

     WHY THERE IS A REMINDER CHIP. "Later" has to exist -- this is a shared, irreversible choice and
     the pair should be able to talk about it -- but Observe only fires on a genuine change, so a
     dismissed modal would never reopen on its own and the Affinity would become unreachable. The
     chip is the standing way back in, and it is visible for exactly as long as the gate is open. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local AffinityData = require(Modules:WaitForChild("AffinityData"))
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local Format = require(Modules:WaitForChild("Format"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))
local Theme = require(Modules:WaitForChild("Theme"))

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "AffinityController"

local BODY = table.concat({
	"The Conflux has reached Stage " .. tostring(EvolutionData.AffinityUnlockStage)
		.. " and will bind to one element.",
	"The Sanctum has ONE Affinity, not one each -- either occupant can make this choice, and it"
		.. " applies to both of you.",
	"It is permanent until your next Transcendence: it cannot be changed, re-rolled or undone.",
}, "\n")

-- If the server never answers a choice (rate limited, or the gate closed underneath us) the button
-- must not stay stuck on "Binding". Long enough that a normal round trip always wins the race.
local ANSWER_GRACE = 3

local connections: { any } = {}
local remotes: { [string]: any } = {}
local store: any = nil
local modal: any = nil
local chip: any = nil
local strokes: { [string]: any } = {}
local selected: string? = nil
local pendingToken = 0

local function new(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		(instance :: any)[key] = value
	end
	instance.Parent = parent -- parent last: one replication step instead of a dozen
	return instance
end

--[[ The five trade-off figures, always all five and always in the same order, so the four buttons
     read as one comparable table rather than four adverts. A neutral value prints as x1 / +0 on
     purpose: "this element gives up nothing here" is information. ]]
local function statsText(def: AffinityData.Affinity): string
	return table.concat({
		"Income   " .. Format.multiplier(def.IncomeMultiplier),
		"Rate       " .. Format.multiplier(def.SpawnRateMultiplier),
		"Mote      " .. Format.multiplier(def.MoteValueMultiplier),
		"Rails      " .. Format.multiplier(def.RailSpeedMultiplier),
		string.format("Speed    %+d", math.floor(def.WalkSpeedBonus)),
	}, "\n")
end

--[[ Turns the builder's plain coloured button into a card: name, flavour, numbers. Done here rather
     than in UiModals because it is entirely about what an Affinity MEANS, and the builder is inert
     by design -- it does not know that AffinityData has a balance model. ]]
local function decorate(button: any, def: AffinityData.Affinity): ()
	button.Text = ""
	-- The stroke is the selection marker, so the hover flash is turned off: two competing
	-- highlights on the most consequential button in the game is one too many.
	button.AutoButtonColor = false

	local ink = Theme.Ui.Background -- dark ink on the element's own colour, which is always bright
	new("TextLabel", {
		Name = "NameLabel", BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
		Position = UDim2.fromScale(0.05, 0.03), Size = UDim2.fromScale(0.9, 0.14),
		Text = def.Name, TextColor3 = ink, TextScaled = true, ZIndex = 24,
	}, button)
	new("TextLabel", {
		Name = "DescLabel", BackgroundTransparency = 1, Font = Enum.Font.Gotham,
		Position = UDim2.fromScale(0.07, 0.19), Size = UDim2.fromScale(0.86, 0.36),
		Text = def.Description, TextColor3 = ink, TextSize = 10, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 24,
	}, button)
	new("TextLabel", {
		Name = "StatsLabel", BackgroundTransparency = 1, Font = Enum.Font.Code,
		Position = UDim2.fromScale(0.07, 0.57), Size = UDim2.fromScale(0.86, 0.4),
		Text = statsText(def), TextColor3 = ink, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 24,
	}, button)

	strokes[def.Id] = button:FindFirstChildOfClass("UIStroke")
end

local function renderSelection(): ()
	for id, stroke in pairs(strokes) do
		if stroke ~= nil then
			local chosen = id == selected
			stroke.Color = if chosen then Theme.Ui.Text else Theme.Ui.Stroke
			stroke.Thickness = if chosen then 4 else 1.5
			stroke.Transparency = if chosen then 0 else 0.6
		end
	end
end

local function renderConfirm(pending: boolean): ()
	local def = if selected ~= nil then AffinityData.get(selected) else nil
	local button = modal.Confirm
	local ready = def ~= nil and not pending
	if pending then
		button.Text = "Binding..."
	elseif def ~= nil then
		button.Text = "Bind " .. def.Name .. " forever"
	else
		button.Text = "Pick an element"
	end
	button.BackgroundColor3 = if ready and def then def.Color else Theme.Ui.Panel
	button.TextColor3 = if ready then Theme.Ui.Background else Theme.Ui.Muted
	button.Active = ready
	button.AutoButtonColor = ready
end

local function setSelected(id: string?): ()
	selected = id
	renderSelection()
	renderConfirm(false)
end

function Controller:Init(context: Context): ()
	remotes = context.Remotes
	store = context.Store
	modal = context.Ui.Modals.Affinity

	modal.Body.Text = BODY
	modal.Body.TextSize = 13
	modal.Root.Visible = false

	for _, def in ipairs(AffinityData.List) do
		local button = modal.Buttons[def.Id]
		if button ~= nil then
			decorate(button, def)
		end
	end
	setSelected(nil)

	--[[ Parented to the ScreenGui rather than added to the action bar: the bar is a fixed
	     UIListLayout whose three buttons already fill it, and a fourth entry would resize the
	     Attune button every time the gate opened. ]]
	chip = new("TextButton", {
		Name = "AffinityChip", AnchorPoint = Vector2.new(0.5, 1), AutoButtonColor = true,
		BackgroundColor3 = Theme.Ui.Warning, BorderSizePixel = 0, Font = Enum.Font.GothamBold,
		Position = UDim2.fromScale(0.5, 0.885), Size = UDim2.fromScale(0.22, 0.045),
		Text = "Choose the Sanctum's Affinity", TextColor3 = Theme.Ui.Background, TextScaled = true,
		Visible = false, ZIndex = 12,
	}, context.Ui.ScreenGui)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, chip)
end

function Controller:Start(): ()
	local function track(connection: any): ()
		table.insert(connections, connection)
	end

	for _, def in ipairs(AffinityData.List) do
		local button = modal.Buttons[def.Id]
		if button ~= nil then
			track(button.Activated:Connect(function()
				setSelected(def.Id)
			end))
		end
	end

	track(chip.Activated:Connect(function()
		modal.Root.Visible = true
	end))

	track(modal.Confirm.Activated:Connect(function()
		local id = selected
		local remote = remotes[RemoteSchema.Remotes.ChooseAffinity.Name]
		if id == nil or remote == nil then
			return
		end
		-- The id is the whole payload and it is one of four literal strings; the server re-checks it
		-- against the catalogue and against the gate before committing anything.
		remote:FireServer({ Affinity = id })
		renderConfirm(true)

		pendingToken += 1
		local token = pendingToken
		task.delay(ANSWER_GRACE, function()
			-- Still ours and still unanswered: hand the button back rather than leave a dead modal.
			if token == pendingToken then
				renderConfirm(false)
			end
		end)
	end))

	-- "Later" hides the modal and nothing more. It sends no remote, because declining to choose is
	-- not a choice the server needs to hear about -- the gate simply stays open.
	track(modal.Cancel.Activated:Connect(function()
		modal.Root.Visible = false
	end))

	--[[ The single source of truth for whether this whole surface exists. Available is the server's
	     answer (Stage >= AffinityUnlockStage), Chosen is the commitment; the client computes
	     neither. Observe fires once immediately, so a player who logs in already past Stage 3 with
	     no Affinity gets the modal on the first Full snapshot. ]]
	track(store:Observe("Gates.Affinity", function(gate: any)
		local g = if type(gate) == "table" then gate else {}
		local chosen = if type(g.Chosen) == "string" then g.Chosen else nil
		local open = g.Available == true and chosen == nil

		chip.Visible = open
		if open then
			modal.Root.Visible = true
			return
		end

		-- Either the gate closed or an Affinity was bound. Both mean the same thing here: this
		-- surface is done, and the confirmation of it came from the server, not from the click.
		pendingToken += 1
		modal.Root.Visible = false
		if chosen ~= nil then
			setSelected(chosen)
		end
	end))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	pendingToken += 1
	if modal ~= nil then
		modal.Root.Visible = false
	end
	if chip ~= nil then
		chip:Destroy()
		chip = nil
	end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">EvolutionFxController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    EvolutionFxController
    The client's reaction to the Fx remote: a stage-tinted screen flash, a short camera shake and a
    banner for an Attunement, a longer and brighter version for a Transcendence, a cheap pulse for a
    purchase, and a banner naming the partner on a link. It renders celebration and nothing else --
    every fact it announces was decided by the server and already exists in the snapshot.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY EVERY EFFECT IS NON-BLOCKING AND TOTAL. An error raised inside a remote handler kills the
     connection, so one malformed payload would silently end every later effect. The payload is
     therefore untrusted throughout: an unknown Kind, a missing Data table, a NaN stage and a nil
     camera all fall through to a no-op, and nothing here ever yields.

     WHY GENERATION TOKENS RATHER THAN WAITING ON A TWEEN. Two Attunements can land back to back,
     and a naive "hide when my tween finishes" would let the first effect's completion hide the
     second effect's banner. Each sequence claims a token; a hide applies only if it still holds. ]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))
local Theme = require(Modules:WaitForChild("Theme"))

-- Sibling require, not a context lookup: controllers are singletons, so this is the same instance
-- ClientBootstrap started, and every entry point into it is a guarded no-op if it never did.
local SoundController = require(script.Parent.SoundController)

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "EvolutionFxController"

-- Flash opacity at its peak (0 = opaque). Attune is a wash, Transcend nearly whites out the screen.
local ATTUNE_FLASH, ATTUNE_FADE = 0.35, 0.9
local TRANSCEND_FLASH, TRANSCEND_FADE = 0.08, 2.2
local BANNER_HOLD = 2.6
local BANNER_FADE = 0.35
local SHAKE_SMALL, SHAKE_BIG = { 0.35, 0.010 }, { 1.10, 0.022 } -- { seconds, radians }

local rng = Random.new()
local connections: { any } = {}
local store: any = nil
local remotes: { [string]: any } = {}
local flash: any = nil
local banner: any = nil
local hudStroke: any = nil
local flashToken, bannerToken = 0, 0
local shakeConnection: any = nil
local shakeUntil, shakeMagnitude, shakeSpan = 0, 0, 1

local function num(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

local function make(className: string, properties: { [string]: any }, parent: Instance): any
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		(instance :: any)[key] = value
	end
	instance.Parent = parent -- parent last: one replication step rather than one per property
	return instance
end

local function tween(instance: any, seconds: number, properties: { [string]: any }): ()
	-- Sine/Out: fast at the start so the peak is instant and the decay is what the eye follows.
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(instance, info, properties):Play()
end

-- Hidden rather than left transparent between flashes: an invisible frame still sits over the HUD.
local function playFlash(colour: Color3, peak: number, fade: number): ()
	if flash == nil then
		return
	end
	flashToken += 1
	local token = flashToken
	flash.BackgroundColor3 = colour
	flash.BackgroundTransparency = peak
	flash.Visible = true
	tween(flash, fade, { BackgroundTransparency = 1 })
	task.delay(fade, function()
		if token == flashToken and flash ~= nil then
			flash.Visible = false
		end
	end)
end

local function playBanner(text: string, colour: Color3): ()
	if banner == nil then
		return
	end
	bannerToken += 1
	local token = bannerToken
	banner.Text = text
	banner.TextColor3 = colour
	banner.TextTransparency = 1
	banner.Visible = true
	tween(banner, BANNER_FADE, { TextTransparency = 0 })
	task.delay(BANNER_HOLD, function()
		if token ~= bannerToken or banner == nil then
			return
		end
		tween(banner, BANNER_FADE, { TextTransparency = 1 })
		task.delay(BANNER_FADE, function()
			if token == bannerToken and banner ~= nil then
				banner.Visible = false
			end
		end)
	end)
end

--[[ Camera shake, so an Attunement is felt as well as seen. Applied as a per-frame angular nudge:
     Roblox's default camera script rewrites CFrame from its subject every frame, so the offset
     decays naturally instead of accumulating, and a nil camera degrades to no shake at all.
     MOCK-EXTRA: workspace.CurrentCamera and Camera.CFrame (the camera is the only handle on this). ]]
local function shake(seconds: number, magnitude: number): ()
	shakeSpan = math.max(seconds, 0.05)
	shakeUntil = os.clock() + shakeSpan
	shakeMagnitude = magnitude
	if shakeConnection ~= nil then
		return
	end
	shakeConnection = RunService.RenderStepped:Connect(function()
		-- MOCK-EXTRA: workspace.CurrentCamera (and Camera.CFrame written below)
		local camera = workspace.CurrentCamera
		local remaining = shakeUntil - os.clock()
		if remaining <= 0 or camera == nil then
			if shakeConnection ~= nil then
				shakeConnection:Disconnect()
				shakeConnection = nil
			end
			return
		end
		-- Linear falloff: the jolt is strongest on the first frame and settles, which reads as an
		-- impact rather than a wobble.
		local amount = shakeMagnitude * (remaining / shakeSpan)
		camera.CFrame = camera.CFrame
			* CFrame.Angles(rng:NextNumber(-amount, amount), rng:NextNumber(-amount, amount), 0)
	end)
end

-- The stage colour as the player actually sees it on the Conflux, affinity tint included: a flash
-- that did not match the thing it is celebrating would read as a different event.
local function stageColour(stage: number): Color3
	local affinity = if store ~= nil then store:GetPath("Plot.Affinity") else nil
	return Theme.getConfluxAppearance(stage, if type(affinity) == "string" then affinity else nil).Color
end

local function onAttune(data: { [string]: any }): ()
	-- Prefer the payload, fall back to the snapshot: a Full StateSync usually lands first, and
	-- either way the banner must name a real stage rather than guess.
	local fallback = if store ~= nil then store:GetPath("Plot.Stage") else 1
	local stage = math.clamp(math.floor(num(data.Stage, num(fallback, 1))), 1, EvolutionData.MaxStage)
	local def = EvolutionData.get(stage)
	local colour = stageColour(stage)
	playFlash(colour, ATTUNE_FLASH, ATTUNE_FADE)
	shake(SHAKE_SMALL[1], SHAKE_SMALL[2])
	playBanner(
		string.format(
			"%s  -  %s   (Stage %d of %d)",
			if def then def.Name else "Attuned",
			if def then def.Title else "the Conflux has grown",
			stage,
			EvolutionData.MaxStage
		),
		colour
	)
	SoundController:PlaySfx("Attune")
end

local function onTranscend(data: { [string]: any }): ()
	local fallback = if store ~= nil then store:GetPath("You.Rebirths") else 0
	local rebirths = math.max(0, math.floor(num(data.Rebirths, num(fallback, 0))))
	-- Primordial white regardless of affinity: the Sanctum has just been given up, so the tint that
	-- belonged to it is exactly what should not be on screen.
	local colour = Theme.Stage[EvolutionData.MaxStage].Color
	playFlash(colour, TRANSCEND_FLASH, TRANSCEND_FADE)
	shake(SHAKE_BIG[1], SHAKE_BIG[2])
	playBanner(string.format("TRANSCENDED  -  Rebirth %d", rebirths), colour)
	SoundController:PlaySfx("Transcend")
end

-- Cheap on purpose: a purchase happens every few seconds at a built-out Sanctum, so it gets one
-- stroke tween on the HUD panel and no flash, no shake and no banner.
local function onPurchase(): ()
	if hudStroke ~= nil then
		hudStroke.Color = Theme.Ui.Positive
		hudStroke.Transparency = 0
		tween(hudStroke, 0.45, { Transparency = 0.25 })
		task.delay(0.5, function()
			if hudStroke ~= nil then
				hudStroke.Color = Theme.Ui.Stroke
			end
		end)
	end
	SoundController:PlaySfx("Purchase")
end

local function onLink(data: { [string]: any }): ()
	local who = data.Name
	playBanner(
		(if type(who) == "string" and who ~= "" then who else "A partner") .. " joined the Sanctum",
		Theme.Ui.Positive
	)
	SoundController:PlaySfx("Notify")
end

local HANDLERS: { [string]: (data: { [string]: any }) -> () } = {
	attune = onAttune, transcend = onTranscend, purchase = function() onPurchase() end, link = onLink,
}

function Controller:Init(context: Context): ()
	store = context.Store
	remotes = context.Remotes
	local screen = context.Ui.ScreenGui

	-- Built here, not in UiBuilder: pure effect surfaces with no bound state, kept beside the code
	-- that animates them so a teardown cannot leave them behind.
	flash = make("Frame", {
		Name = "FxFlash", BackgroundColor3 = Theme.Ui.Accent, BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 40,
	}, screen)

	banner = make("TextLabel", {
		Name = "FxBanner", AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, Position = UDim2.fromScale(0.5, 0.14),
		Size = UDim2.fromScale(0.6, 0.08), Text = "", TextColor3 = Theme.Ui.Text,
		TextScaled = true, TextTransparency = 1, Visible = false, ZIndex = 41,
	}, screen)

	local hudRoot = context.Ui.Hud.Root
	hudStroke = if hudRoot ~= nil then hudRoot:FindFirstChildOfClass("UIStroke") else nil
end

function Controller:Start(): ()
	local fx = remotes[RemoteSchema.Remotes.Fx.Name]
	if fx == nil then
		return
	end

	table.insert(connections, fx.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		local handler = if type(payload.Kind) == "string" then HANDLERS[payload.Kind] else nil
		if handler == nil then
			return
		end
		--[[ Only reject a PlotId we can positively identify as somebody else's. Before the first
		     Full snapshot our own id is 0, and dropping the link/attune effects of the first minute
		     would be a worse bug than rendering a stray one. ]]
		local mine = num(if store ~= nil then store:GetPath("Plot.Id") else 0, 0)
		local theirs = num(payload.PlotId, mine)
		if mine > 0 and theirs > 0 and mine ~= theirs then
			return
		end
		handler(if type(payload.Data) == "table" then payload.Data else {})
	end))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	if shakeConnection ~= nil then
		shakeConnection:Disconnect()
		shakeConnection = nil
	end
	-- Bump both tokens so any delayed hide still in flight becomes a no-op against a destroyed tree.
	flashToken += 1
	bannerToken += 1
	if flash ~= nil then
		flash:Destroy()
		flash = nil
	end
	if banner ~= nil then
		banner:Destroy()
		banner = nil
	end
	hudStroke = nil
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    HudController
    Binds the always-on regions of the SanctumHud -- the essence/income/stage readout, the two
    partner slots and the action bar -- to the ClientStore snapshot. It renders and nothing else:
    every number it shows was computed by the server, and every gate it reports was decided by
    Economy. It also owns the single reason-code -> human-text table the whole client shares.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle), PromptController (ReasonText)
]]
--[[ WHY THE OBSERVERS ARE SPLIT THIS FINELY. StateSync pushes essence twice a second and everything
     else only when the sanctum is dirty. One coarse "re-render the HUD" observer would therefore
     rebuild the partner panel, re-read EvolutionData and reformat six labels 120 times a minute for
     the sake of one number. Each observer below owns exactly the widgets its own path can change,
     and the two that ride the essence tick do a single assignment each. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Economy = require(Modules:WaitForChild("Economy"))
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local Format = require(Modules:WaitForChild("Format"))
local Theme = require(Modules:WaitForChild("Theme"))

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "HudController"

local Reason = Economy.Reason

--[[ THE reason table. Economy returns closed-set codes and never sentences (§11 of DECISIONS), so
     exactly one file is allowed to decide what a code means in English -- this one. PromptController
     reads it through Controller.ReasonText rather than restating any of it, which is what stops a
     pad saying "Locked" while the HUD says "Not enough Essence" about the same refusal. ]]
local REASON_TEXT: { [string]: string } = {
	[Reason.Ok] = "Ready",
	[Reason.LockedStage] = "Attune the Conflux further first",
	[Reason.LockedSection] = "Unlock the Wing it stands in first",
	[Reason.MaxOwned] = "You own every one of these",
	[Reason.MaxLevel] = "Fully upgraded",
	[Reason.AlreadyOwned] = "Already part of the Sanctum",
	[Reason.Insufficient] = "Not enough Essence",
	[Reason.MaxStage] = "Primordial -- nothing further to attune into",
	[Reason.NeedEssence] = "Not enough Essence banked",
	[Reason.NeedLifetime] = "Earn more Essence this run",
	[Reason.NeedDroppers] = "Raise more Wellsprings first",
	[Reason.NeedStage] = "Reach Stage " .. tostring(EvolutionData.MaxStage) .. " first",
	[Reason.UnknownId] = "Unavailable",
}
Controller.ReasonText = REASON_TEXT

--[[ Resolver rather than a raw index, because a reason code arrives over the wire: a server built
     from newer data could name a code this client has never heard of, and a blank button is worse
     than a vague one. ]]
function Controller.reasonText(code: any): string
	if type(code) == "string" then
		local text = REASON_TEXT[code]
		if text ~= nil then
			return text
		end
	end
	return "Not available yet"
end

-- Snapshot fields are untrusted in the same sense Economy treats them: a malformed push must show a
-- zero, never propagate a NaN into a UDim2 (which would collapse the bar to an unrenderable size).
local function num(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

local connections: { any } = {}
local hud: any, partners: any, bar: any
local store: any
-- Cached so the two multi-source labels (income + motes) and the progress bar can each be redrawn
-- from one changed input without re-reading the whole snapshot.
local income, motes, stageTarget = 0, 0, 0

local function renderIncome(): ()
	hud.IncomeLabel.Text = string.format("%s/s   %d motes", Format.essence(income), motes)
end

-- Progress towards the NEXT stage's entry price. stageTarget of 0 means Primordial: the bar reads
-- full, because there is no further stage to be a fraction of.
local function renderProgress(essence: any): ()
	local fraction = if stageTarget > 0 then math.clamp(num(essence, 0) / stageTarget, 0, 1) else 1
	hud.StageFill.Size = UDim2.fromScale(fraction, 1)
end

local function renderStage(value: any): ()
	local index = math.clamp(math.floor(num(value, 1)), 1, EvolutionData.MaxStage)
	local def = EvolutionData.get(index)
	hud.StageLabel.Text = string.format(
		"%s  -  Stage %d / %d",
		if def then def.Name else "Unknown",
		index,
		EvolutionData.MaxStage
	)
	local nextStage = EvolutionData.next(index)
	stageTarget = if nextStage then num(nextStage.RequiredEssence, 0) else 0
	-- The bar's denominator just moved, so redraw it now rather than waiting for the next essence
	-- tick to make an attunement look like it reset the progress it just completed.
	renderProgress(store:GetPath("Essence"))
end

--[[ Two rows, filled by Slot rather than by array order: the server may list occupants in join
     order, and a partner leaving must not shuffle the surviving player into the other row. ]]
local function renderOccupants(list: any): ()
	local bySlot: { [number]: any } = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" then
				local slot = math.floor(num(entry.Slot, 0))
				if slot >= 1 and slot <= #partners.Slots then
					bySlot[slot] = entry
				end
			end
		end
	end

	for slot, row in ipairs(partners.Slots) do
		local occupant = bySlot[slot]
		local filled = occupant ~= nil
		row.NameLabel.Visible = filled
		row.ContributionLabel.Visible = filled
		row.RebirthChip.Visible = filled
		row.EmptyLabel.Visible = not filled
		if occupant ~= nil then
			local you = occupant.IsYou == true
			row.NameLabel.Text = tostring(occupant.Name) .. (if you then "  (you)" else "")
			row.ContributionLabel.Text = Format.abbreviate(num(occupant.Contribution, 0)) .. " contributed"
			-- "R3" rather than "3 rebirths": the chip is a quarter of a row wide and the R reads as
			-- a rank at a glance, which is the only thing it needs to do.
			row.RebirthChip.Text = "R" .. tostring(math.max(0, math.floor(num(occupant.Rebirths, 0))))
			-- The accent stroke is the only "this row is you" marker that survives being read at a
			-- glance; the "(you)" suffix is the accessible fallback for it.
			row.Highlight.Transparency = if you then 0 else 1
		else
			row.Highlight.Transparency = 1
		end
	end
end

--[[ The Attune button is a SIGNPOST, not a purchase: attunement happens at a server-listened pad
     (§1.7), so this only ever mirrors Gates.Attune. Blocked states keep the cost visible, because
     "Not enough Essence" without a number tells the player nothing about how far off they are. ]]
local function renderAttune(gate: any): ()
	local g = if type(gate) == "table" then gate else {}
	local ok = g.Ok == true
	local cost = num(g.Cost, 0)
	local costText = if cost > 0 then Format.essence(cost) else ""
	local button = bar.AttuneButton

	if ok then
		button.Text = if costText ~= "" then ("Attune  " .. costText) else "Attune"
		button.BackgroundColor3 = Theme.Ui.Accent
		button.TextColor3 = Theme.Ui.Background
	else
		local why = Controller.reasonText(g.Reason)
		button.Text = if costText ~= "" then (why .. "  " .. costText) else why
		button.BackgroundColor3 = Theme.Ui.Panel
		button.TextColor3 = Theme.Ui.Muted
	end
	-- Both flags, not just the colour: AutoButtonColor alone would still flash a hover highlight on
	-- a button that cannot do anything.
	button.Active = ok
	button.AutoButtonColor = ok
end

function Controller:Init(context: Context): ()
	store = context.Store
	hud = context.Ui.Hud
	partners = context.Ui.Partners
	bar = context.Ui.ActionBar
end

function Controller:Start(): ()
	local function track(connection: any): ()
		table.insert(connections, connection)
	end

	-- The hot path. Essence arrives ~twice a second, so these two observers do one assignment each
	-- and share no work; everything they would otherwise need was cached by a colder observer.
	track(store:Observe("Essence", function(value: any)
		hud.EssenceLabel.Text = Format.essence(num(value, 0))
	end))
	track(store:Observe("Essence", renderProgress))

	track(store:Observe("Plot.IncomePerSecond", function(value: any)
		income = num(value, 0)
		renderIncome()
	end))
	track(store:Observe("Plot.MoteCount", function(value: any)
		motes = math.max(0, math.floor(num(value, 0)))
		renderIncome()
	end))
	track(store:Observe("Plot.Multiplier", function(value: any)
		hud.MultiplierChip.Text = Format.multiplier(num(value, 1))
	end))
	track(store:Observe("Plot.Stage", renderStage))
	track(store:Observe("Occupants", renderOccupants))
	track(store:Observe("Gates.Attune", renderAttune))

	-- Hidden entirely rather than greyed out: an ineligible Transcendence is not a decision the pair
	-- is being offered, and a permanently dead button trains players to ignore the action bar.
	track(store:Observe("Gates.Transcend", function(gate: any)
		bar.TranscendButton.Visible = type(gate) == "table" and gate.Ok == true
	end))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">NotifyController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    NotifyController
    The toast stack. It is the client's only reader of the Notify remote: it renders at most four
    messages at a time in the bottom-left corner, colour-coded by Kind, each fading out on its own
    timer. Nothing else in the UI may invent a toast, because a message the server did not send is a
    claim about state the client has no way to know.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY A TOKEN BUCKET AND NOT A QUEUE. GameConfig.Network.MaxNotifyPerSecond is the server's own
     Notify budget, and matching it here means a burst -- a Transcendence firing one message per
     unlocked Wing, a bugged loop, a hostile server -- can never paper over the game. An unbounded
     queue would only defer the damage: the player would then sit through a minute of stale toasts
     draining while the Sanctum kept running. Over budget the message is DROPPED, and dropping the
     NEWEST is the honest choice: the toasts already on screen are the ones being read, and a toast
     that arrives during a flood is the least likely one to be the important one.

     WHY THE CAP AND THE BUDGET ARE BOTH NEEDED. The budget bounds the RATE; the four-slot cap
     bounds what is on screen at once, because six per second held for five seconds each would
     still stack thirty toasts up the side of the screen. ]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))
local Theme = require(Modules:WaitForChild("Theme"))

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }
type Toast = { Frame: any, Label: any, Stroke: any, Dismissed: boolean }

local Controller = {}
Controller.Name = "NotifyController"

local MAX_VISIBLE = 4
local HOLD_SECONDS = 5 -- long enough to read a sentence, short enough not to own the corner
local FADE_SECONDS = 0.35
-- A toast is a glance, not a document. Truncating here means a pathological Text cannot resize the
-- stack or push the older toasts off screen.
local MAX_TEXT = 140

-- Kind -> Theme colour. Unknown kinds fall back to Accent rather than being dropped: a message the
-- server bothered to send is worth showing even if this build does not recognise its severity.
local KIND_COLOUR: { [string]: Color3 } = {
	info = Theme.Ui.Accent,
	success = Theme.Ui.Positive,
	warn = Theme.Ui.Warning,
	error = Theme.Ui.Negative,
}

local FADE_TWEEN = TweenInfo.new(FADE_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local active: { Toast } = {}
local connections: { any } = {}
local root: any
local remotes: { [string]: any }
-- Monotonic, never reset: the list is bottom-aligned and sorted by LayoutOrder, so an ever-growing
-- order keeps the newest toast at the bottom and stops a new arrival from shuffling the one above
-- it while it is still being read.
local order = 0

local budget = math.max(1, math.floor(GameConfig.Network.MaxNotifyPerSecond))
local tokens = budget
local lastRefill = os.clock()

--[[ A leaky bucket refilled from the clock rather than a loop: no Heartbeat connection, no timer,
     and it stays correct across a frame hitch that a per-frame refill would under-count. ]]
local function consume(): boolean
	local now = os.clock()
	local elapsed = now - lastRefill
	if elapsed > 0 then
		tokens = math.min(budget, tokens + elapsed * budget)
		lastRefill = now
	end
	if tokens < 1 then
		return false
	end
	tokens -= 1
	return true
end

local function fade(instance: any, properties: { [string]: any }): ()
	-- Tweens are created per surface because a Frame tween cannot reach its label's TextTransparency
	-- or its stroke's Transparency, and a toast that faded its background but kept crisp text would
	-- look like a rendering bug rather than a dismissal.
	TweenService:Create(instance, FADE_TWEEN, properties):Play()
end

local function dismiss(toast: Toast): ()
	if toast.Dismissed then
		return
	end
	toast.Dismissed = true
	for index, entry in ipairs(active) do
		if entry == toast then
			table.remove(active, index)
			break
		end
	end

	fade(toast.Frame, { BackgroundTransparency = 1 })
	fade(toast.Label, { TextTransparency = 1, TextStrokeTransparency = 1 })
	fade(toast.Stroke, { Transparency = 1 })
	-- Debris rather than task.delay + Destroy: the Instance is reclaimed even if this client tears
	-- the controller down before the tween finishes, and there is no dangling closure holding it.
	Debris:AddItem(toast.Frame, FADE_SECONDS)
end

local function buildToast(kind: string, text: string): Toast
	local colour = KIND_COLOUR[kind] or Theme.Ui.Accent
	order += 1

	local frame = Instance.new("Frame")
	frame.Name = "Toast"
	frame.LayoutOrder = order
	frame.Size = UDim2.fromScale(1, 0.155)
	frame.BackgroundColor3 = Theme.Ui.Panel
	frame.BackgroundTransparency = 0.08
	frame.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	-- The stroke carries the severity in colour; the text carries it too, so the toast still reads
	-- correctly for a player who cannot separate the two hues.
	local stroke = Instance.new("UIStroke")
	stroke.Color = colour
	stroke.Thickness = 2
	stroke.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Message"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	-- Wrapped at a fixed size rather than TextScaled: scaling to fill would make a three-word toast
	-- enormous next to a two-line one, and the stack would visibly jump between messages.
	label.TextScaled = false
	label.TextSize = 15
	label.TextWrapped = true
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.6
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Text = text
	label.Parent = frame

	-- Parented last, so a half-built toast never appears in the stack.
	frame.Parent = root
	return { Frame = frame, Label = label, Stroke = stroke, Dismissed = false }
end

local function push(payload: any): ()
	if root == nil or type(payload) ~= "table" then
		return
	end
	local text = payload.Text
	if type(text) ~= "string" or text == "" then
		return
	end
	local kind = payload.Kind
	if type(kind) ~= "string" or KIND_COLOUR[kind] == nil then
		kind = "info"
	end
	if not consume() then
		return
	end

	-- Trim BEFORE building, and pop from the front (the oldest) so the stack never exceeds the cap
	-- even for a frame. table.remove first: dismiss() early-returns on an already-dismissed toast,
	-- so a search-and-remove inside the loop could otherwise spin forever.
	while #active >= MAX_VISIBLE do
		dismiss(table.remove(active, 1) :: Toast)
	end

	local toast = buildToast(kind, string.sub(text, 1, MAX_TEXT))
	table.insert(active, toast)
	-- Idempotent with the trim above and with Stop(): whichever dismissal happens first wins.
	task.delay(HOLD_SECONDS, function()
		dismiss(toast)
	end)
end

function Controller:Init(context: Context): ()
	remotes = context.Remotes
	root = context.Ui.Toasts.Root
end

function Controller:Start(): ()
	local remote = remotes[RemoteSchema.Remotes.Notify.Name]
	if remote == nil then
		-- Silent: ClientBootstrap already warned once per missing remote, and a second line per
		-- controller would bury the one that matters.
		return
	end
	table.insert(connections, remote.OnClientEvent:Connect(push))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	-- Destroy outright rather than fade: Stop means the HUD is going away, and a toast tweening out
	-- over a torn-down interface is a leak with an animation.
	for _, toast in ipairs(active) do
		toast.Dismissed = true
		toast.Frame:Destroy()
	end
	table.clear(active)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">PadVerdict</string>
              <string name="Source"><![CDATA[--!strict
--[[
    PadVerdict
    What one purchase pad MEANS, with no Instance in sight. It keeps a PlotState-shaped view of the
    snapshot and answers, for a given PadKind and id: what the pad is called, whether it can be acted
    on right now, the closed-set reason code if it cannot, and what it costs. Every answer is
    Economy's -- the same pure module PurchaseService runs on the server -- and every name comes
    straight from the catalogues.
    Split out of PromptController for the 300-line rule: this is that controller's pure half, and
    keeping it separate means the wording rules can be read without the Instance plumbing.
    Owner: client  |  Consumers: PromptController (only)
]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local DropperData = require(Modules:WaitForChild("DropperData"))
local Economy = require(Modules:WaitForChild("Economy"))
local EvolutionData = require(Modules:WaitForChild("EvolutionData"))
local SectionData = require(Modules:WaitForChild("SectionData"))
local UpgradeData = require(Modules:WaitForChild("UpgradeData"))

-- Exactly the fields Economy reads out of a PlotState, and nothing else. It is a PROJECTION of the
-- server's state rebuilt from each Full snapshot, never a second copy the client may edit.
type PlotView = {
	Essence: number,
	Stage: number,
	Affinity: string?,
	Droppers: { [string]: number },
	Upgrades: { [string]: number },
	Sections: { [string]: boolean },
	LifetimeEssence: number,
}

local PadVerdict = {}

local Reason = Economy.Reason
local EMPTY: { [string]: any } = {}

-- Re-exported so PromptController never has to spell a reason code as a literal: the closed set has
-- exactly one definition, in Economy, and this is the client's handle on it.
PadVerdict.Reason = Reason

-- The verb each PadKind uses when it CAN be acted on. Everything else a pad ever says is reason
-- text, so this table is the whole of the affordable vocabulary.
local VERBS: { [string]: string } = {
	dropper = "Buy for",
	upgrade = "Buy for",
	section = "Buy for",
	attune = "Attune for",
	transcend = "Transcend",
	link = "Share this Sanctum",
}

-- Snapshot fields are untrusted in the same sense Economy treats them: a NaN reaching a cost makes
-- every comparison against it false, and the pad would silently read as affordable.
local function num(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

local function map(value: any): { [string]: any }
	return if type(value) == "table" then value else EMPTY
end

--[[ The zeroed view a controller starts from. Stage 1 with nothing owned is the emptiest legal
     PlotState, so every pad reads "locked" or "cannot afford" until the first snapshot lands --
     which is the honest answer before the server has told this client anything. ]]
function PadVerdict.new(): PlotView
	return {
		Essence = 0,
		Stage = 1,
		Affinity = nil,
		Droppers = EMPTY :: any,
		Upgrades = EMPTY :: any,
		Sections = EMPTY :: any,
		LifetimeEssence = 0,
	}
end

-- Mutates in place rather than returning a fresh table: the view is held by one controller for the
-- life of the session, and reallocating it on every Full snapshot would churn for no benefit.
function PadVerdict.update(view: PlotView, source: any): ()
	local raw = map(source)
	view.Stage = math.clamp(math.floor(num(raw.Stage, 1)), 1, EvolutionData.MaxStage)
	view.Affinity = if type(raw.Affinity) == "string" then raw.Affinity else nil
	-- Referenced, not copied. ClientStore already deep-copies each Full payload, so these tables are
	-- private to the store and nothing on the client mutates them.
	view.Droppers = map(raw.Droppers) :: any
	view.Upgrades = map(raw.Upgrades) :: any
	view.Sections = map(raw.Sections) :: any
	view.LifetimeEssence = num(raw.LifetimeEssence, 0)
end

function PadVerdict.setEssence(view: PlotView, value: any): ()
	view.Essence = num(value, 0)
end

function PadVerdict.verb(kind: string): string
	return VERBS[kind] or "Buy for"
end

--[[ One switch over PadKind, and every branch DEFERS: the display name comes from the catalogue and
     the verdict from Economy, run on the same PlotState shape the server holds. An id this build has
     never heard of is made UNAVAILABLE, never free -- the same doctrine Economy applies to a corrupt
     def, for the same reason. ]]
function PadVerdict.evaluate(view: PlotView, kind: string, id: string): (string, boolean, string, number)
	if kind == "dropper" then
		local def = DropperData.get(id)
		if def == nil then
			return "Wellspring", false, Reason.UnknownId, 0
		end
		local ok, reason = Economy.dropperStatus(view, def)
		return def.Name, ok, reason, Economy.getDropperCost(def, num(view.Droppers[id], 0))
	elseif kind == "upgrade" then
		local def = UpgradeData.get(id)
		if def == nil then
			return "Upgrade", false, Reason.UnknownId, 0
		end
		local ok, reason = Economy.upgradeStatus(view, def)
		return def.Name, ok, reason, Economy.getUpgradeCost(def, Economy.upgradeLevel(view, id))
	elseif kind == "section" then
		local def = SectionData.get(id)
		if def == nil then
			return "Wing", false, Reason.UnknownId, 0
		end
		local ok, reason = Economy.sectionStatus(view, def)
		return def.Name, ok, reason, Economy.getSectionCost(def)
	elseif kind == "attune" then
		local ok, reason = Economy.attuneStatus(view)
		local nextStage = EvolutionData.next(view.Stage)
		if nextStage == nil then
			-- Primordial. attuneStatus already returned max_stage, so the pad reads as a landmark
			-- rather than as a purchase with a missing price.
			return "The Conflux", ok, reason, 0
		end
		return "Attune: " .. nextStage.Name, ok, reason, num(nextStage.RequiredEssence, 0)
	elseif kind == "transcend" then
		local ok, reason = Economy.transcendStatus(view)
		-- Transcendence spends the run, not the wallet: quoting a price here would be a lie.
		return "Transcendence", ok, reason, 0
	elseif kind == "link" then
		-- Not a purchase at all: the link pad costs nothing and PlotService alone decides who may
		-- use it, so the only honest thing the client can put on it is what it does.
		return "Sanctum Link", true, Reason.Ok, 0
	end
	return "Pad", false, Reason.UnknownId, 0
end

return PadVerdict
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">PromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    PromptController
    Makes every in-world purchase pad readable at a glance. It finds each pad's ProximityPrompt,
    reads the pad's server-published attributes (PadKind, PadId, PadCost, PadLocked), and writes
    ObjectText, ActionText and the sign colour. It buys nothing and judges nothing: what a pad means
    is PadVerdict's answer (which is Economy's answer), and how a refusal is worded is
    HudController's one reason-code table.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY DISCOVERY AND RENDERING ARE TWO SEPARATE PASSES. A Sanctum carries ~40 pads and StateSync
     pushes Essence twice a second, so anything done per pad per tick runs ~80 times a second per
     Sanctum -- and six Sanctums stand in the same Workspace. So discovery (walk the tree, resolve
     the attribute holder, find the sign, wire the signals) happens ONCE per prompt and is never
     redone on a tick; the Essence observer only walks the ALREADY-BOUND table and writes two
     strings and a colour per pad. Rebuilding the binding table on every tick would re-resolve
     hundreds of Instances and allocate a table per pad, twice a second, for a number that moved by
     one -- and it would drop every attribute connection on the floor while doing it. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Format = require(Modules:WaitForChild("Format"))
local Theme = require(Modules:WaitForChild("Theme"))

-- The reason-code -> English table lives in exactly one file (§11 of DECISIONS). Restating any of
-- it here is what would let a pad say "Locked" while the HUD says "Not enough Essence" about the
-- same refusal, so this controller borrows the resolver rather than owning a second table.
local HudController = require(script.Parent.HudController)
-- The pure half of this controller: the PlotState view and the per-kind verdicts.
local PadVerdict = require(script.Parent.PadVerdict)

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

-- Holder is the Instance the four Pad* attributes are read from; Label is the sign's TextLabel.
type Binding = {
	Prompt: any,
	Holder: Instance,
	Label: any,
	Kind: string,
	Id: string,
	Connections: { any },
}

local Controller = {}
Controller.Name = "PromptController"

-- A prompt normally sits directly on its pad; two hops covers a prompt nested one level deeper
-- (inside an Attachment, say) without walking the whole Sanctum for every unrelated prompt.
local MAX_ANCESTOR_HOPS = 2

local bindings: { [any]: Binding } = {}
local connections: { any } = {}
local store: any
local plot = PadVerdict.new()

-- Local rather than shared: a NaN PadCost must not survive into a comparison, and HudController
-- keeps its own copy of this same three-line guard for the same reason.
local function num(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

-- BuildKit parents a BillboardGui named "Sign" to each pad with a single TextLabel inside it.
local function signLabel(holder: Instance): any
	local sign = holder:FindFirstChild("Sign")
	return if sign ~= nil then sign:FindFirstChildOfClass("TextLabel") else nil
end

--[[ PadKind is published on the pad Part by PlotBuilder, but a prompt is allowed to carry its own
     copy, so the first Instance up the chain that has one wins and becomes the SINGLE place this
     binding reads all four attributes from. Reading Kind off one Instance and Cost off another is
     exactly how a pad ends up quoting a price for something it is not selling. ]]
local function holderFor(prompt: any): Instance?
	local node: Instance? = prompt
	for _ = 0, MAX_ANCESTOR_HOPS do
		if node == nil then
			return nil
		end
		if type(node:GetAttribute("PadKind")) == "string" then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function render(binding: Binding): ()
	local holder = binding.Holder
	local locked = holder:GetAttribute("PadLocked") == true
	local name, ok, reason, cost = PadVerdict.evaluate(plot, binding.Kind, binding.Id)
	-- The server's published price outranks the one derived here: PurchaseService rewrites PadCost
	-- on every refresh, and if the two ever disagree the pad must quote what it will actually
	-- charge. The Economy figure is the fallback for the window before the first refresh lands.
	cost = num(holder:GetAttribute("PadCost"), cost)

	local prompt = binding.Prompt
	prompt.ObjectText = name

	if locked then
		-- PadLocked is the server's word and it outranks affordability: a Wing that has not been
		-- unlocked must never read "Buy for X", however much Essence is in the shared wallet. The
		-- fallback covers the disagreement case, where the pad is locked but Economy says "ok".
		prompt.Enabled = false
		prompt.ActionText = HudController.reasonText(if ok then PadVerdict.Reason.LockedSection else reason)
	else
		-- Enabled is driven from PadLocked ALONE, and only ever locally: a client-side write does
		-- not replicate, and PurchaseService re-checks occupancy and affordability on every trigger,
		-- so the worst this can do is offer a prompt the server then refuses.
		prompt.Enabled = true
		if ok then
			local verb = PadVerdict.verb(binding.Kind)
			prompt.ActionText = if cost > 0 then (verb .. " " .. Format.essence(cost)) else verb
		else
			prompt.ActionText = HudController.reasonText(reason)
		end
	end

	local label = binding.Label
	if label ~= nil then
		-- Three states, three colours, legible from across the Sanctum: Negative reads "you cannot
		-- be here yet", Muted reads "come back with more Essence", Positive reads "press E".
		label.TextColor3 = if locked
			then Theme.Ui.Negative
			elseif ok then Theme.Ui.Positive
			else Theme.Ui.Muted
	end
end

local function renderAll(): ()
	for _, binding in pairs(bindings) do
		render(binding)
	end
end

local function unbind(prompt: any): ()
	local binding = bindings[prompt]
	if binding == nil then
		return
	end
	bindings[prompt] = nil
	for _, connection in ipairs(binding.Connections) do
		connection:Disconnect()
	end
end

local function bind(prompt: any): ()
	if bindings[prompt] ~= nil then
		return
	end
	local holder = holderFor(prompt)
	if holder == nil then
		return -- not a purchase pad; every other prompt in the world is somebody else's business
	end
	local kind = holder:GetAttribute("PadKind")
	local id = holder:GetAttribute("PadId")
	if type(kind) ~= "string" or type(id) ~= "string" then
		return
	end

	local binding: Binding = {
		Prompt = prompt,
		Holder = holder,
		Label = signLabel(holder),
		Kind = kind,
		Id = id,
		Connections = {},
	}
	bindings[prompt] = binding

	--[[ Only PadCost and PadLocked earn a signal. PadKind/PadId are the pad's identity, written once
	     at build time, so watching them would cost a connection per pad per Sanctum for an event
	     that never fires. These two are what PurchaseService:RefreshPads rewrites. ]]
	table.insert(binding.Connections, holder:GetAttributeChangedSignal("PadCost"):Connect(function()
		render(binding)
	end))
	table.insert(binding.Connections, holder:GetAttributeChangedSignal("PadLocked"):Connect(function()
		render(binding)
	end))
	-- MOCK-EXTRA: Instance.Destroying. Without it a Transcendence -- which tears the Sanctum down
	-- and rebuilds every pad -- would leave this table holding dead prompts and their attribute
	-- connections for the rest of the session, and every rebuild would leak another ~40.
	table.insert(binding.Connections, prompt.Destroying:Connect(function()
		unbind(prompt)
	end))

	render(binding)
end

local function bindDescendants(root: Instance): ()
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			bind(descendant)
		end
	end
end

function Controller:Init(context: Context): ()
	store = context.Store
	-- Seed from whatever the store already holds so the sweep in Start renders real numbers instead
	-- of a zeroed default that the next snapshot would immediately overwrite.
	PadVerdict.update(plot, store:GetPath("Plot"))
	PadVerdict.setEssence(plot, store:GetPath("Essence"))
end

function Controller:Start(): ()
	local function track(connection: any): ()
		table.insert(connections, connection)
	end

	--[[ PlotBuilder does not tag pads with CollectionService, so discovery is the plain pair: one
	     sweep for the Sanctums that already exist when this client joins, plus DescendantAdded for
	     everything built afterwards. Both funnel into bind(), which is idempotent, so overlap
	     between the two is free. ]]
	bindDescendants(workspace)
	-- MOCK-EXTRA: workspace.DescendantAdded.
	track(workspace.DescendantAdded:Connect(function(descendant: Instance)
		if descendant:IsA("ProximityPrompt") then
			bind(descendant)
		elseif descendant:IsA("Model") or descendant:IsA("Folder") then
			-- A whole Wing arriving at once (an unlock reparents it back into the world) is one
			-- container add, so scan it. Restricted to containers because scanning the descendants
			-- of every Part that ever streams in would be an unbounded cost on a hot signal.
			bindDescendants(descendant)
		end
	end))

	--[[ Two observers, deliberately asymmetric. "Plot" only changes on a Full snapshot -- the server
	     marks a Sanctum dirty -- so rebuilding the PlotState view there is rare and cheap. "Essence"
	     arrives twice a second and writes ONE field before re-rendering the bound pads: no
	     allocation, no attribute walk, no re-resolution of a sign. ]]
	track(store:Observe("Plot", function(value: any)
		PadVerdict.update(plot, value)
		renderAll()
	end))
	track(store:Observe("Essence", function(value: any)
		PadVerdict.setEssence(plot, value)
		renderAll()
	end))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	for prompt in pairs(bindings) do
		unbind(prompt)
	end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">RebirthController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    RebirthController
    Owns the Transcendence modal: the irreversible-action warning, the live consensus vote list and
    its countdown. It decides nothing. The server opens a vote by pushing RebirthVoteState, counts
    the votes and executes; this file renders that state and forwards two button presses as
    RebirthVote { Accept = true } / { Accept = false }.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY THE COPY IS BLUNT. Transcendence deletes an hour of shared work and the pair have thirty
     seconds to agree to it. Softening the wording to "reset your progress" would make the most
     destructive button in the game read like a menu option, so the modal names every category of
     thing that is destroyed and every category that survives, in exactly those words.

     WHY THE MODAL IS CLOSED FROM FOUR DIRECTIONS. A vote can end in four ways: unanimous yes,
     somebody votes no, an occupant leaves, or the window expires -- and only the first is visible
     in the payload. So it closes on a terminal push (an ExpiresAt that is not in the future), on a
     local countdown reaching zero, on unanimity, and on a Confirm the server never answered. A
     stuck modal is a full-screen scrim over a running Sanctum, which is unrecoverable in-game. ]]

local RunService = game:GetService("RunService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Format = require(Modules:WaitForChild("Format"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))
local Theme = require(Modules:WaitForChild("Theme"))

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "RebirthController"

-- Named in full, in the player's vocabulary, with no hedging. "Everything" alone is not a warning.
local WARNING = table.concat({
	"This cannot be undone, and it takes the whole Sanctum with it.",
	"LOST -- every Essence in the shared wallet, your Stage (back to Mote), every Wellspring, every"
		.. " Upgrade, every Wing, and the Affinity the pair chose.",
	"KEPT -- your rebirth count, your permanent multiplier, and the badges you have earned. Those"
		.. " are per player and are never merged or reset.",
	"Every occupant must vote yes inside the window. Everyone who votes yes keeps the reward.",
}, "\n\n")

-- How long a Confirm may go unanswered before the modal gives up. The server replies with a vote
-- state within a tick when it accepts, so silence past this means it refused.
local ANSWER_GRACE = 5
local TICK_INTERVAL = 0.25 -- countdown redraw cadence; a 30s window does not need per-frame text

local connections: { any } = {}
local remotes: { [string]: any } = {}
local modal: any = nil
local transcendButton: any = nil
local selfKey = ""
local names: { [string]: string } = {}
local votes: { [string]: boolean } = {}
local expiresAt = 0 -- os.time() deadline of the live vote; 0 = no vote in progress
-- os.clock() at which Confirm was sent with no live vote. nil, not 0, because os.clock() is zero
-- at the first frame of a session and a sentinel that collides with a real reading is a bug.
local pendingSince: number? = nil
local accumulator = 0

local function num(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

--[[ Rows are filled in sorted key order, not pairs order: Luau's pairs order is unspecified, so
     without the sort a partner could visibly swap rows between two pushes of the same vote. ]]
local function renderVotes(): ()
	local keys: { string } = {}
	for key in pairs(names) do
		table.insert(keys, key)
	end
	table.sort(keys)

	for index, row in ipairs(modal.VoteRows) do
		local key = keys[index]
		if key == nil then
			row.Visible = false
			continue
		end
		local who = tostring(names[key])
		if key == selfKey then
			who ..= "  (you)"
		end
		local vote = votes[key]
		if vote == true then
			row.Text = who .. "  --  yes"
			row.TextColor3 = Theme.Ui.Positive
		elseif vote == false then
			row.Text = who .. "  --  no"
			row.TextColor3 = Theme.Ui.Negative
		else
			-- "deciding", not "no": an occupant who has not answered yet has refused nothing.
			row.Text = who .. "  --  deciding"
			row.TextColor3 = Theme.Ui.Muted
		end
		row.Visible = true
	end
end

-- The Confirm button is the player's own vote, so once it is cast it stops being a button: leaving
-- it live would invite a second press that says nothing new.
local function renderConfirm(): ()
	local cast = votes[selfKey] == true
	local button = modal.Confirm
	button.Text = if cast then "Waiting for the Sanctum" else (if expiresAt > 0 then "Vote yes" else "Begin the vote")
	button.BackgroundColor3 = if cast then Theme.Ui.Panel else Theme.Ui.Warning
	button.TextColor3 = if cast then Theme.Ui.Muted else Theme.Ui.Background
	button.Active = not cast
	button.AutoButtonColor = not cast
end

local function close(): ()
	expiresAt = 0
	pendingSince = nil
	names = {}
	votes = {}
	modal.TimerLabel.Text = ""
	for _, row in ipairs(modal.VoteRows) do
		row.Visible = false
	end
	modal.Root.Visible = false
end

local function open(): ()
	modal.Root.Visible = true
	renderVotes()
	renderConfirm()
end

-- Vacuously-true guard: a push whose Names table is empty must not read as "everybody agreed".
local function unanimous(): boolean
	local count = 0
	for key in pairs(names) do
		count += 1
		if votes[key] ~= true then
			return false
		end
	end
	return count > 0
end

local function send(accept: boolean): ()
	local remote = remotes[RemoteSchema.Remotes.RebirthVote.Name]
	if remote == nil then
		return
	end
	-- Accept is the whole payload: the server derives the sanctum from occupancy, so there is no
	-- plot, player or amount here for anyone to forge.
	remote:FireServer({ Accept = accept })
end

--[[ The server's vote state. It is the only thing that puts a vote on screen -- pressing the HUD
     button opens the warning, but until a state arrives there is no vote, no list and no clock. ]]
local function onVoteState(payload: any): ()
	if type(payload) ~= "table" then
		return
	end
	local deadline = num(payload.ExpiresAt, 0)
	if deadline <= os.time() then
		-- A cancel, an expiry or a completed vote all arrive looking like this. Close, do not guess.
		close()
		return
	end

	names = {}
	votes = {}
	if type(payload.Names) == "table" then
		for key, value in pairs(payload.Names) do
			if type(key) == "string" and type(value) == "string" then
				names[key] = value
			end
		end
	end
	if type(payload.Votes) == "table" then
		for key, value in pairs(payload.Votes) do
			if type(key) == "string" and type(value) == "boolean" then
				votes[key] = value
			end
		end
	end

	expiresAt = deadline
	pendingSince = nil
	if unanimous() then
		-- Everyone has agreed; the server is already executing and the Fx is on its way.
		close()
		return
	end
	open()
end

local function tick(deltaTime: number): ()
	accumulator += deltaTime
	if accumulator < TICK_INTERVAL then
		return
	end
	accumulator = 0
	if modal == nil or modal.Root.Visible ~= true then
		return
	end

	if expiresAt > 0 then
		local remaining = expiresAt - os.time()
		if remaining <= 0 then
			close()
			return
		end
		modal.TimerLabel.Text = "Vote closes in " .. Format.time(remaining)
	elseif pendingSince ~= nil and os.clock() - pendingSince > ANSWER_GRACE then
		-- Confirmed, but the server never opened a vote: it refused (gate not met, or a vote is
		-- already running elsewhere). It said why through Notify; the modal simply gets out of the way.
		close()
	end
end

function Controller:Init(context: Context): ()
	remotes = context.Remotes
	modal = context.Ui.Modals.Transcend
	transcendButton = context.Ui.ActionBar.TranscendButton
	selfKey = tostring(context.Player.UserId)

	modal.Body.Text = WARNING
	-- Smaller than the shell default: this is the longest body copy in the game and it must fit
	-- without scrolling, because a warning the player has to scroll is a warning they will not read.
	modal.Body.TextSize = 13
	modal.TimerLabel.Text = ""
	modal.Root.Visible = false
	renderConfirm()
end

function Controller:Start(): ()
	local function track(connection: any): ()
		table.insert(connections, connection)
	end

	-- The HUD button only ever opens the warning. HudController shows it solely when
	-- Gates.Transcend.Ok is true, and the server re-checks the gate before opening a vote anyway.
	track(transcendButton.Activated:Connect(open))

	track(modal.Confirm.Activated:Connect(function()
		if votes[selfKey] == true then
			return
		end
		send(true)
		if expiresAt == 0 then
			-- Opening the vote, not answering one: start the answer clock so a refusal cannot leave
			-- the modal sitting open forever.
			pendingSince = os.clock()
		end
		-- Optimistic only in the UI: the row and the button say "sent", the server still decides.
		votes[selfKey] = true
		renderVotes()
		renderConfirm()
	end))

	track(modal.Cancel.Activated:Connect(function()
		-- A no is worth sending even with no vote running: it is how a partner declines the vote
		-- the other one just opened, and the server ignores it otherwise.
		send(false)
		close()
	end))

	local remote = remotes[RemoteSchema.Remotes.RebirthVoteState.Name]
	if remote ~= nil then
		track(remote.OnClientEvent:Connect(onVoteState))
	end

	-- One always-on Heartbeat rather than connect/disconnect per vote: the handler is a numeric
	-- compare and an early return, and a countdown that fails to start is worse than a free frame.
	track(RunService.Heartbeat:Connect(tick))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	if modal ~= nil then
		close()
	end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    SettingsController
    Owns the Settings modal and the action-bar button that opens it: the Music and Sfx toggles, and
    the developer-only "reset my save" control behind a two-second hold. It renders the Settings the
    snapshot reports and asks the server to change them; it keeps no preference of its own, so a
    setting the server refuses simply never appears to have changed.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle)
]]
--[[ WHY THE TOGGLES ARE NOT OPTIMISTIC IN STATE. A click fires SetSetting and then does nothing
     else -- it does not touch the label. The label is rewritten only when "You.Settings" comes back
     changed. That costs one round trip of latency and buys the guarantee that the button never
     lies: a setting dropped by the rate limiter or refused by ProfileService snaps back on its own,
     with no reconciliation code and no second source of truth to drift out of sync. They still
     FEEL optimistic, because the snapshot that confirms them is already on a 0.5s cadence. ]]
--[[ CONFIRMED DECISION §9.5.6 -- THE RESET CONTROL. It exists only when GameConfig.Debug
     .AllowDataReset is set and, when DataResetStudioOnly is also set, only in Studio. Hiding the
     button here is a COURTESY, not the control: RemoteSchema refuses the payload and ProfileService
     refuses the action under exactly the same conditions, so a player who fabricates the remote
     call on a live server still gets nothing. This check exists so that a live server never shows a
     button that could not work, not so that the button is safe to show. ]]

local RunService = game:GetService("RunService")

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local RemoteSchema = require(Modules:WaitForChild("RemoteSchema"))
local Theme = require(Modules:WaitForChild("Theme"))

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "SettingsController"

local HOLD_SECONDS = 2
local RESET_LABEL = "Hold to reset my save" -- must match the wording UiModals builds the button with
local WARNING_TEXT = "Resetting deletes your save outright: every Wellspring, Wing, Stage,"
	.. " Transcendence and badge. There is no undo and no backup."

local connections: { any } = {}
local store: any
local remotes: { [string]: any }
local modal: any
local openButton: any
local fill: any
local warning: any
-- Hold state lives here rather than on the widget so cancelling is a single call from three
-- different signals (button up, pointer leave, modal close) that cannot disagree.
local held = 0
local holdConnection: any = nil

--[[ Both halves of the gate, in one place, so the Init-time visibility and the Start-time signal
     wiring can never be decided differently. ]]
local function resetAllowed(): boolean
	if GameConfig.Debug.AllowDataReset ~= true then
		return false
	end
	return GameConfig.Debug.DataResetStudioOnly ~= true or RunService:IsStudio()
end

-- Absent means on: a brand new profile has both enabled, and the pre-snapshot default must match
-- what the server will report rather than showing "Off" for half a second on every join.
local function settingOn(key: string): boolean
	return store:GetPath("You.Settings." .. key) ~= false
end

local function renderToggle(button: any, name: string, on: boolean): ()
	button.Text = name .. ": " .. (if on then "On" else "Off")
	button.BackgroundColor3 = if on then Theme.Ui.Positive else Theme.Ui.Background
	button.TextColor3 = if on then Theme.Ui.Background else Theme.Ui.Muted
end

local function renderSettings(value: any): ()
	local settings = if type(value) == "table" then value else {}
	renderToggle(modal.MusicToggle, "Music", settings.Music ~= false)
	renderToggle(modal.SfxToggle, "Sfx", settings.Sfx ~= false)
end

--[[ Fire and forget. The store is the only thing that decides what the toggle says, so there is
     nothing to roll back if the rate limiter drops this. The NEXT value is derived from the
     SNAPSHOT, never from the widget: two fast clicks then send the same intent twice instead of
     flip-flopping around a value the server never accepted. ]]
local function send(key: string): ()
	local remote = remotes[RemoteSchema.Remotes.SetSetting.Name]
	if remote == nil then
		return
	end
	remote:FireServer({ Key = key, Value = not settingOn(key) })
end

local function stopHold(): ()
	if holdConnection ~= nil then
		holdConnection:Disconnect()
		holdConnection = nil
	end
	held = 0
	if fill ~= nil then
		fill.Size = UDim2.fromScale(0, 1)
	end
end

local function fireReset(): ()
	-- Disconnect FIRST: this runs from inside the Heartbeat handler, and leaving it connected for
	-- even one more frame would fire a second ResetData that the rate limiter would then reject.
	stopHold()
	local remote = remotes[RemoteSchema.Remotes.ResetData.Name]
	if remote == nil then
		return
	end
	modal.ResetButton.Text = "Reset requested"
	remote:FireServer({ Confirm = true })
end

--[[ Accumulated dt rather than a start timestamp: it makes the fill and the threshold read the same
     clock, so the bar is never visibly full while the action has not fired (or the reverse). ]]
local function beginHold(): ()
	if holdConnection ~= nil then
		return
	end
	held = 0
	holdConnection = RunService.Heartbeat:Connect(function(delta: number)
		held += (if type(delta) == "number" and delta == delta then delta else 0)
		fill.Size = UDim2.fromScale(math.clamp(held / HOLD_SECONDS, 0, 1), 1)
		if held >= HOLD_SECONDS then
			fireReset()
		end
	end)
end

local function setOpen(open: boolean): ()
	modal.Root.Visible = open
	if not open then
		-- A modal closed mid-hold must not resume a destructive action when it is reopened.
		stopHold()
		modal.ResetButton.Text = RESET_LABEL
	end
end

function Controller:Init(context: Context): ()
	store = context.Store
	remotes = context.Remotes
	modal = context.Ui.Modals.Settings
	openButton = context.Ui.ActionBar.SettingsButton

	--[[ The hold meter is a CHILD of the button, not a sibling, so it tracks the button's size and
	     position for free. It is semi-transparent because a TextButton draws its own text underneath
	     its children: an opaque fill would hide the very label it is confirming. ]]
	fill = Instance.new("Frame")
	fill.Name = "HoldFill"
	fill.BackgroundColor3 = Theme.Ui.Negative
	fill.BackgroundTransparency = 0.45
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.ZIndex = modal.ResetButton.ZIndex
	fill.Parent = modal.ResetButton

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = fill

	--[[ Blunt, and built here rather than in UiModals: the warning only makes sense next to a button
	     that exists, and whether that button exists is this controller's decision. ]]
	warning = Instance.new("TextLabel")
	warning.Name = "ResetWarning"
	warning.LayoutOrder = 4 -- Content is a vertical UIListLayout; this sits under ResetButton
	warning.Size = UDim2.fromScale(0.9, 0.3)
	warning.BackgroundTransparency = 1
	warning.Font = Enum.Font.Gotham
	warning.TextScaled = false
	warning.TextSize = 13
	warning.TextWrapped = true
	warning.TextColor3 = Theme.Ui.Negative
	warning.TextXAlignment = Enum.TextXAlignment.Center
	warning.Text = WARNING_TEXT
	warning.ZIndex = modal.ResetButton.ZIndex
	warning.Parent = modal.Content

	local allowed = resetAllowed()
	modal.ResetButton.Visible = allowed
	warning.Visible = allowed
end

function Controller:Start(): ()
	local function track(connection: any): ()
		table.insert(connections, connection)
	end

	track(openButton.Activated:Connect(function()
		setOpen(true)
	end))
	-- Both footer buttons close: "Done" and "Close" mean the same thing here, because every setting
	-- was already committed the moment it was toggled. There is nothing left to confirm.
	track(modal.Confirm.Activated:Connect(function()
		setOpen(false)
	end))
	track(modal.Cancel.Activated:Connect(function()
		setOpen(false)
	end))

	track(modal.MusicToggle.Activated:Connect(function()
		send("Music")
	end))
	track(modal.SfxToggle.Activated:Connect(function()
		send("Sfx")
	end))
	track(store:Observe("You.Settings", renderSettings))

	--[[ The hold signals are wired ONLY when the reset is allowed. A hidden-but-live button would
	     still be reachable by anything that can flip Visible, and there is no reason to leave a
	     destructive path armed behind a boolean. MouseLeave is treated as a release because a
	     pointer dragged off the button never delivers MouseButton1Up to it. ]]
	if resetAllowed() then
		track(modal.ResetButton.MouseButton1Down:Connect(beginHold))
		track(modal.ResetButton.MouseButton1Up:Connect(stopHold))
		track(modal.ResetButton.MouseLeave:Connect(stopHold))
	end
end

function Controller:Stop(): ()
	stopHold()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    SoundController
    Every sound the client can play, behind one deliberate gate: all asset ids live in a single
    table at the top of this file, all of them empty. An empty id makes the play call a silent
    no-op rather than an error, so Sanctum of Embers is fully playable before any audio exists and
    becomes audible the moment the ids are filled in -- with no other file touched.
    Owner: client  |  Consumers: ClientBootstrap (lifecycle), EvolutionFxController, NotifyController
]]
--[[ WHY SILENT-BY-DEFAULT IS THE WHOLE DESIGN (confirmed decision 9.5.7). Inventing plausible
     looking asset ids was rejected: an unverifiable id is either silent anyway or, worse, ships the
     wrong sound confidently. So the wiring is finished -- the toggles, the pool, every cue -- and
     only the ids are outstanding. Nothing downstream needs to know whether audio exists yet.

     WHY A POOL. Purchases fire a cue per click and a player mashing a Wellspring pad can trigger
     several a second. Allocating a Sound per click would churn Instances on the hot path, so a
     fixed ring of voices is created once at Init and reused forever; when every voice is busy the
     oldest is stolen, because a dropped cue is better than an unbounded allocation. ]]

local SoundService = game:GetService("SoundService")

type Context = { Store: any, Remotes: { [string]: any }, Player: any, PlayerGui: any, Ui: any }

local Controller = {}
Controller.Name = "SoundController"

--[[ THE one asset table. Every id is a `rbxassetid://...` string when supplied; each is empty until
     then. Do not scatter ids into the code below -- the silent no-op check reads this table only. ]]
local ASSETS = {
	Music = {
		Ambient = "", -- TODO: asset id -- looping sanctum ambience
	},
	Sfx = {
		Purchase = "", -- TODO: asset id -- a Wellspring/Upgrade/Wing pad was bought
		Attune = "", -- TODO: asset id -- the Conflux reached a new Stage
		Transcend = "", -- TODO: asset id -- the pair Transcended
		Notify = "", -- TODO: asset id -- a toast appeared
		Error = "", -- TODO: asset id -- a refused action
		Collect = "", -- TODO: asset id -- a Mote reached the Conflux Font
	},
}

-- Mix levels, kept out of ASSETS so that table stays exactly "the ids". Collect is the quietest by
-- a wide margin: it can fire many times a second at a built-out Sanctum.
local VOLUME: { [string]: number } = {
	Purchase = 0.35, Attune = 0.60, Transcend = 0.80, Notify = 0.30, Error = 0.40, Collect = 0.12,
}
local MUSIC_VOLUME = 0.22
local DEFAULT_VOLUME = 0.35
local POOL_SIZE = 6 -- enough overlap for a purchase burst, small enough to be free

local connections: { any } = {}
local store: any = nil
local root: any = nil
local music: any = nil
local pool: { any } = {}
local cursor = 0
-- Both default to ON, matching StateSchema's Settings default: the store hands us `true` before the
-- first snapshot arrives, and a player whose profile says otherwise is corrected within a tick.
local musicEnabled = true
local sfxEnabled = true

-- The single definition of "we have an id for this". Anything that is not a non-empty string is a
-- cue that has not been supplied yet.
local function isPlayable(id: any): boolean
	return type(id) == "string" and id ~= ""
end

local function applyMusic(): ()
	if music == nil then
		return
	end
	if musicEnabled and isPlayable(ASSETS.Music.Ambient) then
		music.SoundId = ASSETS.Music.Ambient
		if music.Playing ~= true then
			music:Play()
		end
	elseif music.Playing == true then
		music:Stop()
	end
end

-- Round-robin, preferring an idle voice. Returns nil only if Init never ran, which is the one case
-- where a caller must still not error.
local function nextVoice(): any?
	local size = #pool
	if size == 0 then
		return nil
	end
	for _ = 1, size do
		cursor = (cursor % size) + 1
		local candidate = pool[cursor]
		if candidate ~= nil and candidate.Playing ~= true then
			return candidate
		end
	end
	return pool[cursor]
end

--[[ Play one named cue. Silent (and harmless) for an unknown name, a missing id, a disabled Sfx
     setting or a controller that failed to Init -- every one of those is a normal state, not a
     fault, so none of them warns. ]]
function Controller:PlaySfx(name: string): ()
	if not sfxEnabled then
		return
	end
	local id = if type(name) == "string" then (ASSETS.Sfx :: { [string]: any })[name] else nil
	if not isPlayable(id) then
		return
	end
	local voice = nextVoice()
	if voice == nil then
		return
	end
	voice.SoundId = id
	voice.Volume = VOLUME[name] or DEFAULT_VOLUME
	voice:Play()
end

--[[ Local override for the music bed. It deliberately does NOT fire SetSetting: SettingsController
     owns that remote and the saved preference, and this must stay usable for a momentary duck. ]]
function Controller:SetMusicEnabled(enabled: boolean): ()
	musicEnabled = enabled == true
	applyMusic()
end

function Controller:Init(context: Context): ()
	store = context.Store

	-- One folder so a teardown is a single Destroy and nothing is left parented to SoundService.
	root = Instance.new("Folder")
	root.Name = "SanctumAudio"
	root.Parent = SoundService

	music = Instance.new("Sound")
	music.Name = "Ambient"
	music.Looped = true
	music.Volume = MUSIC_VOLUME
	music.SoundId = ASSETS.Music.Ambient
	music.Parent = root

	for index = 1, POOL_SIZE do
		local voice = Instance.new("Sound")
		voice.Name = "Sfx" .. tostring(index)
		voice.Looped = false
		voice.Volume = DEFAULT_VOLUME
		voice.Parent = root
		pool[index] = voice
	end
end

function Controller:Start(): ()
	if store == nil then
		return
	end

	--[[ `value ~= false` rather than `value == true`: a snapshot that predates the profile load has
	     no You.Settings at all, and the honest default for both switches is on. Only an explicit
	     false silences anything. ]]
	table.insert(connections, store:Observe("You.Settings.Music", function(value: any)
		Controller:SetMusicEnabled(value ~= false)
	end))

	table.insert(connections, store:Observe("You.Settings.Sfx", function(value: any)
		sfxEnabled = value ~= false
		if not sfxEnabled then
			-- Stop in-flight voices too: a player who just turned SFX off should hear silence now,
			-- not after the current cue finishes.
			for _, voice in ipairs(pool) do
				if voice.Playing == true then
					voice:Stop()
				end
			end
		end
	end))
end

function Controller:Stop(): ()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	musicEnabled = false
	applyMusic()
	table.clear(pool)
	cursor = 0
	music = nil
	if root ~= nil then
		root:Destroy()
		root = nil
	end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">UiBuilder</string>
              <string name="Source"><![CDATA[--!strict
--[[
    UiBuilder
    Builds the whole SanctumHud ScreenGui in code and hands back a flat table of named references.
    Deliberately inert: no store, no remotes, no connections, no behaviour of any kind. Controllers
    bind to a layout they did not build, which keeps "where a widget lives" and "what a widget
    means" in two separate files -- and keeps the layout reviewable as a plain diff.
    Owner: client  |  Consumers: ClientBootstrap, HudController, and every other controller
]]
--[[ WHY EVERYTHING IS Scale-BASED. This HUD is read on a 1920px monitor and on a 380px phone, so
     every position and size is a fraction of the viewport, text is TextScaled, and any panel whose
     readability depends on its shape carries a UIAspectRatioConstraint. Pixel offsets appear ONLY
     for corner radii and stroke thickness, which are surface detail rather than layout. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Theme = require(Modules:WaitForChild("Theme"))
local Format = require(Modules:WaitForChild("Format"))

-- Modal construction lives next door purely for the 300-line rule; it is handed this file's
-- primitives, so there is exactly one definition of "what a panel looks like".
local UiModals = require(script.Parent.UiModals)

type Props = { [string]: any }
type Region = { [string]: any }
type Ui = { ScreenGui: Instance, Hud: Region, Partners: Region, ActionBar: Region, Modals: Region, Toasts: Region }

local UiBuilder = {}

local TITLE_FONT = Enum.Font.GothamBold
local BODY_FONT = Enum.Font.Gotham

-- Every helper starts from a defaults table it owns exclusively, so mutating it here cannot leak.
local function with(base: Props, overrides: Props?): Props
	if overrides ~= nil then
		for key, value in pairs(overrides) do
			base[key] = value
		end
	end
	return base
end

local function new(className: string, props: Props, parent: Instance?): any
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		(inst :: any)[key] = value
	end
	-- Parent last: every property write on an already-parented instance is a separate replication
	-- step, and this builder writes a dozen per widget.
	inst.Parent = parent
	return inst
end

local function corner(inst: Instance, radius: number): ()
	new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function stroke(inst: Instance, color: Color3, thickness: number): ()
	new("UIStroke", { Color = color, Thickness = thickness, Transparency = 0.25 }, inst)
end

-- Scale padding, not offset: the inset must shrink with the panel or a phone-sized panel is all
-- margin and no content.
local function padding(inst: Instance, scale: number): ()
	local amount = UDim.new(scale, 0)
	new("UIPadding", { PaddingTop = amount, PaddingBottom = amount, PaddingLeft = amount, PaddingRight = amount }, inst)
end

local function listLayout(inst: Instance, gap: number, overrides: Props?): any
	return new("UIListLayout", with({
		FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(gap, 0), HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, overrides), inst)
end

local function aspect(inst: Instance, ratio: number): ()
	new("UIAspectRatioConstraint", { AspectRatio = ratio, DominantAxis = Enum.DominantAxis.Width }, inst)
end

local function label(props: Props, parent: Instance?): any
	return new("TextLabel", with({
		BackgroundTransparency = 1, Font = BODY_FONT, Text = "", TextColor3 = Theme.Ui.Text,
		TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, props), parent)
end

local function panel(props: Props, parent: Instance?): any
	local frame = new("Frame", with({
		BackgroundColor3 = Theme.Ui.Panel, BackgroundTransparency = 0.08, BorderSizePixel = 0,
	}, props), parent)
	corner(frame, 10)
	stroke(frame, Theme.Ui.Stroke, 1.5)
	return frame
end

local function button(props: Props, parent: Instance?): any
	local btn = new("TextButton", with({
		AutoButtonColor = true, BackgroundColor3 = Theme.Ui.Panel, BorderSizePixel = 0,
		Font = TITLE_FONT, Text = "", TextColor3 = Theme.Ui.Text, TextScaled = true,
	}, props), parent)
	corner(btn, 8)
	stroke(btn, Theme.Ui.Stroke, 1.5)
	return btn
end

-- Handed to UiModals as an argument rather than required back out: UiBuilder already requires
-- UiModals, and a cycle would break both.
local Kit: Props = {
	with = with, new = new, corner = corner, stroke = stroke, padding = padding,
	listLayout = listLayout, aspect = aspect, label = label, panel = panel, button = button,
	TitleFont = TITLE_FONT, BodyFont = BODY_FONT,
}

-- HUD: the one region that updates every tick, so it is a flat stack with no nested layouts.
local function buildHud(parent: Instance): Region
	local root = panel({
		Name = "Hud", Position = UDim2.fromScale(0.014, 0.02), Size = UDim2.fromScale(0.26, 0.19),
	}, parent)
	aspect(root, 2.1)
	padding(root, 0.055)
	listLayout(root, 0.03)

	local essence = label({
		Name = "EssenceLabel", LayoutOrder = 1, Size = UDim2.fromScale(1, 0.34),
		Font = TITLE_FONT, TextColor3 = Theme.Ui.Accent, Text = Format.essence(0),
	}, root)
	local income = label({
		Name = "IncomeLabel", LayoutOrder = 2, Size = UDim2.fromScale(1, 0.15),
		TextColor3 = Theme.Ui.Muted, Text = Format.essence(0) .. "/s",
	}, root)
	local stage = label({
		Name = "StageLabel", LayoutOrder = 3, Size = UDim2.fromScale(1, 0.17), Font = TITLE_FONT,
	}, root)

	-- A track plus a Fill whose Size.X.Scale IS the progress: one assignment per update, no maths
	-- in the widget and no tween to fall behind the snapshot.
	local bar = new("Frame", {
		Name = "StageBar", LayoutOrder = 4, Size = UDim2.fromScale(1, 0.09),
		BackgroundColor3 = Theme.Ui.Background, BorderSizePixel = 0,
	}, root)
	corner(bar, 6)
	local fill = new("Frame", {
		Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Ui.Accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 6)

	local chip = label({
		Name = "MultiplierChip", LayoutOrder = 5, Size = UDim2.fromScale(0.46, 0.14),
		BackgroundTransparency = 0.15, BackgroundColor3 = Theme.Ui.Background, Font = TITLE_FONT,
		TextColor3 = Theme.Ui.Warning, TextXAlignment = Enum.TextXAlignment.Center, Text = "x1",
	}, root)
	corner(chip, 6)

	return {
		Root = root, EssenceLabel = essence, IncomeLabel = income,
		StageLabel = stage, StageBar = bar, StageFill = fill, MultiplierChip = chip,
	}
end

--[[ One Sanctum slot. Both the filled and the empty state are built up front, so a partner joining
     or leaving only ever toggles Visible -- no Instance is allocated on a snapshot. ]]
local function buildPartnerRow(parent: Instance, slot: number): Region
	local row = new("Frame", {
		Name = "Slot" .. tostring(slot), LayoutOrder = slot, Size = UDim2.fromScale(1, 0.42),
		BackgroundColor3 = Theme.Ui.Background, BackgroundTransparency = 0.35, BorderSizePixel = 0,
	}, parent)
	corner(row, 8)
	local highlight = new("UIStroke", { Color = Theme.Ui.Accent, Thickness = 2, Transparency = 1 }, row)
	highlight.Name = "Highlight"

	local name = label({
		Name = "NameLabel", Position = UDim2.fromScale(0.05, 0.08),
		Size = UDim2.fromScale(0.62, 0.44), Font = TITLE_FONT, Visible = false,
	}, row)
	local contribution = label({
		Name = "ContributionLabel", Position = UDim2.fromScale(0.05, 0.54),
		Size = UDim2.fromScale(0.62, 0.36), TextColor3 = Theme.Ui.Muted, Visible = false,
	}, row)
	local rebirth = label({
		Name = "RebirthChip", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(0.95, 0.5),
		Size = UDim2.fromScale(0.26, 0.5), BackgroundTransparency = 0.2,
		BackgroundColor3 = Theme.Ui.Panel, TextColor3 = Theme.Ui.Warning,
		TextXAlignment = Enum.TextXAlignment.Center, Visible = false,
	}, row)
	corner(rebirth, 6)

	-- Visible by default: before the first snapshot the honest answer is "nobody is here yet", and
	-- an open slot is the game's standing invitation to bring a friend.
	local empty = label({
		Name = "EmptyLabel", Position = UDim2.fromScale(0.05, 0.2), Size = UDim2.fromScale(0.9, 0.6),
		TextColor3 = Theme.Ui.Muted, Text = "Slot open -- bring a friend to the Sanctum",
	}, row)

	return {
		Row = row, Highlight = highlight, NameLabel = name,
		ContributionLabel = contribution, RebirthChip = rebirth, EmptyLabel = empty,
	}
end

local function buildPartners(parent: Instance): Region
	local root = panel({
		Name = "Partners", AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.986, 0.02), Size = UDim2.fromScale(0.26, 0.16),
	}, parent)
	aspect(root, 2.4)
	padding(root, 0.05)
	listLayout(root, 0.04)
	label({
		Name = "Title", LayoutOrder = 0, Size = UDim2.fromScale(1, 0.16), Font = TITLE_FONT,
		TextColor3 = Theme.Ui.Muted, Text = "SANCTUM",
	}, root)

	return { Root = root, Slots = { buildPartnerRow(root, 1), buildPartnerRow(root, 2) } }
end

-- Bottom-centre, where a thumb reaches on a phone. Transparent: the buttons are the only surface.
local function buildActionBar(parent: Instance): Region
	local root = new("Frame", {
		Name = "ActionBar", AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.975), Size = UDim2.fromScale(0.46, 0.085),
	}, parent)
	listLayout(root, 0.015, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})

	local attune = button({
		Name = "AttuneButton", LayoutOrder = 1, Size = UDim2.fromScale(0.44, 1),
		BackgroundColor3 = Theme.Ui.Accent, Text = "Attune",
	}, root)
	-- Hidden rather than disabled: an ineligible Transcendence is not something the pair should be
	-- looking at at all, and it only appears once Gates.Transcend.Ok says so.
	local transcend = button({
		Name = "TranscendButton", LayoutOrder = 2, Size = UDim2.fromScale(0.34, 1),
		BackgroundColor3 = Theme.Ui.Warning, TextColor3 = Theme.Ui.Background,
		Text = "Transcend", Visible = false,
	}, root)
	local settings = button({
		Name = "SettingsButton", LayoutOrder = 3, Size = UDim2.fromScale(0.14, 1), Text = "Settings",
	}, root)

	return { Root = root, AttuneButton = attune, TranscendButton = transcend, SettingsButton = settings }
end

-- Bottom-left, growing upward so a new toast never shifts one that is still being read.
local function buildToasts(parent: Instance): Region
	local root = new("Frame", {
		Name = "Toasts", AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.014, 0.87), Size = UDim2.fromScale(0.24, 0.42),
	}, parent)
	local layout = listLayout(root, 0.02, { VerticalAlignment = Enum.VerticalAlignment.Bottom })
	return { Root = root, Layout = layout }
end

-- Returns the tree UNPARENTED: ClientBootstrap owns the moment it becomes visible, so a half-built
-- HUD is never on screen.
function UiBuilder.build(): Ui
	local screen = new("ScreenGui", {
		Name = "SanctumHud",
		ResetOnSpawn = false, -- the HUD must survive a respawn; state lives in the store, not here
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, nil)

	return {
		ScreenGui = screen,
		Hud = buildHud(screen),
		Partners = buildPartners(screen),
		ActionBar = buildActionBar(screen),
		Modals = UiModals.build(Kit, screen),
		Toasts = buildToasts(screen),
	}
end

return UiBuilder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">UiModals</string>
              <string name="Source"><![CDATA[--!strict
--[[
    UiModals
    The four full-screen dialogs of the SanctumHud -- link offer, affinity choice, transcendence
    vote and settings -- built from the primitives UiBuilder hands in. Split out of UiBuilder for
    the 300-line rule alone: it is the same builder, equally inert, and knows nothing about the
    store, the remotes or when any of these should be shown.
    Owner: client  |  Consumers: UiBuilder (only)
]]
--[[ WHY EVERY MODAL SHARES ONE SHELL. Four dialogs that each invented their own backdrop, title
     and button row would drift apart the first time one of them was edited. makeShell builds the
     identical frame every time and returns a Content frame for the part that genuinely differs, so
     a controller can show any modal by flipping exactly one Visible. ]]

local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Theme = require(Modules:WaitForChild("Theme"))
local AffinityData = require(Modules:WaitForChild("AffinityData"))

type Kit = { [string]: any }
type Region = { [string]: any }

local UiModals = {}

--[[ Backdrop + panel + title + body + a Content frame + a Confirm/Cancel row.
     The backdrop is Active so it swallows clicks aimed at the world behind it: a modal that can be
     clicked through is a modal a player can dismiss by accident. ]]
local function makeShell(kit: Kit, parent: Instance, name: string, title: string, confirm: string, cancel: string): Region
	local root = kit.new("Frame", {
		Name = name, Active = true, BackgroundColor3 = Theme.Ui.Overlay, BackgroundTransparency = 0.4,
		BorderSizePixel = 0, Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 1),
		Visible = false, ZIndex = 20,
	}, parent)

	local panel = kit.panel({
		Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0,
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.46, 0.44), ZIndex = 21,
	}, root)
	-- Aspect-locked so the panel stays a readable card in portrait instead of a full-height column.
	kit.aspect(panel, 1.45)
	kit.padding(panel, 0.045)
	kit.listLayout(panel, 0.03, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

	local titleLabel = kit.label({
		Name = "Title", LayoutOrder = 1, Size = UDim2.fromScale(1, 0.14), Font = kit.TitleFont,
		TextColor3 = Theme.Ui.Accent, TextXAlignment = Enum.TextXAlignment.Center, Text = title,
		ZIndex = 22,
	}, panel)
	-- TextWrapped + a fixed TextSize, not TextScaled: body copy is several lines, and scaling it to
	-- fill the frame would make a one-line message enormous next to a three-line one.
	local body = kit.label({
		Name = "Body", LayoutOrder = 2, Size = UDim2.fromScale(1, 0.34), TextColor3 = Theme.Ui.Muted,
		TextScaled = false, TextSize = 16, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 22,
	}, panel)

	local content = kit.new("Frame", {
		Name = "Content", BackgroundTransparency = 1, LayoutOrder = 3,
		Size = UDim2.fromScale(1, 0.32), ZIndex = 22,
	}, panel)

	local row = kit.new("Frame", {
		Name = "Actions", BackgroundTransparency = 1, LayoutOrder = 4,
		Size = UDim2.fromScale(1, 0.16), ZIndex = 22,
	}, panel)
	kit.listLayout(row, 0.03, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	local cancelButton = kit.button({
		Name = "Cancel", LayoutOrder = 1, Size = UDim2.fromScale(0.44, 1),
		BackgroundColor3 = Theme.Ui.Background, TextColor3 = Theme.Ui.Muted, Text = cancel, ZIndex = 23,
	}, row)
	local confirmButton = kit.button({
		Name = "Confirm", LayoutOrder = 2, Size = UDim2.fromScale(0.44, 1),
		BackgroundColor3 = Theme.Ui.Accent, TextColor3 = Theme.Ui.Background, Text = confirm, ZIndex = 23,
	}, row)

	return {
		Root = root, Panel = panel, Title = titleLabel, Body = body, Content = content,
		Actions = row, Confirm = confirmButton, Cancel = cancelButton,
	}
end

local function buildLinkOffer(kit: Kit, parent: Instance): Region
	local shell = makeShell(kit, parent, "LinkOffer", "Share this Sanctum?", "Accept", "Decline")
	shell.Body.Text = "Linking merges both Sanctums, keeping the better of every value. Nobody loses"
		.. " anything they already own."
	-- Named so LinkOffer's controller has one label for "who is asking" separate from the fixed
	-- explanation of what linking does -- the explanation must not be overwritten by a name.
	shell.FromLabel = kit.label({
		Name = "FromLabel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 0.6), Font = kit.TitleFont,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 23,
	}, shell.Content)
	return shell
end

--[[ Affinity: the four elements are read from AffinityData rather than written out here, so adding
     a fifth element is a data change and this file never learns their names. ]]
local function buildAffinity(kit: Kit, parent: Instance): Region
	local shell = makeShell(kit, parent, "Affinity", "Choose an Affinity", "Confirm", "Later")
	shell.Body.Text = "The Conflux is ready to commit to an element. This choice is permanent until"
		.. " your next Transcendence."
	kit.listLayout(shell.Content, 0.02, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})

	local buttons: { [string]: any } = {}
	for index, def in ipairs(AffinityData.List) do
		buttons[def.Id] = kit.button({
			Name = def.Id, LayoutOrder = index, Size = UDim2.fromScale(0.23, 0.9),
			-- The element's own colour is the label: four same-coloured buttons would make the
			-- choice read as arbitrary when it is the most flavourful decision in the run.
			BackgroundColor3 = def.Color, TextColor3 = Theme.Ui.Background, Text = def.Name,
			ZIndex = 23,
		}, shell.Content)
	end
	shell.Buttons = buttons
	return shell
end

--[[ Transcendence: the vote list is pre-built at SlotsPerSanctum rows and left invisible, so the
     live vote only ever toggles Visible and rewrites text -- no allocation inside a 30s countdown
     that is already the tensest moment in the game. ]]
local function buildTranscend(kit: Kit, parent: Instance): Region
	local shell = makeShell(kit, parent, "Transcend", "Transcend the Sanctum?", "Vote yes", "Vote no")
	shell.Body.Text = "Everything in the Sanctum resets. Every occupant must agree, and everyone who"
		.. " votes yes keeps the permanent multiplier."

	local list = kit.new("Frame", {
		Name = "VoteList", BackgroundTransparency = 1, Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 0.72), ZIndex = 22,
	}, shell.Content)
	kit.listLayout(list, 0.04, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

	local rows: { any } = {}
	for slot = 1, 2 do
		rows[slot] = kit.label({
			Name = "Vote" .. tostring(slot), LayoutOrder = slot, Size = UDim2.fromScale(0.9, 0.42),
			BackgroundTransparency = 0.35, BackgroundColor3 = Theme.Ui.Background,
			TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 23,
		}, list)
		kit.corner(rows[slot], 6)
	end

	shell.VoteList = list
	shell.VoteRows = rows
	-- Separate from Body so the countdown can be rewritten every second without reflowing the
	-- wrapped explanation above it.
	shell.TimerLabel = kit.label({
		Name = "TimerLabel", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.24), TextColor3 = Theme.Ui.Warning,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 23,
	}, shell.Content)
	return shell
end

--[[ Settings. The toggles are TextButtons whose Text carries their state, so SettingsController
     renders "Music: On" straight from Settings in the snapshot with no widget state of its own.
     ResetButton starts hidden: it is gated on Debug.AllowDataReset and, when
     Debug.DataResetStudioOnly is set, on RunService:IsStudio() -- checks that belong to the
     controller, not to a builder. ]]
local function buildSettings(kit: Kit, parent: Instance): Region
	local shell = makeShell(kit, parent, "Settings", "Settings", "Done", "Close")
	shell.Body.Text = "Audio preferences are saved to your profile and follow you between servers."
	kit.listLayout(shell.Content, 0.03, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

	local function toggle(name: string, order: number, text: string): any
		return kit.button({
			Name = name, LayoutOrder = order, Size = UDim2.fromScale(0.8, 0.26),
			BackgroundColor3 = Theme.Ui.Background, Text = text, ZIndex = 23,
		}, shell.Content)
	end

	shell.MusicToggle = toggle("MusicToggle", 1, "Music: On")
	shell.SfxToggle = toggle("SfxToggle", 2, "Sfx: On")
	shell.ResetButton = kit.button({
		Name = "ResetButton", LayoutOrder = 3, Size = UDim2.fromScale(0.8, 0.26),
		BackgroundColor3 = Theme.Ui.Negative, Text = "Hold to reset my save", Visible = false,
		ZIndex = 23,
	}, shell.Content)
	return shell
end

function UiModals.build(kit: Kit, parent: Instance): Region
	return {
		LinkOffer = buildLinkOffer(kit, parent),
		Affinity = buildAffinity(kit, parent),
		Transcend = buildTranscend(kit, parent),
		Settings = buildSettings(kit, parent),
	}
end

return UiModals
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="65">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-150</float>
      <float name="Gravity">175</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>