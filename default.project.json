{
  "name": "Sanctum of Embers",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Core": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 175,
        "FallenPartsDestroyHeight": -150,
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.055, 0.035, 0.03],
        "OutdoorAmbient": [0.09, 0.055, 0.04],
        "Brightness": 1.1,
        "ClockTime": 1.5,
        "GeographicLatitude": 0,
        "GlobalShadows": true,
        "ShadowSoftness": 0.35,
        "EnvironmentDiffuseScale": 0.25,
        "EnvironmentSpecularScale": 0.4,
        "ExposureCompensation": 0.15,
        "ColorShift_Top": [0.36, 0.17, 0.06],
        "ColorShift_Bottom": [0.1, 0.04, 0.02],
        "FogColor": [0.05, 0.03, 0.035],
        "FogStart": 90,
        "FogEnd": 700
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "AmbientReverb": "Hangar",
        "DistanceFactor": 3.33,
        "DopplerScale": 1,
        "RolloffScale": 1,
        "RespectFilteringEnabled": true
      }
    }
  }
}
